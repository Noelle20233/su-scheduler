#!/system/bin/sh
# ---------------------------------------------------------------------------------------
# 🔥 Su Scheduler Daemon (su-schedulerd) 🔥
# ---------------------------------------------------------------------------------------
# Author: Rex Ackermann
# Description: The background engine that makes magic happen.
# ---------------------------------------------------------------------------------------

VERSION="1.6.8"

# 🧹 CRITICAL: Clean environment to prevent shell interference
unset $(env | grep -E '^(TERMUX_|PREFIX|ANDROID_|COLORTERM|TERM_PROGRAM)' | cut -d= -f1)
export PATH="/system/bin:/system/xbin:/vendor/bin"
export HOME="/data/local/tmp"

# 🔒 CRITICAL: Change to root directory to avoid inheriting caller's cwd
cd / || exit 1

# ⚙️ Constants
DATA_DIR="/data/adb/su-scheduler"           # Where the magic data lives
CONFIG_FILE="/sdcard/Documents/su-scheduler/config.txt" # Your schedule whispering gallery
LOG_FILE="$DATA_DIR/su-scheduler.log"              # The diary of everything that happened
LOCK_FILE="/dev/.su_scheduler.lock"          # Making sure only one ghost is in the machine
TASKS_DIR="$DATA_DIR/tasks"                  # Where individual task processes live
SHELLS_DIR="$DATA_DIR/shells"                # Interactive shell session storage
AUDIT_DIR="$DATA_DIR/audit"                  # Where the Mission Auditor keeps its notes
AUDIT_LOG="$AUDIT_DIR/audit.log"             # The historical record of changes and gaps
CONFIG_SNAPSHOT="$AUDIT_DIR/config.snapshot" # The last known good state of your config
LAST_PULSE_FILE="$AUDIT_DIR/last_pulse"     # Tracking the daemon's heartbeat

# 🎨 Color codes for beautiful logging
C_RESET='\033[0m'
C_RED='\033[38;5;196m'
C_GREEN='\033[38;5;46m'
C_BLUE='\033[38;5;39m'
C_YELLOW='\033[38;5;226m'
C_MAGENTA='\033[38;5;201m'
C_CYAN='\033[38;5;51m'
C_BOLD='\033[1m'

# 🏗️ Ensure our workspace directories exist
mkdir -p "$TASKS_DIR"
mkdir -p "$SHELLS_DIR"
mkdir -p "$AUDIT_DIR"
[ ! -f "$AUDIT_LOG" ] && touch "$AUDIT_LOG"

# ═══════════════════════════════════════════════════════════════════════════
# ⚙️ Production Runtime Library（P2-02）：与 su-scheduler（CLI）共用同一套
#   Registry / Provider / State / Runtime / Lifecycle / Task-CLI 原语
#   （/system/bin/su-scheduler-runtime）。加载契约见库头：
#   - 库缺失 / 不可读 / 语法破损 / selfcheck 不通过 → RUNTIME_LOADED=0；
#   - **legacy 路径原样继续**（本库是叠加层，不修改既有行为路径——C2）；
#   - 本 daemon 启动时仅记录一次 WARNING（不中断、不重试、不降级功能）。
# ═══════════════════════════════════════════════════════════════════════════
RUNTIME_LIB="/system/bin/su-scheduler-runtime"
RUNTIME_LOADED=0
if [ -f "$RUNTIME_LIB" ] && [ -r "$RUNTIME_LIB" ]; then
    . "$RUNTIME_LIB" 2>/dev/null && RUNTIME_LOADED=1 || RUNTIME_LOADED=0
fi
if [ "$RUNTIME_LOADED" -eq 1 ]; then
    runtime_lib_selfcheck >/dev/null 2>&1 || RUNTIME_LOADED=0
fi
if [ "$RUNTIME_LOADED" -eq 1 ]; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [INFO] ⚙️ Runtime library loaded (v${RUNTIME_LIB_VERSION:-?})" >> "$LOG_FILE" 2>/dev/null
else
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [WARNING] ⚠️ Runtime library unavailable ($RUNTIME_LIB); legacy mode active" >> "$LOG_FILE" 2>/dev/null
fi

# 🧪 [P7-01] Runtime 版本漂移诊断（仅记日志、零行为改动）：挂载层（宿主 magic
#   mount / Mountify 拷贝）语义为"重启生效"；模块目录已更新但 /system/bin 仍是
#   旧拷贝时给出待重启提示（取证背景见 docs/P7-MOUNTIFY-HANDOFF.md）。
runtime_drift_check() {
    [ "${RUNTIME_LOADED:-0}" -eq 1 ] || return 0
    SS_MODRT="${SS_MODRT:-/data/adb/modules/su-scheduler/system/bin/su-scheduler-runtime}"
    [ -r "$SS_MODRT" ] || return 0
    SS_MODVER=$(grep -m1 '^RUNTIME_LIB_VERSION=' "$SS_MODRT" 2>/dev/null | sed 's/^RUNTIME_LIB_VERSION="//; s/"$//')
    [ -n "$SS_MODVER" ] || return 0
    if [ "$SS_MODVER" != "${RUNTIME_LIB_VERSION:-}" ]; then
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] [WARNING] 🧪 Runtime version drift: mounted v${RUNTIME_LIB_VERSION:-?} != module-dir v$SS_MODVER (reboot to propagate update)" >> "$LOG_FILE" 2>/dev/null
    fi
    return 0
}
runtime_drift_check

# 🛡️ TERM/INT/HUP trap（D-P5-01 加固）：**在启动最前面注册**（早于单实例仲裁与
#   crash_guard_enter）。否则快速重启风暴中 cmd_stop 的 TERM 可能在实例处于
#   仲裁等待/guard 记账阶段（未注册 trap）时到达 → 默认信号退出 → 不留 last_clean=1
#   → 下一实例误判崩溃 → crash_seq 假累加 → 假降级。此处无论实例处于启动哪个
#   阶段，优雅信号一律记 last_clean=1（graceful kill，非崩溃）。
if [ "$RUNTIME_LOADED" -eq 1 ]; then
    trap 'crash_record_exit "$DATA_DIR" 0 >/dev/null 2>&1; exit 0' TERM INT HUP
fi

# 📝 Function to log events with pretty timestamps and colors
log_msg() {
    local level="$1"
    local message="$2"
    local timestamp="$(date "+%Y-%m-%d %H:%M:%S")"

    case "$level" in
        INFO)    color="${C_BLUE}" ;;
        SUCCESS) color="${C_GREEN}" ;;
        WARNING) color="${C_YELLOW}" ;;
        ERROR)   color="${C_RED}" ;;
        TASK)    color="${C_MAGENTA}" ;;
        *)       color="${C_CYAN}" ;;
    esac

    # Log to file with colors (for cat/tail viewing)
    echo -e "${color}${C_BOLD}[$timestamp]${C_RESET} ${color}[$level]${C_RESET} $message" >> "$LOG_FILE"
}

# 🔍 Specialized Audit Logging
log_audit() {
    local type="$1"
    local message="$2"
    local timestamp="$(date "+%Y-%m-%d %H:%M:%S")"

    case "$type" in
        CHANGE)  color="${C_CYAN}"   ; icon="📝" ;;
        GAP)     color="${C_RED}"    ; icon="⚠️"  ;;
        SUCCESS) color="${C_GREEN}"  ; icon="✅" ;;
        WARNING) color="${C_YELLOW}" ; icon="❗" ;;
        *)       color="${C_WHITE}"  ; icon="🔍" ;;
    esac

    echo -e "${C_BOLD}${color}[$timestamp]${C_RESET} ${color}$icon [$type] $message${C_RESET}" >> "$AUDIT_LOG"
}

# 📅 Function to check if task should run based on advanced scheduling
should_run_advanced_schedule() {
    local trigger="$1"
    local current_time="$2"
    local command_full="$3"
    local state_file="$DATA_DIR/schedule_state.txt"

    # Create state file if it doesn't exist
    [ ! -f "$state_file" ] && touch "$state_file"

    # Get current date components
    local current_day=$(date "+%d")        # Day of month (01-31)
    local current_month=$(date "+%m")      # Month (01-12)
    local current_year=$(date "+%Y")       # Year
    local current_dow=$(date "+%u")        # Day of week (1=Monday, 7=Sunday)
    local current_week=$(date "+%V")       # Week number (01-53)

    # 🧬 Generate a unique task key based on the command content (MD5)
    # This ensures that different tasks scheduled at the same time don't conflict
    local cmd_hash=$(echo "$command_full" | md5sum | cut -d' ' -f1)

    # 📅 Weekly schedule: weekly:DAY:HHMM (e.g., weekly:1:0800 = Monday at 8am)
    if echo "$trigger" | grep -q "^weekly:"; then
        local target_dow=$(echo "$trigger" | cut -d: -f2)
        local target_time=$(echo "$trigger" | cut -d: -f3)

        if [ "$current_dow" = "$target_dow" ] && [ "$current_time" -ge "$target_time" ]; then
            local state_key="weekly_${target_dow}_${target_time}_${cmd_hash}_${current_year}${current_month}${current_day}"
            if ! grep -q "^$state_key$" "$state_file"; then
                echo "$state_key" >> "$state_file"
                return 0
            fi
        fi
        return 1
    fi

    # 📅 N-Weekly schedule: nweekly:N:DAY:HHMM (e.g., nweekly:2:1:0800 = Every 2 weeks on Monday at 8am)
    if echo "$trigger" | grep -q "^nweekly:"; then
        local n_weeks=$(echo "$trigger" | cut -d: -f2)
        local target_dow=$(echo "$trigger" | cut -d: -f3)
        local target_time=$(echo "$trigger" | cut -d: -f4)

        if [ "$current_dow" = "$target_dow" ] && [ "$current_time" -ge "$target_time" ]; then
            local state_key="nweekly_${n_weeks}_${target_dow}_${target_time}_${cmd_hash}"
            local last_run=$(grep "^${state_key}=" "$state_file" | cut -d= -f2)

            if [ -z "$last_run" ]; then
                # First time run
                echo "${state_key}=${current_week}" >> "$state_file"
                return 0
            else
                local weeks_diff=$(( (current_week - last_run + 53) % 53 ))
                if [ $weeks_diff -ge "$n_weeks" ]; then
                    sed -i "s/^${state_key}=.*/${state_key}=${current_week}/" "$state_file"
                    return 0
                fi
            fi
        fi
        return 1
    fi

    # 📅 Monthly schedule: monthly:DAY:HHMM (e.g., monthly:1:0800 = 1st of every month at 8am)
    if echo "$trigger" | grep -q "^monthly:"; then
        local target_day=$(echo "$trigger" | cut -d: -f2)
        local target_time=$(echo "$trigger" | cut -d: -f3)

        if [ "$current_day" = "$target_day" ] && [ "$current_time" -ge "$target_time" ]; then
            local state_key="monthly_${target_day}_${target_time}_${cmd_hash}_${current_year}${current_month}"
            if ! grep -q "^$state_key$" "$state_file"; then
                echo "$state_key" >> "$state_file"
                return 0
            fi
        fi
        return 1
    fi

    # 📅 N-Monthly schedule: nmonthly:N:DAY:HHMM
    if echo "$trigger" | grep -q "^nmonthly:"; then
        local n_months=$(echo "$trigger" | cut -d: -f2)
        local target_day=$(echo "$trigger" | cut -d: -f3)
        local target_time=$(echo "$trigger" | cut -d: -f4)

        if [ "$current_day" = "$target_day" ] && [ "$current_time" -ge "$target_time" ]; then
            local state_key="nmonthly_${n_months}_${target_day}_${target_time}_${cmd_hash}"
            local last_run_month=$(grep "^${state_key}=" "$state_file" | cut -d= -f2)

            if [ -z "$last_run_month" ]; then
                echo "${state_key}=${current_month}" >> "$state_file"
                return 0
            else
                local total_months=$(( (current_year * 12) + current_month ))
                local last_total=$(( (current_year * 12) + last_run_month ))
                # Adjustment for year rollover
                if [ $total_months -lt $last_total ]; then last_total=$(( ( (current_year-1) * 12 ) + last_run_month )); fi

                local months_diff=$(( total_months - last_total ))
                if [ $months_diff -ge "$n_months" ]; then
                    sed -i "s/^${state_key}=.*/${state_key}=${current_month}/" "$state_file"
                    return 0
                fi
            fi
        fi
        return 1
    fi

    # 📅 Yearly schedule: yearly:MMDD:HHMM (e.g., yearly:1225:0800 = Dec 25th at 8am)
    if echo "$trigger" | grep -q "^yearly:"; then
        local target_date=$(echo "$trigger" | cut -d: -f2)
        local target_time=$(echo "$trigger" | cut -d: -f3)
        local current_mmdd="${current_month}${current_day}"

        if [ "$current_mmdd" = "$target_date" ] && [ "$current_time" -ge "$target_time" ]; then
            local state_key="yearly_${target_date}_${target_time}_${cmd_hash}_${current_year}"
            if ! grep -q "^$state_key$" "$state_file"; then
                echo "$state_key" >> "$state_file"
                return 0
            fi
        fi
        return 1
    fi

    # Not an advanced schedule
    return 1
}

# 📢 Function to send Android notifications
send_notification() {
    local title="$1"
    local message="$2"
    local tag="${3:-su_scheduler_alert}"
    local priority="${4:-0}"  # 0=normal, 1=high

    # Try multiple notification methods for compatibility
    if command -v cmd >/dev/null 2>&1; then
        # Modern Android notification service (via shell user 2000 for maximum reliability)
        # We use environment variables to pass the text to avoid messy shell escaping bugs
        NOTIF_TITLE="$title" NOTIF_MSG="$message" NOTIF_TAG="$tag" \
        su -lp 2000 -c 'cmd notification post -S bigtext -t "$NOTIF_TITLE" "$NOTIF_TAG" "$NOTIF_MSG"' >/dev/null 2>&1
    fi

    # Also try termux-notification if available (for Termux users)
    if command -v termux-notification >/dev/null 2>&1; then
        termux-notification --title "$title" --content "$message" --priority "$priority" --id "$tag" 2>/dev/null
    fi

    # Log that we sent a notification
    log_msg "INFO" "📢 Notification sent [$tag]: $title - $message"
}

# 📝 Track Configuration Changes
track_config_changes() {
    [ ! -f "$CONFIG_FILE" ] && return

    # If no snapshot exists, create one and return
    if [ ! -f "$CONFIG_SNAPSHOT" ]; then
        cp "$CONFIG_FILE" "$CONFIG_SNAPSHOT"
        return
    fi

    # Check for additions/modifications (lines in config not in snapshot)
    cat "$CONFIG_FILE" | while read -r line; do
        # Ignore comments and empty lines
        clean_line=$(echo "$line" | sed 's/^[ \t]*//;s/[ \t]*$//')
        [ -z "$clean_line" ] || echo "$clean_line" | grep -q "^#" && continue

        if ! grep -qF "$line" "$CONFIG_SNAPSHOT"; then
             trigger=$(echo "$clean_line" | awk '{print $1}')
             log_audit "CHANGE" "New mission assignment detected: $trigger"
        fi
    done

    # Check for removals
    cat "$CONFIG_SNAPSHOT" | while read -r line; do
        clean_line=$(echo "$line" | sed 's/^[ \t]*//;s/[ \t]*$//')
        [ -z "$clean_line" ] || echo "$clean_line" | grep -q "^#" && continue

        if ! grep -qF "$line" "$CONFIG_FILE" && ! echo "$line" | grep -q "\-\-run-once-now"; then
             trigger=$(echo "$clean_line" | awk '{print $1}')
             log_audit "CHANGE" "Mission terminated/removed: $trigger"
        fi
    done

    # Sync snapshot
    cp "$CONFIG_FILE" "$CONFIG_SNAPSHOT"
}

# ⚠️ Audit Execution Gaps (Downtime Detection)
audit_check_gaps() {
    local now_ts=$(date +%s)

    if [ -f "$LAST_PULSE_FILE" ]; then
        local last_pulse=$(cat "$LAST_PULSE_FILE")
        local diff=$((now_ts - last_pulse))

        # If the gap is longer than 70 seconds (1 min buffer), something happened
        if [ $diff -gt 75 ]; then
            local gap_min=$((diff / 60))
            log_audit "GAP" "Station offline for ~$gap_min minutes. Some missions may have been skipped."
        fi
    fi

    echo "$now_ts" > "$LAST_PULSE_FILE"
}

# 🚀 Function to execute a task in its own isolated process
execute_task() {
    local task_id="$1"
    local cmd_to_run="$2"
    local notify_start="$3"
    local notify_end="$4"
    local custom_msg="$5"
    local interactive="$6"
    local use_termux="$7"

    # 🕵️ Collision Detection: Check if an identical command is already in progress
    if [ -d "$TASKS_DIR" ]; then
        for active_task in "$TASKS_DIR"/*; do
            if [ -d "$active_task" ] && [ -f "$active_task/status.txt" ] && grep -q "RUNNING" "$active_task/status.txt"; then
                if [ -f "$active_task/command.txt" ] && [ "$(cat "$active_task/command.txt")" = "$cmd_to_run" ]; then
                    target_pid=$(cat "$active_task/pid.txt" 2>/dev/null)
                    if [ -n "$target_pid" ] && [ -d "/proc/$target_pid" ]; then
                        log_msg "WARNING" "⚠️ Collision! Identical command already running (PID: $target_pid). Skipping task [$task_id]."
                        return 1
                    else
                        # 🧹 Stale record found! Update it so it doesn't block future runs.
                        echo "STALE" > "$active_task/status.txt"
                        log_msg "INFO" "🧹 Cleared stale run record for: $cmd_to_run"
                    fi
                fi
            fi
        done
    fi

    # Create a unique task directory for this execution
    local task_dir="$TASKS_DIR/$task_id"
    mkdir -p "$task_dir"

    # Create lockfile for this specific task
    local task_lock="$task_dir/task.lock"
    echo $$ > "$task_lock"

    # Task metadata
    echo "$cmd_to_run" > "$task_dir/command.txt"
    date "+%Y-%m-%d %H:%M:%S" > "$task_dir/start_time.txt"
    echo "RUNNING" > "$task_dir/status.txt"

    # Log execution mode
    if [ "$use_termux" = "1" ]; then
        log_msg "TASK" "🐧 Task [$task_id] starting in TERMUX environment: $cmd_to_run"
        echo "TERMUX" > "$task_dir/exec_mode.txt"
    else
        log_msg "TASK" "🚀 Task [$task_id] starting: $cmd_to_run"
        echo "SYSTEM" > "$task_dir/exec_mode.txt"
    fi

    # Send start notification if requested
    if [ "$notify_start" = "1" ]; then
        local start_msg="${custom_msg:-Task started}"
        send_notification "Su Scheduler - Task Started" "$start_msg: $cmd_to_run" "su_scheduler_$task_id"
    fi

    # Execute the command based on mode
    if [ "$interactive" = "1" ]; then
        # 🎮 Interactive mode - Create a named pipe for real-time interaction
        local shell_fifo="$SHELLS_DIR/${task_id}.fifo"
        local shell_out="$SHELLS_DIR/${task_id}.out"
        local shell_in="$SHELLS_DIR/${task_id}.in"

        # Create FIFOs for bidirectional communication
        mkfifo "$shell_in" 2>/dev/null || true
        mkfifo "$shell_fifo" 2>/dev/null || true

        log_msg "INFO" "🎮 Interactive shell session created: $task_id"
        log_msg "INFO" "   Input:  $shell_in"
        log_msg "INFO" "   Output: $shell_out"

        # Determine shell to use
        local shell_cmd="sh"
        if [ "$use_termux" = "1" ]; then
            # Use Termux shell if available
            if [ -x "/system/bin/su-scheduler-termux" ]; then
                shell_cmd="/system/bin/su-scheduler-termux exec sh"
            fi
        fi

        # Run in interactive shell with I/O redirection
        (
            $shell_cmd -i < "$shell_in" > "$shell_out" 2>&1 &
            shell_pid=$!
            echo "$shell_pid" > "$task_dir/pid.txt"

            # Send the command to the shell
            echo "$cmd_to_run" > "$shell_in"

            wait $shell_pid
            exit_code=$?
            echo "$exit_code" > "$task_dir/exit_code.txt"
        ) &
    else
        # 🔧 Standard execution mode
        (
            # 🔒 CRITICAL: Ensure subshell runs from root directory
            cd / || exit 1

            # 🧹 Clean environment to avoid shell interference (keep essential vars)
            export PATH="/system/bin:/system/xbin:/vendor/bin"
            export HOME="/data/local/tmp"
            unset TERMUX_VERSION TERMUX_APP_PID TERMUX_PREFIX PREFIX

            # Redirect all errors to log file for debugging
            exec 2>> "$LOG_FILE"

            # Debug: Mark subshell entry
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] [DEBUG] Subshell started for task $task_id" >> "$LOG_FILE"
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] [DEBUG] Command: $cmd_to_run" >> "$LOG_FILE"

            # 🐧 Check if Termux execution is requested
            if [ "$use_termux" = "1" ]; then
                echo "[$(date '+%Y-%m-%d %H:%M:%S')] [INFO] 🐧 Executing in Termux environment..." >> "$LOG_FILE"

                # Check if Termux helper is available
                if [ -x "/system/bin/su-scheduler-termux" ]; then
                    # Validate Termux installation
                    termux_status=$(/system/bin/su-scheduler-termux status)

                    if [ "$termux_status" = "READY" ]; then
                        echo "[$(date '+%Y-%m-%d %H:%M:%S')] [SUCCESS] ✅ Termux environment validated" >> "$LOG_FILE"
                        echo "[$(date '+%Y-%m-%d %H:%M:%S')] [DEBUG] Final Command (Termux): /system/bin/su-scheduler-termux exec \"$cmd_to_run\"" >> "$LOG_FILE"
                        /system/bin/su-scheduler-termux exec "$cmd_to_run" > "$task_dir/output.log" 2>&1
                        exit_code=$?
                    elif [ "$termux_status" = "LOCKED" ]; then
                        echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ERROR] ❌ User 0 is locked. Cannot access Termux." >> "$LOG_FILE"
                        echo "ERROR: User 0 locked" > "$task_dir/output.log"
                        exit_code=1
                    else
                        echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ERROR] ❌ Termux is not installed or accessible" >> "$LOG_FILE"
                        echo "ERROR: Termux not installed" > "$task_dir/output.log"
                        exit_code=1
                    fi
                else
                    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ERROR] ❌ Termux helper not found" >> "$LOG_FILE"
                    echo "ERROR: Termux helper missing" > "$task_dir/output.log"
                    exit_code=1
                fi
            else
                # 🧠 Smart execution logic
                first_arg=$(echo "$cmd_to_run" | awk '{print $1}')

                if [ -f "$first_arg" ]; then
                    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [INFO] 📜 Detected script file: $first_arg" >> "$LOG_FILE"

                    if [ ! -x "$first_arg" ]; then
                        chmod +x "$first_arg" 2>/dev/null
                    fi

                    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [DEBUG] Final Command (Script): sh -c \"$cmd_to_run\"" >> "$LOG_FILE"
                    sh -c "$cmd_to_run" > "$task_dir/output.log" 2>&1
                    exit_code=$?

                    if [ $exit_code -ne 0 ] && ([ $exit_code -eq 126 ] || [ $exit_code -eq 127 ]); then
                        if command -v bash >/dev/null 2>&1; then
                            echo "[$(date '+%Y-%m-%d %H:%M:%S')] [DEBUG] Final Command (Bash Fallback): bash \"$first_arg\" ..." >> "$LOG_FILE"
                            bash "$first_arg" $(echo "$cmd_to_run" | cut -d' ' -f2-) > "$task_dir/output.log" 2>&1
                            exit_code=$?
                        fi

                        if [ $exit_code -ne 0 ]; then
                            echo "[$(date '+%Y-%m-%d %H:%M:%S')] [DEBUG] Final Command (Sh Fallback): sh \"$first_arg\" ..." >> "$LOG_FILE"
                            sh "$first_arg" $(echo "$cmd_to_run" | cut -d' ' -f2-) > "$task_dir/output.log" 2>&1
                            exit_code=$?
                        fi
                    fi
                else
                    # Not a file, execute as regular command
                    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [DEBUG] Final Command (Shell): sh -c \"$cmd_to_run\"" >> "$LOG_FILE"
                    sh -c "$cmd_to_run" > "$task_dir/output.log" 2>&1
                    exit_code=$?
                    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [DEBUG] Command exit code: $exit_code" >> "$LOG_FILE"
                fi
            fi

            echo "$exit_code" > "$task_dir/exit_code.txt"
            date "+%Y-%m-%d %H:%M:%S" > "$task_dir/end_time.txt"

            if [ $exit_code -eq 0 ]; then
                echo "SUCCESS" > "$task_dir/status.txt"
                echo "[$(date '+%Y-%m-%d %H:%M:%S')] [SUCCESS] ✅ Task [$task_id] completed successfully (exit: $exit_code)" >> "$LOG_FILE"

                if [ "$notify_end" = "1" ]; then
                    send_notification "Su Scheduler - Task Complete" "✅ $cmd_to_run" "su_scheduler_$task_id"
                fi
            else
                echo "FAILED" > "$task_dir/status.txt"
                echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ERROR] ❌ Task [$task_id] failed (exit: $exit_code)" >> "$LOG_FILE"
                send_notification "Su Scheduler - Task Failed" "❌ $cmd_to_run (exit: $exit_code)" "su_scheduler_$task_id"
            fi

            rm -f "$task_lock"
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] [DEBUG] Subshell completed for task $task_id" >> "$LOG_FILE"
        ) &
    fi

    # Store the background process PID
    echo $! > "$task_dir/pid.txt"
}


# 🔍 Parse task modifiers from config line
parse_modifiers() {
    local line="$1"

    # Initialize flags
    notify_start=0
    notify_end=0
    delete_after=0
    interactive=0
    use_termux=0
    run_once_now=0
    custom_msg=""

    # Extract the modifier part (everything after the last ' : ')
    local mods=$(echo "$line" | sed -n 's/.* : //p')

    if [ -n "$mods" ]; then
        # Check for --run-once-now
        echo "$mods" | grep -q "\-\-run-once-now" && run_once_now=1
        # Check for --notify-start
        echo "$mods" | grep -q "\-\-notify-start" && notify_start=1
        # Check for --notify-end
        echo "$mods" | grep -q "\-\-notify-end" && notify_end=1
        # Check for --notify (both start and end)
        if echo "$mods" | grep -q "\-\-notify" && ! echo "$mods" | grep -E -q "\-\-notify-(start|end)"; then
            notify_start=1
            notify_end=1
        fi
        # Check for --delete
        echo "$mods" | grep -q "\-\-delete" && delete_after=1
        # Check for --interactive
        echo "$mods" | grep -q "\-\-interactive" && interactive=1
        # Check for --termux
        echo "$mods" | grep -q "\-\-termux" && use_termux=1

        # Extract custom message if present: --msg="Your message"
        if echo "$mods" | grep -q "\-\-msg="; then
            custom_msg=$(echo "$mods" | sed -n 's/.*--msg="\([^"]*\)".*/\1/p')
        fi
    fi
}

# 🧪 Helper to extract command from config line (strips modifiers)
extract_command() {
    local line="$1"
    # Logic: Preserve everything after the first space (trigger) 
    # but strip everything starting from the modifier separator ( : --)
    local raw_cmd=$(echo "$line" | cut -d' ' -f2-)

    # Robustly strip modifiers: handles " : --", \"; : --\", etc.
    # We look for a space followed by an optional semicolon, then a colon, then a space and --
    echo "$raw_cmd" | sed 's/[ \t]*;*[ \t]*:[ \t]*--.*//'
}
# 🛡️ Single Instance Protection
# Check multiple times to allow old process to exit during restart.
# P4-11：既有实现等待 5s 后**强制接管**（rm lock 继续启动）→ `su-scheduler
#   restart` 与 service.sh watchdog 同时拉起两个实例 → 双实例竞争写
#   daemon.guard 与 IPC 目录 → crash-guard degraded 循环 + IPC operation_timeout
#   （真机实测：restart 后双 PID 并存）。改为：等待 5s 后旧实例**仍存活** →
#   本实例退出（严格单实例，不接管）；仅 stale lock（PID 已死）允许清理接管。
COUNT=0
LOCK_STILL_ACTIVE=0
while [ $COUNT -lt 5 ]; do
    if [ -f "$LOCK_FILE" ]; then
        PID=$(cat "$LOCK_FILE")
        if [ -n "$PID" ] && [ -d "/proc/$PID" ]; then
            if [ $COUNT -eq 0 ]; then
                log_msg "WARNING" "⚠️ Daemon active (PID $PID). Waiting for exit..."
            fi
            sleep 1
            COUNT=$((COUNT + 1))
            LOCK_STILL_ACTIVE=1
            continue
        fi
    fi
    LOCK_STILL_ACTIVE=0
    break
done

# P4-11：等待超时后旧实例仍存活 → 不接管、本实例退出（严格单实例）。避免
#   restart 与 watchdog 竞态产生的双实例竞争 IPC/guard（真机缺陷，见上）。
if [ "$LOCK_STILL_ACTIVE" -eq 1 ]; then
    log_msg "WARNING" "⚠️ Another daemon (PID $(cat "$LOCK_FILE" 2>/dev/null)) still active after 5s; refusing to start (single-instance)"
    exit 0
fi

# 🔒 原子接管（D-P5-01）：watchdog 与 CLI 可能同时拉起实例，仅"检查后再写 PID"
#   存在 TOCTOU 窗口（两实例都可能通过 LOCK_STILL_ACTIVE 判定）。改用 noclobber
#   原子创建锁文件——仅一个实例能成功；竞态落败者重新判定存活后拒绝退出。
#   注意：接管前**不**无条件 rm 锁文件（会删掉并发实例刚创建的空锁 → 双实例）。
#   空锁 = 并发实例正在写 PID → 让位轮询（至多 ~3s），不立即 rm；仅对"死 PID"
#   或"长时间仍空（崩溃残留）"的锁清理后重试一次。
if ( set -C; : > "$LOCK_FILE" ) 2>/dev/null; then
    echo $$ > "$LOCK_FILE"
else
    NPID=$(cat "$LOCK_FILE" 2>/dev/null)
    _c=0
    while [ -z "$NPID" ] && [ "$_c" -lt 3 ]; do
        sleep 1; _c=$((_c + 1)); NPID=$(cat "$LOCK_FILE" 2>/dev/null)
    done
    if [ -n "$NPID" ] && [ -d "/proc/$NPID" ]; then
        log_msg "WARNING" "⚠️ Another daemon (PID $NPID) holds the lock; refusing to start (single-instance)"
        exit 0
    fi
    # stale（死 PID）或 3s 仍空（崩溃残留空锁）→ 清理后重试一次
    rm -f "$LOCK_FILE" 2>/dev/null
    ( set -C; : > "$LOCK_FILE" ) 2>/dev/null || { log_msg "WARNING" "⚠️ Lock claim failed; refusing to start (single-instance)"; exit 0; }
    echo $$ > "$LOCK_FILE"
fi

# ⚙️ Crash Loop 保护（P2-14，D-P5-01 重排）：**单实例仲裁之后**才登记本次启动 /
#   评估前次异常——被拒/竞态落败实例在触碰 guard 前退出，不再留下"无退出记录的
#   脏启动"导致 crash_seq 假累加。降级（rc 2）或节流（rc 3）→ 记 WARNING、释放
#   已占锁后快速退出。TERM/INT/HUP trap（记 last_clean=1）已在启动最前面注册。
#   参数默认值：CRASH_WINDOW=60 CRASH_THRESHOLD=3 CRASH_MIN_UPTIME=30
#   CRASH_COOLDOWN=300 CRASH_MIN_START_INTERVAL=10。
if [ "$RUNTIME_LOADED" -eq 1 ]; then
    crash_guard_enter "$DATA_DIR" >/dev/null 2>&1
    if [ "$?" -ne 0 ]; then
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] [WARNING] ⚠️ Crash-guard throttle/degraded; fast-exit" >> "$LOG_FILE" 2>/dev/null
        rm -f "$LOCK_FILE" 2>/dev/null
        exit 0
    fi
fi

# ⚙️ 调度来源启动（P3-03）：Managed 模式 → sched_reload（task-config 权威快照，不再重扫
#   config.txt）；Legacy 模式 → shadow_init + 生命周期 Registry 引导（P2-09，KEPT 回退）。
# 🗺️ Canonical↔Legacy Run ID 映射（P2-04）：建映射供新 ID 查询；**不碰旧运行目录**
if [ "$RUNTIME_LOADED" -eq 1 ]; then
    if tcfg_is_managed; then
        sched_reload "$DATA_DIR" "$CONFIG_FILE" >/dev/null 2>&1
    else
        shadow_init "$DATA_DIR" "$CONFIG_FILE" "$DATA_DIR/shadow/shadow.log" >/dev/null 2>&1
        # ⚙️ 生命周期 Registry 引导（P2-09）：shadow_init 之后补**最后有效快照**回退
        #   （config 缺失 → registry_attach 只读挂载历史快照；KEPT 语义，不重扫配置）
        lifecycle_startup_registry "$DATA_DIR" "$CONFIG_FILE" >/dev/null 2>&1
    fi
    runtime_map_refresh "$DATA_DIR" "$TASKS_DIR" >/dev/null 2>&1
    for tid in $(registry_task_ids); do
        trigger_decide "$DATA_DIR" "$tid" "$(date +%H%M)" "${TRIGGER_BOOT_CONTEXT:-0}" "$DATA_DIR/schedule_state.txt" >> "$DATA_DIR/shadow/shadow.log" 2>/dev/null
    done
    # ⚙️ 本地 IPC 控制面（P3-04）：建 0700 请求/响应目录 + daemon.pid 存活标记
    ipc_server_init "$DATA_DIR" >/dev/null 2>&1
    # ⚙️ 安全与资源加固（P3-08）：权限强制（ipc 0700 / task-config 600 /
    #   运行目录 700 / 文件 600）+ 请求频率限制状态重置（每 daemon 启动新窗）
    secv_fix_perms "$DATA_DIR" "$TASKS_DIR" >/dev/null 2>&1
    rm -f "$(ipc_dir "$DATA_DIR")/rate.state" 2>/dev/null
fi

# 🧹 Clean slate: Mark ALL 'orphaned' tasks from previous runs as 'ZOMBIE_CRASHED'
# Since this daemon instance just started, it cannot have any truly active tasks yet.
if [ -d "$TASKS_DIR" ]; then
    for task_dir in "$TASKS_DIR"/*; do
        if [ -d "$task_dir" ] && [ -f "$task_dir/status.txt" ] && grep -q "RUNNING" "$task_dir/status.txt"; then
             log_msg "INFO" "🧹 Pruning zombie task record: $(basename "$task_dir")"
             echo "ZOMBIE_CRASHED" > "$task_dir/status.txt"
        fi
    done
fi

# ⚙️ 重启残留再水合（P2-07，RUNTIME_LOADED 门控旁路；不改 legacy 剪枝/执行路径）：
#   剪枝后的运行态（status.txt=RUNNING/STARTING/ZOMBIE_CRASHED/STALE）→
#   新 state.txt=FAILED + events.log daemon_restart 事件（旧 status.txt 不动——
#   旧 CLI 仍按旧语义读取；状态机成为新事实源）。
# ⚙️ 生命周期恢复（P2-09）：stale PID 扫描（§4 runtime_scan_stale）接入同一
#   启动序列——pid.txt 指向已死进程的运行态 → state.txt=FAILED + daemon_restart
#   事件（与 §14 lifecycle_startup_recover 一致；旧工件不动）。
if [ "$RUNTIME_LOADED" -eq 1 ]; then
    runtime_scan_stale "$TASKS_DIR" >/dev/null 2>&1
    state_rehydrate_residual "$TASKS_DIR" >/dev/null 2>&1
fi

# Stake our claim
echo $$ > "$LOCK_FILE"

log_msg "INFO" "🎬 Su Scheduler Daemon v$VERSION initialized (PID: $$)"
log_msg "INFO" "🏁 Startup phase: Executing initialization tasks..."

# 🎯 Check for BOOT tasks
# P3-03：Registry 正式调度启动 boot（scheduler_boot → TriggerProvider→ActionProvider）；
#        RUNTIME_LOADED=0 时保持 legacy 原样扫描（C2 fallback，含 P2-06 统一入口门控）
if [ "$RUNTIME_LOADED" -eq 1 ]; then
    scheduler_boot "$DATA_DIR" "$CONFIG_FILE" "$TASKS_DIR" >> "$DATA_DIR/scheduler/audit.log" 2>/dev/null
else
    if [ -f "$CONFIG_FILE" ]; then
        exec 3< "$CONFIG_FILE"
        while IFS= read -r line <&3 || [ -n "$line" ]; do
            clean_line=$(echo "$line" | sed 's/^[ \t]*//;s/[ \t]*$//')
            case "$clean_line" in
                \#*) continue ;;
                "") continue ;;
            esac

            trigger=$(echo "$clean_line" | awk '{print $1}')
            if [ "$trigger" = "boot" ]; then
                parse_modifiers "$clean_line"
                cmd_to_run=$(extract_command "$clean_line")
                task_counter=$((task_counter + 1))
                task_id="startup_${task_counter}_$(date +%s)"
                # P2-06：经统一 Action 入口运行（RUNTIME_LOADED 门控；legacy 原样 fallback）
                if [ "$RUNTIME_LOADED" -eq 1 ]; then
                    action_run "$task_id" "$cmd_to_run" "$use_termux" "$interactive" "$notify_start" "$notify_end" "$custom_msg" >/dev/null 2>&1
                else
                    execute_task "$task_id" "$cmd_to_run" "$notify_start" "$notify_end" "$custom_msg" "$interactive" "$use_termux" < /dev/null
                fi
            fi
        done
        exec 3<&-
    fi
fi

log_msg "INFO" "💓 Daemon pulse detected. Entering main loop. I'm watching you... in a good way!"

LAST_MTIME=0

# 🔄 Main Event Loop
while true; do
    # 🔒 锁主围栏（D-P6-10-02）：任何时刻仅锁持有者执行 tick。若 lock 内 PID ≠ 自身
    #   且该 PID 存活且为 su-schedulerd → 本实例为被删锁/接管竞态后的非持有者孪生，
    #   自退（不删锁——锁属现任持有者；记 clean exit 防 crash_seq 假累加）。service.sh
    #   看护的 noclobber 拉起行为保持原样（由本围栏使接管安全，单常驻不变量兜底）。
    if [ "$RUNTIME_LOADED" -eq 1 ] && [ "$(lifecycle_lock_owner_fence "$LOCK_FILE" "$$")" = "yield" ]; then
        log_msg "WARNING" "🔒 Lock-owner fence: live daemon (PID $(cat "$LOCK_FILE" 2>/dev/null)) holds the lock; non-holder (PID $$) exiting (single-resident invariant, D-P6-10-02)"
        crash_record_exit "$DATA_DIR" 0 >/dev/null 2>&1
        exit 0
    fi

    current_time=$(date "+%H%M")

    if [ "$RUNTIME_LOADED" -eq 1 ]; then
        # P5-05：boot_completed 上下文（系统启动完成后置 1，一次检测保持；经前缀
        # 变量注入 scheduler_tick → trigger_decide → bootcompleted Provider）
        if [ "${BOOT_COMPLETED_CTX:-0}" != "1" ] && [ "$(getprop sys.boot_completed 2>/dev/null)" = "1" ]; then
            BOOT_COMPLETED_CTX=1
        fi
        # ⚙️ Registry 正式调度（P3-03）：TriggerProvider→ActionProvider→Supervisor
        TRIGGER_BOOT_COMPLETED_CONTEXT=${BOOT_COMPLETED_CTX:-0} \
            scheduler_tick "$DATA_DIR" "$CONFIG_FILE" "$TASKS_DIR" "$current_time" >/dev/null 2>&1
        # 🗺️ ID 映射随快照刷新（P2-04，幂等；不重命名旧运行目录）
        runtime_map_refresh "$DATA_DIR" "$TASKS_DIR" >/dev/null 2>&1
        # ⚙️ legacy 模式（无 MANAGED）保留 shadow 旁路比对（P2-03/P2-04）
        if ! tcfg_is_managed; then
            shadow_tick "$DATA_DIR" "$CONFIG_FILE" "$DATA_DIR/shadow/shadow.log" >/dev/null 2>&1
            for tid in $(registry_task_ids); do
                trigger_decide "$DATA_DIR" "$tid" "$(date +%H%M)" "0" "$DATA_DIR/schedule_state.txt" >> "$DATA_DIR/shadow/shadow.log" 2>/dev/null
            done
        fi
        # ⚙️ 统一状态对账（P2-07，RUNTIME_LOADED 门控旁路）：exit_code.txt 出现
        # → 终态双写（成功 → STOPPED，一次性任务不虚假 HEALTHY；失败 → FAILED）；
        # 已终态幂等跳过。非法/异常目录不中止本轮（单目录错误只置 rc）。
        state_sync_all "$TASKS_DIR" >/dev/null 2>&1
        # ⚙️ Supervisor 统一事件循环（P2-12，RUNTIME_LOADED 门控旁路）：每轮对
        # 每个受监督任务至多一步（RUNNING→HEALTHY→UNHEALTHY→RECOVERING→
        # STARTING|FAILED）；无每任务常驻线程/循环（daemon 主循环唯一）。
        supervisor_tick "$TASKS_DIR" "$DATA_DIR" >/dev/null 2>&1
        # ⚙️ 资源保护（P2-14，每 tick）：日志截断（LOG_MAX_BYTES）+ 快照/
        #   任务目录上限修剪（SNAP_MAX_KEEP / TASK_DIRS_MAX；活跃运行目录保留）
        runtime_protect "$DATA_DIR" >/dev/null 2>&1
        runtime_protect_tasks "$TASKS_DIR" >/dev/null 2>&1
    else
        # ⚠️ RUNTIME_LOADED=0：legacy config.txt 原样扫描执行（C2 fallback）
        if [ -f "$CONFIG_FILE" ]; then
            # Hot reload: Check if config file was modified
            CURRENT_MTIME=$(ls -l "$CONFIG_FILE" | awk '{print $6$7$8}')
            if [ "$CURRENT_MTIME" != "$LAST_MTIME" ]; then
                log_msg "INFO" "🔥 New configuration detected! Hot reloading presets..."
                LAST_MTIME=$CURRENT_MTIME
            fi

            task_counter=0

            # 🕵️ Scan the schedule using FD 3
            exec 3< "$CONFIG_FILE"
            while IFS= read -r line <&3 || [ -n "$line" ]; do
                 clean_line=$(echo "$line" | sed 's/^[ \t]*//;s/[ \t]*$//')

                 case "$clean_line" in
                    \#*) continue ;;
                    "") continue ;;
                esac

                # 📜 Heredoc parsing
                if echo "$clean_line" | grep -q '<<EOF'; then
                    trigger=$(echo "$clean_line" | awk '{print $1}')
                    cmd_start=$(echo "$clean_line" | sed 's/^[^ ]* //' | sed 's/ *<<EOF.*//')

                    multiline_cmd=""
                    while IFS= read -r block_line <&3; do
                        if echo "$block_line" | grep -q '^EOF'; then
                            break
                        fi
                        multiline_cmd="${multiline_cmd}${block_line}
"
                    done

                    clean_line="$trigger $cmd_start '$multiline_cmd'; : $(echo "$clean_line" | sed -n 's/.*\(: --[^;]*\).*/\1/p')"
                fi

                # Normalize trigger
                trigger=$(echo "$clean_line" | awk '{print $1}')
                trigger_norm=$(echo "$trigger" | sed 's/://g')

                # 🚀 Check for immediate execution request
                parse_modifiers "$clean_line"
                if [ "$run_once_now" = "1" ]; then
                    log_msg "INFO" "⚡ Immediate execution triggered: $trigger"
                    cmd_to_run=$(extract_command "$clean_line")
                    task_counter=$((task_counter + 1))
                    task_id="immediate_${task_counter}_$(date +%s)"
                    # P2-06：经统一 Action 入口运行（RUNTIME_LOADED 门控；legacy 原样 fallback）
                    if [ "$RUNTIME_LOADED" -eq 1 ]; then
                        action_run "$task_id" "$cmd_to_run" "$use_termux" "$interactive" "$notify_start" "$notify_end" "$custom_msg" >/dev/null 2>&1
                    else
                        execute_task "$task_id" "$cmd_to_run" "$notify_start" "$notify_end" "$custom_msg" "$interactive" "$use_termux" < /dev/null
                    fi

                    # Prune the --run-once-now modifier from the file
                    log_msg "INFO" "✂️ Pruning --run-once-now from config"
                    # We use a unique marker to avoid double-processing during sed
                    new_line=$(echo "$line" | sed "s/--run-once-now//; s/  */ /g; s/ :[ 	]*$//; s/[ 	]*$//")
                    awk -v old="$line" -v new="$new_line" '{if ($0 == old) print new; else print $0}' "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
                    continue
                fi

                # 🎯 Check advanced schedules
                if should_run_advanced_schedule "$trigger" "$current_time" "$clean_line"; then
                    log_msg "INFO" "📅 Advanced schedule matched: $trigger"
                    parse_modifiers "$clean_line"
                    cmd_to_run=$(extract_command "$clean_line")
                    task_counter=$((task_counter + 1))
                    task_id="advanced_${task_counter}_$(date +%s)"
                    # P2-06：经统一 Action 入口运行（RUNTIME_LOADED 门控；legacy 原样 fallback）
                    if [ "$RUNTIME_LOADED" -eq 1 ]; then
                        action_run "$task_id" "$cmd_to_run" "$use_termux" "$interactive" "$notify_start" "$notify_end" "$custom_msg" >/dev/null 2>&1
                    else
                        execute_task "$task_id" "$cmd_to_run" "$notify_start" "$notify_end" "$custom_msg" "$interactive" "$use_termux" < /dev/null
                    fi

                    if [ $delete_after -eq 1 ]; then
                         log_msg "INFO" "💥 Boom. Task deleted."
                         # Q13 修复（P2-01，设备冒烟实证）：`grep -v -F` 在配置只剩
                         # 该删除行时输出为空且退出码 1 → `&&` 短路、行未被移除（tmp
                         # 残留 0 字节）。改为分号连接：mv 始终执行（尽力而为删除）。
                         grep -v -F "$line" "$CONFIG_FILE" > "${CONFIG_FILE}.tmp"
                         mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
                    fi
                # 🎯 Check standard time
                elif [ "$trigger_norm" = "$current_time" ]; then
                    parse_modifiers "$clean_line"
                    cmd_to_run=$(extract_command "$clean_line")
                    task_counter=$((task_counter + 1))
                    task_id="time_${current_time}_${task_counter}_$(date +%s)"
                    # P2-06：经统一 Action 入口运行（RUNTIME_LOADED 门控；legacy 原样 fallback）
                    if [ "$RUNTIME_LOADED" -eq 1 ]; then
                        action_run "$task_id" "$cmd_to_run" "$use_termux" "$interactive" "$notify_start" "$notify_end" "$custom_msg" >/dev/null 2>&1
                    else
                        execute_task "$task_id" "$cmd_to_run" "$notify_start" "$notify_end" "$custom_msg" "$interactive" "$use_termux" < /dev/null
                    fi

                    if [ $delete_after -eq 1 ]; then
                         log_msg "INFO" "💥 Boom. Task deleted."
                         # Q13 修复（P2-01，设备冒烟实证）：`grep -v -F` 在配置只剩
                         # 该删除行时输出为空且退出码 1 → `&&` 短路、行未被移除（tmp
                         # 残留 0 字节）。改为分号连接：mv 始终执行（尽力而为删除）。
                         grep -v -F "$line" "$CONFIG_FILE" > "${CONFIG_FILE}.tmp"
                         mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
                    fi
                fi
            done
            exec 3<&-
        fi
    fi

    # 💤 Nap until the start of the next minute, polling the IPC control
    # channel each second (P3-04). 外层单常驻循环仍恰 1 处；调度周期仍以分钟
    # 为单位推进（本子循环只负责逐秒逼近下一分钟边界 + 非阻塞 IPC 轮询）。
    ipc_nap=$((60 - $(date +%S)))
    [ "$ipc_nap" -lt 1 ] && ipc_nap=1
    while [ "$ipc_nap" -gt 0 ]; do
        if [ "$RUNTIME_LOADED" -eq 1 ]; then
            ipc_server_poll "$DATA_DIR" "$CONFIG_FILE" "$TASKS_DIR" >/dev/null 2>&1
        fi
        sleep 1
        ipc_nap=$((ipc_nap - 1))
    done
done