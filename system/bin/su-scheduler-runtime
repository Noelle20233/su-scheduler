#!/system/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# su-scheduler-runtime — 生产 Runtime 库（P2-02）
# ═══════════════════════════════════════════════════════════════════════════
# 性质：daemon（su-schedulerd）与 CLI（su-scheduler）**共用同一套**生产运行时
#      原语的可加载 Shell 库。内容 = P1-01..P1-11 已验证原语的生产化整理：
#        §1 State Machine  （P1-03）    task_state_* / TSM_*
#        §2 Legacy Adapter （P1-05）    legacy_adapter_parse（内部助手 rt_* 前缀）
#        §3 Provider 契约  （P1-04/07/08） provider_* / TPR_* + 静态 Provider
#        §4 Runtime 状态/事件（P1-09）  runtime_*
#        §5 Canonical Registry（P1-06） registry_*
#        §6 Lifecycle      （P1-10）    lifecycle_*
#        §7 Task 只读 CLI  （P1-11）    task_cli_*
#      依赖顺序：§1→§2→§3→§4→§5→§6→§7（本文件内已按序排列；单文件自包含，
#      不 source 任何外部文件——与测试域 P1 库**路径隔离**：测试库不改动，本库
#      零引用测试域路径（路径隔离门禁由 P2-02 回归套件断言，记录见 docs/P2-02.md）。
# ═══════════════════════════════════════════════════════════════════════════
# 约束（C3）：纯 POSIX sh + Android 系统命令（echo/printf/sed/grep/awk/cut/
#  sort/ls/date/mkdir/rm/mv/cat/mkfifo/kill/sleep/nohup/chmod/md5sum/type），
#  无外部运行时。**不启用 set -u**（不改变宿主脚本的 nounset 状态）。
# ═══════════════════════════════════════════════════════════════════════════
# 命名空间：除 P1 契约名外，adapter 内部解析助手统一 `rt_` 前缀，避免覆盖
#  daemon/CLI 既有同名 legacy 函数（parse_modifiers / extract_command 等——
#  C2 保护：daemon 解析路径必须保持逐字节原样）。
# ═══════════════════════════════════════════════════════════════════════════
# 加载失败 fallback（daemon/CLI 加载契约，见两者头部加载块）：
#   库缺失 / 不可读 / 语法破损 / selfcheck 不通过 → RUNTIME_LOADED=0；
#   调用方**legacy 路径原样继续**（本库是叠加层，不修改既有行为路径）；
#   daemon 启动时记录一次 WARNING；CLI 不输出加载噪音。
# ═══════════════════════════════════════════════════════════════════════════

RUNTIME_LIB_VERSION="1.11.0"

# ───────────────────────────────────────────────────────────────────────────
# §1 State Machine（P1-03 验证原语 → P2-02 生产化）
# ───────────────────────────────────────────────────────────────────────────
# 11 个规范状态 / 触发原因令牌 / 允许转换（单一事实源；与
# docs/architecture/task-state-machine-transitions.tsv 镜像）。
TSM_STATES='DISABLED PENDING WAITING STARTING RUNNING HEALTHY UNHEALTHY RECOVERING FAILED STOPPING STOPPED'
TSM_CAUSES='config_load time_trigger manual_exec action_success action_failure timeout daemon_restart stop_request rearm enable disable supervisor spawn probe'
TSM_ALLOWED='DISABLED>PENDING PENDING>DISABLED PENDING>STARTING PENDING>WAITING WAITING>PENDING WAITING>STARTING WAITING>FAILED WAITING>DISABLED STARTING>RUNNING STARTING>WAITING STARTING>FAILED STARTING>STOPPING RUNNING>STOPPED RUNNING>FAILED RUNNING>STOPPING RUNNING>HEALTHY HEALTHY>UNHEALTHY HEALTHY>STOPPED HEALTHY>FAILED HEALTHY>STOPPING UNHEALTHY>RUNNING UNHEALTHY>RECOVERING UNHEALTHY>STOPPED UNHEALTHY>FAILED UNHEALTHY>STOPPING RECOVERING>STARTING RECOVERING>FAILED RECOVERING>STOPPING STOPPING>STOPPED STOPPING>FAILED FAILED>PENDING FAILED>WAITING FAILED>DISABLED STOPPED>PENDING STOPPED>DISABLED'

task_state_log() {
    [ "${TSM_LOG:-1}" = "1" ] && echo "[WARNING] $1" >&2
}

task_state_is_valid() {
    case " $TSM_STATES " in
        *" $1 "*) return 0 ;;
        *) return 1 ;;
    esac
}

task_state_cause_is_valid() {
    case " $TSM_CAUSES " in
        *" $1 "*) return 0 ;;
        *) return 1 ;;
    esac
}

task_state_transition() {
    from=$1
    to=$2
    cause=${3:-}
    if ! task_state_is_valid "$from" || ! task_state_is_valid "$to"; then
        task_state_log "state-machine: unknown state in transition '$from'->'$to'"
        return 1
    fi
    case " $TSM_ALLOWED " in
        *" $from>$to "*)
            if [ -n "$cause" ] && ! task_state_cause_is_valid "$cause"; then
                task_state_log "state-machine: unknown cause '$cause' for allowed edge '$from'->'$to'"
                return 2
            fi
            return 0
            ;;
        *)
            task_state_log "state-machine: ILLEGAL transition '$from'->'$to' rejected${cause:+ (cause=$cause)}"
            return 1
            ;;
    esac
}

task_state_rehydrate() {
    case "$1" in
        STARTING|RUNNING|HEALTHY|UNHEALTHY|RECOVERING|STOPPING) echo FAILED ;;
        *) echo "$1" ;;
    esac
}

task_state_from_legacy() {
    case "$1" in
        RUNNING|running)   echo RUNNING ;;
        SUCCESS|success)   echo STOPPED ;;
        FAILED|failed|ZOMBIE_CRASHED|zombie) echo FAILED ;;
        invalid|disabled)  echo DISABLED ;;
        idle)              echo PENDING ;;
        *)                 echo "$1" ;;
    esac
}

# ───────────────────────────────────────────────────────────────────────────
# §2 Legacy Config Adapter（P1-05 验证原语 → P2-02 生产化）
# ───────────────────────────────────────────────────────────────────────────
# config.txt → 内部 Task v2；legacy 全部语义保持（P1-01 基线）。返回码：
#   0=全行成功 / 1=行级错误（合法行仍产出，错误行不产出）/ 2=文件级错误。
# 内部助手以 rt_ 前缀命名（见库头命名空间说明），不覆盖 daemon/CLI 同名函数。
rt_clean() { echo "$1" | tr -d '\r' | sed 's/^[ \t]*//;s/[ \t]*$//'; }
rt_norm()  { echo "$1" | sed 's/://g'; }
rt_first_word() { echo "$1" | awk '{print $1}'; }
rt_esc() {
    printf '%s' "$1" | awk '{ gsub(/\\/, "\\\\"); if (NR>1) printf "\\n"; printf "%s", $0 }'
}
rt_parse_modifiers() {
    line=$1
    notify_start=0; notify_end=0; delete_after=0; interactive=0
    use_termux=0; run_once_now=0; custom_msg=""
    mods=$(echo "$line" | sed -n 's/.* : //p')
    if [ -n "$mods" ]; then
        echo "$mods" | grep -q -- '--run-once-now' && run_once_now=1
        echo "$mods" | grep -q -- '--notify-start' && notify_start=1
        echo "$mods" | grep -q -- '--notify-end' && notify_end=1
        if echo "$mods" | grep -q -- '--notify' && ! echo "$mods" | grep -E -q -- '--notify-(start|end)'; then
            notify_start=1
            notify_end=1
        fi
        echo "$mods" | grep -q -- '--delete' && delete_after=1
        echo "$mods" | grep -q -- '--interactive' && interactive=1
        echo "$mods" | grep -q -- '--termux' && use_termux=1
        if echo "$mods" | grep -q -- '--msg='; then
            custom_msg=$(echo "$mods" | sed -n 's/.*--msg="\([^"]*\)".*/\1/p')
        fi
    fi
}
# 单空格分隔（确定性：首 token 之后；无第二个 token → 空，镜像 P1-02）
rt_extract_command() {
    line=$1
    raw_cmd=$(printf '%s' "$line" | awk '{ rest=$0; if (sub(/^[^ ]+[ ]/, "", rest)) print rest; else print "" }')
    echo "$raw_cmd" | sed 's/[ \t]*;*[ \t]*:[ \t]*--.*//'
}
legacy_adapter_task_id() {   # <line> <trigger> → echo id
    echo "t${1}_$(rt_norm "$2")"
}
_rt_emit_task() {
    id=$1; trigger=$2; action=$3; stype=$4; sline=$5; sraw=$6; subject=$7
    boot_flag=0
    echo "$subject" | grep -q -- '--boot' && boot_flag=1
    name=$(rt_first_word "$action")
    [ -n "$name" ] || name="task"
    name=$(printf '%s' "$name" | cut -c1-40)
    f="$out/$id.task"
    t="$f.tmp"
    tmp="$t"
    {
        echo "schema_version=2"
        echo "id=$id"
        echo "name=$(rt_esc "$name")"
        echo "enabled=1"
        echo "trigger=$(rt_esc "$trigger")"
        echo "condition="
        echo "action.command=$(rt_esc "$action")"
        echo "action.notify_start=$notify_start"
        echo "action.notify_end=$notify_end"
        echo "action.delete=$delete_after"
        echo "action.termux=$use_termux"
        echo "action.interactive=$interactive"
        echo "action.run_once_now=$run_once_now"
        echo "action.boot=$boot_flag"
        echo "action.msg=$(rt_esc "$custom_msg")"
        echo "dependency="
        echo "health.type=none"
        echo "recovery.type=none"
        echo "retry.max=0"
        echo "retry.interval=60"
        echo "source.type=$stype"
        echo "source.line=$sline"
        echo "source.raw=$(rt_esc "$sraw")"
        echo "runtime.state=PENDING"
        echo "runtime.run_count=0"
        echo "runtime.last_status="
        echo "runtime.last_exit="
        echo "runtime.last_start="
        echo "runtime.last_end="
        echo "runtime.pid="
    } > "$t"
    mv "$t" "$f"
    tmp=""
    echo "task=$id file=$f"
}
legacy_adapter_parse() {
    config=$1
    out=${2:-}
    rc=0

    if [ ! -f "$config" ]; then
        echo "[legacy-adapter] ERROR: config file not found: $config" >&2
        return 2
    fi
    if [ -z "$out" ]; then
        echo "[legacy-adapter] ERROR: out_dir required" >&2
        return 2
    fi
    if ! mkdir -p "$out"; then
        echo "[legacy-adapter] ERROR: cannot create out_dir: $out" >&2
        return 2
    fi

    tmp=""
    trap 'rm -f "$tmp"' INT TERM HUP

    lineno=0
    while IFS= read -r line || [ -n "$line" ]; do
        lineno=$((lineno + 1))
        cl=$(rt_clean "$line")
        case "$cl" in
            \#*|"") continue ;;
        esac

        trigger=$(echo "$cl" | awk '{print $1}')

        if printf '%s' "$trigger" | grep -q '[[:cntrl:]]'; then
            echo "[legacy-adapter] ERROR $config:${lineno}: trigger contains control character: '$trigger'" >&2
            rc=1
            continue
        fi

        if echo "$cl" | grep -q '<<EOF'; then
            cmd_start=$(echo "$cl" | sed 's/^[^ ]* //' | sed 's/ *<<EOF.*//')
            multiline_cmd=""
            block_raw="$cl"
            j=0
            found_eof=0
            while IFS= read -r block_line; do
                if echo "$block_line" | grep -q '^EOF'; then
                    found_eof=1
                    break
                fi
                j=$((j + 1))
                multiline_cmd="${multiline_cmd}${block_line}\n"
                block_raw="$block_raw
${block_line}"
            done
            mods=$(echo "$cl" | sed -n 's/.*\(: --[^;]*\).*/\1/p')
            reconstructed="$trigger $cmd_start '$multiline_cmd'; : $mods"
            if [ "$found_eof" -eq 1 ]; then
                end=$((lineno + j + 1))
            else
                end=$((lineno + j))
            fi

            rt_parse_modifiers "$reconstructed"
            action=$(rt_extract_command "$reconstructed")
            id=$(legacy_adapter_task_id "$lineno" "$trigger")
            _rt_emit_task "$id" "$trigger" "$action" "block" "${lineno}-${end}" "$block_raw" "$reconstructed"

            if [ "$found_eof" -eq 1 ]; then
                lineno=$((lineno + j + 1))
            else
                lineno=$((lineno + j))
            fi
            continue
        fi

        rt_parse_modifiers "$cl"
        action=$(rt_extract_command "$cl")
        id=$(legacy_adapter_task_id "$lineno" "$trigger")
        _rt_emit_task "$id" "$trigger" "$action" "line" "$lineno" "$line" "$cl"
    done < "$config"

    trap - INT TERM HUP
    return "$rc"
}

# ───────────────────────────────────────────────────────────────────────────
# §3 Provider 契约 + 静态 Provider（P1-04/07/08 验证原语 → P2-02 生产化）
# ───────────────────────────────────────────────────────────────────────────
# kind: trigger | action | health | recovery；name 同 kind 内唯一；
# prefix: 能力函数统一前缀；provider_dispatch 是引擎唯一依赖入口。
TPR_KINDS='trigger action health recovery'
TPR_CAPS_ALL='validate parse matches next_due prepare start stop status restart check recover'
TPR_CAPS_TRIGGER='validate parse matches next_due'
TPR_CAPS_ACTION='validate prepare start stop status restart'
TPR_CAPS_HEALTH='validate check'
TPR_CAPS_RECOVERY='validate recover'
TPR_CAPS_REQUIRED='trigger>validate trigger>parse trigger>matches action>validate action>prepare action>start health>validate health>check recovery>validate recovery>recover'
TPR_REGISTRY=''

provider_log() {
    [ "${TPR_LOG:-1}" = "1" ] && echo "[provider] $1" >&2
}

provider_kind_is_valid() {
    case " $TPR_KINDS " in
        *" $1 "*) return 0 ;;
        *) return 1 ;;
    esac
}

provider_cap_is_valid() {
    case " $TPR_CAPS_ALL " in
        *" $1 "*) return 0 ;;
        *) return 1 ;;
    esac
}

provider_cap_is_of_kind() {
    cap=$1
    case "$2" in
        trigger)  case " $TPR_CAPS_TRIGGER " in *" $cap "*) return 0 ;; *) return 1 ;; esac ;;
        action)   case " $TPR_CAPS_ACTION " in *" $cap "*) return 0 ;; *) return 1 ;; esac ;;
        health)   case " $TPR_CAPS_HEALTH " in *" $cap "*) return 0 ;; *) return 1 ;; esac ;;
        recovery) case " $TPR_CAPS_RECOVERY " in *" $cap "*) return 0 ;; *) return 1 ;; esac ;;
        *) return 1 ;;
    esac
}

provider_register() {
    kind=$1; name=$2; prefix=$3
    provider_kind_is_valid "$kind" || { provider_log "register: unknown kind '$kind'"; return 1; }
    case " $TPR_REGISTRY " in
        *" $kind>$name>"*) provider_log "register: duplicate '$kind>$name'"; return 1 ;;
    esac
    TPR_REGISTRY="$TPR_REGISTRY $kind>$name>$prefix"
    return 0
}

provider_lookup() {
    kind=$1; name=${2:-}
    for entry in $TPR_REGISTRY; do
        f1=${entry%%>*}
        rest=${entry#*>}
        f2=${rest%%>*}
        pre=${rest#*>}
        if [ "$f1" = "$kind" ] && { [ -z "$name" ] || [ "$f2" = "$name" ]; }; then
            echo "$pre"
            return 0
        fi
    done
    return 1
}

provider_dispatch() {
    kind=$1; name=$2; cap=$3
    shift 3
    provider_kind_is_valid "$kind" || { provider_log "dispatch: unknown kind '$kind'"; return 1; }
    provider_cap_is_valid "$cap" || { provider_log "dispatch: unknown capability '$cap'"; return 2; }
    provider_cap_is_of_kind "$cap" "$kind" || { provider_log "dispatch: capability '$cap' not in kind '$kind'"; return 2; }
    prefix=$(provider_lookup "$kind" "$name") || {
        provider_log "dispatch: no $kind provider named '$name' registered"
        return 1
    }
    fn="${prefix}_${cap}"
    type "$fn" >/dev/null 2>&1 || { provider_log "dispatch: provider '$prefix' lacks capability '$cap'"; return 2; }
    "$fn" "$@"
}

provider_dispatch_default() {
    kind=$1; cap=$2
    shift 2
    provider_kind_is_valid "$kind" || { provider_log "dispatch_default: unknown kind '$kind'"; return 1; }
    provider_cap_is_valid "$cap" || { provider_log "dispatch_default: unknown capability '$cap'"; return 2; }
    provider_cap_is_of_kind "$cap" "$kind" || { provider_log "dispatch_default: capability '$cap' not in kind '$kind'"; return 2; }
    prefix=$(provider_lookup "$kind") || {
        provider_log "dispatch_default: no $kind provider registered"
        return 1
    }
    fn="${prefix}_${cap}"
    type "$fn" >/dev/null 2>&1 || { provider_log "dispatch_default: provider '$prefix' lacks capability '$cap'"; return 2; }
    "$fn" "$@"
}

# ── 上下文助手 ────────────────────────────────────────────────────────────
tpr_ctx_now()  { echo "${TRIGGER_DECISION_NOW:-$(date +%H%M)}"; }
tpr_ctx_date() { # $1 = strftime 格式；TRIGGER_TODAY=YYYYMMDD 时用 -d 镜像（测试确定性）
    if [ -n "${TRIGGER_TODAY:-}" ]; then date -d "$TRIGGER_TODAY" "+$1"; else date "+$1"; fi
}
tpr_ctx_state_file() { echo "${TRIGGER_STATE_FILE:-/data/adb/su-scheduler/schedule_state.txt}"; }
tpr_ctx_line_md5() {
    printf '%s\n' "${TRIGGER_DECISION_LINE:-}" | md5sum | cut -d' ' -f1
}

# ── TriggerProvider: boot ─────────────────────────────────────────────────
tpr_trigger_boot_validate() {
    [ "$1" = "boot" ] && return 0 || return 1
}
tpr_trigger_boot_parse() { echo "kind=boot"; }
tpr_trigger_boot_matches() {
    [ "${TRIGGER_BOOT_CONTEXT:-0}" = "1" ] && return 0 || return 1
}
tpr_trigger_boot_next_due() {
    if [ "${TRIGGER_BOOT_CONTEXT:-0}" = "1" ]; then echo 0; return 0; fi
    return 1
}

# ── TriggerProvider: time（分钟级）────────────────────────────────────────
tpr_trigger_time_norm() { echo "$1" | sed 's/://g'; }
tpr_trigger_time_validate() {
    case "$(tpr_trigger_time_norm "$1")" in
        [0-9][0-9][0-9][0-9]) return 0 ;;
        *) return 1 ;;
    esac
}
tpr_trigger_time_parse() {
    echo "kind=time;time=$(tpr_trigger_time_norm "$1")"
}
tpr_trigger_time_matches() {
    [ -n "$1" ] || return 1
    [ "$(tpr_trigger_time_norm "$1")" = "$(tpr_ctx_now)" ] && return 0 || return 1
}
tpr_trigger_time_next_due() {
    norm=$(tpr_trigger_time_norm "$1")
    case "$norm" in
        [0-9][0-9][0-9][0-9]) ;;
        *) return 1 ;;
    esac
    th=$(echo "$norm" | cut -c1-2); tm=$(echo "$norm" | cut -c3-4)
    th=$(echo "$th" | sed 's/^0*//'); tm=$(echo "$tm" | sed 's/^0*//')
    [ -z "$th" ] && th=0; [ -z "$tm" ] && tm=0
    nh=$(date +%H | sed 's/^0*//'); nm=$(date +%M | sed 's/^0*//')
    [ -z "$nh" ] && nh=0; [ -z "$nm" ] && nm=0
    target=$((th * 60 + tm)); now=$((nh * 60 + nm))
    if [ "$target" -gt "$now" ]; then
        echo $(((target - now) * 60))
    elif [ "$target" -eq "$now" ]; then
        echo 0
    else
        echo $(((1440 - now + target) * 60))
    fi
    return 0
}

# ── TriggerProvider: advanced（镜像 should_run_advanced_schedule，只判断）───
tpr_trigger_advanced_validate() {
    case "$1" in
        weekly:*|nweekly:*|monthly:*|nmonthly:*|yearly:*) return 0 ;;
        *) return 1 ;;
    esac
}
tpr_trigger_advanced_parse() {
    case "$1" in
        weekly:*)  echo "kind=advanced;family=weekly" ;;
        nweekly:*) echo "kind=advanced;family=nweekly" ;;
        monthly:*) echo "kind=advanced;family=monthly" ;;
        nmonthly:*) echo "kind=advanced;family=nmonthly" ;;
        yearly:*)  echo "kind=advanced;family=yearly" ;;
    esac
}
_tpr_adv_read() {  # $1=行；返回 0 若状态文件含该行（去重判定，只读）
    sf=$(tpr_ctx_state_file)
    [ -f "$sf" ] && grep -qF "$1" "$sf"
}
tpr_trigger_advanced_matches() {
    trigger=$1
    now=$(tpr_ctx_now)
    hash=$(tpr_ctx_line_md5)
    yy=$(tpr_ctx_date %Y); mm=$(tpr_ctx_date %m); dd=$(tpr_ctx_date %d)
    dow=$(tpr_ctx_date %u); wk=$(tpr_ctx_date %V)
    mmdd="${mm}${dd}"; yymm="${yy}${mm}"; yymmdd="${yy}${mm}${dd}"

    case "$trigger" in
        weekly:*)
            tdow=$(echo "$trigger" | cut -d: -f2); ttime=$(echo "$trigger" | cut -d: -f3)
            if [ "$dow" = "$tdow" ] && [ "$now" -ge "$ttime" ] \
               && ! _tpr_adv_read "weekly_${tdow}_${ttime}_${hash}_${yymmdd}"; then
                return 0
            fi ;;
        nweekly:*)
            n=$(echo "$trigger" | cut -d: -f2); tdow=$(echo "$trigger" | cut -d: -f3)
            ttime=$(echo "$trigger" | cut -d: -f4)
            key="nweekly_${n}_${tdow}_${ttime}_${hash}"
            last=$(grep "^${key}=" "$(tpr_ctx_state_file)" 2>/dev/null | cut -d= -f2)
            # P2-05 修复：host bash 将 08/09 视为非法八进制 → 剥前导零后算术（POSIX；daemon mksh 等价）
            wkz=$(echo "$wk" | sed -n 's/^0*\([0-9][0-9]*\)$/\1/p'); [ -z "$wkz" ] && wkz=0
            lastz=$(echo "$last" | sed -n 's/^0*\([0-9][0-9]*\)$/\1/p'); [ -z "$lastz" ] && lastz=0
            if [ "$dow" = "$tdow" ] && [ "$now" -ge "$ttime" ] && {
                [ -z "$last" ] || [ $(((wkz - lastz + 53) % 53)) -ge "$n" ]; }; then
                return 0
            fi ;;
        monthly:*)
            tdd=$(echo "$trigger" | cut -d: -f2); ttime=$(echo "$trigger" | cut -d: -f3)
            if [ "$dd" = "$tdd" ] && [ "$now" -ge "$ttime" ] \
               && ! _tpr_adv_read "monthly_${tdd}_${ttime}_${hash}_${yymm}"; then
                return 0
            fi ;;
        nmonthly:*)
            n=$(echo "$trigger" | cut -d: -f2); tdd=$(echo "$trigger" | cut -d: -f3)
            ttime=$(echo "$trigger" | cut -d: -f4)
            key="nmonthly_${n}_${tdd}_${ttime}_${hash}"
            last=$(grep "^${key}=" "$(tpr_ctx_state_file)" 2>/dev/null | cut -d= -f2)
            # P2-05 修复：host bash 将 08/09 视为非法八进制 → 剥前导零后算术（POSIX；daemon mksh 等价）
            yyz=$(echo "$yy" | sed -n 's/^0*\([0-9][0-9]*\)$/\1/p'); [ -z "$yyz" ] && yyz=0
            mmz=$(echo "$mm" | sed -n 's/^0*\([0-9][0-9]*\)$/\1/p'); [ -z "$mmz" ] && mmz=0
            lastz=$(echo "$last" | sed -n 's/^0*\([0-9][0-9]*\)$/\1/p'); [ -z "$lastz" ] && lastz=0
            lt=$((yyz * 12 + lastz)); tt=$((yyz * 12 + mmz))
            [ "$lt" -gt "$tt" ] && lt=$(((yyz - 1) * 12 + lastz))
            if [ "$dd" = "$tdd" ] && [ "$now" -ge "$ttime" ] && {
                [ -z "$last" ] || [ $((tt - lt)) -ge "$n" ]; }; then
                return 0
            fi ;;
        yearly:*)
            tdate=$(echo "$trigger" | cut -d: -f2); ttime=$(echo "$trigger" | cut -d: -f3)
            if [ "$mmdd" = "$tdate" ] && [ "$now" -ge "$ttime" ] \
               && ! _tpr_adv_read "yearly_${tdate}_${ttime}_${hash}_${yy}"; then
                return 0
            fi ;;
        *) return 1 ;;
    esac
    return 1
}
tpr_trigger_advanced_next_due() {
    if tpr_trigger_advanced_matches "$1"; then echo 0; return 0; fi
    return 1
}

# ── ActionProvider: command（P1-08 全模式，镜像 execute_task）──────────────
tpr_action_command_dir() { echo "${TPR_ACTION_DIR:-/tmp/su-scheduler-actions}/$1"; }
tpr_action_command_validate() { [ -n "$1" ] && return 0 || return 1; }
tpr_action_command_prepare() {
    dir=$(tpr_action_command_dir "$1")
    mkdir -p "$dir"
    echo "$2" > "$dir/command.txt"
    date "+%Y-%m-%d %H:%M:%S" > "$dir/start_time.txt"
    echo "RUNNING" > "$dir/status.txt"
    echo "$dir"
}
tpr_action_command_start() {  # <id> <cmd> [termux] [interactive] [notify_start] [notify_end] [custom_msg]
    id=$1; cmd=$2; termux=${3:-0}; interactive=${4:-0}
    notify_start=${5:-0}; notify_end=${6:-0}; custom_msg=${7:-}
    if type execute_task >/dev/null 2>&1; then
        # P2-06（委托既有执行器，不建立第二套命令执行器）：daemon 上下文——
        # 7 参原样传递 execute_task；旧工件 status.txt/pid.txt/output.log/
        # exit_code.txt/command.txt/start_time.txt/end_time.txt/exec_mode.txt
        # 由 execute_task 原样产出（C2：零改动、零降级）。
        execute_task "$id" "$cmd" "$notify_start" "$notify_end" "$custom_msg" \
            "$interactive" "$termux" < /dev/null
        return $?
    fi
    dir=$(tpr_action_command_dir "$id")
    (
        if [ "$interactive" = "1" ]; then
            tpr_action_exec_interactive "$id" "$dir" "$cmd"
        elif [ "$termux" = "1" ]; then
            tpr_action_exec_termux "$dir" "$cmd"
        else
            tpr_action_exec_smart "$dir" "$cmd"
        fi
    ) &
    echo $!
}
tpr_action_command_status() {
    pid=$2
    [ -n "$pid" ] && [ -d "/proc/$pid" ] && return 0 || return 1
}
tpr_action_command_stop() { kill "$2" 2>/dev/null; }
tpr_action_command_restart() {
    tpr_action_command_stop "$1" "$3"
    sleep 1
    tpr_action_command_start "$1" "$2" "${4:-0}" "${5:-0}"
}

tpr_action_exec_finalize() {
    dir=$1; rc=$2
    echo "$rc" > "$dir/exit_code.txt"
    date "+%Y-%m-%d %H:%M:%S" > "$dir/end_time.txt"
    if [ "$rc" -eq 0 ]; then
        echo "SUCCESS" > "$dir/status.txt"
    else
        echo "FAILED" > "$dir/status.txt"
    fi
}
tpr_action_exec_smart() {
    dir=$1; cmd=$2
    first_arg=$(echo "$cmd" | awk '{print $1}')
    if [ -f "$first_arg" ]; then
        [ ! -x "$first_arg" ] && chmod +x "$first_arg" 2>/dev/null
        sh -c "$cmd" > "$dir/output.log" 2>&1
        rc=$?
        if [ "$rc" -ne 0 ] && { [ "$rc" -eq 126 ] || [ "$rc" -eq 127 ]; }; then
            if command -v bash >/dev/null 2>&1; then
                bash "$first_arg" $(echo "$cmd" | cut -d' ' -f2-) > "$dir/output.log" 2>&1
                rc=$?
            fi
            if [ "$rc" -ne 0 ]; then
                sh "$first_arg" $(echo "$cmd" | cut -d' ' -f2-) > "$dir/output.log" 2>&1
                rc=$?
            fi
        fi
    else
        sh -c "$cmd" > "$dir/output.log" 2>&1
        rc=$?
    fi
    tpr_action_exec_finalize "$dir" "$rc"
}

tpr_action_termux_helper() { echo "${TPR_TERMUX_HELPER:-/system/bin/su-scheduler-termux}"; }
tpr_action_exec_termux() {
    dir=$1; cmd=$2
    helper=$(tpr_action_termux_helper)
    if [ ! -x "$helper" ]; then
        echo "ERROR: Termux helper missing" > "$dir/output.log"
        rc=1
    else
        ts=$($helper status 2>/dev/null)
        if [ "$ts" = "READY" ]; then
            $helper exec "$cmd" > "$dir/output.log" 2>&1
            rc=$?
        elif [ "$ts" = "LOCKED" ]; then
            echo "ERROR: User 0 locked" > "$dir/output.log"
            rc=1
        else
            echo "ERROR: Termux not installed" > "$dir/output.log"
            rc=1
        fi
    fi
    tpr_action_exec_finalize "$dir" "$rc"
}
tpr_action_exec_interactive() {
    id=$1; dir=$2; cmd=$3
    in="$dir/task.in"; out="$dir/task.out"
    mkfifo "$in" 2>/dev/null || true
    sh -i < "$in" > "$out" 2>&1 &
    pid=$!
    echo "$cmd" > "$in"
    wait $pid
    rc=$?
    echo "$rc" > "$dir/exit_code.txt"
}

# ── HealthProvider / RecoveryProvider: builtin（接口 + 空实现 stub）────────
tpr_health_builtin_validate() {
    case "$1" in
        ""|none) return 0 ;;
        *) return 1 ;;
    esac
}
tpr_health_builtin_check() { echo "ok"; return 0; }

tpr_recovery_builtin_validate() {
    case "$1" in
        ""|none) return 0 ;;
        *) return 1 ;;
    esac
}
tpr_recovery_builtin_recover() { echo "none"; return 0; }

# ── 静态注册（加载即注册；重复注册被拒）───────────────────────────────────
provider_register trigger boot     tpr_trigger_boot
provider_register trigger time     tpr_trigger_time
provider_register trigger advanced tpr_trigger_advanced
provider_register action command   tpr_action_command
provider_register action app       tpr_action_app
provider_register health builtin   tpr_health_builtin
provider_register health process   tpr_health_process
provider_register health port      tpr_health_port
provider_register recovery builtin tpr_recovery_builtin

# ───────────────────────────────────────────────────────────────────────────
# §4 Runtime State & Event Log（P1-09 验证原语 → P2-02 生产化）
# ───────────────────────────────────────────────────────────────────────────
# 新状态源 <dir>/state.txt + 事件日志 <dir>/events.log（7 字段）；旧兼容文件
# （status.txt/pid.txt/...）**只读不写**；日志失败不中止任务（仅返回非 0）。
RT_EVENTS='create delete config_load time_trigger manual_exec spawn action_success action_failure timeout stop_request daemon_restart rearm enable disable supervisor probe recover'

runtime_log() {
    [ "${RT_LOG:-1}" = "1" ] && echo "[runtime] $1" >&2
}

runtime_state_file()  { echo "$1/state.txt"; }
runtime_events_file() { echo "$1/events.log"; }

runtime_current_state() {
    dir=$1
    sf=$(runtime_state_file "$dir")
    if [ -f "$sf" ] && [ -s "$sf" ]; then
        cat "$sf"
        return 0
    fi
    if [ -f "$dir/status.txt" ]; then
        task_state_from_legacy "$(cat "$dir/status.txt")"
        return 0
    fi
    echo PENDING
}

runtime_log_event() {
    dir=$1; task_id=$2; event=$3; state=$4; pid=${5:-}; exit_code=${6:-}; message=${7:-}
    [ -n "$dir" ] || { runtime_log "ERROR log_event: dir required"; return 1; }
    task_state_is_valid "$state" || {
        runtime_log "WARNING log_event: illegal state '$state' rejected (task=$task_id)"
        return 1
    }
    case " $RT_EVENTS " in
        *" $event "*) ;;
        *) runtime_log "WARNING log_event: unknown event '$event' rejected (task=$task_id)"; return 1 ;;
    esac
    [ -d "$dir" ] || mkdir -p "$dir" || { runtime_log "ERROR log_event: cannot mkdir $dir"; return 2; }

    ts=$(date "+%Y-%m-%d %H:%M:%S")
    msg=$(printf '%s' "$message" | sed 's/|/;/g')
    line="$ts|$task_id|$event|$state|$pid|$exit_code|$msg"

    if ( printf '%s\n' "$line" >> "$(runtime_events_file "$dir")" ) 2>/dev/null; then
        :
    else
        runtime_log "ERROR log_event: append failed for $task_id (event=$event) — task continues"
        return 2
    fi
    sf=$(runtime_state_file "$dir")
    tmp="$sf.tmp"
    if ( printf '%s\n' "$state" > "$tmp" && mv -f "$tmp" "$sf" ) 2>/dev/null; then
        :
    else
        rm -f "$tmp" 2>/dev/null
        runtime_log "ERROR log_event: state write failed for $task_id (state=$state) — task continues"
        return 2
    fi
    return 0
}

runtime_scan_stale() {
    root=$1
    [ -d "$root" ] || { runtime_log "ERROR scan_stale: no tasks dir $root"; return 2; }
    found=0
    for p in "$root"/*; do
        [ -d "$p" ] || continue
        [ -f "$p/pid.txt" ] || continue
        id=$(basename "$p")
        pid=$(cat "$p/pid.txt" 2>/dev/null)
        cur=$(runtime_current_state "$p")
        case "$cur" in
            STARTING|RUNNING|HEALTHY|UNHEALTHY|RECOVERING|STOPPING) ;;
            *) continue ;;
        esac
        if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
            continue
        fi
        newstate=$(task_state_rehydrate "$cur")
        runtime_log_event "$p" "$id" daemon_restart "$newstate" "$pid" "" \
            "stale running record detected at startup (legacy status.txt untouched)"
        echo "$id"
        found=$((found + 1))
    done
    return 0
}

# ───────────────────────────────────────────────────────────────────────────
# §5 Canonical Task Registry（P1-06 验证原语 → P2-02 生产化）
# ───────────────────────────────────────────────────────────────────────────
# 完整快照 <base>/snapshots/snap_<N>/（确定性序号）+ `current` 指针原子切换；
# 无效配置 → KEPT 保留最后有效快照；防重复注册（id==文件名且唯一）。
# 返回码：0=已提交生效 / 1=解析失败回退（KEPT）/ 2=硬错误（无 config/无 adapter）。
TR_LOGGING=1
registry_log() {
    [ "${TR_LOGGING:-1}" = "1" ] && echo "[task-registry] $1" >&2
}

registry_init() {
    TR_BASE=${1:-}
    TR_CONFIG_PATH=${2:-}
    [ -n "$TR_BASE" ] || { registry_log "ERROR init: base_dir required"; return 2; }
    [ -n "$TR_CONFIG_PATH" ] || { registry_log "ERROR init: config required"; return 2; }
    mkdir -p "$TR_BASE/snapshots" || { registry_log "ERROR init: cannot mkdir $TR_BASE/snapshots"; return 2; }
    if [ -f "$TR_CONFIG_PATH" ]; then
        registry_reload "$TR_CONFIG_PATH"
    else
        registry_log "ERROR init: config not found: $TR_CONFIG_PATH (no fallback on first load)"
        TASK_REGISTRY_SNAPSHOT=""
        return 1
    fi
}

# P2-08：只读挂载既有快照（CLI task 子命令数据源——**不重新解析 config**：
# 仅设 TR_BASE 并读取 current 指针；不调用 adapter/parse/reload）。
registry_attach() {
    TR_BASE=${1:-}
    [ -n "$TR_BASE" ] || { registry_log "ERROR attach: base_dir required"; return 2; }
    TR_CONFIG_PATH=""
    TASK_REGISTRY_SNAPSHOT=$(registry_current_snapshot_id)
    [ -n "$TASK_REGISTRY_SNAPSHOT" ] && return 0 || return 1
}

registry_snapshot_next() {
    next=1
    for d in "$TR_BASE"/snapshots/snap_*; do
        [ -d "$d" ] || continue
        n=${d##*snap_}
        case "$n" in ''|*[!0-9]*) continue ;; esac
        [ "$n" -ge "$next" ] && next=$((n + 1))
    done
    echo "snap_$next"
}

registry_current_snapshot_id() {
    [ -f "$TR_BASE/current" ] && cat "$TR_BASE/current" || echo ""
}

registry_snapshot_dir() {
    id=$(registry_current_snapshot_id)
    [ -n "$id" ] && echo "$TR_BASE/snapshots/$id"
}

registry_has_task() {
    d=$(registry_snapshot_dir)
    [ -n "$d" ] && [ -f "$d/$1.task" ]
}

registry_task_file() {
    d=$(registry_snapshot_dir)
    if [ -n "$d" ] && [ -f "$d/$1.task" ]; then
        echo "$d/$1.task"
        return 0
    fi
    return 1
}

registry_task_ids() {
    d=$(registry_snapshot_dir)
    [ -n "$d" ] && ls "$d" 2>/dev/null | grep '\.task$' | sed 's/\.task$//' | sort
}

registry_manifest() {
    d=$(registry_snapshot_dir)
    [ -n "$d" ] && cat "$d/manifest" 2>/dev/null
}

_registry_snap_valid() {
    sdir=$1
    seen=""
    count=0
    for f in "$sdir"/*.task; do
        [ -f "$f" ] || continue
        count=$((count + 1))
        id=$(basename "$f" .task)
        iid=$(grep '^id=' "$f" | head -1 | cut -d= -f2)
        [ "$id" = "$iid" ] || {
            registry_log "ERROR snapshot $sdir: id field '$iid' != filename '$id'"
            return 1
        }
        case " $seen " in
            *" $id "*) registry_log "ERROR snapshot $sdir: duplicate task id '$id'"; return 1 ;;
        esac
        seen="$seen $id"
    done
    TASK_REGISTRY_COUNT=$count
    return 0
}

registry_reload() {
    config=${1:-$TR_CONFIG_PATH}
    [ -n "$config" ] || { registry_log "ERROR reload: no config (init first)"; echo "HARD"; return 2; }
    [ -f "$config" ] || {
        registry_log "ERROR reload: config not found: $config (fallback: keeping current snapshot)"
        echo "KEPT"
        return 1
    }
    command -v legacy_adapter_parse >/dev/null 2>&1 || {
        registry_log "ERROR reload: legacy_adapter_parse not sourced (adapter section missing)"
        echo "HARD"
        return 2
    }

    sid=$(registry_snapshot_next)
    sdir="$TR_BASE/snapshots/$sid"
    mkdir -p "$sdir" || { registry_log "ERROR reload: cannot mkdir $sdir"; echo "HARD"; return 2; }

    stdout=$(legacy_adapter_parse "$config" "$sdir")
    arc=$?
    tcount=$(ls "$sdir" 2>/dev/null | grep -c '\.task$')

    valid=0
    if [ "$arc" -eq 0 ]; then
        valid=1
    elif [ "$arc" -eq 1 ] && [ "$tcount" -ge 1 ]; then
        valid=1
    fi

    if [ "$valid" -eq 1 ]; then
        if _registry_snap_valid "$sdir"; then
            {
                echo "snapshot=$sid"
                echo "config=$config"
                echo "parse_rc=$arc"
                echo "task_count=$TASK_REGISTRY_COUNT"
            } > "$sdir/manifest.tmp" && mv "$sdir/manifest.tmp" "$sdir/manifest"
            echo "$sid" > "$TR_BASE/current.tmp" && mv "$TR_BASE/current.tmp" "$TR_BASE/current"
            TASK_REGISTRY_SNAPSHOT=$sid
            echo "$sid"
            return 0
        fi
        registry_log "ERROR reload: snapshot $sid invalid (dup/mismatch); fallback"
        rm -rf "$sdir"
        TASK_REGISTRY_SNAPSHOT=$(registry_current_snapshot_id)
        return 1
    fi

    registry_log "ERROR reload: parse rc=$arc tasks=$tcount -> invalid; keeping last valid snapshot"
    rm -rf "$sdir"
    TASK_REGISTRY_SNAPSHOT=$(registry_current_snapshot_id)
    echo "KEPT"
    return 1
}

# ───────────────────────────────────────────────────────────────────────────
# §6 Lifecycle（P1-10 验证原语 → P2-02 生产化）
# ───────────────────────────────────────────────────────────────────────────
# 单实例锁 / stale 恢复 / 僵尸清理 / 启动初始化 / 停止 / 重启 / 看护单轮
# （fail-safe：初始化失败回滚锁，不留半初始化状态）。
lifecycle_log() {
    [ "${LIFECYCLE_LOG:-1}" = "1" ] && echo "[lifecycle] $1" >&2
}

lifecycle_ensure_dirs() {
    base=$1
    [ -n "$base" ] || { lifecycle_log "ERROR ensure_dirs: base required"; return 1; }
    for d in "$base" "$base/tasks" "$base/audit"; do
        if ! mkdir -p "$d" 2>/dev/null; then
            lifecycle_log "ERROR ensure_dirs: cannot mkdir $d"
            return 1
        fi
        if ! chmod 755 "$d" 2>/dev/null; then
            lifecycle_log "ERROR ensure_dirs: cannot chmod $d"
            return 1
        fi
    done
    return 0
}

lifecycle_lock_pid() { [ -f "$1" ] && cat "$1" 2>/dev/null; }

lifecycle_lock_alive() {
    pid=$(lifecycle_lock_pid "$1")
    [ -n "$pid" ] && [ -d "/proc/$pid" ] && return 0
    return 1
}

lifecycle_lock_acquire() {
    lock=$1
    if lifecycle_lock_alive "$lock"; then
        lifecycle_log "WARNING lock_acquire: daemon already alive (pid=$(lifecycle_lock_pid "$lock")) — rejected"
        return 1
    fi
    if [ -f "$lock" ]; then
        lifecycle_log "INFO lock_acquire: stale lock removed (pid=$(cat "$lock" 2>/dev/null))"
        rm -f "$lock" 2>/dev/null || { lifecycle_log "ERROR lock_acquire: cannot rm stale lock"; return 2; }
    fi
    if ! echo "$$" > "$lock" 2>/dev/null; then
        lifecycle_log "ERROR lock_acquire: cannot write $lock"
        return 2
    fi
    return 0
}

lifecycle_lock_force_reclaim() {
    lock=$1
    wait_s=${LIFECYCLE_LOCK_WAIT:-5}
    i=0
    while [ "$i" -lt "$wait_s" ]; do
        lifecycle_lock_alive "$lock" || break
        sleep 1
        i=$((i + 1))
    done
    if [ -f "$lock" ]; then
        lifecycle_log "INFO lock_force: reclaiming lock (old pid=$(cat "$lock" 2>/dev/null))"
        rm -f "$lock" 2>/dev/null || { lifecycle_log "ERROR lock_force: cannot rm lock"; return 2; }
    fi
    if ! echo "$$" > "$lock" 2>/dev/null; then
        lifecycle_log "ERROR lock_force: cannot write $lock"
        return 2
    fi
    return 0
}

lifecycle_lock_release() {
    rm -f "$1" 2>/dev/null
    return 0
}

lifecycle_cleanup_zombies() {
    tasks_dir=$1
    [ -d "$tasks_dir" ] || { lifecycle_log "INFO cleanup: no tasks dir $tasks_dir"; echo 0; return 0; }
    n=0
    for p in "$tasks_dir"/*; do
        [ -d "$p" ] || continue
        cur=$(runtime_current_state "$p")
        case "$cur" in
            STARTING|RUNNING|HEALTHY|UNHEALTHY|RECOVERING|STOPPING) ;;
            *) continue ;;
        esac
        id=$(basename "$p")
        old_state=$(cat "$p/status.txt" 2>/dev/null)
        pid_rec=$(cat "$p/pid.txt" 2>/dev/null)
        case "$old_state" in
            *RUNNING*) echo "ZOMBIE_CRASHED" > "$p/status.txt" 2>/dev/null ;;
        esac
        newstate=$(task_state_rehydrate "$cur")
        runtime_log_event "$p" "$id" daemon_restart "$newstate" "$pid_rec" "" \
            "zombie cleanup at startup (legacy status.txt -> ZOMBIE_CRASHED)" >/dev/null 2>&1
        lifecycle_log "INFO cleanup: recovered zombie task $id ($cur -> $newstate)"
        n=$((n + 1))
    done
    echo "$n"
    return 0
}

lifecycle_start() {
    base=$1; config=$2; lock=$3
    [ -n "$base" ] && [ -n "$config" ] && [ -n "$lock" ] || {
        lifecycle_log "ERROR start: base/config/lock required"
        return 2
    }
    lifecycle_ensure_dirs "$base" || return 2
    lifecycle_lock_acquire "$lock" || return 1
    lifecycle_cleanup_zombies "$base/tasks" >/dev/null 2>&1
    registry_init "$base" "$config" >/dev/null 2>&1
    if [ -n "$(registry_current_snapshot_id 2>/dev/null)" ]; then
        lifecycle_log "INFO start: ready (base=$base snapshot=$(registry_current_snapshot_id 2>/dev/null))"
        return 0
    fi
    lifecycle_log "ERROR start: registry init failed for $config (no valid snapshot fallback)"
    lifecycle_lock_release "$lock"
    return 2
}

lifecycle_stop() {
    lock=$1
    pid=$(lifecycle_lock_pid "$lock")
    if [ -n "$pid" ] && [ -d "/proc/$pid" ] 2>/dev/null; then
        kill "$pid" 2>/dev/null
        i=0
        while [ "$i" -lt 5 ]; do
            [ -d "/proc/$pid" ] 2>/dev/null || break
            sleep 1
            i=$((i + 1))
        done
    fi
    lifecycle_lock_release "$lock"
    return 0
}

lifecycle_restart() {
    lock=$1; base=$2; config=$3; daemon_cmd=${4:-}
    lifecycle_stop "$lock"
    sleep 1
    if [ -n "$daemon_cmd" ]; then
        nohup $daemon_cmd >/dev/null 2>&1 &
        lifecycle_log "INFO restart: launched '$daemon_cmd' (new daemon re-locks itself)"
        return 0
    fi
    lifecycle_log "ERROR restart: no daemon_cmd given"
    return 2
}

lifecycle_watchdog_tick() {
    lock=$1; daemon_cmd=${2:-}
    if lifecycle_lock_alive "$lock"; then
        return 0
    fi
    lifecycle_log "WARNING watchdog_tick: daemon not running — cleaning stale lock and (re)starting"
    rm -f "$lock" 2>/dev/null
    if [ -n "$daemon_cmd" ]; then
        nohup $daemon_cmd >/dev/null 2>&1 &
        lifecycle_log "INFO watchdog_tick: launched '$daemon_cmd'"
    else
        lifecycle_log "INFO watchdog_tick: no daemon_cmd given — handover to caller"
    fi
    return 1
}

# ───────────────────────────────────────────────────────────────────────────
# §7 Task 只读 CLI（P1-11 验证原语 → P2-02 生产化）
# ───────────────────────────────────────────────────────────────────────────
# 只读：task_cli_list / task_cli_status。数据源 = registry 快照（不重新解析
# config.txt）；状态 = runtime_current_state（新 state.txt → 旧 status.txt
# 推导 → 快照 runtime.state 回退）；错误三态 rc 1/2/3。
task_cli_log() {
    [ "${TASK_CLI_LOG:-1}" = "1" ] && echo "[task-cli] $1" >&2
}

task_cli_config_valid() {
    [ -n "$(registry_current_snapshot_id 2>/dev/null)" ] && return 0
    return 1
}

task_cli_task_exists() {
    registry_task_file "$1" >/dev/null 2>&1
}

task_cli_state_for() {
    id=$1; tf=$2
    if [ -n "${TASK_CLI_TASKS_DIR:-}" ] && [ -d "$TASK_CLI_TASKS_DIR/$id" ]; then
        runtime_current_state "$TASK_CLI_TASKS_DIR/$id"
        return 0
    fi
    grep '^runtime.state=' "$tf" | head -1 | cut -d= -f2-
}

task_cli_daemon_running() {
    [ -n "${TASK_CLI_LOCK:-}" ] || return 1
    lifecycle_lock_alive "$TASK_CLI_LOCK"
}

task_cli_list() {
    task_cli_config_valid || {
        echo "ERROR: configuration invalid (no valid task snapshot)" >&2
        return 2
    }
    for id in $(registry_task_ids); do
        f=$(registry_task_file "$id") || continue
        name=$(grep '^name=' "$f" | head -1 | cut -d= -f2-)
        trigger=$(grep '^trigger=' "$f" | head -1 | cut -d= -f2)
        action=$(grep '^action.command=' "$f" | head -1 | cut -d= -f2-)
        enabled=$(grep '^enabled=' "$f" | head -1 | cut -d= -f2)
        state=$(task_cli_state_for "$id" "$f")
        echo "$id|$name|$trigger|$action|$enabled|$state"
    done
    return 0
}

task_cli_status() {
    id=$1
    [ -n "$id" ] || { echo "ERROR: usage: task status <id>" >&2; return 1; }
    task_cli_config_valid || {
        echo "ERROR: configuration invalid (no valid task snapshot)" >&2
        return 2
    }
    f=$(registry_task_file "$id") || {
        echo "ERROR: task not found: $id" >&2
        return 1
    }
    if [ -n "${TASK_CLI_LOCK:-}" ] && ! task_cli_daemon_running; then
        echo "ERROR: daemon is not running — cannot report live task state (disk state may be stale)" >&2
        return 3
    fi

    rdir="${TASK_CLI_TASKS_DIR:-}/$id"
    echo "id=$id"
    echo "name=$(grep '^name=' "$f" | head -1 | cut -d= -f2-)"
    echo "enabled=$(grep '^enabled=' "$f" | head -1 | cut -d= -f2)"
    echo "trigger=$(grep '^trigger=' "$f" | head -1 | cut -d= -f2)"
    echo "condition=$(grep '^condition=' "$f" | head -1 | cut -d= -f2-)"
    echo "action=$(grep '^action.command=' "$f" | head -1 | cut -d= -f2-)"
    echo "source.type=$(grep '^source.type=' "$f" | head -1 | cut -d= -f2)"
    echo "source.line=$(grep '^source.line=' "$f" | head -1 | cut -d= -f2)"
    echo "source.raw=$(grep '^source.raw=' "$f" | head -1 | cut -d= -f2-)"
    echo "state=$(task_cli_state_for "$id" "$f")"
    if [ -d "$rdir" ] && [ -f "$rdir/status.txt" ]; then
        echo "legacy_status=$(cat "$rdir/status.txt" 2>/dev/null)"
    else
        echo "legacy_status="
    fi
    echo "run_count=$(grep '^runtime.run_count=' "$f" | head -1 | cut -d= -f2)"
    echo "last_status=$(grep '^runtime.last_status=' "$f" | head -1 | cut -d= -f2-)"
    echo "last_exit=$(grep '^runtime.last_exit=' "$f" | head -1 | cut -d= -f2-)"
    echo "last_start=$(grep '^runtime.last_start=' "$f" | head -1 | cut -d= -f2-)"
    echo "last_end=$(grep '^runtime.last_end=' "$f" | head -1 | cut -d= -f2-)"
    if [ -n "${TASK_CLI_LOCK:-}" ]; then
        if task_cli_daemon_running; then echo "daemon=running"; else echo "daemon=stopped"; fi
    fi
    if [ -d "$rdir" ] && [ -f "$rdir/events.log" ]; then
        echo "last_event=$(tail -1 "$rdir/events.log" 2>/dev/null)"
    else
        echo "last_event="
    fi
    return 0
}

# ───────────────────────────────────────────────────────────────────────────
# §8 Registry Shadow Mode（P2-03，旁路比对）
# ───────────────────────────────────────────────────────────────────────────
# **不改 legacy 执行路径**（C2）：本层只镜像旧扫描、不消耗 daemon 扫描结果、
# 不触发任何执行/修剪——仅建 Registry 快照并比对记录。
#   - shadow_init  <base> <config> [log]  —— daemon 启动：建首快照 + 基线比对；
#   - shadow_tick  <base> <config> [log]  —— 每轮：config md5 变化 → 原子
#     registry_reload（损坏配置 → KEPT 保留最后有效快照）；legacy 镜像扫描 ↔
#     registry 触发器集比对；记录 shadow.log + shadow.last（原子 tmp+mv）。
#   - legacy 镜像扫描与 daemon 主循环同法（修边/跳注释空行/heredoc 块计 1）。
# 记录（shadow.log 追加，`|` 分隔）：op=<init|reload|compare>|agree=<Y|N>|
# legacy=<n>|registry=<m>|snap=<id>|cfg_md5=<12>；agree=N 时另记 diff 行。
# ═══════════════════════════════════════════════════════════════════════════
shadow_log() {
    [ "${SHADOW_LOG:-1}" = "1" ] && echo "$1" >> "${SHADOW_LOGFILE:-/dev/null}" 2>/dev/null
}
shadow_state_file() { echo "$1/shadow/shadow.last"; }

# legacy 镜像扫描：stdout 每个激活行一个**归一触发器**（heredoc 块计 1 并
# 消耗块体，与 daemon 主循环同法）。返回码 0=可扫 1=config 缺失。
shadow_scan_legacy() {
    config=$1
    [ -f "$config" ] || return 1
    while IFS= read -r line || [ -n "$line" ]; do
        cl=$(echo "$line" | tr -d '\r' | sed 's/^[ \t]*//;s/[ \t]*$//')
        case "$cl" in
            \#*|"") continue ;;
        esac
        if echo "$cl" | grep -q '<<EOF'; then
            echo "$(echo "$cl" | awk '{print $1}')" | sed 's/://g'
            while IFS= read -r lin || [ -n "$lin" ]; do
                echo "$lin" | grep -q '^EOF' && break
            done
            continue
        fi
        echo "$(echo "$cl" | awk '{print $1}')" | sed 's/://g'
    done < "$config"
    return 0
}

# registry 触发器集：当前快照每任务 trigger 字段（去冒号归一）。
shadow_scan_registry() {
    base=$1
    [ -d "$base/snapshots" ] || return 1
    for id in $(registry_task_ids); do
        f=$(registry_task_file "$id") || continue
        trig=$(grep '^trigger=' "$f" | head -1 | cut -d= -f2)
        echo "$trig" | sed 's/://g'
    done
    return 0
}

# 比对两清单：$1=legacy 清单文件 $2=registry 清单文件 → stdout 判定行 +
# 差异详情（各限 5）。comm 差集：legacy_only / registry_only。
shadow_compare() {
    leg=$1; reg=$2
    agree=Y
    ln=$(wc -l < "$leg" 2>/dev/null || echo 0)
    rn=$(wc -l < "$reg" 2>/dev/null || echo 0)
    [ "$ln" = "$rn" ] || agree=N
    sort "$leg" 2>/dev/null > "$leg.s"
    sort "$reg" 2>/dev/null > "$reg.s"
    lo=$(comm -23 "$leg.s" "$reg.s" 2>/dev/null | head -5 | tr '\n' ',')
    ro=$(comm -13 "$leg.s" "$reg.s" 2>/dev/null | head -5 | tr '\n' ',')
    [ -z "$lo$ro" ] || agree=N
    echo "agree=$agree"
    echo "legacy=$ln registry=$rn"
    [ -n "$lo" ] && echo "legacy_only=$lo"
    [ -n "$ro" ] && echo "registry_only=$ro"
    rm -f "$leg.s" "$reg.s"
}

# 单轮旁路比对核心：$1=base $2=config $3=log(缺省 base/shadow/shadow.log)
# 0=一致 1=不一致（含 config 缺失）2=状态目录不可建。
shadow_tick() {
    base=$1; config=$2
    SHADOW_LOGFILE=${3:-$base/shadow/shadow.log}
    [ -f "$config" ] || { shadow_log "$(date '+%Y-%m-%d %H:%M:%S')|SHADOW|op=compare|agree=N|legacy=0|registry=?|snap=|cfg_md5=|msg=config-missing"; return 1; }
    mkdir -p "$base/shadow" 2>/dev/null || return 2

    mdfile=$(shadow_state_file "$base")
    newmd5=$(md5sum "$config" | cut -d' ' -f1)
    oldmd5=$(grep '^last_md5=' "$mdfile" 2>/dev/null | cut -d= -f2)
    op="compare"
    changed=0
    if [ -n "$oldmd5" ] && [ "$oldmd5" = "$newmd5" ]; then
        :   # 未变化：沿用当前快照（不 reload）
    else
        # 配置变化 → 原子 reload（损坏/无效 → KEPT：快照与指针不动）
        registry_reload "$config" >/dev/null 2>&1; rrc=$?
        op="reload"
        changed=1
    fi
    snap=$(registry_current_snapshot_id)

    L="$base/shadow/leg.tmp"
    R="$base/shadow/reg.tmp"
    shadow_scan_legacy "$config" > "$L"
    shadow_scan_registry "$base" > "$R"
    out=$(shadow_compare "$L" "$R")
    agree=$(echo "$out" | sed -n 's/^agree=//p')
    ln=$(echo "$out" | sed -n 's/.*legacy=\([0-9]*\).*/\1/p')
    rn=$(echo "$out" | sed -n 's/.*registry=\([0-9]*\).*/\1/p')
    cm=$(echo "$newmd5" | cut -c1-12)

    {
        echo "last_md5=$newmd5"
        echo "last_snap=$snap"
        echo "last_agree=$agree"
        echo "last_legacy=$ln"
        echo "last_registry=$rn"
    } > "$mdfile.tmp" && mv "$mdfile.tmp" "$mdfile"

    shadow_log "$(date '+%Y-%m-%d %H:%M:%S')|SHADOW|op=$op|agree=$agree|legacy=$ln|registry=$rn|snap=$snap|cfg_md5=$cm|rrc=${rrc:-0}"
    if [ "$agree" = "N" ]; then
        shadow_log "$(date '+%Y-%m-%d %H:%M:%S')|SHADOW|diff|legacy_only=$(echo "$out" | sed -n 's/^legacy_only=//p')|registry_only=$(echo "$out" | sed -n 's/^registry_only=//p')"
    fi
    rm -f "$L" "$R" 2>/dev/null
    [ "$agree" = "Y" ] && return 0 || return 1
}

# daemon 启动旁路：建首快照 + 基线比对（op=init，不 reload）。
shadow_init() {
    base=$1; config=$2
    SHADOW_LOGFILE=${3:-$base/shadow/shadow.log}
    mkdir -p "$base/shadow" 2>/dev/null || return 2
    registry_init "$base" "$config" >/dev/null 2>&1
    snap=$(registry_current_snapshot_id)
    [ -n "$snap" ] || {
        shadow_log "$(date '+%Y-%m-%d %H:%M:%S')|SHADOW|op=init|agree=N|legacy=?|registry=0|snap=|cfg_md5=|msg=no-valid-snapshot"
        return 1
    }
    L="$base/shadow/leg.tmp"; R="$base/shadow/reg.tmp"
    shadow_scan_legacy "$config" > "$L"
    shadow_scan_registry "$base" > "$R"
    out=$(shadow_compare "$L" "$R")
    agree=$(echo "$out" | sed -n 's/^agree=//p')
    ln=$(echo "$out" | sed -n 's/.*legacy=\([0-9]*\).*/\1/p')
    rn=$(echo "$out" | sed -n 's/.*registry=\([0-9]*\).*/\1/p')
    cm=$(md5sum "$config" | cut -d' ' -f1 | cut -c1-12)
    {
        echo "last_md5=$(md5sum "$config" | cut -d' ' -f1)"
        echo "last_snap=$snap"
        echo "last_agree=$agree"
        echo "last_legacy=$ln"
        echo "last_registry=$rn"
    } > "$base/shadow/shadow.last.tmp" && mv "$base/shadow/shadow.last.tmp" "$base/shadow/shadow.last"
    shadow_log "$(date '+%Y-%m-%d %H:%M:%S')|SHADOW|op=init|agree=$agree|legacy=$ln|registry=$rn|snap=$snap|cfg_md5=$cm"
    if [ "$agree" = "N" ]; then
        shadow_log "$(date '+%Y-%m-%d %H:%M:%S')|SHADOW|diff|legacy_only=$(echo "$out" | sed -n 's/^legacy_only=//p')|registry_only=$(echo "$out" | sed -n 's/^registry_only=//p')"
    fi
    rm -f "$L" "$R" 2>/dev/null
    [ "$agree" = "Y" ] && return 0 || return 1
}

# §9 Canonical↔Legacy Run ID 映射（P2-04）
# ═══════════════════════════════════════════════════════════════════════════
# 目标：新版 Canonical Task ID（t<line>_<trigger>，registry 快照）与旧运行
# 目录 ID（time_<HHMM>_<n>_<epoch> / advanced_<n>_<epoch> / immediate_<n>_<epoch>
# / startup_<n>_<epoch>）之间建立**双向映射**；**不重命名旧运行目录、不改旧
# CLI 命令**（C2/C4：task-info/task-output/task-kill 继续按旧 ID 原路径操作，
# 映射层只读旁路）。匹配键：主=命令文本（command.txt == action.command）；
# 回退=触发器（startup→boot / time_<HHMM> / advanced→adv 家族 / immediate→
# 命令匹配）。映射文件：<base>/runtime/idmap，行 `task=<canonical>|run=<run_id>`，
# sort -u + tmp+mv 原子写（幂等：重复 refresh 无重复行）。
# ═══════════════════════════════════════════════════════════════════════════
runtime_idmap_file() { echo "$1/runtime/idmap"; }

runtime_map_refresh() {   # <base> <tasks_dir> → 0 成功 / 2 目录不可建
    base=$1; tasks=$2
    mkdir -p "$base/runtime" 2>/dev/null || return 2
    f=$(runtime_idmap_file "$base")
    : > "$f.tmp"
    if [ -d "$tasks" ]; then
        for p in "$tasks"/*; do
            [ -d "$p" ] || continue
            [ -f "$p/command.txt" ] || continue
            run=$(basename "$p")
            cmd=$(cat "$p/command.txt" 2>/dev/null)
            canon=""
            # 主键：命令文本匹配 registry task action.command
            for id in $(registry_task_ids); do
                tf=$(registry_task_file "$id") || continue
                ac=$(grep '^action.command=' "$tf" | head -1 | cut -d= -f2-)
                [ "$ac" = "$cmd" ] && canon=$id && break
            done
            # 回退键：触发器（run 前缀）
            if [ -z "$canon" ]; then
                case "$run" in
                    startup_*)
                        for id in $(registry_task_ids); do
                            tf=$(registry_task_file "$id") || continue
                            tr=$(grep '^trigger=' "$tf" | head -1 | cut -d= -f2)
                            [ "$tr" = "boot" ] && canon=$id && break
                        done ;;
                    time_*)
                        hhmm=$(echo "$run" | cut -d_ -f2)
                        for id in $(registry_task_ids); do
                            tf=$(registry_task_file "$id") || continue
                            tr=$(echo "$(grep '^trigger=' "$tf" | head -1 | cut -d= -f2)" | sed 's/://g')
                            [ "$tr" = "$hhmm" ] && canon=$id && break
                        done ;;
                    advanced_*)
                        for id in $(registry_task_ids); do
                            tf=$(registry_task_file "$id") || continue
                            tr=$(grep '^trigger=' "$tf" | head -1 | cut -d= -f2)
                            case "$tr" in
                                weekly:*|nweekly:*|monthly:*|nmonthly:*|yearly:*) canon=$id; break ;;
                            esac
                        done ;;
                esac
            fi
            [ -n "$canon" ] && echo "task=$canon|run=$run" >> "$f.tmp"
        done
    fi
    sort -u "$f.tmp" > "$f.tmp.s" && mv "$f.tmp.s" "$f"
    rm -f "$f.tmp" 2>/dev/null
    return 0
}

runtime_map_task_runs() {   # <base> <canonical_id> → 各旧 run id（每行一个）
    f=$(runtime_idmap_file "$1")
    [ -f "$f" ] || return 1
    grep "^task=$2|" "$f" | sed 's/^task=[^|]*|run=//'
}

runtime_map_run_task() {    # <base> <run_id> → canonical id（无则空）
    f=$(runtime_idmap_file "$1")
    [ -f "$f" ] || return 1
    grep "|run=$2$" "$f" | head -1 | cut -d= -f2 | cut -d'|' -f1
}

runtime_map_lookup() {      # <base> <tasks_dir> <id>：双向自动识别
    base=$1; tasks=$2; id=$3
    if [ -n "$(runtime_map_task_runs "$base" "$id")" ]; then
        echo "task=$id"
        runtime_map_task_runs "$base" "$id" | sed 's/^/run=/' 2>/dev/null
        return 0
    fi
    if [ -d "$tasks/$id" ]; then
        canon=$(runtime_map_run_task "$base" "$id")
        [ -n "$canon" ] && echo "task=$canon" || echo "task="
        echo "run=$id"
        return 0
    fi
    return 1
}

# ───────────────────────────────────────────────────────────────────────────
# §10 Trigger Decision Layer（P2-05）
# ═══════════════════════════════════════════════════════════════════════════
# 正式入口（唯一）：trigger_decide —— 每个 registry Task 的 boot / time /
# advanced 判断一律经 `provider_dispatch trigger <family> matches`（P1-04 唯一
# 分发入口）。**旧判断保留为 fallback**（daemon 内联决策原样；C2）；本层只做
# 旁路决策 + 与新侧镜像的**一致性记录**（trigger.log）。
# 保留语义（C4）：
#   - heredoc：source.type=block 任务与单行同触发器语义（决策按 trigger 字段）；
#   - --run-once-now：action.run_once_now=1 → 首扫即 due（legacy “立即执行”语义；
#     修剪动作仍归执行层的既有权责，本层不修剪、不改配置）；
#   - --delete：action.delete 仅是执行层动作语义，本层决策不含删除、不改配置；
#   - 既有去重状态：advanced 家族只**读**状态文件（tpr_trigger_advanced_matches
#     内部既有键检查）；键的**写**仍归 legacy 执行路径（本层零写入）。
# 不引入：Dependency / Condition / 新 Trigger（仅 boot/time/advanced 三家族）。
# ═══════════════════════════════════════════════════════════════════════════
trigger_ctx_now()   { echo "${TRIGGER_DECISION_NOW:-$(date +%H%M)}"; }
trigger_ctx_boot()  { echo "${TRIGGER_BOOT_CONTEXT:-0}"; }
trigger_ctx_state() { echo "${TRIGGER_STATE_FILE:-/data/adb/su-scheduler/schedule_state.txt}"; }
trigger_ctx_today() { echo "${TRIGGER_TODAY:-$(date +%Y%m%d)}"; }

# advanced 去重键的**写**（仅执行层使用；P2-05 本层不调用——保留由 legacy 路径
# should_run_advanced_schedule 写入既有格式键。此处仅供镜像比对构造只读键集合。）
trigger_adv_key() {   # <trigger> <clean_line> <state_file> [today] → echo key（镜像 daemon 键格式）
    trig=$1; line=$2; sf=${3:-$(trigger_ctx_state)}
    today=${4:-$(trigger_ctx_today)}
    yy=$(echo "$today" | cut -c1-4); mm=$(echo "$today" | cut -c5-6); dd=$(echo "$today" | cut -c7-8)
    dow=$(date -d "$today" +%u 2>/dev/null || date +%u)
    wk=$(date -d "$today" +%V 2>/dev/null || date +%V)
    hash=$(printf '%s\n' "$line" | md5sum | cut -d' ' -f1)
    case "$trig" in
        weekly:*)  t=$(echo "$trig" | cut -d: -f3); echo "weekly_$(echo "$trig" | cut -d: -f2)_${t}_${hash}_${yy}${mm}${dd}" ;;
        nweekly:*) n=$(echo "$trig" | cut -d: -f2); t=$(echo "$trig" | cut -d: -f4); echo "nweekly_${n}_$(echo "$trig" | cut -d: -f3)_${t}_${hash}=${wk}" ;;
        monthly:*) t=$(echo "$trig" | cut -d: -f3); echo "monthly_$(echo "$trig" | cut -d: -f2)_${t}_${hash}_${yy}${mm}" ;;
        nmonthly:*) n=$(echo "$trig" | cut -d: -f2); t=$(echo "$trig" | cut -d: -f4); echo "nmonthly_${n}_$(echo "$trig" | cut -d: -f3)_${t}_${hash}=${mm}" ;;
        yearly:*)  t=$(echo "$trig" | cut -d: -f3); echo "yearly_$(echo "$trig" | cut -d: -f2)_${t}_${hash}_${yy}" ;;
    esac
}

# ── 正式决策入口（唯一）：trigger_decide <base> <task_id> [now] [boot] [state_file]
# → stdout 单行：task=<id>|trigger=<trig>|due=<Y|N>|cause=<boot|time_trigger|
# advanced|manual_exec|>；返回 0=due / 1=not due / 2=硬错误。全部匹配经 provider
# dispatch（单入口）。heredoc/--delete/--run-once-now/去重保留见 §10 头注释。
trigger_decide() {
    base=$1; tid=$2
    now=${3:-$(trigger_ctx_now)}
    boot=${4:-$(trigger_ctx_boot)}
    sf=${5:-$(trigger_ctx_state)}
    tf=$(registry_task_file "$tid") || { echo "task=$tid|due=N|err=no-task"; return 2; }
    trig=$(grep '^trigger=' "$tf" | head -1 | cut -d= -f2)
    stype=$(grep '^source.type=' "$tf" | head -1 | cut -d= -f2)
    ron=$(grep '^action.run_once_now=' "$tf" | head -1 | cut -d= -f2)
    if [ "$ron" = "1" ]; then
        echo "task=$tid|trigger=$trig|due=Y|cause=manual_exec"
        return 0
    fi
    case "$trig" in
        boot)
            if TRIGGER_BOOT_CONTEXT=$boot provider_dispatch trigger boot matches >/dev/null 2>&1; then
                echo "task=$tid|trigger=$trig|due=Y|cause=boot"
                return 0
            fi
            echo "task=$tid|trigger=$trig|due=N|cause="
            return 1 ;;
        [0-9][0-9]:[0-9][0-9]|[0-9][0-9][0-9][0-9])
            if TRIGGER_DECISION_NOW=$now provider_dispatch trigger time matches "$trig" >/dev/null 2>&1; then
                echo "task=$tid|trigger=$trig|due=Y|cause=time_trigger"
                return 0
            fi
            echo "task=$tid|trigger=$trig|due=N|cause="
            return 1 ;;
        weekly:*|nweekly:*|monthly:*|nmonthly:*|yearly:*)
            RAW=$(grep '^source.raw=' "$tf" | head -1 | cut -d= -f2-)
            CLEAN=$(rt_clean "$RAW")
            if TRIGGER_DECISION_NOW=$now TRIGGER_STATE_FILE=$sf \
               TRIGGER_DECISION_LINE="$CLEAN" provider_dispatch trigger advanced matches "$trig" >/dev/null 2>&1; then
                echo "task=$tid|trigger=$trig|due=Y|cause=advanced"
                return 0
            fi
            echo "task=$tid|trigger=$trig|due=N|cause="
            return 1 ;;
        *)
            echo "task=$tid|trigger=$trig|due=N|err=unknown-trigger"
            return 2 ;;
    esac
}
# ───────────────────────────────────────────────────────────────────────────
# §11 Action Execution Layer（P2-06）
# ═══════════════════════════════════════════════════════════════════════════
# 正式入口（唯一）：action_run —— 命令 / 脚本 / Termux / Interactive 四模式
# 一律经 `provider_dispatch action command <cap>`（P1-04 唯一分发入口）。
# **旧执行路径保留为 fallback**（C2）：RUNTIME_LOADED=0 时 daemon 直接调用
# legacy execute_task（原样）；RUNTIME_LOADED=1 时 daemon 调用本正式入口
# （接线见 su-schedulerd 四处执行点）。**Provider 内部委托既有 execute_task**
# （不建立第二套命令执行器）：本库运行于 daemon 上下文（`type execute_task`
# 命中——daemon 同 shell 注入）时，command Provider 的 start 能力以 7 参原样
# 委托 execute_task——旧工件 status.txt / pid.txt / output.log / exit_code.txt
# / command.txt / start_time.txt / end_time.txt / exec_mode.txt 由 execute_task
# 原样产出（零改动、零降级）。非 daemon 上下文（CLI/测试）使用 §3 既有镜像
# 执行器（P1-08 全模式，工件语义一致）——不引入新执行引擎。
# 保留语义：notify_start/notify_end/custom_msg 仅随委托透传；本层不发送通知
# （通知归 execute_task）；镜像路径不发送通知（与 P1-08/测试域一致）。
# stdout（至多一行）：id=<id>|mode=<system|termux|interactive>|pid=<pid>|dir=<dir>
# 返回：0=已启动 1=任务无效（缺 id/command）或分发失败（含碰撞跳过）2=硬错误。
# ═══════════════════════════════════════════════════════════════════════════
action_log() {
    [ "${ACTION_LOG:-1}" = "1" ] && echo "[action] $1" >&2
}

action_run() {   # <id> <cmd> [termux] [interactive] [notify_start] [notify_end] [custom_msg]
    id=$1; cmd=$2; termux=${3:-0}; interactive=${4:-0}
    notify_start=${5:-0}; notify_end=${6:-0}; custom_msg=${7:-}
    [ -n "$id" ] || { action_log "ERROR action_run: id required"; return 1; }
    [ -n "$cmd" ] || { action_log "ERROR action_run: no command (id=$id)"; return 1; }
    mode="system"
    [ "$termux" = "1" ] && mode="termux"
    [ "$interactive" = "1" ] && mode="interactive"
    # P2-10：结构化 App Action（app:op:target[:extras]）——参数全校验后经 app
    # Provider 启动（固定 am 模板 + 校验片段，绝不经 shell 拼接任意 Root Shell）；
    # 本分支先于 execute_task 委托：daemon 上下文中 app 任务也不得落入 shell 执行。
    if [ "${cmd#app:}" != "$cmd" ]; then
        run_dir=$(provider_dispatch action app prepare "$id" "$cmd") || {
            action_log "ERROR action_run: app prepare rejected (id=$id)"
            return 1
        }
        provider_dispatch action app start "$id" "$cmd" > "$run_dir/pid.txt" 2>/dev/null || return 1
        pid=$(cat "$run_dir/pid.txt" 2>/dev/null)
        state_log_event "$run_dir" "$id" spawn RUNNING "$pid" "" "app action via provider" >/dev/null 2>&1
        echo "id=$id|mode=app|pid=$pid|dir=$run_dir"
        return 0
    fi
    run_dir=""
    if type execute_task >/dev/null 2>&1; then
        # daemon 上下文：经 provider 分发；command Provider start 内部委托
        # 既有 execute_task（7 参原样 → 旧工件原样产出；C2/不建第二执行器）。
        provider_dispatch action command start "$id" "$cmd" "$termux" "$interactive" \
            "$notify_start" "$notify_end" "$custom_msg" >/dev/null 2>&1
        rc=$?
        [ "$rc" -eq 0 ] || { action_log "ERROR action_run: start rc=$rc (id=$id)"; return 1; }
        run_dir="${TASKS_DIR:-}/$id"
    else
        # 非 daemon 上下文（CLI/测试）：镜像路径（prepare → start，§3 全模式）。
        run_dir=$(provider_dispatch action command prepare "$id" "$cmd") || {
            action_log "ERROR action_run: prepare failed (id=$id)"
            return 1
        }
        provider_dispatch action command start "$id" "$cmd" "$termux" "$interactive" \
            > "$run_dir/pid.txt" 2>/dev/null || return 1
    fi
    pid=$(cat "$run_dir/pid.txt" 2>/dev/null)
    # P2-07：启动即双写新状态（state.txt=RUNNING + events.log spawn；旧工件由
    # execute_task/镜像执行器原样产出，本层只读旧、只写新——不碰 status.txt 等）。
    state_log_event "$run_dir" "$id" spawn RUNNING "$pid" "" "launched via unified action entry" >/dev/null 2>&1
    echo "id=$id|mode=$mode|pid=$pid|dir=$run_dir"
    return 0
}
# ───────────────────────────────────────────────────────────────────────────
# §12 Unified State & Event Wiring（P2-07）
# ═══════════════════════════════════════════════════════════════════════════
# 生产事实源：新 `state.txt`（TSM v2 状态）+ `events.log`（7 字段事件行）成为
# 权威状态记录；旧兼容工件（status.txt / pid.txt / output.log / exit_code.txt）
# **只读、双写共存**（旧 CLI 按旧语义继续读取——P2-04/06 兼容边界）。本层叠在
# §4 runtime_log_event（P1-09 原语：先事件行、后 state.txt 原子 tmp+mv）之上，
# 增加三条生产策略：
#   1) 健康族门槛：**只有注册了非 builtin 的真实 Health Provider 才允许写
#      HEALTHY/UNHEALTHY**（`state_health_allowed`）——当前仅 builtin stub，
#      故 HEALTHY 一律被拒（一次性任务成功 → STOPPED，绝不虚假 HEALTHY）。
#   2) 状态机迁移校验：state.txt 已存在且目标不同时，按 TSM 允许边校验
#      （task_state_transition；事件 ∈ TSM_CAUSES 时作 cause）；非法迁移 →
#      WARNING + 拒绝写入（**非致命：不影响 daemon 主循环**）。
#   3) 幂等对账（state_sync_all / state_sync_one）：主循环每轮以 exit_code.txt
#      为准写终态——成功 → STOPPED（一次性任务），失败 → FAILED；已终态跳过；
#      新源缺失时由旧工件推导并物化（旧工件不动）。
# 重启残留（state_rehydrate_residual）：daemon 启动剪枝后旧 status.txt 为
# RUNNING/STARTING/ZOMBIE_CRASHED/STALE 的运行目录 → state.txt=FAILED +
# daemon_restart 事件（task_state_rehydrate 语义；旧 status.txt 不动）。
# 返回约定：各入口非致命——任何拒绝/错误均 return != 0 且不中止调用方循环。
# ═══════════════════════════════════════════════════════════════════════════
state_log() {
    [ "${STATE_LOG:-1}" = "1" ] && echo "[state] $1" >&2
}

# 健康族门槛：注册表中存在非 builtin 的真实 Health Provider → 0；否则 1。
state_health_allowed() {
    for entry in $TPR_REGISTRY; do
        f1=${entry%%>*}
        [ "$f1" = "health" ] || continue
        rest=${entry#*>}; f2=${rest%%>*}; pre=${rest#*>}
        [ "$f2" = "builtin" ] || { [ -n "$pre" ] && return 0; }
    done
    return 1
}

# 统一状态/事件写入（生产正式入口）：健康族门槛 + TSM 迁移校验 +
# 双写 state.txt/events.log（委托 §4 runtime_log_event；旧工件只读不动）。
state_log_event() {   # <dir> <task_id> <event> <state> [pid] [exit_code] [message]
    dir=$1; task_id=$2; event=$3; state=$4; pid=${5:-}; exit_code=${6:-}; message=${7:-}
    [ -n "$dir" ] || { state_log "ERROR log_event: dir required"; return 1; }
    if [ "$state" = "HEALTHY" ] || [ "$state" = "UNHEALTHY" ]; then
        state_health_allowed || {
            state_log "WARNING log_event: HEALTHY/UNHEALTHY requires a real health provider (task=$task_id) — rejected, daemon loop unaffected"
            return 1
        }
    fi
    cur=""
    [ -f "$dir/state.txt" ] && cur=$(cat "$dir/state.txt" 2>/dev/null)
    if [ -n "$cur" ] && [ "$cur" != "$state" ]; then
        case " $TSM_CAUSES " in
            *" $event "*) cause=$event ;;
            *) cause="" ;;
        esac
        TSM_LOG=0 task_state_transition "$cur" "$state" "$cause" >/dev/null 2>&1 || {
            state_log "WARNING log_event: illegal transition '$cur'->'$state' rejected (task=$task_id; event=$event) — daemon loop unaffected"
            return 1
        }
    fi
    runtime_log_event "$dir" "$task_id" "$event" "$state" "$pid" "$exit_code" "$message"
}

# 单目录对账：exit_code.txt 存在 → 按退出码写终态（powered 一次性任务成功 →
# STOPPED；失败 → FAILED）；新源缺失时由旧工件推导并物化。幂等：已终态跳过。
state_sync_one() {   # <dir> → 0=ok 1=未完成（无终态可判定）2=硬错误（不中止循环）
    dir=$1
    [ -d "$dir" ] || return 2
    id=$(basename "$dir")
    [ -f "$dir/exit_code.txt" ] || return 1
    ec=$(cat "$dir/exit_code.txt" 2>/dev/null)
    cur=$(runtime_current_state "$dir")
    case "$cur" in
        STARTING|RUNNING|PENDING|WAITING)
            if [ "$ec" = "0" ]; then
                state_log_event "$dir" "$id" action_success STOPPED "" "$ec" "exit=$ec" >/dev/null 2>&1
            else
                state_log_event "$dir" "$id" action_failure FAILED "" "$ec" "exit=$ec" >/dev/null 2>&1
            fi
            ;;
        STOPPED|FAILED|DISABLED)
            if [ ! -f "$dir/state.txt" ]; then
                # 新源缺失：由旧工件推导的终态 → 物化（旧工件不动）。
                if [ "$cur" = "STOPPED" ]; then
                    state_log_event "$dir" "$id" action_success STOPPED "" "$ec" "materialized from legacy" >/dev/null 2>&1
                elif [ "$cur" = "FAILED" ]; then
                    state_log_event "$dir" "$id" action_failure FAILED "" "$ec" "materialized from legacy" >/dev/null 2>&1
                fi
            fi
            ;;
        *) : ;;   # 未知/非法现态：不触碰（非致命，继续）
    esac
    return 0
}

# 全目录对账：单目录错误不中止（非法状态转换不破主循环）。
state_sync_all() {   # <tasks_dir> → 0=ok 1=存在未完成/错误目录 2=目录不可用
    tasks=$1
    [ -d "$tasks" ] || { state_log "ERROR sync_all: no tasks dir $tasks"; return 2; }
    rc=0
    for p in "$tasks"/*; do
        [ -d "$p" ] || continue
        state_sync_one "$p" >/dev/null 2>&1 || rc=1
    done
    return "$rc"
}

# 重启残留再水合：daemon 启动剪枝后的运行态（RUNNING/STARTING/
# ZOMBIE_CRASHED/STALE）→ state.txt=FAILED + daemon_restart 事件；旧工件不动。
state_rehydrate_residual() {   # <tasks_dir>
    tasks=$1
    [ -d "$tasks" ] || { state_log "ERROR rehydrate: no tasks dir $tasks"; return 2; }
    for p in "$tasks"/*; do
        [ -d "$p" ] || continue
        [ -f "$p/status.txt" ] || continue
        id=$(basename "$p")
        st=$(cat "$p/status.txt" 2>/dev/null)
        case "$st" in
            RUNNING|STARTING|ZOMBIE_CRASHED|STALE)
                cur=$(runtime_current_state "$p")
                case "$cur" in
                    STARTING|RUNNING|PENDING|WAITING)
                        state_log_event "$p" "$id" daemon_restart FAILED "" "" "residual after daemon restart" >/dev/null 2>&1
                        ;;
                    FAILED)
                        # 旧源已推导 FAILED（如 ZOMBIE_CRASHED）但新源缺失 → 物化
                        if [ ! -f "$p/state.txt" ]; then
                            state_log_event "$p" "$id" daemon_restart FAILED "" "" "residual materialized from legacy" >/dev/null 2>&1
                        fi
                        ;;
                esac
                ;;
        esac
    done
    return 0
}
# ───────────────────────────────────────────────────────────────────────────
# §13 Task CLI 接线（P2-08）
# ═══════════════════════════════════════════════════════════════════════════
# CLI `su-scheduler task list | task status <id>` 的生产数据路径：**读取
# Registry，不重新扫描配置**（registry_attach 只挂载当前快照；不调用
# adapter/parse/reload）。三态错误区分沿 §7：rc1 task not found / rc2
# configuration invalid / rc3 daemon is not running——均带明确 stderr 消息。
# 支持**稳定 Task ID（t<line>_<trigger>）与旧运行 ID（time_/advanced_/
# immediate_/startup_…）**双向查询：旧 ID 经 §9 idmap（runtime_map_refresh
# 幂等刷新 + run→canonical 反向查询）。旧 CLI 命令零改动（P2-04 兼容边界）；
# 本层只新增 task 前缀命令（不 alias、不覆盖 commands 同名函数）。
# 返回：0=成功 / 1=任务未找到或用法错 / 2=配置无效（无有效快照）/ 3=daemon 未运行。
# ═══════════════════════════════════════════════════════════════════════════
task_cli_attach() {   # <base> → 0=已挂载当前快照 / 1=无有效快照 / 2=base 缺失
    registry_attach "$1"
}

task_cli_resolve_id() {   # <base> <tasks_dir> <id> → echo canonical id（无则返回 1）
    base=$1; tasks=$2; qid=$3
    # 注：查询 ID 用 qid 而非 id —— runtime_map_refresh 内部以全局 `id` 作循环
    # 变量（POSIX sh 无局部变量），复用同名会覆盖本函数参数（P2-08 实测修复）。
    if registry_task_file "$qid" >/dev/null 2>&1; then
        echo "$qid"
        return 0
    fi
    # 旧运行 ID → canonical（§9 idmap：幂等刷新后反向查询 run→canonical）
    runtime_map_refresh "$base" "$tasks" >/dev/null 2>&1
    canon=$(runtime_map_run_task "$base" "$qid")
    [ -n "$canon" ] || return 1
    echo "$canon"
    return 0
}

task_cli_status_id() {   # <base> <tasks_dir> <lock> <id> → rc 沿 §7 三态
    base=$1; tasks=$2; lock=$3; qid=$4
    [ -n "$qid" ] || { echo "ERROR: usage: task status <id>" >&2; return 1; }
    task_cli_attach "$base" >/dev/null 2>&1 || {
        echo "ERROR: configuration invalid (no valid task snapshot)" >&2
        return 2
    }
    canon=$(task_cli_resolve_id "$base" "$tasks" "$qid")
    if [ -z "$canon" ]; then
        echo "ERROR: task not found: $qid" >&2
        return 1
    fi
    if [ "$canon" != "$qid" ]; then
        echo "queried_id=$qid"
        echo "canonical_id=$canon"
    fi
    TASK_CLI_TASKS_DIR="$tasks" TASK_CLI_LOCK="$lock" task_cli_status "$canon"
}
# ───────────────────────────────────────────────────────────────────────────
# §14 Daemon Lifecycle Startup（P2-09）
# ═══════════════════════════════════════════════════════════════════════════
# daemon 启动生命周期（**单次执行，不创建第二个常驻循环**；**不重复实现锁逻辑**
# ——daemon 既有 LOCK_FILE 单实例保护与 service.sh 60 秒看护循环原样保留）。
# 两个正式入口：
#   lifecycle_startup_registry <base> <config> —— Registry 引导：当前已有快照
#     （shadow_init 已建 / reload KEPT）即就绪；否则 config 存在 → registry_init
#     （新快照）；config 缺失 → registry_attach **只读挂载最后有效快照**（KEPT
#     语义，不重新扫描配置）。返回 0=快照就绪 / 1=无有效快照 / 2=参数错。
#   lifecycle_startup_recover <tasks_dir> —— 恢复序列（幂等，单目录错误不中止）：
#     = runtime_scan_stale（stale PID：pid.txt 指向已死进程的运行态 →
#       state.txt=FAILED + daemon_restart 事件）+ state_rehydrate_residual
#       （剪枝后运行态 status.txt=RUNNING/STARTING/ZOMBIE_CRASHED/STALE →
#       state.txt=FAILED + daemon_restart 事件）；旧工件（status.txt/pid.txt/…）
#       **只读不动**（旧 CLI 仍按旧语义读取）。
# daemon 接线：su-schedulerd 启动区按同一序列组合（P2-03 shadow_init →
# P2-04 runtime_map_refresh → 本层 registry 引导 → P2-05 trigger_decide 预热 →
# legacy 剪枝后本层恢复序列）；本层亦供测试以同一序列做真实链路验证
# （daemon 重启 / stop / restart / stale lock / service 看护）。
# ═══════════════════════════════════════════════════════════════════════════
lifecycle_startup_registry() {   # <base> <config> → 0=快照就绪 / 1=无有效快照 / 2=参数错
    base=$1; config=$2
    [ -n "$base" ] && [ -n "$config" ] || {
        lifecycle_log "ERROR startup_registry: base/config required"; return 2; }
    if [ -n "$(registry_current_snapshot_id 2>/dev/null)" ]; then
        return 0
    fi
    if [ -f "$config" ]; then
        registry_init "$base" "$config" >/dev/null 2>&1
    else
        registry_attach "$base" >/dev/null 2>&1
    fi
    [ -n "$(registry_current_snapshot_id 2>/dev/null)" ] && return 0 || return 1
}

lifecycle_startup_recover() {   # <tasks_dir> → 0=完成（幂等；单目录错误不中止）
    tasks=$1
    [ -d "$tasks" ] || { lifecycle_log "INFO startup_recover: no tasks dir $tasks"; return 0; }
    runtime_scan_stale "$tasks" >/dev/null 2>&1
    state_rehydrate_residual "$tasks" >/dev/null 2>&1
    return 0
}
# ───────────────────────────────────────────────────────────────────────────
# §15 App Action Provider（P2-10）
# ═══════════════════════════════════════════════════════════════════════════
# 结构化 App Action（P1-04 契约预留；Shizuku/GKD 类应用可经结构化 Task 启动）：
#   spec = `app:<op>:<target>[:<extras>]`
#     op     ∈ package | activity | broadcast | service
#     target ：
#       package   包名（com.example.app）
#       activity/service 组件（com.example/.Main 或 com.example/.a.b.C；
#                         允许包内相对类；含 `$` 的内部类组件暂不支持——安全集
#                         拒绝 `$`，属后续扩展点）
#       broadcast 意图动作（com.example.ACTION_GO / android.intent.action.X）
#     extras （仅 broadcast）可选：k1=v1,k2=v2（字符串 extra，--es 透传）
# **安全门（所有参数校验，不允许 Web/CLI 拼接任意 Root Shell）**：
#   1) 全局安全字符集门：spec 仅允许 `[A-Za-z0-9._:/=+%-]`（无空格、无引号、
#      无反引号/$、无 ;|&<>(){} 等任何 shell 元字符）——case 负向类一票否决；
#   2) 逐操作结构校验：包名/组件/意图动作的正则白名单；
#   3) 执行构建 = **固定 am 模板 + 已校验片段**（直接 argv 调用 am，不经
#      sh -c / eval；校验失败 → 拒启、零执行、写 FAILED 工件）。
# 能力（沿 action 契约）：validate / prepare / start / status / stop / restart；
# 注册 `provider_register action app tpr_action_app`（核心引擎零改动——
# provider_dispatch 只认 kind+cap）。工件语义与 §3 command 一致：
# command.txt(spec)/start_time/status RUNNING → am 执行 → output.log/
# exit_code.txt/end_time/SUCCESS|FAILED。
# ═══════════════════════════════════════════════════════════════════════════
tpr_action_app_log() {
    [ "${TPR_LOG:-1}" = "1" ] && echo "[app-action] $1" >&2
}

# 解析 + 全校验：置 op/target/extras（全局；POSIX sh 无局部变量）；非法 → 1。
tpr_action_app_parse() {   # <spec>
    spec=$1
    # 全局安全门（负向字符类）：任何不在安全集内的字符一票否决（含空格与全部
    # shell 元字符——Web/CLI 无法经 spec 注入任意 Root Shell 命令）。
    # 安全集 = 字母数字 + . _ : / = + - % ,（`$`/`!`/`@` 等一律拒绝——内部类
    # 组件含 `$` 的 spec 暂不支持，属后续扩展点）。
    case "$spec" in
        *[!A-Za-z0-9._:/\=%+-,]*) return 1 ;;
    esac
    op=$(echo "$spec" | cut -d: -f2)
    target=$(echo "$spec" | cut -d: -f3)
    extras=$(echo "$spec" | cut -d: -f4-)
    [ -n "$op" ] && [ -n "$target" ] || return 1
    case "$op" in
        package)
            echo "$target" | grep -E '^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+$' >/dev/null || return 1
            [ -z "$extras" ] || return 1
            ;;
        activity|service)
            echo "$target" | grep -E '^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+(/\.?[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*)?$' >/dev/null || return 1
            [ -z "$extras" ] || return 1
            ;;
        broadcast)
            echo "$target" | grep -E '^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)*$' >/dev/null || return 1
            if [ -n "$extras" ]; then
                oldifs=$IFS; IFS=','
                for pair in $extras; do
                    [ -n "$pair" ] || continue
                    k=${pair%%=*}; v=${pair#*=}
                    [ -n "$k" ] && [ -n "$v" ] || { IFS=$oldifs; return 1; }
                    echo "$k" | grep -E '^[A-Za-z][A-Za-z0-9_]*$' >/dev/null || { IFS=$oldifs; return 1; }
                    echo "$v" | grep -E '^[A-Za-z0-9._:/%+\-]*$' >/dev/null || { IFS=$oldifs; return 1; }
                done
                IFS=$oldifs
            fi
            ;;
        *) return 1 ;;
    esac
    return 0
}

tpr_action_app_validate() {   # <spec> → 0=合法 / 1=非法（安全门）
    tpr_action_app_parse "$1" >/dev/null 2>&1
}

tpr_action_app_dir() { echo "${TPR_ACTION_DIR:-/tmp/su-scheduler-actions}/$1"; }

tpr_action_app_prepare() {   # <id> <spec> → echo dir；非法 spec 拒启（不建目录）
    id=$1; spec=$2
    tpr_action_app_parse "$spec" >/dev/null 2>&1 || {
        tpr_action_app_log "ERROR prepare: invalid app spec rejected (id=$id): $spec"
        return 1
    }
    dir=$(tpr_action_app_dir "$id")
    mkdir -p "$dir" || return 2
    echo "$spec" > "$dir/command.txt"
    date "+%Y-%m-%d %H:%M:%S" > "$dir/start_time.txt"
    echo "RUNNING" > "$dir/status.txt"
    echo "$dir"
}

tpr_action_app_start() {   # <id> <spec> → 后台执行（固定 am 模板）+ echo pid
    id=$1; spec=$2
    tpr_action_app_parse "$spec" >/dev/null 2>&1 || {
        tpr_action_app_log "ERROR start: invalid app spec rejected — no shell execution (id=$id): $spec"
        return 1
    }
    dir=$(tpr_action_app_dir "$id")
    (
        tpr_action_exec_app "$id" "$dir" "$spec"
    ) &
    echo $!
}

tpr_action_app_status() {   # <id> <pid>
    pid=$2
    [ -n "$pid" ] && [ -d "/proc/$pid" ] && return 0 || return 1
}

tpr_action_app_stop() { kill "$2" 2>/dev/null; }

tpr_action_app_restart() {   # <id> <spec> <old_pid>
    tpr_action_app_stop "$1" "$3"
    sleep 1
    tpr_action_app_start "$1" "$2"
}

tpr_action_exec_app() {   # <id> <dir> <spec>（spec 已全校验；构建固定 am 模板）
    id=$1; dir=$2; spec=$3
    tpr_action_app_parse "$spec" >/dev/null 2>&1 || {
        echo "ERROR: invalid app action spec: $spec" > "$dir/output.log" 2>/dev/null
        echo "1" > "$dir/exit_code.txt" 2>/dev/null
        echo "FAILED" > "$dir/status.txt" 2>/dev/null
        return 1
    }
    case "$op" in
        package)
            am start -a android.intent.action.MAIN -c android.intent.category.LAUNCHER -p "$target" ;;
        activity)
            am start -n "$target" ;;
        service)
            am startservice -n "$target" ;;
        broadcast)
            set -- am broadcast -a "$target"
            if [ -n "$extras" ]; then
                oldifs=$IFS; IFS=','
                for pair in $extras; do
                    [ -n "$pair" ] || continue
                    k=${pair%%=*}; v=${pair#*=}
                    set -- "$@" --es "$k" "$v"
                done
                IFS=$oldifs
            fi
            "$@" ;;
    esac > "$dir/output.log" 2>&1
    rc=$?
    echo "$rc" > "$dir/exit_code.txt"
    date "+%Y-%m-%d %H:%M:%S" > "$dir/end_time.txt"
    if [ "$rc" -eq 0 ]; then
        echo "SUCCESS" > "$dir/status.txt"
    else
        echo "FAILED" > "$dir/status.txt"
    fi
    return "$rc"
}
# ───────────────────────────────────────────────────────────────────────────
# §16 Process & Port Health Provider（P2-11）
# ═══════════════════════════════════════════════════════════════════════════
# 首批真实健康检查（P1-04 health 契约：validate / check）：
#   health>process —— Process Check：spec = 进程名（pidof）或 PID（/proc/<pid>）；
#   health>port    —— Port Check：spec = TCP 端口 1-65535（/proc/net/tcp 的
#                     LISTEN(0A) 状态；IPv4，IPv6 为扩展点）。
# **统一返回三态 + 原因 + 延迟 + 目标**（单行，`|` 分隔）：
#   <HEALTHY|UNHEALTHY|UNKNOWN>|reason=<原因>|latency_ms=<毫秒>|target=<spec>
#   返回码：0=HEALTHY / 1=UNHEALTHY / 2=UNKNOWN / 3=分发或用法错误。
# 安全：spec 经安全字符集 + 结构校验（拒绝 shell 元字符——同 §15 原则；
# 仅做只读检查，零执行副作用）。
# 正式入口：`health_check <kind> <spec>`（唯一；经 provider_dispatch health）。
# 注意：注册 process/port 后 **P2-07 state_health_allowed 打开**——HEALTHY/
# UNHEALTHY 状态写入获准（真实 Health Provider 已接入；门槛机制本身在
# builtin-only 注册表下仍关闭，状态套件 §4 有双侧断言）。
# ═══════════════════════════════════════════════════════════════════════════
tpr_health_log() {
    [ "${TPR_LOG:-1}" = "1" ] && echo "[health] $1" >&2
}

# 毫秒时间戳：date +%s%3N（GNU/toybox）截取前 13 位 = 纪元毫秒；uutils 的
# %3N 输出 9 位纳秒（19 位）同样截 13 位归一；不支持 %N → 秒*1000 退化。
tpr_health_ms() {
    ms=$(date "+%s%3N" 2>/dev/null | cut -c1-13)
    case "$ms" in
        *[!0-9]*) echo $(( $(date +%s) * 1000 )) ;;
        *) echo "$ms" ;;
    esac
}

# ── Process Check ───────────────────────────────────────────────────────────
tpr_health_process_validate() {   # <spec> → 进程名或 PID（安全字符集 + 结构）
    case "$1" in
        *[!A-Za-z0-9_./:-]*) return 1 ;;
    esac
    case "$1" in
        [0-9]*) echo "$1" | grep -E '^[0-9]+$' >/dev/null ;;
        *) echo "$1" | grep -E '^[A-Za-z][A-Za-z0-9_./:-]*$' >/dev/null ;;
    esac
}

tpr_health_process_check() {   # <spec> → 三态行 + rc 0/1/2
    spec=$1
    t0=$(tpr_health_ms)
    if ! tpr_health_process_validate "$spec"; then
        t1=$(tpr_health_ms)
        lat=$((t1 - t0)); [ "$lat" -lt 0 ] && lat=0   # 时钟抖动防护
        echo "UNKNOWN|reason=invalid-spec|latency_ms=$lat|target=$spec"
        return 2
    fi
    found=0
    cmd_err=0
    if echo "$spec" | grep -qE '^[0-9]+$'; then
        [ -d "/proc/$spec" ] && found=1
    else
        if command -v pidof >/dev/null 2>&1; then
            pidof "$spec" >/dev/null 2>&1 && found=1
        else
            cmd_err=1
        fi
    fi
    t1=$(tpr_health_ms)
    lat=$((t1 - t0))
    [ "$lat" -lt 0 ] && lat=0   # 时钟抖动防护（宿主 uutils date 偶发负差）
    if [ "$found" -eq 1 ]; then
        echo "HEALTHY|reason=process-running|latency_ms=$lat|target=$spec"
        return 0
    elif [ "$cmd_err" -eq 1 ]; then
        echo "UNKNOWN|reason=pidof-unavailable|latency_ms=$lat|target=$spec"
        return 2
    else
        echo "UNHEALTHY|reason=process-not-found|latency_ms=$lat|target=$spec"
        return 1
    fi
}

# ── Port Check（TCP LISTEN，/proc/net/tcp）──────────────────────────────────
tpr_health_port_validate() {   # <spec> → 端口 1-65535
    echo "$1" | grep -E '^[0-9]{1,5}$' >/dev/null || return 1
    [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

tpr_health_port_check() {   # <spec> → 三态行 + rc 0/1/2
    spec=$1
    t0=$(tpr_health_ms)
    if ! tpr_health_port_validate "$spec"; then
        t1=$(tpr_health_ms)
        lat=$((t1 - t0)); [ "$lat" -lt 0 ] && lat=0   # 时钟抖动防护
        echo "UNKNOWN|reason=invalid-spec|latency_ms=$lat|target=port:$spec"
        return 2
    fi
    hex=$(printf '%04X' "$spec")
    listening=0
    unreadable=0
    if [ -r /proc/net/tcp ]; then
        n=$(awk -v h="$hex" '$4 == "0A" && $2 ~ ":" h "$" { n++ } END { print n+0 }' /proc/net/tcp 2>/dev/null)
        [ "$n" -gt 0 ] && listening=1
    else
        unreadable=1
    fi
    t1=$(tpr_health_ms)
    lat=$((t1 - t0))
    [ "$lat" -lt 0 ] && lat=0   # 时钟抖动防护（宿主 uutils date 偶发负差）
    if [ "$listening" -eq 1 ]; then
        echo "HEALTHY|reason=port-listening|latency_ms=$lat|target=port:$spec"
        return 0
    elif [ "$unreadable" -eq 1 ]; then
        echo "UNKNOWN|reason=proc-unreadable|latency_ms=$lat|target=port:$spec"
        return 2
    else
        echo "UNHEALTHY|reason=port-not-listening|latency_ms=$lat|target=port:$spec"
        return 1
    fi
}

# 正式入口（唯一）：health_check <kind> <spec> → 三态行 + rc 0/1/2/3
health_check() {
    kind=${1:-}; spec=${2:-}
    [ -n "$kind" ] && [ -n "$spec" ] || {
        tpr_health_log "ERROR check: kind/spec required"
        return 3
    }
    provider_dispatch health "$kind" check "$spec"
}
# ───────────────────────────────────────────────────────────────────────────
# §17 Supervisor Core（P2-12）+ Recovery/Retry/Cooldown（P2-13）
# ═══════════════════════════════════════════════════════════════════════════
# 驱动受监督任务的完整生命周期（TSM 允许边 + §16 健康检查）：
#   RUNNING → HEALTHY（首检通过）
#   HEALTHY → UNHEALTHY（探针失败）
#   UNHEALTHY → RECOVERING（进入恢复）
#   RECOVERING → STARTING（恢复动作成功）→ spawn → RUNNING（循环）
#   RECOVERING → FAILED（重试超过策略 retry.max）
# **统一事件循环**：`supervisor_tick <tasks_dir> <base>` 为唯一入口——每 tick
# 对每个受监督任务**至多一步**；**不创建任何每任务常驻线程/循环**（无 while、
# 无后台 `&` 派生；与 shadow_tick/state_sync_all 同构，daemon 唯一主循环调用）。
# ── P2-13 恢复动作（recovery.type ∈ task v2 字段；缺省 none=重跑 action）──
#   restart   Restart Action：停既有进程（TERM→超时 KILL）→ 重跑 action；
#   stopstart Stop + Start：优雅停（TERM）→ 重跑 action；
#   start     Start Action：直接重跑 action（默认/无类型）；
#   script    Execute Script：运行 recovery.script（绝对路径、存在可读）——
#             脚本负责恢复（如重启 Node/Python/Rust 服务）；rc 0=成功。
# ── 策略（禁止无限重启）──
#   retry.max（=max_retry）：每恢复 episode 重试次数上限；**非负整数钳制 +
#     硬上限 100**（非法/负值 → 0，>100 → 100）——重启次数必然有限；
#   retry.interval（=retry_interval）：尝试节奏（秒，recovery.next）；
#   retry.cooldown：基础 cooldown——episode 耗尽（FAILED）后写
#     recovery.cooldown_until（epoch 秒），到期前 supervisor 跳过该任务
#     （禁止失败风暴热循环；FAILED 为终态，须人工 rearm 或到期后新 episode）。
# 运行目录监督工件：recovery.count / recovery.next / recovery.cooldown_until。
# 事件：state_log_event event=supervisor 驱动迁移；UNKNOWN → 不迁移。
# ═══════════════════════════════════════════════════════════════════════════
supervisor_log() {
    [ "${SUPERVISOR_LOG:-1}" = "1" ] && echo "[supervisor] $1" >&2
}

supervisor_health_spec() {   # <task_file> → echo health spec（process:<t>/port:<t>；无配置 → 空）
    tf=$1
    htype=$(grep '^health.type=' "$tf" | head -1 | cut -d= -f2-)
    htarget=$(grep '^health.target=' "$tf" | head -1 | cut -d= -f2-)
    case "$htype" in
        process|port)
            [ -n "$htarget" ] && echo "$htype:$htarget"
            ;;
    esac
}

# P2-13：置 retry_max / retry_interval / retry_cooldown（全部非负整数钳制；
# retry.max 硬上限 100——禁止无限重启；非法/负值 → 缺省 0/60/0）。
supervisor_policy() {   # <task_file>
    tf=$1
    retry_max=$(grep '^retry.max=' "$tf" | head -1 | cut -d= -f2-)
    retry_interval=$(grep '^retry.interval=' "$tf" | head -1 | cut -d= -f2-)
    retry_cooldown=$(grep '^retry.cooldown=' "$tf" | head -1 | cut -d= -f2-)
    case "$retry_max" in
        ''|*[!0-9]*) retry_max=0 ;;
    esac
    [ "$retry_max" -gt 100 ] && retry_max=100   # 硬上限：重启次数必然有限
    case "$retry_interval" in
        ''|*[!0-9]*) retry_interval=60 ;;
    esac
    case "$retry_cooldown" in
        ''|*[!0-9]*) retry_cooldown=0 ;;
    esac
}

supervisor_task_file() {   # <base> <tasks_dir> <id> → 注册表任务文件（旧运行 ID 经 idmap 解析）
    base=$1; tasks=$2; qid=$3
    f=$(registry_task_file "$qid" 2>/dev/null) && { echo "$f"; return 0; }
    runtime_map_refresh "$base" "$tasks" >/dev/null 2>&1
    canon=$(runtime_map_run_task "$base" "$qid")
    [ -n "$canon" ] || return 1
    f=$(registry_task_file "$canon" 2>/dev/null) || return 1
    echo "$f"
    return 0
}

# P2-13：停既有任务进程（pid.txt；TERM → 有界等待 → force=1 时 KILL）。有界
# 等待循环（非常驻；单次恢复内至多 ~3s）。无 pid/已死 → 0。
supervisor_stop_task() {   # <run_dir> [force]
    rd=$1; force=${2:-0}
    pid=$(cat "$rd/pid.txt" 2>/dev/null)
    [ -n "$pid" ] && [ -d "/proc/$pid" ] 2>/dev/null || return 0
    kill "$pid" 2>/dev/null
    i=0
    while [ "$i" -lt 5 ] && [ -d "/proc/$pid" ] 2>/dev/null; do
        sleep 0.3
        i=$((i + 1))
    done
    if [ "$force" -eq 1 ] && [ -d "/proc/$pid" ] 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null
    fi
    return 0
}

# P2-13：执行恢复动作（recovery.type）→ 0=成功（已重跑/脚本 rc0） 1=失败
supervisor_recover() {   # <run_dir> <task_file>
    rd=$1; tf=$2
    rtype=$(grep '^recovery.type=' "$tf" | head -1 | cut -d= -f2-)
    act=$(grep '^action.command=' "$tf" | head -1 | cut -d= -f2-)
    id=$(basename "$rd")
    case "$rtype" in
        restart)
            # Restart Action：停既有（TERM→KILL）→ 重跑 action
            supervisor_stop_task "$rd" 1
            [ -n "$act" ] || return 1
            action_run "$id" "$act" >/dev/null 2>&1 ;;
        stopstart)
            # Stop + Start：优雅停（TERM）→ 重跑 action
            supervisor_stop_task "$rd" 0
            [ -n "$act" ] || return 1
            action_run "$id" "$act" >/dev/null 2>&1 ;;
        start|""|none)
            # Start Action（默认/无类型）：直接重跑 action
            [ -n "$act" ] || return 1
            action_run "$id" "$act" >/dev/null 2>&1 ;;
        script)
            # Execute Script：recovery.script 绝对路径 + 存在可读；rc 0=成功
            spath=$(grep '^recovery.script=' "$tf" | head -1 | cut -d= -f2-)
            case "$spath" in
                /*) [ -f "$spath" ] && [ -r "$spath" ] || return 1 ;;
                *) return 1 ;;
            esac
            sh "$spath" >/dev/null 2>&1 ;;
        *) return 1 ;;
    esac
}

# 单任务单步（每 tick 至多一步；无循环、无后台派生）：
# <run_dir> <task_file> → 0=无动作/保持 1=发生迁移 2=FAILED（策略超限）3=无健康配置/目录缺失
supervisor_step() {
    rd=$1; tf=$2
    [ -d "$rd" ] || return 3
    # 基础 cooldown：cooldown_until 未到 → 不监督（失败风暴热循环禁止）
    cdu=$(cat "$rd/recovery.cooldown_until" 2>/dev/null)
    if [ -n "$cdu" ] && [ "$(date +%s)" -lt "$cdu" ]; then
        return 0
    fi
    spec=$(supervisor_health_spec "$tf")
    [ -n "$spec" ] || return 3
    id=$(basename "$rd")
    cur=$(runtime_current_state "$rd")
    kind=${spec%%:*}
    target=${spec#*:}
    case "$cur" in
        RUNNING)
            # 首检通过 → HEALTHY（TSM: RUNNING>HEALTHY）；失败/UNKNOWN → 保持 RUNNING
            if health_check "$kind" "$target" >/dev/null 2>&1; then
                state_log_event "$rd" "$id" supervisor HEALTHY "" "" "probe ok" >/dev/null 2>&1 && return 1
            fi
            return 0 ;;
        HEALTHY)
            st=$(health_check "$kind" "$target" 2>/dev/null | cut -d'|' -f1)
            if [ "$st" = "UNHEALTHY" ]; then
                state_log_event "$rd" "$id" supervisor UNHEALTHY "" "" "probe unhealthy" >/dev/null 2>&1 && return 1
            fi
            return 0 ;;
        UNHEALTHY)
            state_log_event "$rd" "$id" supervisor RECOVERING "" "" "recovery started" >/dev/null 2>&1 && return 1
            return 0 ;;
        RECOVERING)
            supervisor_policy "$tf"
            # 节奏：retry.interval 秒内不重试（recovery.next = epoch 秒）
            now=$(date +%s)
            nxt=$(cat "$rd/recovery.next" 2>/dev/null)
            if [ -n "$nxt" ] && [ "$now" -lt "$nxt" ]; then
                return 0
            fi
            cnt=$(cat "$rd/recovery.count" 2>/dev/null)
            [ -n "$cnt" ] || cnt=0
            if [ "$cnt" -ge "$retry_max" ]; then
                # 策略超限 → FAILED + 基础 cooldown（禁止无限重启/失败风暴热循环）
                state_log_event "$rd" "$id" supervisor FAILED "" "" "retry-exhausted (max=$retry_max)" >/dev/null 2>&1
                echo $((now + retry_cooldown)) > "$rd/recovery.cooldown_until"
                return 2
            fi
            act=$(grep '^action.command=' "$tf" | head -1 | cut -d= -f2-)
            if [ -z "$act" ] && [ "$(grep '^recovery.type=' "$tf" | head -1 | cut -d= -f2-)" != "script" ]; then
                state_log_event "$rd" "$id" supervisor FAILED "" "" "no-action-for-recovery" >/dev/null 2>&1
                echo $((now + retry_cooldown)) > "$rd/recovery.cooldown_until"
                return 2
            fi
            cnt=$((cnt + 1))
            echo "$cnt" > "$rd/recovery.count"
            echo $((now + retry_interval)) > "$rd/recovery.next"
            rm -f "$rd/exit_code.txt" 2>/dev/null
            # 恢复尝试（state 仍为 RECOVERING——action_run spawn 锚点从 RECOVERING
            # 写 RUNNING 会被 TSM 拒绝，属预期、零副作用）。尝试成功 → 显式两段
            # 合法迁移 RECOVERING→STARTING→RUNNING；**尝试失败 → 保持 RECOVERING**
            # （按 retry.max 重试，节奏 recovery.next；次数耗尽在 tick 起始判）。
            if supervisor_recover "$rd" "$tf" >/dev/null 2>&1; then
                state_log_event "$rd" "$id" supervisor STARTING "" "" "recovery attempt $cnt ok ($(grep '^recovery.type=' "$tf" | head -1 | cut -d= -f2-))" >/dev/null 2>&1
                state_log_event "$rd" "$id" supervisor RUNNING "" "" "recovered" >/dev/null 2>&1
                rm -f "$rd/recovery.count" "$rd/recovery.next" "$rd/recovery.cooldown_until" 2>/dev/null
                return 1
            fi
            return 0 ;;
    esac
    return 0
}

# 统一事件循环（唯一入口）：<tasks_dir> <base> → 每 tick 每任务至多一步；0=完成
supervisor_tick() {
    tasks=$1; base=$2
    [ -d "$tasks" ] || { supervisor_log "INFO tick: no tasks dir $tasks"; return 0; }
    n=0; f=0
    for rd in "$tasks"/*; do
        [ -d "$rd" ] || continue
        id=$(basename "$rd")
        tf=$(supervisor_task_file "$base" "$tasks" "$id") || continue
        supervisor_step "$rd" "$tf" >/dev/null 2>&1
        rc=$?
        if [ "$rc" -eq 1 ] || [ "$rc" -eq 2 ]; then
            n=$((n + 1))
        fi
        [ "$rc" -eq 2 ] && f=$((f + 1))
    done
    supervisor_log "INFO tick: transitions=$n failed=$f"
    return 0
}
# ───────────────────────────────────────────────────────────────────────────
runtime_lib_selfcheck() {
    [ -n "${RUNTIME_LIB_VERSION:-}" ] || return 1
    for fn in task_state_transition legacy_adapter_parse provider_dispatch \
              runtime_log_event registry_init lifecycle_start task_cli_list \
              shadow_tick runtime_map_lookup trigger_decide action_run \
              state_log_event state_health_allowed state_sync_all \
              state_rehydrate_residual registry_attach task_cli_attach \
              task_cli_resolve_id task_cli_status_id runtime_scan_stale \
              lifecycle_startup_registry lifecycle_startup_recover \
              tpr_action_app_validate tpr_action_app_start health_check \
              tpr_health_process_check tpr_health_port_check supervisor_step \
              supervisor_tick supervisor_health_spec supervisor_recover \
              supervisor_stop_task; do
        type "$fn" >/dev/null 2>&1 || { echo "runtime-lib selfcheck: missing $fn" >&2; return 1; }
    done
    return 0
}