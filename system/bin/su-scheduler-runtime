#!/system/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# su-scheduler-runtime — 生产 Runtime 库（P2-02）
# ═══════════════════════════════════════════════════════════════════════════
# 性质：daemon（su-schedulerd）与 CLI（su-scheduler）**共用同一套**生产运行时
#      原语的可加载 Shell 库。内容 = P1-01..P1-11 已验证原语的生产化整理：
#        §1 State Machine  （P1-03）    task_state_* / TSM_*
#        §2 Legacy Adapter （P1-05）    legacy_adapter_parse（内部助手 rt_* 前缀）
#        §3 Provider 契约  （P1-04/07/08） provider_* / TPR_* + 静态 Provider
#        §4 Runtime 状态/事件（P1-09）  runtime_*
#        §5 Canonical Registry（P1-06） registry_*
#        §6 Lifecycle      （P1-10）    lifecycle_*
#        §7 Task 只读 CLI  （P1-11）    task_cli_*
#      依赖顺序：§1→§2→§3→§4→§5→§6→§7（本文件内已按序排列；单文件自包含，
#      不 source 任何外部文件——与测试域 P1 库**路径隔离**：测试库不改动，本库
#      零引用测试域路径（路径隔离门禁由 P2-02 回归套件断言，记录见 docs/P2-02.md）。
#      §21-§24 为 P3 系列（IPC/WebUI/Editor/Control）；§25 为 P3-08 安全与资源加固。
# ═══════════════════════════════════════════════════════════════════════════
# 约束（C3）：纯 POSIX sh + Android 系统命令（echo/printf/sed/grep/awk/cut/
#  sort/ls/date/mkdir/rm/mv/cat/mkfifo/kill/sleep/nohup/chmod/md5sum/type），
#  无外部运行时。**不启用 set -u**（不改变宿主脚本的 nounset 状态）。
# ═══════════════════════════════════════════════════════════════════════════
# 命名空间：除 P1 契约名外，adapter 内部解析助手统一 `rt_` 前缀，避免覆盖
#  daemon/CLI 既有同名 legacy 函数（parse_modifiers / extract_command 等——
#  C2 保护：daemon 解析路径必须保持逐字节原样）。
# ═══════════════════════════════════════════════════════════════════════════
# 加载失败 fallback（daemon/CLI 加载契约，见两者头部加载块）：
#   库缺失 / 不可读 / 语法破损 / selfcheck 不通过 → RUNTIME_LOADED=0；
#   调用方**legacy 路径原样继续**（本库是叠加层，不修改既有行为路径）；
#   daemon 启动时记录一次 WARNING；CLI 不输出加载噪音。
# ═══════════════════════════════════════════════════════════════════════════

RUNTIME_LIB_VERSION="1.28.0"

# ────────────────────────────────────────────────────────────────────────
# §1 State Machine（P1-03 验证原语 → P2-02 生产化）
# ────────────────────────────────────────────────────────────────────────
# 11 个规范状态 / 触发原因令牌 / 允许转换（单一事实源；与
# docs/architecture/task-state-machine-transitions.tsv 镜像）。
TSM_STATES='DISABLED PENDING WAITING STARTING RUNNING HEALTHY UNHEALTHY RECOVERING FAILED STOPPING STOPPED'
TSM_CAUSES='config_load time_trigger manual_exec action_success action_failure timeout daemon_restart stop_request rearm enable disable supervisor spawn probe'
TSM_ALLOWED='DISABLED>PENDING PENDING>DISABLED PENDING>STARTING PENDING>WAITING WAITING>PENDING WAITING>STARTING WAITING>FAILED WAITING>DISABLED STARTING>RUNNING STARTING>WAITING STARTING>FAILED STARTING>STOPPING RUNNING>STOPPED RUNNING>FAILED RUNNING>STOPPING RUNNING>HEALTHY HEALTHY>UNHEALTHY HEALTHY>STOPPED HEALTHY>FAILED HEALTHY>STOPPING UNHEALTHY>RUNNING UNHEALTHY>RECOVERING UNHEALTHY>STOPPED UNHEALTHY>FAILED UNHEALTHY>STOPPING RECOVERING>STARTING RECOVERING>FAILED RECOVERING>STOPPING STOPPING>STOPPED STOPPING>FAILED FAILED>PENDING FAILED>WAITING FAILED>DISABLED STOPPED>PENDING STOPPED>DISABLED'

task_state_log() {
    [ "${TSM_LOG:-1}" = "1" ] && echo "[WARNING] $1" >&2
}

task_state_is_valid() {
    case " $TSM_STATES " in
        *" $1 "*) return 0 ;;
        *) return 1 ;;
    esac
}

task_state_cause_is_valid() {
    case " $TSM_CAUSES " in
        *" $1 "*) return 0 ;;
        *) return 1 ;;
    esac
}

task_state_transition() {
    from=$1
    to=$2
    cause=${3:-}
    if ! task_state_is_valid "$from" || ! task_state_is_valid "$to"; then
        task_state_log "state-machine: unknown state in transition '$from'->'$to'"
        return 1
    fi
    case " $TSM_ALLOWED " in
        *" $from>$to "*)
            if [ -n "$cause" ] && ! task_state_cause_is_valid "$cause"; then
                task_state_log "state-machine: unknown cause '$cause' for allowed edge '$from'->'$to'"
                return 2
            fi
            return 0
            ;;
        *)
            task_state_log "state-machine: ILLEGAL transition '$from'->'$to' rejected${cause:+ (cause=$cause)}"
            return 1
            ;;
    esac
}

task_state_rehydrate() {
    case "$1" in
        STARTING|RUNNING|HEALTHY|UNHEALTHY|RECOVERING|STOPPING) echo FAILED ;;
        *) echo "$1" ;;
    esac
}

task_state_from_legacy() {
    case "$1" in
        RUNNING|running)   echo RUNNING ;;
        SUCCESS|success)   echo STOPPED ;;
        FAILED|failed|ZOMBIE_CRASHED|zombie) echo FAILED ;;
        invalid|disabled)  echo DISABLED ;;
        idle)              echo PENDING ;;
        *)                 echo "$1" ;;
    esac
}

# ────────────────────────────────────────────────────────────────────────
# §2 Legacy Config Adapter（P1-05 验证原语 → P2-02 生产化）
# ────────────────────────────────────────────────────────────────────────
# config.txt → 内部 Task v2；legacy 全部语义保持（P1-01 基线）。返回码：
#   0=全行成功 / 1=行级错误（合法行仍产出，错误行不产出）/ 2=文件级错误。
# 内部助手以 rt_ 前缀命名（见库头命名空间说明），不覆盖 daemon/CLI 同名函数。
rt_clean() { echo "$1" | tr -d '\r' | sed 's/^[ \t]*//;s/[ \t]*$//'; }
rt_norm()  { echo "$1" | sed 's/://g'; }
rt_first_word() { echo "$1" | awk '{print $1}'; }
rt_esc() {
    printf '%s' "$1" | awk '{ gsub(/\\/, "\\\\"); if (NR>1) printf "\\n"; printf "%s", $0 }'
}
rt_parse_modifiers() {
    line=$1
    notify_start=0; notify_end=0; delete_after=0; interactive=0
    use_termux=0; run_once_now=0; custom_msg=""
    mods=$(echo "$line" | sed -n 's/.* : //p')
    if [ -n "$mods" ]; then
        echo "$mods" | grep -q -- '--run-once-now' && run_once_now=1
        echo "$mods" | grep -q -- '--notify-start' && notify_start=1
        echo "$mods" | grep -q -- '--notify-end' && notify_end=1
        if echo "$mods" | grep -q -- '--notify' && ! echo "$mods" | grep -E -q -- '--notify-(start|end)'; then
            notify_start=1
            notify_end=1
        fi
        echo "$mods" | grep -q -- '--delete' && delete_after=1
        echo "$mods" | grep -q -- '--interactive' && interactive=1
        echo "$mods" | grep -q -- '--termux' && use_termux=1
        if echo "$mods" | grep -q -- '--msg='; then
            custom_msg=$(echo "$mods" | sed -n 's/.*--msg="\([^"]*\)".*/\1/p')
        fi
    fi
}
# 单空格分隔（确定性：首 token 之后；无第二个 token → 空，镜像 P1-02）
rt_extract_command() {
    line=$1
    raw_cmd=$(printf '%s' "$line" | awk '{ rest=$0; if (sub(/^[^ ]+[ ]/, "", rest)) print rest; else print "" }')
    echo "$raw_cmd" | sed 's/[ \t]*;*[ \t]*:[ \t]*--.*//'
}
legacy_adapter_task_id() {   # <line> <trigger> → echo id
    echo "t${1}_$(rt_norm "$2")"
}
_rt_emit_task() {
    id=$1; trigger=$2; action=$3; stype=$4; sline=$5; sraw=$6; subject=$7
    boot_flag=0
    echo "$subject" | grep -q -- '--boot' && boot_flag=1
    name=$(rt_first_word "$action")
    [ -n "$name" ] || name="task"
    name=$(printf '%s' "$name" | cut -c1-40)
    f="$out/$id.task"
    t="$f.tmp"
    tmp="$t"
    {
        echo "schema_version=2"
        echo "id=$id"
        echo "name=$(rt_esc "$name")"
        echo "enabled=1"
        echo "trigger=$(rt_esc "$trigger")"
        echo "condition="
        echo "action.command=$(rt_esc "$action")"
        echo "action.notify_start=$notify_start"
        echo "action.notify_end=$notify_end"
        echo "action.delete=$delete_after"
        echo "action.termux=$use_termux"
        echo "action.interactive=$interactive"
        echo "action.run_once_now=$run_once_now"
        echo "action.boot=$boot_flag"
        echo "action.msg=$(rt_esc "$custom_msg")"
        echo "dependency="
        echo "health.type=none"
        echo "recovery.type=none"
        echo "retry.max=0"
        echo "retry.interval=60"
        echo "source.type=$stype"
        echo "source.line=$sline"
        echo "source.raw=$(rt_esc "$sraw")"
        echo "runtime.state=PENDING"
        echo "runtime.run_count=0"
        echo "runtime.last_status="
        echo "runtime.last_exit="
        echo "runtime.last_start="
        echo "runtime.last_end="
        echo "runtime.pid="
    } > "$t"
    mv "$t" "$f"
    tmp=""
    echo "task=$id file=$f"
}
legacy_adapter_parse() {
    config=$1
    out=${2:-}
    rc=0

    if [ ! -f "$config" ]; then
        echo "[legacy-adapter] ERROR: config file not found: $config" >&2
        return 2
    fi
    if [ -z "$out" ]; then
        echo "[legacy-adapter] ERROR: out_dir required" >&2
        return 2
    fi
    if ! mkdir -p "$out"; then
        echo "[legacy-adapter] ERROR: cannot create out_dir: $out" >&2
        return 2
    fi

    tmp=""
    trap 'rm -f "$tmp"' INT TERM HUP

    lineno=0
    while IFS= read -r line || [ -n "$line" ]; do
        lineno=$((lineno + 1))
        cl=$(rt_clean "$line")
        case "$cl" in
            \#*|"") continue ;;
        esac

        trigger=$(echo "$cl" | awk '{print $1}')

        if printf '%s' "$trigger" | grep -q '[[:cntrl:]]'; then
            echo "[legacy-adapter] ERROR $config:${lineno}: trigger contains control character: '$trigger'" >&2
            rc=1
            continue
        fi

        if echo "$cl" | grep -q '<<EOF'; then
            cmd_start=$(echo "$cl" | sed 's/^[^ ]* //' | sed 's/ *<<EOF.*//')
            multiline_cmd=""
            block_raw="$cl"
            j=0
            found_eof=0
            while IFS= read -r block_line; do
                if echo "$block_line" | grep -q '^EOF'; then
                    found_eof=1
                    break
                fi
                j=$((j + 1))
                multiline_cmd="${multiline_cmd}${block_line}\n"
                block_raw="$block_raw
${block_line}"
            done
            mods=$(echo "$cl" | sed -n 's/.*\(: --[^;]*\).*/\1/p')
            reconstructed="$trigger $cmd_start '$multiline_cmd'; : $mods"
            if [ "$found_eof" -eq 1 ]; then
                end=$((lineno + j + 1))
            else
                end=$((lineno + j))
            fi

            rt_parse_modifiers "$reconstructed"
            action=$(rt_extract_command "$reconstructed")
            id=$(legacy_adapter_task_id "$lineno" "$trigger")
            _rt_emit_task "$id" "$trigger" "$action" "block" "${lineno}-${end}" "$block_raw" "$reconstructed"

            if [ "$found_eof" -eq 1 ]; then
                lineno=$((lineno + j + 1))
            else
                lineno=$((lineno + j))
            fi
            continue
        fi

        rt_parse_modifiers "$cl"
        action=$(rt_extract_command "$cl")
        id=$(legacy_adapter_task_id "$lineno" "$trigger")
        _rt_emit_task "$id" "$trigger" "$action" "line" "$lineno" "$line" "$cl"
    done < "$config"

    trap - INT TERM HUP
    return "$rc"
}

# ────────────────────────────────────────────────────────────────────────
# §3 Provider 契约 + 静态 Provider（P1-04/07/08 验证原语 → P2-02 生产化）
# ────────────────────────────────────────────────────────────────────────
# kind: trigger | action | health | recovery；name 同 kind 内唯一；
# prefix: 能力函数统一前缀；provider_dispatch 是引擎唯一依赖入口。
TPR_KINDS='trigger action health recovery'
TPR_CAPS_ALL='validate parse matches next_due prepare start stop status restart check recover'
TPR_CAPS_TRIGGER='validate parse matches next_due'
TPR_CAPS_ACTION='validate prepare start stop status restart'
TPR_CAPS_HEALTH='validate check'
TPR_CAPS_RECOVERY='validate recover'
TPR_CAPS_REQUIRED='trigger>validate trigger>parse trigger>matches action>validate action>prepare action>start health>validate health>check recovery>validate recovery>recover'
TPR_REGISTRY=''

provider_log() {
    [ "${TPR_LOG:-1}" = "1" ] && echo "[provider] $1" >&2
}

provider_kind_is_valid() {
    case " $TPR_KINDS " in
        *" $1 "*) return 0 ;;
        *) return 1 ;;
    esac
}

provider_cap_is_valid() {
    case " $TPR_CAPS_ALL " in
        *" $1 "*) return 0 ;;
        *) return 1 ;;
    esac
}

provider_cap_is_of_kind() {
    cap=$1
    case "$2" in
        trigger)  case " $TPR_CAPS_TRIGGER " in *" $cap "*) return 0 ;; *) return 1 ;; esac ;;
        action)   case " $TPR_CAPS_ACTION " in *" $cap "*) return 0 ;; *) return 1 ;; esac ;;
        health)   case " $TPR_CAPS_HEALTH " in *" $cap "*) return 0 ;; *) return 1 ;; esac ;;
        recovery) case " $TPR_CAPS_RECOVERY " in *" $cap "*) return 0 ;; *) return 1 ;; esac ;;
        *) return 1 ;;
    esac
}

provider_register() {
    kind=$1; name=$2; prefix=$3
    provider_kind_is_valid "$kind" || { provider_log "register: unknown kind '$kind'"; return 1; }
    case " $TPR_REGISTRY " in
        *" $kind>$name>"*) provider_log "register: duplicate '$kind>$name'"; return 1 ;;
    esac
    TPR_REGISTRY="$TPR_REGISTRY $kind>$name>$prefix"
    return 0
}

provider_lookup() {
    kind=$1; name=${2:-}
    for entry in $TPR_REGISTRY; do
        f1=${entry%%>*}
        rest=${entry#*>}
        f2=${rest%%>*}
        pre=${rest#*>}
        if [ "$f1" = "$kind" ] && { [ -z "$name" ] || [ "$f2" = "$name" ]; }; then
            echo "$pre"
            return 0
        fi
    done
    return 1
}

provider_dispatch() {
    kind=$1; name=$2; cap=$3
    shift 3
    provider_kind_is_valid "$kind" || { provider_log "dispatch: unknown kind '$kind'"; return 1; }
    provider_cap_is_valid "$cap" || { provider_log "dispatch: unknown capability '$cap'"; return 2; }
    provider_cap_is_of_kind "$cap" "$kind" || { provider_log "dispatch: capability '$cap' not in kind '$kind'"; return 2; }
    prefix=$(provider_lookup "$kind" "$name") || {
        provider_log "dispatch: no $kind provider named '$name' registered"
        return 1
    }
    fn="${prefix}_${cap}"
    type "$fn" >/dev/null 2>&1 || { provider_log "dispatch: provider '$prefix' lacks capability '$cap'"; return 2; }
    "$fn" "$@"
}

provider_dispatch_default() {
    kind=$1; cap=$2
    shift 2
    provider_kind_is_valid "$kind" || { provider_log "dispatch_default: unknown kind '$kind'"; return 1; }
    provider_cap_is_valid "$cap" || { provider_log "dispatch_default: unknown capability '$cap'"; return 2; }
    provider_cap_is_of_kind "$cap" "$kind" || { provider_log "dispatch_default: capability '$cap' not in kind '$kind'"; return 2; }
    prefix=$(provider_lookup "$kind") || {
        provider_log "dispatch_default: no $kind provider registered"
        return 1
    }
    fn="${prefix}_${cap}"
    type "$fn" >/dev/null 2>&1 || { provider_log "dispatch_default: provider '$prefix' lacks capability '$cap'"; return 2; }
    "$fn" "$@"
}

# ── 上下文助手 ────────────────────────────────────────────────────────────
tpr_ctx_now()  { echo "${TRIGGER_DECISION_NOW:-$(date +%H%M)}"; }
tpr_ctx_date() { # $1 = strftime 格式；TRIGGER_TODAY=YYYYMMDD 时用 -d 镜像（测试确定性）
    if [ -n "${TRIGGER_TODAY:-}" ]; then date -d "$TRIGGER_TODAY" "+$1"; else date "+$1"; fi
}
tpr_ctx_state_file() { echo "${TRIGGER_STATE_FILE:-/data/adb/su-scheduler/schedule_state.txt}"; }
tpr_ctx_line_md5() {
    printf '%s\n' "${TRIGGER_DECISION_LINE:-}" | md5sum | cut -d' ' -f1
}

# ── TriggerProvider: boot ─────────────────────────────────────────────────
tpr_trigger_boot_validate() {
    [ "$1" = "boot" ] && return 0 || return 1
}
tpr_trigger_boot_parse() { echo "kind=boot"; }
tpr_trigger_boot_matches() {
    [ "${TRIGGER_BOOT_CONTEXT:-0}" = "1" ] && return 0 || return 1
}
tpr_trigger_boot_next_due() {
    if [ "${TRIGGER_BOOT_CONTEXT:-0}" = "1" ]; then echo 0; return 0; fi
    return 1
}

# ── TriggerProvider: time（分钟级）────────────────────────────────────────
tpr_trigger_time_norm() { echo "$1" | sed 's/://g'; }
tpr_trigger_time_validate() {
    case "$(tpr_trigger_time_norm "$1")" in
        [0-9][0-9][0-9][0-9]) return 0 ;;
        *) return 1 ;;
    esac
}
tpr_trigger_time_parse() {
    echo "kind=time;time=$(tpr_trigger_time_norm "$1")"
}
tpr_trigger_time_matches() {
    [ -n "$1" ] || return 1
    [ "$(tpr_trigger_time_norm "$1")" = "$(tpr_ctx_now)" ] && return 0 || return 1
}
tpr_trigger_time_next_due() {
    norm=$(tpr_trigger_time_norm "$1")
    case "$norm" in
        [0-9][0-9][0-9][0-9]) ;;
        *) return 1 ;;
    esac
    th=$(echo "$norm" | cut -c1-2); tm=$(echo "$norm" | cut -c3-4)
    th=$(echo "$th" | sed 's/^0*//'); tm=$(echo "$tm" | sed 's/^0*//')
    [ -z "$th" ] && th=0; [ -z "$tm" ] && tm=0
    nh=$(date +%H | sed 's/^0*//'); nm=$(date +%M | sed 's/^0*//')
    [ -z "$nh" ] && nh=0; [ -z "$nm" ] && nm=0
    target=$((th * 60 + tm)); now=$((nh * 60 + nm))
    if [ "$target" -gt "$now" ]; then
        echo $(((target - now) * 60))
    elif [ "$target" -eq "$now" ]; then
        echo 0
    else
        echo $(((1440 - now + target) * 60))
    fi
    return 0
}

# ── TriggerProvider: advanced（镜像 should_run_advanced_schedule，只判断）───
tpr_trigger_advanced_validate() {
    case "$1" in
        weekly:*|nweekly:*|monthly:*|nmonthly:*|yearly:*) return 0 ;;
        *) return 1 ;;
    esac
}
tpr_trigger_advanced_parse() {
    case "$1" in
        weekly:*)  echo "kind=advanced;family=weekly" ;;
        nweekly:*) echo "kind=advanced;family=nweekly" ;;
        monthly:*) echo "kind=advanced;family=monthly" ;;
        nmonthly:*) echo "kind=advanced;family=nmonthly" ;;
        yearly:*)  echo "kind=advanced;family=yearly" ;;
    esac
}
_tpr_adv_read() {  # $1=行；返回 0 若状态文件含该行（去重判定，只读）
    sf=$(tpr_ctx_state_file)
    [ -f "$sf" ] && grep -qF "$1" "$sf"
}
tpr_trigger_advanced_matches() {
    trigger=$1
    now=$(tpr_ctx_now)
    hash=$(tpr_ctx_line_md5)
    yy=$(tpr_ctx_date %Y); mm=$(tpr_ctx_date %m); dd=$(tpr_ctx_date %d)
    dow=$(tpr_ctx_date %u); wk=$(tpr_ctx_date %V)
    mmdd="${mm}${dd}"; yymm="${yy}${mm}"; yymmdd="${yy}${mm}${dd}"

    case "$trigger" in
        weekly:*)
            tdow=$(echo "$trigger" | cut -d: -f2); ttime=$(echo "$trigger" | cut -d: -f3)
            if [ "$dow" = "$tdow" ] && [ "$now" -ge "$ttime" ] \
               && ! _tpr_adv_read "weekly_${tdow}_${ttime}_${hash}_${yymmdd}"; then
                return 0
            fi ;;
        nweekly:*)
            n=$(echo "$trigger" | cut -d: -f2); tdow=$(echo "$trigger" | cut -d: -f3)
            ttime=$(echo "$trigger" | cut -d: -f4)
            key="nweekly_${n}_${tdow}_${ttime}_${hash}"
            last=$(grep "^${key}=" "$(tpr_ctx_state_file)" 2>/dev/null | cut -d= -f2)
            # P2-05 修复：host bash 将 08/09 视为非法八进制 → 剥前导零后算术（POSIX；daemon mksh 等价）
            wkz=$(echo "$wk" | sed -n 's/^0*\([0-9][0-9]*\)$/\1/p'); [ -z "$wkz" ] && wkz=0
            lastz=$(echo "$last" | sed -n 's/^0*\([0-9][0-9]*\)$/\1/p'); [ -z "$lastz" ] && lastz=0
            if [ "$dow" = "$tdow" ] && [ "$now" -ge "$ttime" ] && {
                [ -z "$last" ] || [ $(((wkz - lastz + 53) % 53)) -ge "$n" ]; }; then
                return 0
            fi ;;
        monthly:*)
            tdd=$(echo "$trigger" | cut -d: -f2); ttime=$(echo "$trigger" | cut -d: -f3)
            if [ "$dd" = "$tdd" ] && [ "$now" -ge "$ttime" ] \
               && ! _tpr_adv_read "monthly_${tdd}_${ttime}_${hash}_${yymm}"; then
                return 0
            fi ;;
        nmonthly:*)
            n=$(echo "$trigger" | cut -d: -f2); tdd=$(echo "$trigger" | cut -d: -f3)
            ttime=$(echo "$trigger" | cut -d: -f4)
            key="nmonthly_${n}_${tdd}_${ttime}_${hash}"
            last=$(grep "^${key}=" "$(tpr_ctx_state_file)" 2>/dev/null | cut -d= -f2)
            # P2-05 修复：host bash 将 08/09 视为非法八进制 → 剥前导零后算术（POSIX；daemon mksh 等价）
            yyz=$(echo "$yy" | sed -n 's/^0*\([0-9][0-9]*\)$/\1/p'); [ -z "$yyz" ] && yyz=0
            mmz=$(echo "$mm" | sed -n 's/^0*\([0-9][0-9]*\)$/\1/p'); [ -z "$mmz" ] && mmz=0
            lastz=$(echo "$last" | sed -n 's/^0*\([0-9][0-9]*\)$/\1/p'); [ -z "$lastz" ] && lastz=0
            lt=$((yyz * 12 + lastz)); tt=$((yyz * 12 + mmz))
            [ "$lt" -gt "$tt" ] && lt=$(((yyz - 1) * 12 + lastz))
            if [ "$dd" = "$tdd" ] && [ "$now" -ge "$ttime" ] && {
                [ -z "$last" ] || [ $((tt - lt)) -ge "$n" ]; }; then
                return 0
            fi ;;
        yearly:*)
            tdate=$(echo "$trigger" | cut -d: -f2); ttime=$(echo "$trigger" | cut -d: -f3)
            if [ "$mmdd" = "$tdate" ] && [ "$now" -ge "$ttime" ] \
               && ! _tpr_adv_read "yearly_${tdate}_${ttime}_${hash}_${yy}"; then
                return 0
            fi ;;
        *) return 1 ;;
    esac
    return 1
}
tpr_trigger_advanced_next_due() {
    if tpr_trigger_advanced_matches "$1"; then echo 0; return 0; fi
    return 1
}

# ── ActionProvider: command（P1-08 全模式，镜像 execute_task）──────────────
tpr_action_command_dir() { echo "${TPR_ACTION_DIR:-/tmp/su-scheduler-actions}/$1"; }
tpr_action_command_validate() { [ -n "$1" ] && return 0 || return 1; }
tpr_action_command_prepare() {
    dir=$(tpr_action_command_dir "$1")
    mkdir -p "$dir"
    echo "$2" > "$dir/command.txt"
    date "+%Y-%m-%d %H:%M:%S" > "$dir/start_time.txt"
    echo "RUNNING" > "$dir/status.txt"
    echo "$dir"
}
tpr_action_command_start() {  # <id> <cmd> [termux] [interactive] [notify_start] [notify_end] [custom_msg]
    id=$1; cmd=$2; termux=${3:-0}; interactive=${4:-0}
    notify_start=${5:-0}; notify_end=${6:-0}; custom_msg=${7:-}
    if type execute_task >/dev/null 2>&1; then
        # P2-06（委托既有执行器，不建立第二套命令执行器）：daemon 上下文——
        # 7 参原样传递 execute_task；旧工件 status.txt/pid.txt/output.log/
        # exit_code.txt/command.txt/start_time.txt/end_time.txt/exec_mode.txt
        # 由 execute_task 原样产出（C2：零改动、零降级）。
        execute_task "$id" "$cmd" "$notify_start" "$notify_end" "$custom_msg" \
            "$interactive" "$termux" < /dev/null
        return $?
    fi
    dir=$(tpr_action_command_dir "$id")
    (
        if [ "$interactive" = "1" ]; then
            tpr_action_exec_interactive "$id" "$dir" "$cmd"
        elif [ "$termux" = "1" ]; then
            tpr_action_exec_termux "$dir" "$cmd"
        else
            tpr_action_exec_smart "$dir" "$cmd"
        fi
    ) &
    echo $!
}
tpr_action_command_status() {
    pid=$2
    [ -n "$pid" ] && [ -d "/proc/$pid" ] && return 0 || return 1
}
tpr_action_command_stop() { kill "$2" 2>/dev/null; }
tpr_action_command_restart() {
    tpr_action_command_stop "$1" "$3"
    sleep 1
    tpr_action_command_start "$1" "$2" "${4:-0}" "${5:-0}"
}

tpr_action_exec_finalize() {
    dir=$1; rc=$2
    echo "$rc" > "$dir/exit_code.txt"
    date "+%Y-%m-%d %H:%M:%S" > "$dir/end_time.txt"
    if [ "$rc" -eq 0 ]; then
        echo "SUCCESS" > "$dir/status.txt"
    else
        echo "FAILED" > "$dir/status.txt"
    fi
}
tpr_action_exec_smart() {
    dir=$1; cmd=$2
    first_arg=$(echo "$cmd" | awk '{print $1}')
    if [ -f "$first_arg" ]; then
        [ ! -x "$first_arg" ] && chmod +x "$first_arg" 2>/dev/null
        sh -c "$cmd" > "$dir/output.log" 2>&1
        rc=$?
        if [ "$rc" -ne 0 ] && { [ "$rc" -eq 126 ] || [ "$rc" -eq 127 ]; }; then
            if command -v bash >/dev/null 2>&1; then
                bash "$first_arg" $(echo "$cmd" | cut -d' ' -f2-) > "$dir/output.log" 2>&1
                rc=$?
            fi
            if [ "$rc" -ne 0 ]; then
                sh "$first_arg" $(echo "$cmd" | cut -d' ' -f2-) > "$dir/output.log" 2>&1
                rc=$?
            fi
        fi
    else
        sh -c "$cmd" > "$dir/output.log" 2>&1
        rc=$?
    fi
    tpr_action_exec_finalize "$dir" "$rc"
}

tpr_action_termux_helper() { echo "${TPR_TERMUX_HELPER:-/system/bin/su-scheduler-termux}"; }
tpr_action_exec_termux() {
    dir=$1; cmd=$2
    helper=$(tpr_action_termux_helper)
    if [ ! -x "$helper" ]; then
        echo "ERROR: Termux helper missing" > "$dir/output.log"
        rc=1
    else
        ts=$($helper status 2>/dev/null)
        if [ "$ts" = "READY" ]; then
            $helper exec "$cmd" > "$dir/output.log" 2>&1
            rc=$?
        elif [ "$ts" = "LOCKED" ]; then
            echo "ERROR: User 0 locked" > "$dir/output.log"
            rc=1
        else
            echo "ERROR: Termux not installed" > "$dir/output.log"
            rc=1
        fi
    fi
    tpr_action_exec_finalize "$dir" "$rc"
}
tpr_action_exec_interactive() {
    id=$1; dir=$2; cmd=$3
    in="$dir/task.in"; out="$dir/task.out"
    mkfifo "$in" 2>/dev/null || true
    sh -i < "$in" > "$out" 2>&1 &
    pid=$!
    echo "$cmd" > "$in"
    wait $pid
    rc=$?
    echo "$rc" > "$dir/exit_code.txt"
}

# ── HealthProvider / RecoveryProvider: builtin（接口 + 空实现 stub）────────
tpr_health_builtin_validate() {
    case "$1" in
        ""|none) return 0 ;;
        *) return 1 ;;
    esac
}
tpr_health_builtin_check() { echo "ok"; return 0; }

tpr_recovery_builtin_validate() {
    case "$1" in
        ""|none) return 0 ;;
        *) return 1 ;;
    esac
}
tpr_recovery_builtin_recover() { echo "none"; return 0; }

# ── 静态注册（加载即注册；重复注册被拒）───────────────────────────────────
provider_register trigger boot     tpr_trigger_boot
provider_register trigger time     tpr_trigger_time
provider_register trigger advanced tpr_trigger_advanced
provider_register action command   tpr_action_command
provider_register action app       tpr_action_app
provider_register health builtin   tpr_health_builtin
provider_register health process   tpr_health_process
provider_register health port      tpr_health_port
provider_register recovery builtin tpr_recovery_builtin

# ────────────────────────────────────────────────────────────────────────
# §4 Runtime State & Event Log（P1-09 验证原语 → P2-02 生产化）
# ────────────────────────────────────────────────────────────────────────
# 新状态源 <dir>/state.txt + 事件日志 <dir>/events.log（7 字段）；旧兼容文件
# （status.txt/pid.txt/...）**只读不写**；日志失败不中止任务（仅返回非 0）。
# P4-04：新增 WAITING 门控事件令牌（gate_wait=进入 WAITING / gate_ok=门控解除→
# STARTING / gate_fail=门控超时/终态失败）。它们不属于 TSM_CAUSES（语义 cause 仍为
# time_trigger / action_failure，见 task-state-machine.md）；state_log_event 对
# WAITING 边不校验 cause（边本身在 TSM_ALLOWED），故写入校验通过、事件令牌可审计。
RT_EVENTS='create delete config_load time_trigger manual_exec spawn action_success action_failure timeout stop_request daemon_restart rearm enable disable supervisor probe recover gate_wait gate_ok gate_fail'

runtime_log() {
    [ "${RT_LOG:-1}" = "1" ] && echo "[runtime] $1" >&2
}

runtime_state_file()  { echo "$1/state.txt"; }
runtime_events_file() { echo "$1/events.log"; }

runtime_current_state() {
    dir=$1
    sf=$(runtime_state_file "$dir")
    if [ -f "$sf" ] && [ -s "$sf" ]; then
        cat "$sf"
        return 0
    fi
    if [ -f "$dir/status.txt" ]; then
        task_state_from_legacy "$(cat "$dir/status.txt")"
        return 0
    fi
    echo PENDING
}

runtime_log_event() {
    dir=$1; task_id=$2; event=$3; state=$4; pid=${5:-}; exit_code=${6:-}; message=${7:-}
    [ -n "$dir" ] || { runtime_log "ERROR log_event: dir required"; return 1; }
    task_state_is_valid "$state" || {
        runtime_log "WARNING log_event: illegal state '$state' rejected (task=$task_id)"
        return 1
    }
    case " $RT_EVENTS " in
        *" $event "*) ;;
        *) runtime_log "WARNING log_event: unknown event '$event' rejected (task=$task_id)"; return 1 ;;
    esac
    [ -d "$dir" ] || mkdir -p "$dir" || { runtime_log "ERROR log_event: cannot mkdir $dir"; return 2; }

    ts=$(date "+%Y-%m-%d %H:%M:%S")
    msg=$(printf '%s' "$message" | sed 's/|/;/g')
    line="$ts|$task_id|$event|$state|$pid|$exit_code|$msg"

    if ( printf '%s\n' "$line" >> "$(runtime_events_file "$dir")" ) 2>/dev/null; then
        :
    else
        runtime_log "ERROR log_event: append failed for $task_id (event=$event) — task continues"
        return 2
    fi
    sf=$(runtime_state_file "$dir")
    tmp="$sf.tmp"
    if ( printf '%s\n' "$state" > "$tmp" && mv -f "$tmp" "$sf" ) 2>/dev/null; then
        :
    else
        rm -f "$tmp" 2>/dev/null
        runtime_log "ERROR log_event: state write failed for $task_id (state=$state) — task continues"
        return 2
    fi
    return 0
}

runtime_scan_stale() {
    root=$1
    [ -d "$root" ] || { runtime_log "ERROR scan_stale: no tasks dir $root"; return 2; }
    found=0
    for p in "$root"/*; do
        [ -d "$p" ] || continue
        [ -f "$p/pid.txt" ] || continue
        id=$(basename "$p")
        pid=$(cat "$p/pid.txt" 2>/dev/null)
        cur=$(runtime_current_state "$p")
        case "$cur" in
            STARTING|RUNNING|HEALTHY|UNHEALTHY|RECOVERING|STOPPING) ;;
            *) continue ;;
        esac
        if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
            continue
        fi
        newstate=$(task_state_rehydrate "$cur")
        runtime_log_event "$p" "$id" daemon_restart "$newstate" "$pid" "" \
            "stale running record detected at startup (legacy status.txt untouched)"
        echo "$id"
        found=$((found + 1))
    done
    return 0
}

# ────────────────────────────────────────────────────────────────────────
# §5 Canonical Task Registry（P1-06 验证原语 → P2-02 生产化）
# ────────────────────────────────────────────────────────────────────────
# 完整快照 <base>/snapshots/snap_<N>/（确定性序号）+ `current` 指针原子切换；
# 无效配置 → KEPT 保留最后有效快照；防重复注册（id==文件名且唯一）。
# 返回码：0=已提交生效 / 1=解析失败回退（KEPT）/ 2=硬错误（无 config/无 adapter）。
TR_LOGGING=1
registry_log() {
    [ "${TR_LOGGING:-1}" = "1" ] && echo "[task-registry] $1" >&2
}

registry_init() {
    TR_BASE=${1:-}
    TR_CONFIG_PATH=${2:-}
    [ -n "$TR_BASE" ] || { registry_log "ERROR init: base_dir required"; return 2; }
    [ -n "$TR_CONFIG_PATH" ] || { registry_log "ERROR init: config required"; return 2; }
    mkdir -p "$TR_BASE/snapshots" || { registry_log "ERROR init: cannot mkdir $TR_BASE/snapshots"; return 2; }
    if [ -f "$TR_CONFIG_PATH" ]; then
        registry_reload "$TR_CONFIG_PATH"
    else
        registry_log "ERROR init: config not found: $TR_CONFIG_PATH (no fallback on first load)"
        TASK_REGISTRY_SNAPSHOT=""
        return 1
    fi
}

# P2-08：只读挂载既有快照（CLI task 子命令数据源——**不重新解析 config**：
# 仅设 TR_BASE 并读取 current 指针；不调用 adapter/parse/reload）。
registry_attach() {
    TR_BASE=${1:-}
    [ -n "$TR_BASE" ] || { registry_log "ERROR attach: base_dir required"; return 2; }
    TR_CONFIG_PATH=""
    TASK_REGISTRY_SNAPSHOT=$(registry_current_snapshot_id)
    [ -n "$TASK_REGISTRY_SNAPSHOT" ] && return 0 || return 1
}

registry_snapshot_next() {
    next=1
    for d in "$TR_BASE"/snapshots/snap_*; do
        [ -d "$d" ] || continue
        n=${d##*snap_}
        case "$n" in ''|*[!0-9]*) continue ;; esac
        [ "$n" -ge "$next" ] && next=$((n + 1))
    done
    echo "snap_$next"
}

registry_current_snapshot_id() {
    [ -f "$TR_BASE/current" ] && cat "$TR_BASE/current" || echo ""
}

registry_snapshot_dir() {
    id=$(registry_current_snapshot_id)
    [ -n "$id" ] && echo "$TR_BASE/snapshots/$id"
}

registry_has_task() {
    d=$(registry_snapshot_dir)
    [ -n "$d" ] && [ -f "$d/$1.task" ]
}

registry_task_file() {
    d=$(registry_snapshot_dir)
    if [ -n "$d" ] && [ -f "$d/$1.task" ]; then
        echo "$d/$1.task"
        return 0
    fi
    return 1
}

registry_task_ids() {
    d=$(registry_snapshot_dir)
    [ -n "$d" ] && ls "$d" 2>/dev/null | grep '\.task$' | sed 's/\.task$//' | sort
}

registry_manifest() {
    d=$(registry_snapshot_dir)
    [ -n "$d" ] && cat "$d/manifest" 2>/dev/null
}

_registry_snap_valid() {
    sdir=$1
    seen=""
    count=0
    for f in "$sdir"/*.task; do
        [ -f "$f" ] || continue
        count=$((count + 1))
        id=$(basename "$f" .task)
        iid=$(grep '^id=' "$f" | head -1 | cut -d= -f2)
        [ "$id" = "$iid" ] || {
            registry_log "ERROR snapshot $sdir: id field '$iid' != filename '$id'"
            return 1
        }
        case " $seen " in
            *" $id "*) registry_log "ERROR snapshot $sdir: duplicate task id '$id'"; return 1 ;;
        esac
        seen="$seen $id"
    done
    TASK_REGISTRY_COUNT=$count
    return 0
}

registry_reload() {
    config=${1:-$TR_CONFIG_PATH}
    [ -n "$config" ] || { registry_log "ERROR reload: no config (init first)"; echo "HARD"; return 2; }
    [ -f "$config" ] || {
        registry_log "ERROR reload: config not found: $config (fallback: keeping current snapshot)"
        echo "KEPT"
        return 1
    }
    command -v legacy_adapter_parse >/dev/null 2>&1 || {
        registry_log "ERROR reload: legacy_adapter_parse not sourced (adapter section missing)"
        echo "HARD"
        return 2
    }

    sid=$(registry_snapshot_next)
    sdir="$TR_BASE/snapshots/$sid"
    mkdir -p "$sdir" || { registry_log "ERROR reload: cannot mkdir $sdir"; echo "HARD"; return 2; }

    stdout=$(legacy_adapter_parse "$config" "$sdir")
    arc=$?
    tcount=$(ls "$sdir" 2>/dev/null | grep -c '\.task$')

    valid=0
    if [ "$arc" -eq 0 ]; then
        valid=1
    elif [ "$arc" -eq 1 ] && [ "$tcount" -ge 1 ]; then
        valid=1
    fi

    if [ "$valid" -eq 1 ]; then
        if _registry_snap_valid "$sdir"; then
            {
                echo "snapshot=$sid"
                echo "config=$config"
                echo "parse_rc=$arc"
                echo "task_count=$TASK_REGISTRY_COUNT"
            } > "$sdir/manifest.tmp" && mv "$sdir/manifest.tmp" "$sdir/manifest"
            echo "$sid" > "$TR_BASE/current.tmp" && mv "$TR_BASE/current.tmp" "$TR_BASE/current"
            TASK_REGISTRY_SNAPSHOT=$sid
            echo "$sid"
            return 0
        fi
        registry_log "ERROR reload: snapshot $sid invalid (dup/mismatch); fallback"
        rm -rf "$sdir"
        TASK_REGISTRY_SNAPSHOT=$(registry_current_snapshot_id)
        return 1
    fi

    registry_log "ERROR reload: parse rc=$arc tasks=$tcount -> invalid; keeping last valid snapshot"
    rm -rf "$sdir"
    TASK_REGISTRY_SNAPSHOT=$(registry_current_snapshot_id)
    echo "KEPT"
    return 1
}

# ────────────────────────────────────────────────────────────────────────
# §6 Lifecycle（P1-10 验证原语 → P2-02 生产化）
# ────────────────────────────────────────────────────────────────────────
# 单实例锁 / stale 恢复 / 僵尸清理 / 启动初始化 / 停止 / 重启 / 看护单轮
# （fail-safe：初始化失败回滚锁，不留半初始化状态）。
lifecycle_log() {
    [ "${LIFECYCLE_LOG:-1}" = "1" ] && echo "[lifecycle] $1" >&2
}

lifecycle_ensure_dirs() {
    base=$1
    [ -n "$base" ] || { lifecycle_log "ERROR ensure_dirs: base required"; return 1; }
    for d in "$base" "$base/tasks" "$base/audit"; do
        if ! mkdir -p "$d" 2>/dev/null; then
            lifecycle_log "ERROR ensure_dirs: cannot mkdir $d"
            return 1
        fi
        if ! chmod 755 "$d" 2>/dev/null; then
            lifecycle_log "ERROR ensure_dirs: cannot chmod $d"
            return 1
        fi
    done
    return 0
}

lifecycle_lock_pid() { [ -f "$1" ] && cat "$1" 2>/dev/null; }

lifecycle_lock_alive() {
    pid=$(lifecycle_lock_pid "$1")
    [ -n "$pid" ] && [ -d "/proc/$pid" ] && return 0
    return 1
}

lifecycle_lock_acquire() {
    lock=$1
    if lifecycle_lock_alive "$lock"; then
        lifecycle_log "WARNING lock_acquire: daemon already alive (pid=$(lifecycle_lock_pid "$lock")) — rejected"
        return 1
    fi
    if [ -f "$lock" ]; then
        lifecycle_log "INFO lock_acquire: stale lock removed (pid=$(cat "$lock" 2>/dev/null))"
        rm -f "$lock" 2>/dev/null || { lifecycle_log "ERROR lock_acquire: cannot rm stale lock"; return 2; }
    fi
    if ! echo "$$" > "$lock" 2>/dev/null; then
        lifecycle_log "ERROR lock_acquire: cannot write $lock"
        return 2
    fi
    return 0
}

lifecycle_lock_force_reclaim() {
    lock=$1
    wait_s=${LIFECYCLE_LOCK_WAIT:-5}
    i=0
    while [ "$i" -lt "$wait_s" ]; do
        lifecycle_lock_alive "$lock" || break
        sleep 1
        i=$((i + 1))
    done
    if [ -f "$lock" ]; then
        lifecycle_log "INFO lock_force: reclaiming lock (old pid=$(cat "$lock" 2>/dev/null))"
        rm -f "$lock" 2>/dev/null || { lifecycle_log "ERROR lock_force: cannot rm lock"; return 2; }
    fi
    if ! echo "$$" > "$lock" 2>/dev/null; then
        lifecycle_log "ERROR lock_force: cannot write $lock"
        return 2
    fi
    return 0
}

lifecycle_lock_release() {
    rm -f "$1" 2>/dev/null
    return 0
}

lifecycle_cleanup_zombies() {
    tasks_dir=$1
    [ -d "$tasks_dir" ] || { lifecycle_log "INFO cleanup: no tasks dir $tasks_dir"; echo 0; return 0; }
    n=0
    for p in "$tasks_dir"/*; do
        [ -d "$p" ] || continue
        cur=$(runtime_current_state "$p")
        case "$cur" in
            STARTING|RUNNING|HEALTHY|UNHEALTHY|RECOVERING|STOPPING) ;;
            *) continue ;;
        esac
        id=$(basename "$p")
        old_state=$(cat "$p/status.txt" 2>/dev/null)
        pid_rec=$(cat "$p/pid.txt" 2>/dev/null)
        case "$old_state" in
            *RUNNING*) echo "ZOMBIE_CRASHED" > "$p/status.txt" 2>/dev/null ;;
        esac
        newstate=$(task_state_rehydrate "$cur")
        runtime_log_event "$p" "$id" daemon_restart "$newstate" "$pid_rec" "" \
            "zombie cleanup at startup (legacy status.txt -> ZOMBIE_CRASHED)" >/dev/null 2>&1
        lifecycle_log "INFO cleanup: recovered zombie task $id ($cur -> $newstate)"
        n=$((n + 1))
    done
    echo "$n"
    return 0
}

lifecycle_start() {
    base=$1; config=$2; lock=$3
    [ -n "$base" ] && [ -n "$config" ] && [ -n "$lock" ] || {
        lifecycle_log "ERROR start: base/config/lock required"
        return 2
    }
    lifecycle_ensure_dirs "$base" || return 2
    lifecycle_lock_acquire "$lock" || return 1
    lifecycle_cleanup_zombies "$base/tasks" >/dev/null 2>&1
    registry_init "$base" "$config" >/dev/null 2>&1
    if [ -n "$(registry_current_snapshot_id 2>/dev/null)" ]; then
        lifecycle_log "INFO start: ready (base=$base snapshot=$(registry_current_snapshot_id 2>/dev/null))"
        return 0
    fi
    lifecycle_log "ERROR start: registry init failed for $config (no valid snapshot fallback)"
    lifecycle_lock_release "$lock"
    return 2
}

lifecycle_stop() {
    lock=$1
    pid=$(lifecycle_lock_pid "$lock")
    if [ -n "$pid" ] && [ -d "/proc/$pid" ] 2>/dev/null; then
        kill "$pid" 2>/dev/null
        i=0
        while [ "$i" -lt 5 ]; do
            [ -d "/proc/$pid" ] 2>/dev/null || break
            sleep 1
            i=$((i + 1))
        done
    fi
    lifecycle_lock_release "$lock"
    return 0
}

lifecycle_restart() {
    lock=$1; base=$2; config=$3; daemon_cmd=${4:-}
    lifecycle_stop "$lock"
    sleep 1
    if [ -n "$daemon_cmd" ]; then
        nohup $daemon_cmd >/dev/null 2>&1 &
        lifecycle_log "INFO restart: launched '$daemon_cmd' (new daemon re-locks itself)"
        return 0
    fi
    lifecycle_log "ERROR restart: no daemon_cmd given"
    return 2
}

lifecycle_watchdog_tick() {
    lock=$1; daemon_cmd=${2:-}
    if lifecycle_lock_alive "$lock"; then
        return 0
    fi
    lifecycle_log "WARNING watchdog_tick: daemon not running — cleaning stale lock and (re)starting"
    rm -f "$lock" 2>/dev/null
    if [ -n "$daemon_cmd" ]; then
        nohup $daemon_cmd >/dev/null 2>&1 &
        lifecycle_log "INFO watchdog_tick: launched '$daemon_cmd'"
    else
        lifecycle_log "INFO watchdog_tick: no daemon_cmd given — handover to caller"
    fi
    return 1
}

# ────────────────────────────────────────────────────────────────────────
# §7 Task 只读 CLI（P1-11 验证原语 → P2-02 生产化）
# ────────────────────────────────────────────────────────────────────────
# 只读：task_cli_list / task_cli_status。数据源 = registry 快照（不重新解析
# config.txt）；状态 = runtime_current_state（新 state.txt → 旧 status.txt
# 推导 → 快照 runtime.state 回退）；错误三态 rc 1/2/3。
task_cli_log() {
    [ "${TASK_CLI_LOG:-1}" = "1" ] && echo "[task-cli] $1" >&2
}

task_cli_config_valid() {
    [ -n "$(registry_current_snapshot_id 2>/dev/null)" ] && return 0
    return 1
}

task_cli_task_exists() {
    registry_task_file "$1" >/dev/null 2>&1
}

task_cli_state_for() {
    id=$1; tf=$2
    if [ -n "${TASK_CLI_TASKS_DIR:-}" ] && [ -d "$TASK_CLI_TASKS_DIR/$id" ]; then
        runtime_current_state "$TASK_CLI_TASKS_DIR/$id"
        return 0
    fi
    grep '^runtime.state=' "$tf" | head -1 | cut -d= -f2-
}

task_cli_daemon_running() {
    [ -n "${TASK_CLI_LOCK:-}" ] || return 1
    lifecycle_lock_alive "$TASK_CLI_LOCK"
}

task_cli_list() {
    task_cli_config_valid || {
        echo "ERROR: configuration invalid (no valid task snapshot)" >&2
        return 2
    }
    for id in $(registry_task_ids); do
        f=$(registry_task_file "$id") || continue
        name=$(grep '^name=' "$f" | head -1 | cut -d= -f2-)
        trigger=$(grep '^trigger=' "$f" | head -1 | cut -d= -f2)
        action=$(grep '^action.command=' "$f" | head -1 | cut -d= -f2-)
        enabled=$(grep '^enabled=' "$f" | head -1 | cut -d= -f2)
        state=$(task_cli_state_for "$id" "$f")
        echo "$id|$name|$trigger|$action|$enabled|$state"
    done
    return 0
}

task_cli_status() {
    id=$1
    [ -n "$id" ] || { echo "ERROR: usage: task status <id>" >&2; return 1; }
    task_cli_config_valid || {
        echo "ERROR: configuration invalid (no valid task snapshot)" >&2
        return 2
    }
    f=$(registry_task_file "$id") || {
        echo "ERROR: task not found: $id" >&2
        return 1
    }
    if [ -n "${TASK_CLI_LOCK:-}" ] && ! task_cli_daemon_running; then
        echo "ERROR: daemon is not running — cannot report live task state (disk state may be stale)" >&2
        return 3
    fi

    rdir="${TASK_CLI_TASKS_DIR:-}/$id"
    echo "id=$id"
    echo "name=$(grep '^name=' "$f" | head -1 | cut -d= -f2-)"
    echo "enabled=$(grep '^enabled=' "$f" | head -1 | cut -d= -f2)"
    echo "trigger=$(grep '^trigger=' "$f" | head -1 | cut -d= -f2)"
    echo "dependency=$(grep '^dependency=' "$f" | head -1 | cut -d= -f2-)"
    echo "condition=$(grep '^condition=' "$f" | head -1 | cut -d= -f2-)"
    echo "action=$(grep '^action.command=' "$f" | head -1 | cut -d= -f2-)"
    echo "source.type=$(grep '^source.type=' "$f" | head -1 | cut -d= -f2)"
    echo "source.line=$(grep '^source.line=' "$f" | head -1 | cut -d= -f2)"
    echo "source.raw=$(grep '^source.raw=' "$f" | head -1 | cut -d= -f2-)"
    echo "state=$(task_cli_state_for "$id" "$f")"
    if [ -d "$rdir" ] && [ -f "$rdir/status.txt" ]; then
        echo "legacy_status=$(cat "$rdir/status.txt" 2>/dev/null)"
    else
        echo "legacy_status="
    fi
    echo "run_count=$(grep '^runtime.run_count=' "$f" | head -1 | cut -d= -f2)"
    echo "last_status=$(grep '^runtime.last_status=' "$f" | head -1 | cut -d= -f2-)"
    echo "last_exit=$(grep '^runtime.last_exit=' "$f" | head -1 | cut -d= -f2-)"
    echo "last_start=$(grep '^runtime.last_start=' "$f" | head -1 | cut -d= -f2-)"
    echo "last_end=$(grep '^runtime.last_end=' "$f" | head -1 | cut -d= -f2-)"
    if [ -n "${TASK_CLI_LOCK:-}" ]; then
        if task_cli_daemon_running; then echo "daemon=running"; else echo "daemon=stopped"; fi
    fi
    if [ -d "$rdir" ] && [ -f "$rdir/events.log" ]; then
        echo "last_event=$(tail -1 "$rdir/events.log" 2>/dev/null)"
    else
        echo "last_event="
    fi
    # P4-09：门控状态行（WAITING + 原因；缺省空）
    obs_g=$(obs_gate_state "${TASK_CLI_TASKS_DIR:-}" "$id")
    if [ -n "$obs_g" ]; then
        echo "Gate: $obs_g"
    fi
    return 0
}

# ────────────────────────────────────────────────────────────────────────
# §8 Registry Shadow Mode（P2-03，旁路比对）
# ────────────────────────────────────────────────────────────────────────
# **不改 legacy 执行路径**（C2）：本层只镜像旧扫描、不消耗 daemon 扫描结果、
# 不触发任何执行/修剪——仅建 Registry 快照并比对记录。
#   - shadow_init  <base> <config> [log]  —— daemon 启动：建首快照 + 基线比对；
#   - shadow_tick  <base> <config> [log]  —— 每轮：config md5 变化 → 原子
#     registry_reload（损坏配置 → KEPT 保留最后有效快照）；legacy 镜像扫描 ↔
#     registry 触发器集比对；记录 shadow.log + shadow.last（原子 tmp+mv）。
#   - legacy 镜像扫描与 daemon 主循环同法（修边/跳注释空行/heredoc 块计 1）。
# 记录（shadow.log 追加，`|` 分隔）：op=<init|reload|compare>|agree=<Y|N>|
# legacy=<n>|registry=<m>|snap=<id>|cfg_md5=<12>；agree=N 时另记 diff 行。
# ═══════════════════════════════════════════════════════════════════════════
shadow_log() {
    [ "${SHADOW_LOG:-1}" = "1" ] && echo "$1" >> "${SHADOW_LOGFILE:-/dev/null}" 2>/dev/null
}
shadow_state_file() { echo "$1/shadow/shadow.last"; }

# legacy 镜像扫描：stdout 每个激活行一个**归一触发器**（heredoc 块计 1 并
# 消耗块体，与 daemon 主循环同法）。返回码 0=可扫 1=config 缺失。
shadow_scan_legacy() {
    config=$1
    [ -f "$config" ] || return 1
    while IFS= read -r line || [ -n "$line" ]; do
        cl=$(echo "$line" | tr -d '\r' | sed 's/^[ \t]*//;s/[ \t]*$//')
        case "$cl" in
            \#*|"") continue ;;
        esac
        if echo "$cl" | grep -q '<<EOF'; then
            echo "$(echo "$cl" | awk '{print $1}')" | sed 's/://g'
            while IFS= read -r lin || [ -n "$lin" ]; do
                echo "$lin" | grep -q '^EOF' && break
            done
            continue
        fi
        echo "$(echo "$cl" | awk '{print $1}')" | sed 's/://g'
    done < "$config"
    return 0
}

# registry 触发器集：当前快照每任务 trigger 字段（去冒号归一）。
shadow_scan_registry() {
    base=$1
    [ -d "$base/snapshots" ] || return 1
    for id in $(registry_task_ids); do
        f=$(registry_task_file "$id") || continue
        trig=$(grep '^trigger=' "$f" | head -1 | cut -d= -f2)
        echo "$trig" | sed 's/://g'
    done
    return 0
}

# 比对两清单：$1=legacy 清单文件 $2=registry 清单文件 → stdout 判定行 +
# 差异详情（各限 5）。comm 差集：legacy_only / registry_only。
shadow_compare() {
    leg=$1; reg=$2
    agree=Y
    ln=$(wc -l < "$leg" 2>/dev/null || echo 0)
    rn=$(wc -l < "$reg" 2>/dev/null || echo 0)
    [ "$ln" = "$rn" ] || agree=N
    sort "$leg" 2>/dev/null > "$leg.s"
    sort "$reg" 2>/dev/null > "$reg.s"
    lo=$(comm -23 "$leg.s" "$reg.s" 2>/dev/null | head -5 | tr '\n' ',')
    ro=$(comm -13 "$leg.s" "$reg.s" 2>/dev/null | head -5 | tr '\n' ',')
    [ -z "$lo$ro" ] || agree=N
    echo "agree=$agree"
    echo "legacy=$ln registry=$rn"
    [ -n "$lo" ] && echo "legacy_only=$lo"
    [ -n "$ro" ] && echo "registry_only=$ro"
    rm -f "$leg.s" "$reg.s"
}

# 单轮旁路比对核心：$1=base $2=config $3=log(缺省 base/shadow/shadow.log)
# 0=一致 1=不一致（含 config 缺失）2=状态目录不可建。
shadow_tick() {
    base=$1; config=$2
    SHADOW_LOGFILE=${3:-$base/shadow/shadow.log}
    [ -f "$config" ] || { shadow_log "$(date '+%Y-%m-%d %H:%M:%S')|SHADOW|op=compare|agree=N|legacy=0|registry=?|snap=|cfg_md5=|msg=config-missing"; return 1; }
    mkdir -p "$base/shadow" 2>/dev/null || return 2

    mdfile=$(shadow_state_file "$base")
    newmd5=$(md5sum "$config" | cut -d' ' -f1)
    oldmd5=$(grep '^last_md5=' "$mdfile" 2>/dev/null | cut -d= -f2)
    op="compare"
    changed=0
    if [ -n "$oldmd5" ] && [ "$oldmd5" = "$newmd5" ]; then
        :   # 未变化：沿用当前快照（不 reload）
    else
        # 配置变化 → 原子 reload（损坏/无效 → KEPT：快照与指针不动）
        registry_reload "$config" >/dev/null 2>&1; rrc=$?
        op="reload"
        changed=1
    fi
    snap=$(registry_current_snapshot_id)

    L="$base/shadow/leg.tmp"
    R="$base/shadow/reg.tmp"
    shadow_scan_legacy "$config" > "$L"
    shadow_scan_registry "$base" > "$R"
    out=$(shadow_compare "$L" "$R")
    agree=$(echo "$out" | sed -n 's/^agree=//p')
    ln=$(echo "$out" | sed -n 's/.*legacy=\([0-9]*\).*/\1/p')
    rn=$(echo "$out" | sed -n 's/.*registry=\([0-9]*\).*/\1/p')
    cm=$(echo "$newmd5" | cut -c1-12)

    {
        echo "last_md5=$newmd5"
        echo "last_snap=$snap"
        echo "last_agree=$agree"
        echo "last_legacy=$ln"
        echo "last_registry=$rn"
    } > "$mdfile.tmp" && mv "$mdfile.tmp" "$mdfile"

    shadow_log "$(date '+%Y-%m-%d %H:%M:%S')|SHADOW|op=$op|agree=$agree|legacy=$ln|registry=$rn|snap=$snap|cfg_md5=$cm|rrc=${rrc:-0}"
    if [ "$agree" = "N" ]; then
        shadow_log "$(date '+%Y-%m-%d %H:%M:%S')|SHADOW|diff|legacy_only=$(echo "$out" | sed -n 's/^legacy_only=//p')|registry_only=$(echo "$out" | sed -n 's/^registry_only=//p')"
    fi
    rm -f "$L" "$R" 2>/dev/null
    [ "$agree" = "Y" ] && return 0 || return 1
}

# daemon 启动旁路：建首快照 + 基线比对（op=init，不 reload）。
shadow_init() {
    base=$1; config=$2
    SHADOW_LOGFILE=${3:-$base/shadow/shadow.log}
    mkdir -p "$base/shadow" 2>/dev/null || return 2
    registry_init "$base" "$config" >/dev/null 2>&1
    snap=$(registry_current_snapshot_id)
    [ -n "$snap" ] || {
        shadow_log "$(date '+%Y-%m-%d %H:%M:%S')|SHADOW|op=init|agree=N|legacy=?|registry=0|snap=|cfg_md5=|msg=no-valid-snapshot"
        return 1
    }
    L="$base/shadow/leg.tmp"; R="$base/shadow/reg.tmp"
    shadow_scan_legacy "$config" > "$L"
    shadow_scan_registry "$base" > "$R"
    out=$(shadow_compare "$L" "$R")
    agree=$(echo "$out" | sed -n 's/^agree=//p')
    ln=$(echo "$out" | sed -n 's/.*legacy=\([0-9]*\).*/\1/p')
    rn=$(echo "$out" | sed -n 's/.*registry=\([0-9]*\).*/\1/p')
    cm=$(md5sum "$config" | cut -d' ' -f1 | cut -c1-12)
    {
        echo "last_md5=$(md5sum "$config" | cut -d' ' -f1)"
        echo "last_snap=$snap"
        echo "last_agree=$agree"
        echo "last_legacy=$ln"
        echo "last_registry=$rn"
    } > "$base/shadow/shadow.last.tmp" && mv "$base/shadow/shadow.last.tmp" "$base/shadow/shadow.last"
    shadow_log "$(date '+%Y-%m-%d %H:%M:%S')|SHADOW|op=init|agree=$agree|legacy=$ln|registry=$rn|snap=$snap|cfg_md5=$cm"
    if [ "$agree" = "N" ]; then
        shadow_log "$(date '+%Y-%m-%d %H:%M:%S')|SHADOW|diff|legacy_only=$(echo "$out" | sed -n 's/^legacy_only=//p')|registry_only=$(echo "$out" | sed -n 's/^registry_only=//p')"
    fi
    rm -f "$L" "$R" 2>/dev/null
    [ "$agree" = "Y" ] && return 0 || return 1
}

# §9 Canonical↔Legacy Run ID 映射（P2-04）
# ═══════════════════════════════════════════════════════════════════════════
# 目标：新版 Canonical Task ID（t<line>_<trigger>，registry 快照）与旧运行
# 目录 ID（time_<HHMM>_<n>_<epoch> / advanced_<n>_<epoch> / immediate_<n>_<epoch>
# / startup_<n>_<epoch>）之间建立**双向映射**；**不重命名旧运行目录、不改旧
# CLI 命令**（C2/C4：task-info/task-output/task-kill 继续按旧 ID 原路径操作，
# 映射层只读旁路）。匹配键：主=命令文本（command.txt == action.command）；
# 回退=触发器（startup→boot / time_<HHMM> / advanced→adv 家族 / immediate→
# 命令匹配）。映射文件：<base>/runtime/idmap，行 `task=<canonical>|run=<run_id>`，
# sort -u + tmp+mv 原子写（幂等：重复 refresh 无重复行）。
# ═══════════════════════════════════════════════════════════════════════════
runtime_idmap_file() { echo "$1/runtime/idmap"; }

runtime_map_refresh() {   # <base> <tasks_dir> → 0 成功 / 2 目录不可建
    base=$1; tasks=$2
    mkdir -p "$base/runtime" 2>/dev/null || return 2
    f=$(runtime_idmap_file "$base")
    : > "$f.tmp"
    if [ -d "$tasks" ]; then
        for p in "$tasks"/*; do
            [ -d "$p" ] || continue
            [ -f "$p/command.txt" ] || continue
            run=$(basename "$p")
            cmd=$(cat "$p/command.txt" 2>/dev/null)
            canon=""
            # 主键：命令文本匹配 registry task action.command
            for id in $(registry_task_ids); do
                tf=$(registry_task_file "$id") || continue
                ac=$(grep '^action.command=' "$tf" | head -1 | cut -d= -f2-)
                [ "$ac" = "$cmd" ] && canon=$id && break
            done
            # 回退键：触发器（run 前缀）
            if [ -z "$canon" ]; then
                case "$run" in
                    startup_*)
                        for id in $(registry_task_ids); do
                            tf=$(registry_task_file "$id") || continue
                            tr=$(grep '^trigger=' "$tf" | head -1 | cut -d= -f2)
                            [ "$tr" = "boot" ] && canon=$id && break
                        done ;;
                    time_*)
                        hhmm=$(echo "$run" | cut -d_ -f2)
                        for id in $(registry_task_ids); do
                            tf=$(registry_task_file "$id") || continue
                            tr=$(echo "$(grep '^trigger=' "$tf" | head -1 | cut -d= -f2)" | sed 's/://g')
                            [ "$tr" = "$hhmm" ] && canon=$id && break
                        done ;;
                    advanced_*)
                        for id in $(registry_task_ids); do
                            tf=$(registry_task_file "$id") || continue
                            tr=$(grep '^trigger=' "$tf" | head -1 | cut -d= -f2)
                            case "$tr" in
                                weekly:*|nweekly:*|monthly:*|nmonthly:*|yearly:*) canon=$id; break ;;
                            esac
                        done ;;
                esac
            fi
            [ -n "$canon" ] && echo "task=$canon|run=$run" >> "$f.tmp"
        done
    fi
    sort -u "$f.tmp" > "$f.tmp.s" && mv "$f.tmp.s" "$f"
    rm -f "$f.tmp" 2>/dev/null
    return 0
}

runtime_map_task_runs() {   # <base> <canonical_id> → 各旧 run id（每行一个）
    f=$(runtime_idmap_file "$1")
    [ -f "$f" ] || return 1
    grep "^task=$2|" "$f" | sed 's/^task=[^|]*|run=//'
}

runtime_map_run_task() {    # <base> <run_id> → canonical id（无则空）
    f=$(runtime_idmap_file "$1")
    [ -f "$f" ] || return 1
    grep "|run=$2$" "$f" | head -1 | cut -d= -f2 | cut -d'|' -f1
}

runtime_map_lookup() {      # <base> <tasks_dir> <id>：双向自动识别
    base=$1; tasks=$2; id=$3
    if [ -n "$(runtime_map_task_runs "$base" "$id")" ]; then
        echo "task=$id"
        runtime_map_task_runs "$base" "$id" | sed 's/^/run=/' 2>/dev/null
        return 0
    fi
    if [ -d "$tasks/$id" ]; then
        canon=$(runtime_map_run_task "$base" "$id")
        [ -n "$canon" ] && echo "task=$canon" || echo "task="
        echo "run=$id"
        return 0
    fi
    return 1
}

# ────────────────────────────────────────────────────────────────────────
# §10 Trigger Decision Layer（P2-05）
# ═══════════════════════════════════════════════════════════════════════════
# 正式入口（唯一）：trigger_decide —— 每个 registry Task 的 boot / time /
# advanced 判断一律经 `provider_dispatch trigger <family> matches`（P1-04 唯一
# 分发入口）。**旧判断保留为 fallback**（daemon 内联决策原样；C2）；本层只做
# 旁路决策 + 与新侧镜像的**一致性记录**（trigger.log）。
# 保留语义（C4）：
#   - heredoc：source.type=block 任务与单行同触发器语义（决策按 trigger 字段）；
#   - --run-once-now：action.run_once_now=1 → 首扫即 due（legacy “立即执行”语义；
#     修剪动作仍归执行层的既有权责，本层不修剪、不改配置）；
#   - --delete：action.delete 仅是执行层动作语义，本层决策不含删除、不改配置；
#   - 既有去重状态：advanced 家族只**读**状态文件（tpr_trigger_advanced_matches
#     内部既有键检查）；键的**写**仍归 legacy 执行路径（本层零写入）。
# 不引入：Dependency / Condition / 新 Trigger（仅 boot/time/advanced 三家族）。
# ═══════════════════════════════════════════════════════════════════════════
trigger_ctx_now()   { echo "${TRIGGER_DECISION_NOW:-$(date +%H%M)}"; }
trigger_ctx_boot()  { echo "${TRIGGER_BOOT_CONTEXT:-0}"; }
trigger_ctx_state() { echo "${TRIGGER_STATE_FILE:-/data/adb/su-scheduler/schedule_state.txt}"; }
trigger_ctx_today() { echo "${TRIGGER_TODAY:-$(date +%Y%m%d)}"; }

# advanced 去重键的**写**（仅执行层使用；P2-05 本层不调用——保留由 legacy 路径
# should_run_advanced_schedule 写入既有格式键。此处仅供镜像比对构造只读键集合。）
trigger_adv_key() {   # <trigger> <clean_line> <state_file> [today] → echo key（镜像 daemon 键格式）
    trig=$1; line=$2; sf=${3:-$(trigger_ctx_state)}
    today=${4:-$(trigger_ctx_today)}
    yy=$(echo "$today" | cut -c1-4); mm=$(echo "$today" | cut -c5-6); dd=$(echo "$today" | cut -c7-8)
    dow=$(date -d "$today" +%u 2>/dev/null || date +%u)
    wk=$(date -d "$today" +%V 2>/dev/null || date +%V)
    hash=$(printf '%s\n' "$line" | md5sum | cut -d' ' -f1)
    case "$trig" in
        weekly:*)  t=$(echo "$trig" | cut -d: -f3); echo "weekly_$(echo "$trig" | cut -d: -f2)_${t}_${hash}_${yy}${mm}${dd}" ;;
        nweekly:*) n=$(echo "$trig" | cut -d: -f2); t=$(echo "$trig" | cut -d: -f4); echo "nweekly_${n}_$(echo "$trig" | cut -d: -f3)_${t}_${hash}=${wk}" ;;
        monthly:*) t=$(echo "$trig" | cut -d: -f3); echo "monthly_$(echo "$trig" | cut -d: -f2)_${t}_${hash}_${yy}${mm}" ;;
        nmonthly:*) n=$(echo "$trig" | cut -d: -f2); t=$(echo "$trig" | cut -d: -f4); echo "nmonthly_${n}_$(echo "$trig" | cut -d: -f3)_${t}_${hash}=${mm}" ;;
        yearly:*)  t=$(echo "$trig" | cut -d: -f3); echo "yearly_$(echo "$trig" | cut -d: -f2)_${t}_${hash}_${yy}" ;;
    esac
}

# ── 正式决策入口（唯一）：trigger_decide <base> <task_id> [now] [boot] [state_file]
# → stdout 单行：task=<id>|trigger=<trig>|due=<Y|N>|cause=<boot|time_trigger|
# advanced|manual_exec|>；返回 0=due / 1=not due / 2=硬错误。全部匹配经 provider
# dispatch（单入口）。heredoc/--delete/--run-once-now/去重保留见 §10 头注释。
trigger_decide() {
    base=$1; tid=$2
    now=${3:-$(trigger_ctx_now)}
    boot=${4:-$(trigger_ctx_boot)}
    sf=${5:-$(trigger_ctx_state)}
    tf=$(registry_task_file "$tid") || { echo "task=$tid|due=N|err=no-task"; return 2; }
    trig=$(grep '^trigger=' "$tf" | head -1 | cut -d= -f2)
    stype=$(grep '^source.type=' "$tf" | head -1 | cut -d= -f2)
    ron=$(grep '^action.run_once_now=' "$tf" | head -1 | cut -d= -f2)
    if [ "$ron" = "1" ]; then
        echo "task=$tid|trigger=$trig|due=Y|cause=manual_exec"
        return 0
    fi
    case "$trig" in
        boot)
            if TRIGGER_BOOT_CONTEXT=$boot provider_dispatch trigger boot matches >/dev/null 2>&1; then
                echo "task=$tid|trigger=$trig|due=Y|cause=boot"
                return 0
            fi
            echo "task=$tid|trigger=$trig|due=N|cause="
            return 1 ;;
        [0-9][0-9]:[0-9][0-9]|[0-9][0-9][0-9][0-9])
            if TRIGGER_DECISION_NOW=$now provider_dispatch trigger time matches "$trig" >/dev/null 2>&1; then
                echo "task=$tid|trigger=$trig|due=Y|cause=time_trigger"
                return 0
            fi
            echo "task=$tid|trigger=$trig|due=N|cause="
            return 1 ;;
        weekly:*|nweekly:*|monthly:*|nmonthly:*|yearly:*)
            RAW=$(grep '^source.raw=' "$tf" | head -1 | cut -d= -f2-)
            CLEAN=$(rt_clean "$RAW")
            if TRIGGER_DECISION_NOW=$now TRIGGER_STATE_FILE=$sf \
               TRIGGER_DECISION_LINE="$CLEAN" provider_dispatch trigger advanced matches "$trig" >/dev/null 2>&1; then
                echo "task=$tid|trigger=$trig|due=Y|cause=advanced"
                return 0
            fi
            echo "task=$tid|trigger=$trig|due=N|cause="
            return 1 ;;
        *)
            echo "task=$tid|trigger=$trig|due=N|err=unknown-trigger"
            return 2 ;;
    esac
}
# ────────────────────────────────────────────────────────────────────────
# §11 Action Execution Layer（P2-06）
# ═══════════════════════════════════════════════════════════════════════════
# 正式入口（唯一）：action_run —— 命令 / 脚本 / Termux / Interactive 四模式
# 一律经 `provider_dispatch action command <cap>`（P1-04 唯一分发入口）。
# **旧执行路径保留为 fallback**（C2）：RUNTIME_LOADED=0 时 daemon 直接调用
# legacy execute_task（原样）；RUNTIME_LOADED=1 时 daemon 调用本正式入口
# （接线见 su-schedulerd 四处执行点）。**Provider 内部委托既有 execute_task**
# （不建立第二套命令执行器）：本库运行于 daemon 上下文（`type execute_task`
# 命中——daemon 同 shell 注入）时，command Provider 的 start 能力以 7 参原样
# 委托 execute_task——旧工件 status.txt / pid.txt / output.log / exit_code.txt
# / command.txt / start_time.txt / end_time.txt / exec_mode.txt 由 execute_task
# 原样产出（零改动、零降级）。非 daemon 上下文（CLI/测试）使用 §3 既有镜像
# 执行器（P1-08 全模式，工件语义一致）——不引入新执行引擎。
# 保留语义：notify_start/notify_end/custom_msg 仅随委托透传；本层不发送通知
# （通知归 execute_task）；镜像路径不发送通知（与 P1-08/测试域一致）。
# stdout（至多一行）：id=<id>|mode=<system|termux|interactive>|pid=<pid>|dir=<dir>
# 返回：0=已启动 1=任务无效（缺 id/command）或分发失败（含碰撞跳过）2=硬错误。
# ═══════════════════════════════════════════════════════════════════════════
action_log() {
    [ "${ACTION_LOG:-1}" = "1" ] && echo "[action] $1" >&2
}

action_run() {   # <id> <cmd> [termux] [interactive] [notify_start] [notify_end] [custom_msg]
    id=$1; cmd=$2; termux=${3:-0}; interactive=${4:-0}
    notify_start=${5:-0}; notify_end=${6:-0}; custom_msg=${7:-}
    [ -n "$id" ] || { action_log "ERROR action_run: id required"; return 1; }
    [ -n "$cmd" ] || { action_log "ERROR action_run: no command (id=$id)"; return 1; }
    mode="system"
    [ "$termux" = "1" ] && mode="termux"
    [ "$interactive" = "1" ] && mode="interactive"
    # P2-10：结构化 App Action（app:op:target[:extras]）——参数全校验后经 app
    # Provider 启动（固定 am 模板 + 校验片段，绝不经 shell 拼接任意 Root Shell）；
    # 本分支先于 execute_task 委托：daemon 上下文中 app 任务也不得落入 shell 执行。
    if [ "${cmd#app:}" != "$cmd" ]; then
        run_dir=$(provider_dispatch action app prepare "$id" "$cmd") || {
            action_log "ERROR action_run: app prepare rejected (id=$id)"
            return 1
        }
        provider_dispatch action app start "$id" "$cmd" > "$run_dir/pid.txt" 2>/dev/null || return 1
        pid=$(cat "$run_dir/pid.txt" 2>/dev/null)
        state_log_event "$run_dir" "$id" spawn RUNNING "$pid" "" "app action via provider" >/dev/null 2>&1
        echo "id=$id|mode=app|pid=$pid|dir=$run_dir"
        return 0
    fi
    run_dir=""
    if type execute_task >/dev/null 2>&1; then
        # daemon 上下文：经 provider 分发；command Provider start 内部委托
        # 既有 execute_task（7 参原样 → 旧工件原样产出；C2/不建第二执行器）。
        provider_dispatch action command start "$id" "$cmd" "$termux" "$interactive" \
            "$notify_start" "$notify_end" "$custom_msg" >/dev/null 2>&1
        rc=$?
        [ "$rc" -eq 0 ] || { action_log "ERROR action_run: start rc=$rc (id=$id)"; return 1; }
        run_dir="${TASKS_DIR:-}/$id"
    else
        # 非 daemon 上下文（CLI/测试）：镜像路径（prepare → start，§3 全模式）。
        run_dir=$(provider_dispatch action command prepare "$id" "$cmd") || {
            action_log "ERROR action_run: prepare failed (id=$id)"
            return 1
        }
        provider_dispatch action command start "$id" "$cmd" "$termux" "$interactive" \
            > "$run_dir/pid.txt" 2>/dev/null || return 1
    fi
    pid=$(cat "$run_dir/pid.txt" 2>/dev/null)
    # P2-07：启动即双写新状态（state.txt=RUNNING + events.log spawn；旧工件由
    # execute_task/镜像执行器原样产出，本层只读旧、只写新——不碰 status.txt 等）。
    state_log_event "$run_dir" "$id" spawn RUNNING "$pid" "" "launched via unified action entry" >/dev/null 2>&1
    echo "id=$id|mode=$mode|pid=$pid|dir=$run_dir"
    return 0
}
# ────────────────────────────────────────────────────────────────────────
# §12 Unified State & Event Wiring（P2-07）
# ═══════════════════════════════════════════════════════════════════════════
# 生产事实源：新 `state.txt`（TSM v2 状态）+ `events.log`（7 字段事件行）成为
# 权威状态记录；旧兼容工件（status.txt / pid.txt / output.log / exit_code.txt）
# **只读、双写共存**（旧 CLI 按旧语义继续读取——P2-04/06 兼容边界）。本层叠在
# §4 runtime_log_event（P1-09 原语：先事件行、后 state.txt 原子 tmp+mv）之上，
# 增加三条生产策略：
#   1) 健康族门槛：**只有注册了非 builtin 的真实 Health Provider 才允许写
#      HEALTHY/UNHEALTHY**（`state_health_allowed`）——当前仅 builtin stub，
#      故 HEALTHY 一律被拒（一次性任务成功 → STOPPED，绝不虚假 HEALTHY）。
#   2) 状态机迁移校验：state.txt 已存在且目标不同时，按 TSM 允许边校验
#      （task_state_transition；事件 ∈ TSM_CAUSES 时作 cause）；非法迁移 →
#      WARNING + 拒绝写入（**非致命：不影响 daemon 主循环**）。
#   3) 幂等对账（state_sync_all / state_sync_one）：主循环每轮以 exit_code.txt
#      为准写终态——成功 → STOPPED（一次性任务），失败 → FAILED；已终态跳过；
#      新源缺失时由旧工件推导并物化（旧工件不动）。
# 重启残留（state_rehydrate_residual）：daemon 启动剪枝后旧 status.txt 为
# RUNNING/STARTING/ZOMBIE_CRASHED/STALE 的运行目录 → state.txt=FAILED +
# daemon_restart 事件（task_state_rehydrate 语义；旧 status.txt 不动）。
# 返回约定：各入口非致命——任何拒绝/错误均 return != 0 且不中止调用方循环。
# ═══════════════════════════════════════════════════════════════════════════
state_log() {
    [ "${STATE_LOG:-1}" = "1" ] && echo "[state] $1" >&2
}

# 健康族门槛：注册表中存在非 builtin 的真实 Health Provider → 0；否则 1。
state_health_allowed() {
    for entry in $TPR_REGISTRY; do
        f1=${entry%%>*}
        [ "$f1" = "health" ] || continue
        rest=${entry#*>}; f2=${rest%%>*}; pre=${rest#*>}
        [ "$f2" = "builtin" ] || { [ -n "$pre" ] && return 0; }
    done
    return 1
}

# 统一状态/事件写入（生产正式入口）：健康族门槛 + TSM 迁移校验 +
# 双写 state.txt/events.log（委托 §4 runtime_log_event；旧工件只读不动）。
state_log_event() {   # <dir> <task_id> <event> <state> [pid] [exit_code] [message]
    dir=$1; task_id=$2; event=$3; state=$4; pid=${5:-}; exit_code=${6:-}; message=${7:-}
    [ -n "$dir" ] || { state_log "ERROR log_event: dir required"; return 1; }
    if [ "$state" = "HEALTHY" ] || [ "$state" = "UNHEALTHY" ]; then
        state_health_allowed || {
            state_log "WARNING log_event: HEALTHY/UNHEALTHY requires a real health provider (task=$task_id) — rejected, daemon loop unaffected"
            return 1
        }
    fi
    cur=""
    [ -f "$dir/state.txt" ] && cur=$(cat "$dir/state.txt" 2>/dev/null)
    if [ -n "$cur" ] && [ "$cur" != "$state" ]; then
        case " $TSM_CAUSES " in
            *" $event "*) cause=$event ;;
            *) cause="" ;;
        esac
        TSM_LOG=0 task_state_transition "$cur" "$state" "$cause" >/dev/null 2>&1 || {
            state_log "WARNING log_event: illegal transition '$cur'->'$state' rejected (task=$task_id; event=$event) — daemon loop unaffected"
            return 1
        }
    fi
    runtime_log_event "$dir" "$task_id" "$event" "$state" "$pid" "$exit_code" "$message"
}

# 单目录对账：exit_code.txt 存在 → 按退出码写终态（powered 一次性任务成功 →
# STOPPED；失败 → FAILED）；新源缺失时由旧工件推导并物化。幂等：已终态跳过。
state_sync_one() {   # <dir> → 0=ok 1=未完成（无终态可判定）2=硬错误（不中止循环）
    dir=$1
    [ -d "$dir" ] || return 2
    id=$(basename "$dir")
    [ -f "$dir/exit_code.txt" ] || return 1
    ec=$(cat "$dir/exit_code.txt" 2>/dev/null)
    cur=$(runtime_current_state "$dir")
    case "$cur" in
        STARTING|RUNNING|PENDING)
            # P4-07：WAITING 不在对账列——重试退避/依赖门控中的 WAITING 任务带
            # 残留 exit_code.txt（上次失败遗留），若被对账会强制回写 FAILED/STOPPED，
            # 破坏 FAILED>WAITING 退避。WAITING 的解除/终态由 advance 通道负责。
            if [ "$ec" = "0" ]; then
                state_log_event "$dir" "$id" action_success STOPPED "" "$ec" "exit=$ec" >/dev/null 2>&1
            else
                state_log_event "$dir" "$id" action_failure FAILED "" "$ec" "exit=$ec" >/dev/null 2>&1
            fi
            ;;
        STOPPED|FAILED|DISABLED)
            # P4-07：终态对账后清除重试退避工件（retry.count/retry.until/gate.fail）
            # ——重试退避只存在于 FAILED>WAITING 期间，终态是新一轮生命周期。
            rm -f "$dir/retry.count" "$dir/retry.until" "$dir/gate.fail" 2>/dev/null
            if [ ! -f "$dir/state.txt" ]; then
                # 新源缺失：由旧工件推导的终态 → 物化（旧工件不动）。
                if [ "$cur" = "STOPPED" ]; then
                    state_log_event "$dir" "$id" action_success STOPPED "" "$ec" "materialized from legacy" >/dev/null 2>&1
                elif [ "$cur" = "FAILED" ]; then
                    state_log_event "$dir" "$id" action_failure FAILED "" "$ec" "materialized from legacy" >/dev/null 2>&1
                fi
            fi
            ;;
        *) : ;;   # 未知/非法现态：不触碰（非致命，继续）
    esac
    return 0
}

# 全目录对账：单目录错误不中止（非法状态转换不破主循环）。
state_sync_all() {   # <tasks_dir> → 0=ok 1=存在未完成/错误目录 2=目录不可用
    tasks=$1
    [ -d "$tasks" ] || { state_log "ERROR sync_all: no tasks dir $tasks"; return 2; }
    rc=0
    for p in "$tasks"/*; do
        [ -d "$p" ] || continue
        state_sync_one "$p" >/dev/null 2>&1 || rc=1
    done
    return "$rc"
}

# 重启残留再水合：daemon 启动剪枝后的运行态（RUNNING/STARTING/
# ZOMBIE_CRASHED/STALE）→ state.txt=FAILED + daemon_restart 事件；旧工件不动。
# P4-04：WAITING 为「门控等待」非执行态，重启后**原样保留**（下个 tick 复查依赖、
# 重新计时 WAIT_MAX）——不再强制 FAILED（合法语义变更，docs/P4-04.md §3）。
state_rehydrate_residual() {   # <tasks_dir>
    tasks=$1
    [ -d "$tasks" ] || { state_log "ERROR rehydrate: no tasks dir $tasks"; return 2; }
    for p in "$tasks"/*; do
        [ -d "$p" ] || continue
        [ -f "$p/status.txt" ] || continue
        id=$(basename "$p")
        st=$(cat "$p/status.txt" 2>/dev/null)
        case "$st" in
            RUNNING|STARTING|ZOMBIE_CRASHED|STALE)
                cur=$(runtime_current_state "$p")
                case "$cur" in
                    WAITING) : ;;   # 门控等待：保留，重启后复查依赖（P4-04）
                    STARTING|RUNNING|PENDING)
                        state_log_event "$p" "$id" daemon_restart FAILED "" "" "residual after daemon restart" >/dev/null 2>&1
                        ;;
                    FAILED)
                        # 旧源已推导 FAILED（如 ZOMBIE_CRASHED）但新源缺失 → 物化
                        if [ ! -f "$p/state.txt" ]; then
                            state_log_event "$p" "$id" daemon_restart FAILED "" "" "residual materialized from legacy" >/dev/null 2>&1
                        fi
                        ;;
                esac
                ;;
        esac
    done
    return 0
}
# ────────────────────────────────────────────────────────────────────────
# §13 Task CLI 接线（P2-08）
# ═══════════════════════════════════════════════════════════════════════════
# CLI `su-scheduler task list | task status <id>` 的生产数据路径：**读取
# Registry，不重新扫描配置**（registry_attach 只挂载当前快照；不调用
# adapter/parse/reload）。三态错误区分沿 §7：rc1 task not found / rc2
# configuration invalid / rc3 daemon is not running——均带明确 stderr 消息。
# 支持**稳定 Task ID（t<line>_<trigger>）与旧运行 ID（time_/advanced_/
# immediate_/startup_…）**双向查询：旧 ID 经 §9 idmap（runtime_map_refresh
# 幂等刷新 + run→canonical 反向查询）。旧 CLI 命令零改动（P2-04 兼容边界）；
# 本层只新增 task 前缀命令（不 alias、不覆盖 commands 同名函数）。
# 返回：0=成功 / 1=任务未找到或用法错 / 2=配置无效（无有效快照）/ 3=daemon 未运行。
# ═══════════════════════════════════════════════════════════════════════════
task_cli_attach() {   # <base> → 0=已挂载当前快照 / 1=无有效快照 / 2=base 缺失
    registry_attach "$1"
}

task_cli_resolve_id() {   # <base> <tasks_dir> <id> → echo canonical id（无则返回 1）
    base=$1; tasks=$2; qid=$3
    # 注：查询 ID 用 qid 而非 id —— runtime_map_refresh 内部以全局 `id` 作循环
    # 变量（POSIX sh 无局部变量），复用同名会覆盖本函数参数（P2-08 实测修复）。
    if registry_task_file "$qid" >/dev/null 2>&1; then
        echo "$qid"
        return 0
    fi
    # 旧运行 ID → canonical（§9 idmap：幂等刷新后反向查询 run→canonical）
    runtime_map_refresh "$base" "$tasks" >/dev/null 2>&1
    canon=$(runtime_map_run_task "$base" "$qid")
    [ -n "$canon" ] || return 1
    echo "$canon"
    return 0
}

task_cli_status_id() {   # <base> <tasks_dir> <lock> <id> → rc 沿 §7 三态
    base=$1; tasks=$2; lock=$3; qid=$4
    [ -n "$qid" ] || { echo "ERROR: usage: task status <id>" >&2; return 1; }
    task_cli_attach "$base" >/dev/null 2>&1 || {
        echo "ERROR: configuration invalid (no valid task snapshot)" >&2
        return 2
    }
    canon=$(task_cli_resolve_id "$base" "$tasks" "$qid")
    if [ -z "$canon" ]; then
        echo "ERROR: task not found: $qid" >&2
        return 1
    fi
    if [ "$canon" != "$qid" ]; then
        echo "queried_id=$qid"
        echo "canonical_id=$canon"
    fi
    TASK_CLI_TASKS_DIR="$tasks" TASK_CLI_LOCK="$lock" task_cli_status "$canon"
}
# ────────────────────────────────────────────────────────────────────────
# §14 Daemon Lifecycle Startup（P2-09）
# ═══════════════════════════════════════════════════════════════════════════
# daemon 启动生命周期（**单次执行，不创建第二个常驻循环**；**不重复实现锁逻辑**
# ——daemon 既有 LOCK_FILE 单实例保护与 service.sh 60 秒看护循环原样保留）。
# 两个正式入口：
#   lifecycle_startup_registry <base> <config> —— Registry 引导：当前已有快照
#     （shadow_init 已建 / reload KEPT）即就绪；否则 config 存在 → registry_init
#     （新快照）；config 缺失 → registry_attach **只读挂载最后有效快照**（KEPT
#     语义，不重新扫描配置）。返回 0=快照就绪 / 1=无有效快照 / 2=参数错。
#   lifecycle_startup_recover <tasks_dir> —— 恢复序列（幂等，单目录错误不中止）：
#     = runtime_scan_stale（stale PID：pid.txt 指向已死进程的运行态 →
#       state.txt=FAILED + daemon_restart 事件）+ state_rehydrate_residual
#       （剪枝后运行态 status.txt=RUNNING/STARTING/ZOMBIE_CRASHED/STALE →
#       state.txt=FAILED + daemon_restart 事件）；旧工件（status.txt/pid.txt/…）
#       **只读不动**（旧 CLI 仍按旧语义读取）。
# daemon 接线：su-schedulerd 启动区按同一序列组合（P2-03 shadow_init →
# P2-04 runtime_map_refresh → 本层 registry 引导 → P2-05 trigger_decide 预热 →
# legacy 剪枝后本层恢复序列）；本层亦供测试以同一序列做真实链路验证
# （daemon 重启 / stop / restart / stale lock / service 看护）。
# ═══════════════════════════════════════════════════════════════════════════
lifecycle_startup_registry() {   # <base> <config> → 0=快照就绪 / 1=无有效快照 / 2=参数错
    base=$1; config=$2
    [ -n "$base" ] && [ -n "$config" ] || {
        lifecycle_log "ERROR startup_registry: base/config required"; return 2; }
    if [ -n "$(registry_current_snapshot_id 2>/dev/null)" ]; then
        return 0
    fi
    if [ -f "$config" ]; then
        registry_init "$base" "$config" >/dev/null 2>&1
    else
        registry_attach "$base" >/dev/null 2>&1
    fi
    [ -n "$(registry_current_snapshot_id 2>/dev/null)" ] && return 0 || return 1
}

lifecycle_startup_recover() {   # <tasks_dir> → 0=完成（幂等；单目录错误不中止）
    tasks=$1
    [ -d "$tasks" ] || { lifecycle_log "INFO startup_recover: no tasks dir $tasks"; return 0; }
    runtime_scan_stale "$tasks" >/dev/null 2>&1
    state_rehydrate_residual "$tasks" >/dev/null 2>&1
    return 0
}
# ────────────────────────────────────────────────────────────────────────
# §15 App Action Provider（P2-10）
# ═══════════════════════════════════════════════════════════════════════════
# 结构化 App Action（P1-04 契约预留；Shizuku/GKD 类应用可经结构化 Task 启动）：
#   spec = `app:<op>:<target>[:<extras>]`
#     op     ∈ package | activity | broadcast | service
#     target ：
#       package   包名（com.example.app）
#       activity/service 组件（com.example/.Main 或 com.example/.a.b.C；
#                         允许包内相对类；含 `$` 的内部类组件暂不支持——安全集
#                         拒绝 `$`，属后续扩展点）
#       broadcast 意图动作（com.example.ACTION_GO / android.intent.action.X）
#     extras （仅 broadcast）可选：k1=v1,k2=v2（字符串 extra，--es 透传）
# **安全门（所有参数校验，不允许 Web/CLI 拼接任意 Root Shell）**：
#   1) 全局安全字符集门：spec 仅允许 `[A-Za-z0-9._:/=+%-]`（无空格、无引号、
#      无反引号/$、无 ;|&<>(){} 等任何 shell 元字符）——case 负向类一票否决；
#   2) 逐操作结构校验：包名/组件/意图动作的正则白名单；
#   3) 执行构建 = **固定 am 模板 + 已校验片段**（直接 argv 调用 am，不经
#      sh -c / eval；校验失败 → 拒启、零执行、写 FAILED 工件）。
# 能力（沿 action 契约）：validate / prepare / start / status / stop / restart；
# 注册 `provider_register action app tpr_action_app`（核心引擎零改动——
# provider_dispatch 只认 kind+cap）。工件语义与 §3 command 一致：
# command.txt(spec)/start_time/status RUNNING → am 执行 → output.log/
# exit_code.txt/end_time/SUCCESS|FAILED。
# ═══════════════════════════════════════════════════════════════════════════
tpr_action_app_log() {
    [ "${TPR_LOG:-1}" = "1" ] && echo "[app-action] $1" >&2
}

# 解析 + 全校验：置 op/target/extras（全局；POSIX sh 无局部变量）；非法 → 1。
tpr_action_app_parse() {   # <spec>
    spec=$1
    # 全局安全门（负向字符类）：任何不在安全集内的字符一票否决（含空格与全部
    # shell 元字符——Web/CLI 无法经 spec 注入任意 Root Shell 命令）。
    # 安全集 = 字母数字 + . _ : / = + - % ,（`$`/`!`/`@` 等一律拒绝——内部类
    # 组件含 `$` 的 spec 暂不支持，属后续扩展点）。
    case "$spec" in
        *[!A-Za-z0-9._:/\=%+-,]*) return 1 ;;
    esac
    op=$(echo "$spec" | cut -d: -f2)
    target=$(echo "$spec" | cut -d: -f3)
    extras=$(echo "$spec" | cut -d: -f4-)
    [ -n "$op" ] && [ -n "$target" ] || return 1
    case "$op" in
        package)
            echo "$target" | grep -E '^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+$' >/dev/null || return 1
            [ -z "$extras" ] || return 1
            ;;
        activity|service)
            echo "$target" | grep -E '^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+(/\.?[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*)?$' >/dev/null || return 1
            [ -z "$extras" ] || return 1
            ;;
        broadcast)
            echo "$target" | grep -E '^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)*$' >/dev/null || return 1
            if [ -n "$extras" ]; then
                oldifs=$IFS; IFS=','
                for pair in $extras; do
                    [ -n "$pair" ] || continue
                    k=${pair%%=*}; v=${pair#*=}
                    [ -n "$k" ] && [ -n "$v" ] || { IFS=$oldifs; return 1; }
                    echo "$k" | grep -E '^[A-Za-z][A-Za-z0-9_]*$' >/dev/null || { IFS=$oldifs; return 1; }
                    echo "$v" | grep -E '^[A-Za-z0-9._:/%+\-]*$' >/dev/null || { IFS=$oldifs; return 1; }
                done
                IFS=$oldifs
            fi
            ;;
        *) return 1 ;;
    esac
    return 0
}

tpr_action_app_validate() {   # <spec> → 0=合法 / 1=非法（安全门）
    tpr_action_app_parse "$1" >/dev/null 2>&1
}

tpr_action_app_dir() { echo "${TPR_ACTION_DIR:-/tmp/su-scheduler-actions}/$1"; }

tpr_action_app_prepare() {   # <id> <spec> → echo dir；非法 spec 拒启（不建目录）
    id=$1; spec=$2
    tpr_action_app_parse "$spec" >/dev/null 2>&1 || {
        tpr_action_app_log "ERROR prepare: invalid app spec rejected (id=$id): $spec"
        return 1
    }
    dir=$(tpr_action_app_dir "$id")
    mkdir -p "$dir" || return 2
    echo "$spec" > "$dir/command.txt"
    date "+%Y-%m-%d %H:%M:%S" > "$dir/start_time.txt"
    echo "RUNNING" > "$dir/status.txt"
    echo "$dir"
}

tpr_action_app_start() {   # <id> <spec> → 后台执行（固定 am 模板）+ echo pid
    id=$1; spec=$2
    tpr_action_app_parse "$spec" >/dev/null 2>&1 || {
        tpr_action_app_log "ERROR start: invalid app spec rejected — no shell execution (id=$id): $spec"
        return 1
    }
    dir=$(tpr_action_app_dir "$id")
    (
        tpr_action_exec_app "$id" "$dir" "$spec"
    ) &
    echo $!
}

tpr_action_app_status() {   # <id> <pid>
    pid=$2
    [ -n "$pid" ] && [ -d "/proc/$pid" ] && return 0 || return 1
}

tpr_action_app_stop() { kill "$2" 2>/dev/null; }

tpr_action_app_restart() {   # <id> <spec> <old_pid>
    tpr_action_app_stop "$1" "$3"
    sleep 1
    tpr_action_app_start "$1" "$2"
}

tpr_action_exec_app() {   # <id> <dir> <spec>（spec 已全校验；构建固定 am 模板）
    id=$1; dir=$2; spec=$3
    tpr_action_app_parse "$spec" >/dev/null 2>&1 || {
        echo "ERROR: invalid app action spec: $spec" > "$dir/output.log" 2>/dev/null
        echo "1" > "$dir/exit_code.txt" 2>/dev/null
        echo "FAILED" > "$dir/status.txt" 2>/dev/null
        return 1
    }
    case "$op" in
        package)
            am start -a android.intent.action.MAIN -c android.intent.category.LAUNCHER -p "$target" ;;
        activity)
            am start -n "$target" ;;
        service)
            am startservice -n "$target" ;;
        broadcast)
            set -- am broadcast -a "$target"
            if [ -n "$extras" ]; then
                oldifs=$IFS; IFS=','
                for pair in $extras; do
                    [ -n "$pair" ] || continue
                    k=${pair%%=*}; v=${pair#*=}
                    set -- "$@" --es "$k" "$v"
                done
                IFS=$oldifs
            fi
            "$@" ;;
    esac > "$dir/output.log" 2>&1
    rc=$?
    echo "$rc" > "$dir/exit_code.txt"
    date "+%Y-%m-%d %H:%M:%S" > "$dir/end_time.txt"
    if [ "$rc" -eq 0 ]; then
        echo "SUCCESS" > "$dir/status.txt"
    else
        echo "FAILED" > "$dir/status.txt"
    fi
    return "$rc"
}
# ────────────────────────────────────────────────────────────────────────
# §16 Process & Port Health Provider（P2-11）
# ═══════════════════════════════════════════════════════════════════════════
# 首批真实健康检查（P1-04 health 契约：validate / check）：
#   health>process —— Process Check：spec = 进程名（pidof）或 PID（/proc/<pid>）；
#   health>port    —— Port Check：spec = TCP 端口 1-65535（/proc/net/tcp 的
#                     LISTEN(0A) 状态；IPv4，IPv6 为扩展点）。
# **统一返回三态 + 原因 + 延迟 + 目标**（单行，`|` 分隔）：
#   <HEALTHY|UNHEALTHY|UNKNOWN>|reason=<原因>|latency_ms=<毫秒>|target=<spec>
#   返回码：0=HEALTHY / 1=UNHEALTHY / 2=UNKNOWN / 3=分发或用法错误。
# 安全：spec 经安全字符集 + 结构校验（拒绝 shell 元字符——同 §15 原则；
# 仅做只读检查，零执行副作用）。
# 正式入口：`health_check <kind> <spec>`（唯一；经 provider_dispatch health）。
# 注意：注册 process/port 后 **P2-07 state_health_allowed 打开**——HEALTHY/
# UNHEALTHY 状态写入获准（真实 Health Provider 已接入；门槛机制本身在
# builtin-only 注册表下仍关闭，状态套件 §4 有双侧断言）。
# ═══════════════════════════════════════════════════════════════════════════
tpr_health_log() {
    [ "${TPR_LOG:-1}" = "1" ] && echo "[health] $1" >&2
}

# 毫秒时间戳：date +%s%3N（GNU/toybox）截取前 13 位 = 纪元毫秒；uutils 的
# %3N 输出 9 位纳秒（19 位）同样截 13 位归一；不支持 %N → 秒*1000 退化。
tpr_health_ms() {
    ms=$(date "+%s%3N" 2>/dev/null | cut -c1-13)
    case "$ms" in
        *[!0-9]*) echo $(( $(date +%s) * 1000 )) ;;
        *) echo "$ms" ;;
    esac
}

# ── Process Check ───────────────────────────────────────────────────────────
tpr_health_process_validate() {   # <spec> → 进程名或 PID（安全字符集 + 结构）
    case "$1" in
        *[!A-Za-z0-9_./:-]*) return 1 ;;
    esac
    case "$1" in
        [0-9]*) echo "$1" | grep -E '^[0-9]+$' >/dev/null ;;
        *) echo "$1" | grep -E '^[A-Za-z][A-Za-z0-9_./:-]*$' >/dev/null ;;
    esac
}

tpr_health_process_check() {   # <spec> → 三态行 + rc 0/1/2
    spec=$1
    t0=$(tpr_health_ms)
    if ! tpr_health_process_validate "$spec"; then
        t1=$(tpr_health_ms)
        lat=$((t1 - t0)); [ "$lat" -lt 0 ] && lat=0   # 时钟抖动防护
        echo "UNKNOWN|reason=invalid-spec|latency_ms=$lat|target=$spec"
        return 2
    fi
    found=0
    cmd_err=0
    if echo "$spec" | grep -qE '^[0-9]+$'; then
        [ -d "/proc/$spec" ] && found=1
    else
        if command -v pidof >/dev/null 2>&1; then
            pidof "$spec" >/dev/null 2>&1 && found=1
        else
            cmd_err=1
        fi
    fi
    t1=$(tpr_health_ms)
    lat=$((t1 - t0))
    [ "$lat" -lt 0 ] && lat=0   # 时钟抖动防护（宿主 uutils date 偶发负差）
    if [ "$found" -eq 1 ]; then
        echo "HEALTHY|reason=process-running|latency_ms=$lat|target=$spec"
        return 0
    elif [ "$cmd_err" -eq 1 ]; then
        echo "UNKNOWN|reason=pidof-unavailable|latency_ms=$lat|target=$spec"
        return 2
    else
        echo "UNHEALTHY|reason=process-not-found|latency_ms=$lat|target=$spec"
        return 1
    fi
}

# ── Port Check（TCP LISTEN，/proc/net/tcp）──────────────────────────────────
tpr_health_port_validate() {   # <spec> → 端口 1-65535
    echo "$1" | grep -E '^[0-9]{1,5}$' >/dev/null || return 1
    [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

tpr_health_port_check() {   # <spec> → 三态行 + rc 0/1/2
    spec=$1
    t0=$(tpr_health_ms)
    if ! tpr_health_port_validate "$spec"; then
        t1=$(tpr_health_ms)
        lat=$((t1 - t0)); [ "$lat" -lt 0 ] && lat=0   # 时钟抖动防护
        echo "UNKNOWN|reason=invalid-spec|latency_ms=$lat|target=port:$spec"
        return 2
    fi
    hex=$(printf '%04X' "$spec")
    listening=0
    unreadable=0
    if [ -r /proc/net/tcp ]; then
        n=$(awk -v h="$hex" '$4 == "0A" && $2 ~ ":" h "$" { n++ } END { print n+0 }' /proc/net/tcp 2>/dev/null)
        [ "$n" -gt 0 ] && listening=1
    else
        unreadable=1
    fi
    t1=$(tpr_health_ms)
    lat=$((t1 - t0))
    [ "$lat" -lt 0 ] && lat=0   # 时钟抖动防护（宿主 uutils date 偶发负差）
    if [ "$listening" -eq 1 ]; then
        echo "HEALTHY|reason=port-listening|latency_ms=$lat|target=port:$spec"
        return 0
    elif [ "$unreadable" -eq 1 ]; then
        echo "UNKNOWN|reason=proc-unreadable|latency_ms=$lat|target=port:$spec"
        return 2
    else
        echo "UNHEALTHY|reason=port-not-listening|latency_ms=$lat|target=port:$spec"
        return 1
    fi
}

# 正式入口（唯一）：health_check <kind> <spec> → 三态行 + rc 0/1/2/3
health_check() {
    kind=${1:-}; spec=${2:-}
    [ -n "$kind" ] && [ -n "$spec" ] || {
        tpr_health_log "ERROR check: kind/spec required"
        return 3
    }
    provider_dispatch health "$kind" check "$spec"
}
# ────────────────────────────────────────────────────────────────────────
# §17 Supervisor Core（P2-12）+ Recovery/Retry/Cooldown（P2-13）
# ═══════════════════════════════════════════════════════════════════════════
# 驱动受监督任务的完整生命周期（TSM 允许边 + §16 健康检查）：
#   RUNNING → HEALTHY（首检通过）
#   HEALTHY → UNHEALTHY（探针失败）
#   UNHEALTHY → RECOVERING（进入恢复）
#   RECOVERING → STARTING（恢复动作成功）→ spawn → RUNNING（循环）
#   RECOVERING → FAILED（重试超过策略 retry.max）
# **统一事件循环**：`supervisor_tick <tasks_dir> <base>` 为唯一入口——每 tick
# 对每个受监督任务**至多一步**；**不创建任何每任务常驻线程/循环**（无 while、
# 无后台 `&` 派生；与 shadow_tick/state_sync_all 同构，daemon 唯一主循环调用）。
# ── P2-13 恢复动作（recovery.type ∈ task v2 字段；缺省 none=重跑 action）──
#   restart   Restart Action：停既有进程（TERM→超时 KILL）→ 重跑 action；
#   stopstart Stop + Start：优雅停（TERM）→ 重跑 action；
#   start     Start Action：直接重跑 action（默认/无类型）；
#   script    Execute Script：运行 recovery.script（绝对路径、存在可读）——
#             脚本负责恢复（如重启 Node/Python/Rust 服务）；rc 0=成功。
# ── 策略（禁止无限重启）──
#   retry.max（=max_retry）：每恢复 episode 重试次数上限；**非负整数钳制 +
#     硬上限 100**（非法/负值 → 0，>100 → 100）——重启次数必然有限；
#   retry.interval（=retry_interval）：尝试节奏（秒，recovery.next）；
#   retry.cooldown：基础 cooldown——episode 耗尽（FAILED）后写
#     recovery.cooldown_until（epoch 秒），到期前 supervisor 跳过该任务
#     （禁止失败风暴热循环；FAILED 为终态，须人工 rearm 或到期后新 episode）。
# 运行目录监督工件：recovery.count / recovery.next / recovery.cooldown_until。
# 事件：state_log_event event=supervisor 驱动迁移；UNKNOWN → 不迁移。
# ═══════════════════════════════════════════════════════════════════════════
supervisor_log() {
    [ "${SUPERVISOR_LOG:-1}" = "1" ] && echo "[supervisor] $1" >&2
}

supervisor_health_spec() {   # <task_file> → echo health spec（process:<t>/port:<t>；无配置 → 空）
    tf=$1
    htype=$(grep '^health.type=' "$tf" | head -1 | cut -d= -f2-)
    htarget=$(grep '^health.target=' "$tf" | head -1 | cut -d= -f2-)
    case "$htype" in
        process|port)
            [ -n "$htarget" ] && echo "$htype:$htarget"
            ;;
    esac
}

# P2-13：置 retry_max / retry_interval / retry_cooldown（全部非负整数钳制；
# retry.max 硬上限 100——禁止无限重启；非法/负值 → 缺省 0/60/0）。
supervisor_policy() {   # <task_file>
    tf=$1
    retry_max=$(grep '^retry.max=' "$tf" | head -1 | cut -d= -f2-)
    retry_interval=$(grep '^retry.interval=' "$tf" | head -1 | cut -d= -f2-)
    retry_cooldown=$(grep '^retry.cooldown=' "$tf" | head -1 | cut -d= -f2-)
    case "$retry_max" in
        ''|*[!0-9]*) retry_max=0 ;;
    esac
    [ "$retry_max" -gt 100 ] && retry_max=100   # 硬上限：重启次数必然有限
    case "$retry_interval" in
        ''|*[!0-9]*) retry_interval=60 ;;
    esac
    case "$retry_cooldown" in
        ''|*[!0-9]*) retry_cooldown=0 ;;
    esac
}

supervisor_task_file() {   # <base> <tasks_dir> <id> → 注册表任务文件（旧运行 ID 经 idmap 解析）
    base=$1; tasks=$2; qid=$3
    f=$(registry_task_file "$qid" 2>/dev/null) && { echo "$f"; return 0; }
    runtime_map_refresh "$base" "$tasks" >/dev/null 2>&1
    canon=$(runtime_map_run_task "$base" "$qid")
    [ -n "$canon" ] || {
        # P3-03 要求 9：任务已从新快照移除但仍在运行 → 用运行目录 stash 的
        # task.v2 继续监督（快照移除的旧任务不中止监督/收尾；无 stash → 兜底失败）
        if [ -f "$tasks/$qid/task.v2" ]; then
            echo "$tasks/$qid/task.v2"
            return 0
        fi
        return 1
    }
    f=$(registry_task_file "$canon" 2>/dev/null) || {
        if [ -f "$tasks/$qid/task.v2" ]; then
            echo "$tasks/$qid/task.v2"
            return 0
        fi
        return 1
    }
    echo "$f"
    return 0
}

# P2-13：停既有任务进程（pid.txt；TERM → 有界等待 → force=1 时 KILL）。有界
# 等待循环（非常驻；单次恢复内至多 ~3s）。无 pid/已死 → 0。
supervisor_stop_task() {   # <run_dir> [force]
    rd=$1; force=${2:-0}
    pid=$(cat "$rd/pid.txt" 2>/dev/null)
    [ -n "$pid" ] && [ -d "/proc/$pid" ] 2>/dev/null || return 0
    kill "$pid" 2>/dev/null
    i=0
    while [ "$i" -lt 5 ] && [ -d "/proc/$pid" ] 2>/dev/null; do
        sleep 0.3
        i=$((i + 1))
    done
    if [ "$force" -eq 1 ] && [ -d "/proc/$pid" ] 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null
    fi
    return 0
}

# P2-13：执行恢复动作（recovery.type）→ 0=成功（已重跑/脚本 rc0） 1=失败
supervisor_recover() {   # <run_dir> <task_file>
    rd=$1; tf=$2
    rtype=$(grep '^recovery.type=' "$tf" | head -1 | cut -d= -f2-)
    act=$(grep '^action.command=' "$tf" | head -1 | cut -d= -f2-)
    id=$(basename "$rd")
    case "$rtype" in
        restart)
            # Restart Action：停既有（TERM→KILL）→ 重跑 action
            supervisor_stop_task "$rd" 1
            [ -n "$act" ] || return 1
            action_run "$id" "$act" >/dev/null 2>&1 ;;
        stopstart)
            # Stop + Start：优雅停（TERM）→ 重跑 action
            supervisor_stop_task "$rd" 0
            [ -n "$act" ] || return 1
            action_run "$id" "$act" >/dev/null 2>&1 ;;
        start|""|none)
            # Start Action（默认/无类型）：直接重跑 action
            [ -n "$act" ] || return 1
            action_run "$id" "$act" >/dev/null 2>&1 ;;
        script)
            # Execute Script：recovery.script 绝对路径 + 存在可读；rc 0=成功
            spath=$(grep '^recovery.script=' "$tf" | head -1 | cut -d= -f2-)
            case "$spath" in
                /*) [ -f "$spath" ] && [ -r "$spath" ] || return 1 ;;
                *) return 1 ;;
            esac
            sh "$spath" >/dev/null 2>&1 ;;
        *) return 1 ;;
    esac
}

# 单任务单步（每 tick 至多一步；无循环、无后台派生）：
# <run_dir> <task_file> → 0=无动作/保持 1=发生迁移 2=FAILED（策略超限）3=无健康配置/目录缺失
supervisor_step() {
    rd=$1; tf=$2
    [ -d "$rd" ] || return 3
    # 基础 cooldown：cooldown_until 未到 → 不监督（失败风暴热循环禁止）
    cdu=$(cat "$rd/recovery.cooldown_until" 2>/dev/null)
    if [ -n "$cdu" ] && [ "$(date +%s)" -lt "$cdu" ]; then
        return 0
    fi
    spec=$(supervisor_health_spec "$tf")
    [ -n "$spec" ] || return 3
    id=$(basename "$rd")
    cur=$(runtime_current_state "$rd")
    kind=${spec%%:*}
    target=${spec#*:}
    case "$cur" in
        RUNNING)
            # P2-14：运行时钟起点（supervisor.since 首次监督该 RUNNING 时落桩）
            if [ ! -e "$rd/supervisor.since" ]; then
                date +%s > "$rd/supervisor.since" 2>/dev/null
            fi
            # P2-14：运行超时护栏（P3-08：按 per-task 有效超时 advanced.timeout，
            # 缺省 TASK_RUNTIME_MAX；>0 且超时 → FAILED 终止）
            if supervisor_runtime_exceeded "$rd" "$(secv_effective_timeout "$tf")"; then
                supervisor_stop_task "$rd" 1
                state_log_event "$rd" "$id" supervisor FAILED "" "" "runtime-limit exceeded" >/dev/null 2>&1 && return 1
            fi
            # P2-14：健康探针最小间隔（HEALTH_MIN_INTERVAL>0 时按 health.last 节流）
            # 首检通过 → HEALTHY（TSM: RUNNING>HEALTHY）；失败/UNKNOWN → 保持 RUNNING
            if supervisor_health_due "$rd"; then
                supervisor_health_mark "$rd"
                if health_check "$kind" "$target" >/dev/null 2>&1; then
                    state_log_event "$rd" "$id" supervisor HEALTHY "" "" "probe ok" >/dev/null 2>&1 && return 1
                fi
            fi
            return 0 ;;
        HEALTHY)
            # P2-14：运行超时护栏（P3-08：per-task 有效超时；超时 → FAILED 终止）
            if supervisor_runtime_exceeded "$rd" "$(secv_effective_timeout "$tf")"; then
                supervisor_stop_task "$rd" 1
                state_log_event "$rd" "$id" supervisor FAILED "" "" "runtime-limit exceeded" >/dev/null 2>&1 && return 1
            fi
            # P2-14：健康探针最小间隔（HEALTH_MIN_INTERVAL 内不重复探）
            if supervisor_health_due "$rd"; then
                supervisor_health_mark "$rd"
                st=$(health_check "$kind" "$target" 2>/dev/null | cut -d'|' -f1)
                if [ "$st" = "UNHEALTHY" ]; then
                    state_log_event "$rd" "$id" supervisor UNHEALTHY "" "" "probe unhealthy" >/dev/null 2>&1 && return 1
                fi
            fi
            return 0 ;;
        UNHEALTHY)
            state_log_event "$rd" "$id" supervisor RECOVERING "" "" "recovery started" >/dev/null 2>&1 && return 1
            return 0 ;;
        RECOVERING)
            # P4-07：依赖失败传播（gate_fail）的任务不 auto-recovery——依赖失败 ≠
            # 进程崩溃。gate.fail 标记存在 → 不派发 recovery 动作（restart/start/
            # stopstart/script），直接转 FAILED（终态，等待 rearm/人工）。执行期失败
            # （无 gate.fail）维持既有 recovery 语义。
            if [ -f "$(sched_retry_gatefail_file "$rd")" ]; then
                state_log_event "$rd" "$id" supervisor FAILED "" "" "gate-failed task not auto-recovered (dependency failure)" >/dev/null 2>&1
                rm -f "$(sched_retry_gatefail_file "$rd")" 2>/dev/null
                return 1
            fi
            supervisor_policy "$tf"
            # 节奏：retry.interval 秒内不重试（recovery.next = epoch 秒）
            now=$(date +%s)
            nxt=$(cat "$rd/recovery.next" 2>/dev/null)
            if [ -n "$nxt" ] && [ "$now" -lt "$nxt" ]; then
                return 0
            fi
            cnt=$(cat "$rd/recovery.count" 2>/dev/null)
            [ -n "$cnt" ] || cnt=0
            if [ "$cnt" -ge "$retry_max" ]; then
                # 策略超限 → FAILED + 基础 cooldown（禁止无限重启/失败风暴热循环）
                state_log_event "$rd" "$id" supervisor FAILED "" "" "retry-exhausted (max=$retry_max)" >/dev/null 2>&1
                echo $((now + retry_cooldown)) > "$rd/recovery.cooldown_until"
                return 2
            fi
            act=$(grep '^action.command=' "$tf" | head -1 | cut -d= -f2-)
            if [ -z "$act" ] && [ "$(grep '^recovery.type=' "$tf" | head -1 | cut -d= -f2-)" != "script" ]; then
                state_log_event "$rd" "$id" supervisor FAILED "" "" "no-action-for-recovery" >/dev/null 2>&1
                echo $((now + retry_cooldown)) > "$rd/recovery.cooldown_until"
                return 2
            fi
            cnt=$((cnt + 1))
            echo "$cnt" > "$rd/recovery.count"
            echo $((now + retry_interval)) > "$rd/recovery.next"
            rm -f "$rd/exit_code.txt" 2>/dev/null
            # 恢复尝试（state 仍为 RECOVERING——action_run spawn 锚点从 RECOVERING
            # 写 RUNNING 会被 TSM 拒绝，属预期、零副作用）。尝试成功 → 显式两段
            # 合法迁移 RECOVERING→STARTING→RUNNING；**尝试失败 → 保持 RECOVERING**
            # （按 retry.max 重试，节奏 recovery.next；次数耗尽在 tick 起始判）。
            if supervisor_recover "$rd" "$tf" >/dev/null 2>&1; then
                state_log_event "$rd" "$id" supervisor STARTING "" "" "recovery attempt $cnt ok ($(grep '^recovery.type=' "$tf" | head -1 | cut -d= -f2-))" >/dev/null 2>&1
                state_log_event "$rd" "$id" supervisor RUNNING "" "" "recovered" >/dev/null 2>&1
                rm -f "$rd/recovery.count" "$rd/recovery.next" "$rd/recovery.cooldown_until" "$rd/supervisor.since" 2>/dev/null
                return 1
            fi
            return 0 ;;
    esac
    return 0
}

# 统一事件循环（唯一入口）：<tasks_dir> <base> → 每 tick 每任务至多一步；0=完成
supervisor_tick() {
    tasks=$1; base=$2
    [ -d "$tasks" ] || { supervisor_log "INFO tick: no tasks dir $tasks"; return 0; }
    n=0; f=0
    for rd in "$tasks"/*; do
        [ -d "$rd" ] || continue
        id=$(basename "$rd")
        tf=$(supervisor_task_file "$base" "$tasks" "$id") || continue
        supervisor_step "$rd" "$tf" >/dev/null 2>&1
        rc=$?
        if [ "$rc" -eq 1 ] || [ "$rc" -eq 2 ]; then
            n=$((n + 1))
        fi
        [ "$rc" -eq 2 ] && f=$((f + 1))
    done
    supervisor_log "INFO tick: transitions=$n failed=$f"
    return 0
}
# ────────────────────────────────────────────────────────────────────────
# §18 Crash Loop 保护与资源保护（P2-14）
# ────────────────────────────────────────────────────────────────────────
# 目标：daemon 异常退出（SIGKILL / 启动即崩）不得无限重启风暴；
#       运行日志 / 快照 / 任务目录不得无限膨胀。
# 判定模型：
#   - 崩溃证据 = **前一次运行**异常死亡（无 exit 记录 / 退出早于启动 /
#     存活 ≤ CRASH_MIN_UPTIME 且非优雅退出）；SIGKILL 不留退出记录 → 下次进入计 1 次。
#   - 时间窗内（CRASH_WINDOW）连续异常 ≥ CRASH_THRESHOLD → 降级窗口
#     （CRASH_COOLDOWN 内 crash_guard_enter 快速退出 rc 2，不做任何启动工作）。
#   - 异常退出后立即重启 → 节流（CRASH_MIN_START_INTERVAL 内 rc 3）。
#   - 优雅退出（TERM/INT/HUP trap → crash_record_exit，last_clean=1）→ 计数清零。
#   - 全部参数可经环境覆盖（daemon 端默认值见 su-schedulerd 加载段）。
# 约束：新增函数不使用 while/for/后台派生（§17 supervisor_step 结构断言不受影响）。
CRASH_WINDOW=${CRASH_WINDOW:-60}
CRASH_THRESHOLD=${CRASH_THRESHOLD:-3}
CRASH_MIN_UPTIME=${CRASH_MIN_UPTIME:-30}
CRASH_COOLDOWN=${CRASH_COOLDOWN:-300}
CRASH_MIN_START_INTERVAL=${CRASH_MIN_START_INTERVAL:-10}
HEALTH_MIN_INTERVAL=${HEALTH_MIN_INTERVAL:-30}
TASK_RUNTIME_MAX=${TASK_RUNTIME_MAX:-86400}
LOG_MAX_BYTES=${LOG_MAX_BYTES:-262144}
SNAP_MAX_KEEP=${SNAP_MAX_KEEP:-30}
TASK_DIRS_MAX=${TASK_DIRS_MAX:-200}

crash_guard_file() {   # <base> → 守护文件绝对路径
    echo "$1/runtime/daemon.guard"
}
crash_read() {   # <guard_file> <key>
    grep "^$2=" "$1" 2>/dev/null | head -1 | cut -d= -f2-
}
crash_write() {   # <guard_file> <key> <value>（临时文件 + mv 原子写）
    f=$1; k=$2; v=$3
    mkdir -p "$(dirname "$f")" 2>/dev/null
    t="$f.tmp.$$"
    if [ -f "$f" ]; then
        grep -v "^$k=" "$f" > "$t" 2>/dev/null
    else
        : > "$t"
    fi
    printf '%s=%s\n' "$k" "$v" >> "$t" 2>/dev/null
    mv "$t" "$f" 2>/dev/null
}

# 进入启动序列（daemon 加载段调用）：<base> → 0=放行并记录本次启动
#                                   2=降级窗口内快速退出  3=节流快速退出
crash_guard_enter() {
    base=$1
    gf=$(crash_guard_file "$base")
    now=$(date +%s)
    starts=$(crash_read "$gf" starts);      [ -n "$starts" ] || starts=0
    exits=$(crash_read "$gf" exits);        [ -n "$exits" ] || exits=0
    last_start=$(crash_read "$gf" last_start)
    last_exit=$(crash_read "$gf" last_exit)
    last_clean=$(crash_read "$gf" last_clean);  [ -n "$last_clean" ] || last_clean=0
    eval_start=$(crash_read "$gf" eval_start);  [ -n "$eval_start" ] || eval_start=0
    crash_seq=$(crash_read "$gf" crash_seq);    [ -n "$crash_seq" ] || crash_seq=0
    degraded_until=$(crash_read "$gf" degraded_until)

    # ① 降级窗口：COOLDOWN 未到 → 快速退出（不写锁、不建 registry、不跑 boot 任务）
    if [ -n "$degraded_until" ] && [ "$now" -lt "$degraded_until" ]; then
        return 2
    fi

    # ② 前次运行健康评估（幂等：eval_start 记已评估的 starts 计数值，每新启动
    #    至多评估一次——用单调 starts 而非秒级 last_start 时间戳，避免同秒内
    #    两次启动时间戳相同导致评估被跳过）
    if [ -n "$last_start" ] && [ "$eval_start" -lt "$starts" ]; then
        abnormal=0
        if [ "$last_clean" != "1" ]; then
            # 无退出记录（SIGKILL）或退出早于启动，或存活 ≤ CRASH_MIN_UPTIME → 异常
            if [ -z "$last_exit" ] || [ "$last_exit" -lt "$last_start" ] || \
               [ $((last_exit - last_start)) -le "$CRASH_MIN_UPTIME" ]; then
                abnormal=1
            fi
        fi
        if [ "$abnormal" -eq 1 ]; then
            # 距上次启动超出时间窗 → 计数重置为 1；否则窗口内连续计数
            if [ $((now - last_start)) -gt "$CRASH_WINDOW" ]; then
                crash_seq=1
            else
                crash_seq=$((crash_seq + 1))
            fi
        else
            crash_seq=0
        fi
        crash_write "$gf" crash_seq "$crash_seq"
        if [ "$crash_seq" -ge "$CRASH_THRESHOLD" ]; then
            degraded_until=$((now + CRASH_COOLDOWN))
            crash_write "$gf" degraded_until "$degraded_until"
        fi
        crash_write "$gf" eval_start "$starts"
    fi

    # ②b 评估后再次检查降级窗口（阈值命中即刻快速退出，不重复计数）
    if [ -n "$degraded_until" ] && [ "$now" -lt "$degraded_until" ]; then
        return 2
    fi

    # ③ 节流：前次异常退出且距上次启动 < CRASH_MIN_START_INTERVAL → 快速退出
    if [ "$last_clean" != "1" ] && [ -n "$last_start" ] && [ "$now" -lt $((last_start + CRASH_MIN_START_INTERVAL)) ]; then
        return 3
    fi

    # ④ 记录本次启动（starts++；前次无退出记录 → exits++ 一并补记）
    starts=$((starts + 1))
    if [ -n "$last_start" ] && { [ -z "$last_exit" ] || [ "$last_exit" -lt "$last_start" ]; }; then
        exits=$((exits + 1))
    fi
    crash_write "$gf" starts "$starts"
    crash_write "$gf" exits "$exits"
    crash_write "$gf" last_start "$now"
    crash_write "$gf" last_clean 0
    return 0
}

# 优雅退出记录（daemon trap 处理器）：<base> <rc> → last_clean=1（下次进入不视为崩溃）
crash_record_exit() {
    base=$1; rc=${2:-0}
    gf=$(crash_guard_file "$base")
    now=$(date +%s)
    exits=$(crash_read "$gf" exits);  [ -n "$exits" ] || exits=0
    exits=$((exits + 1))
    crash_write "$gf" exits "$exits"
    crash_write "$gf" last_exit "$now"
    crash_write "$gf" last_exit_rc "$rc"
    crash_write "$gf" last_clean 1
    return 0
}

# 日志截断：<file> <max_bytes> → 超限则保留尾部 max/2 字节（临时文件 + mv 原子）
runtime_limit_log() {
    f=$1; max=$2
    [ -f "$f" ] || return 0
    sz=$(wc -c < "$f" 2>/dev/null)
    [ -n "$sz" ] && [ "$sz" -gt "$max" ] || return 0
    keep=$((max / 2))
    t="$f.tmp.$$"
    tail -c "$keep" "$f" > "$t" 2>/dev/null && mv "$t" "$f" 2>/dev/null
    return 0
}

# 运行目录是否活跃：pid.txt 进程存活 或 状态机处于运行态（含门控等待 WAITING——
# P4-04：依赖未满足的 WAITING 任务目录不得被上限修剪误删，P4-07 深化）
runtime_dir_active() {
    rd=$1
    pid=$(cat "$rd/pid.txt" 2>/dev/null)
    if [ -n "$pid" ] && [ -d "/proc/$pid" ] 2>/dev/null; then
        return 0
    fi
    st=$(cat "$rd/status.txt" 2>/dev/null)
    case "$st" in
        STARTING|RUNNING|HEALTHY|UNHEALTHY|RECOVERING|STOPPING) return 0 ;;
    esac
    case "$(cat "$rd/state.txt" 2>/dev/null)" in
        WAITING) return 0 ;;
    esac
    return 1
}

# 任务目录上限修剪：<tasks_dir> <max> → 最新（ls -t）优先，超限且非活跃的删除
runtime_prune_tasks() {
    td=$1; max=$2
    [ -d "$td" ] || return 0
    n=0
    for rd in $(ls -dt "$td"/* 2>/dev/null); do
        [ -d "$rd" ] || continue
        n=$((n + 1))
        [ "$n" -le "$max" ] && continue
        if runtime_dir_active "$rd"; then
            continue
        fi
        rm -rf "$rd" 2>/dev/null
    done
    return 0
}

# 快照上限修剪：<base> <max> → 保留 current 指针所指快照 + 其余最新 max 个
runtime_prune_snapshots() {
    base=$1; max=$2
    sd="$base/snapshots"
    [ -d "$sd" ] || return 0
    cur=$(cat "$base/current" 2>/dev/null)
    keep_cur=""
    [ -n "$cur" ] && [ -d "$sd/$cur" ] && keep_cur="$sd/$cur"
    [ "$max" -lt 1 ] && max=1
    n=0
    for sp in $(ls -dt "$sd"/snap_* 2>/dev/null); do
        [ -d "$sp" ] || continue
        if [ -n "$keep_cur" ] && [ "$sp" = "$keep_cur" ]; then
            continue
        fi
        n=$((n + 1))
        [ "$n" -le "$max" ] && continue
        rm -rf "$sp" 2>/dev/null
    done
    return 0
}

# 总资源保护（daemon 每 tick）：<base> → 日志截断 + 快照修剪
runtime_protect() {
    base=$1
    runtime_limit_log "$base/su-scheduler.log" "$LOG_MAX_BYTES"
    runtime_limit_log "$base/audit/audit.log" "$LOG_MAX_BYTES"
    runtime_limit_log "$base/shadow/shadow.log" "$LOG_MAX_BYTES"
    runtime_prune_snapshots "$base" "$SNAP_MAX_KEEP"
    return 0
}

# 任务目录资源保护（daemon 每 tick）：<tasks_dir> → 单 Task 日志字节上限截断
# + 目录数上限修剪
runtime_protect_tasks() {
    td=$1
    for rd in "$td"/*; do
        [ -d "$rd" ] || continue
        runtime_limit_task_log "$rd"
    done
    runtime_prune_tasks "$td" "$TASK_DIRS_MAX"
    return 0
}

# 健康探针到期判定：<run_dir> → 0=应探活 1=未到期（HEALTH_MIN_INTERVAL ≤0 → 恒到期）
supervisor_health_due() {
    rd=$1
    [ "$HEALTH_MIN_INTERVAL" -le 0 ] 2>/dev/null && return 0
    last=$(cat "$rd/health.last" 2>/dev/null)
    [ -n "$last" ] || return 0
    now=$(date +%s)
    if [ $((now - last)) -ge "$HEALTH_MIN_INTERVAL" ]; then
        return 0
    fi
    return 1
}
supervisor_health_mark() {   # <run_dir>
    date +%s > "$1/health.last" 2>/dev/null
    return 0
}

# 运行超时判定：<run_dir> [timeout] → 0=超时 1=未超时（timeout≤0 → 恒不超时）
# P3-08：第二参为可选的有效超时（§25 secv_effective_timeout 产出；缺省
# TASK_RUNTIME_MAX）——每个 Action 必须有超时（per-task advanced.timeout 生效，
# 且不超全局护栏）。
supervisor_runtime_exceeded() {
    rd=$1; tmx=${2:-$TASK_RUNTIME_MAX}
    [ "$tmx" -le 0 ] 2>/dev/null && return 1
    since=$(cat "$rd/supervisor.since" 2>/dev/null)
    [ -n "$since" ] || return 1
    now=$(date +%s)
    if [ $((now - since)) -ge "$tmx" ]; then
        return 0
    fi
    return 1
}
# ────────────────────────────────────────────────────────────────────────
# §19 Canonical Task Config Store & Migration（P3-02）
# ────────────────────────────────────────────────────────────────────────
# 双模式配置权威：
#   - Legacy（默认，无 MANAGED 标记）：config.txt 是**唯一配置源**，daemon/CLI
#     行为不变（C2/C4 零改动）；
#   - Managed（显式导入后）：task-config/ 是**权威配置源**，config.txt 保留为
#     备份与兼容导出。迁移可回滚、不静默覆盖用户配置、重复导入幂等。
# 存储：<TCFG_DIR|/data/adb/su-scheduler/task-config>/（独立于运行目录 tasks/）
#   MANAGED                   标记文件（存在 = managed；**最后写**，中断不产生
#                             半管理态——没有标记则一切按 legacy）
#   manifest                 元数据（mode/source/imported_at/count/…）
#   backup/config.txt.<ts>   导入前逐字节备份（回滚源；导入过程**永不改写**
#                             config.txt 本身）
#   <id>.task                每任务一个 POSIX key=value Task v2 文件
# 幂等/安全：
#   - 导入：备份 → 解析到 staging → 逐文件校验 → 幂等提升（已存在 id 跳过，
#     不覆盖既有条目）→ 写 manifest + MANAGED（最后）；
#   - 全部写经 tmp+mv 原子；任意失败不留半成品（staging 清理 + 已提升文件完整）；
#   - 导入失败时 config.txt 逐字节不变（导入从不写 config.txt）；
#   - 新建任务 ID 用 task_<trigger_norm>_<n>，避免与 legacy t<line>_<trigger>
#     命名空间冲突（ID 兼容规则见 docs/architecture/config-authority.md）。
# ═══════════════════════════════════════════════════════════════════════════
tcfg_dir() { echo "${TCFG_DIR:-/data/adb/su-scheduler/task-config}"; }
tcfg_managed_marker() { echo "$(tcfg_dir)/MANAGED"; }
tcfg_manifest_file() { echo "$(tcfg_dir)/manifest"; }
tcfg_backup_dir() { echo "$(tcfg_dir)/backup"; }

tcfg_is_managed() { [ -f "$(tcfg_managed_marker)" ] && return 0 || return 1; }
tcfg_mode() { tcfg_is_managed && echo managed || echo legacy; }

tcfg_task_file() { echo "$(tcfg_dir)/$1.task"; }
tcfg_task_ids() {
    d=$(tcfg_dir)
    [ -d "$d" ] || return 0
    for f in "$d"/*.task; do
        [ -f "$f" ] || continue
        basename "$f" .task
    done | sort
}
tcfg_task_count() { tcfg_task_ids | sed '/^$/d' | wc -l; }

# 原子写：<target>（内容从 stdin 读取）→ tmp + mv；失败清理 tmp
tcfg_atomic_write() {
    t=$1
    td=$(dirname "$t")
    mkdir -p "$td" 2>/dev/null || return 2
    tmp="$t.tmp.$$"
    cat > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 2; }
    mv "$tmp" "$t" 2>/dev/null || { rm -f "$tmp"; return 2; }
    return 0
}

tcfg_get() {   # <file> <key> → 值（无则空）
    grep "^$2=" "$1" 2>/dev/null | head -1 | cut -d= -f2-
}

# 校验单个任务文件：schema_version=2 + id==文件名 + trigger 非空
tcfg_validate_task() {   # <file> → 0 合法 / 1 非法（绝不清空、绝不退出）
    # 命名空间：内部变量一律 tcfgv_ 前缀，**不覆盖调用方全局变量**
    #（POSIX sh 无局部变量——防 `base`/`id`/`tr` 等被 clobber，P3-03 审计发现）。
    tcfgv_f=$1
    [ -f "$tcfgv_f" ] || return 1
    tcfgv_sv=$(tcfg_get "$tcfgv_f" schema_version)
    [ "$tcfgv_sv" = "2" ] || return 1
    tcfgv_id=$(tcfg_get "$tcfgv_f" id)
    tcfgv_base=$(basename "$tcfgv_f" .task)
    [ -n "$tcfgv_id" ] && [ "$tcfgv_id" = "$tcfgv_base" ] || return 1
    tcfgv_tr=$(tcfg_get "$tcfgv_f" trigger)
    [ -n "$tcfgv_tr" ] || return 1
    # P4-02：dependency/condition 字段做存储层语法 sanity（缺省/空即合法；
    # 非法 → 该条目非法，绝不清空/退出，B9 原子性由调用方保证）
    tcfgv_dep=$(tcfg_get "$tcfgv_f" dependency)
    dep_validate "$tcfgv_dep" || return 1
    tcfgv_cond=$(tcfg_get "$tcfgv_f" condition)
    cond_validate "$tcfgv_cond" || return 1
    [ -z "$tcfgv_cond" ] || cond_grammar_ok "$tcfgv_cond" || return 1   # P4-06 文法/白名单
    return 0
}

# 写入一个任务文件（内容 stdin；managed 语义下由调用方保证权威性）
tcfg_write_task() {   # <id>
    id=$1
    f=$(tcfg_task_file "$id")
    tcfg_atomic_write "$f" || return 2
    return 0
}

# 新建任务 ID：<trigger> → task_<trigger_norm>_<n>（避免与 legacy t<line>_ 冲突）
tcfg_new_id() {   # <trigger>
    trig=$1
    norm=$(echo "$trig" | sed 's/://g')
    n=1
    while [ -f "$(tcfg_task_file "task_${norm}_${n}")" ]; do
        n=$((n + 1))
    done
    echo "task_${norm}_${n}"
}

# 导入：config.txt → task-config/（备份 + staging 解析 + 校验 + 幂等提升 + 标记）
# 返回：0=成功（含全部跳过） 1=无有效任务/配置无效（config 逐字节不变）
#       2=硬错误（目录不可建/备份失败等）
tcfg_import() {   # <config>
    cfg=$1
    d=$(tcfg_dir)
    mkdir -p "$d" 2>/dev/null || { echo "[task-config] ERROR: cannot mkdir $d" >&2; return 2; }
    [ -f "$cfg" ] || { echo "[task-config] ERROR: config not found: $cfg" >&2; return 2; }

    # ① 逐字节备份（导入过程永不改写 config.txt 本身）
    ts=$(date +%Y%m%d-%H%M%S)
    bk="$(tcfg_backup_dir)/config.txt.$ts"
    mkdir -p "$(tcfg_backup_dir)" 2>/dev/null || { echo "[task-config] ERROR: cannot mkdir backup" >&2; return 2; }
    cp "$cfg" "$bk" 2>/dev/null || { echo "[task-config] ERROR: backup failed" >&2; return 2; }

    # ② 解析到 staging（不直接写 task-config/，失败不污染正式目录）
    stage="$d/.staging.$$"
    rm -rf "$stage" 2>/dev/null
    mkdir -p "$stage" 2>/dev/null || { rm -rf "$stage"; return 2; }
    legacy_adapter_parse "$cfg" "$stage" >/dev/null 2>&1
    arc=$?

    # P4-03：导入整体依赖图校验（未知/自依赖/环）——校验「最终有效集合」=
    # 既有 task-config + staging 新任务（幂等提升后）。非法 → 拒绝，config 逐字节不变
    merge="$d/.merge.$$"
    rm -rf "$merge" 2>/dev/null
    mkdir -p "$merge" 2>/dev/null || { rm -rf "$stage" "$merge" 2>/dev/null; return 2; }
    for f in "$d"/*.task; do
        [ -f "$f" ] && cp "$f" "$merge/" 2>/dev/null
    done
    for f in "$stage"/*.task; do
        [ -f "$f" ] && cp "$f" "$merge/" 2>/dev/null
    done
    if ! dep_validate_graph "$merge" "" "" "[task-config] ERROR:"; then
        rm -rf "$stage" "$merge" 2>/dev/null
        echo "[task-config] ERROR: import rejected (dependency graph invalid); config unchanged" >&2
        return 1
    fi
    rm -rf "$merge" 2>/dev/null

    # ③ 统计并校验 staging 内任务
    n=0; invalid=0
    for f in "$stage"/*.task; do
        [ -f "$f" ] || continue
        n=$((n + 1))
        if ! tcfg_validate_task "$f"; then
            invalid=$((invalid + 1))
        fi
    done

    if [ "$n" -eq 0 ] || [ "$invalid" -ne 0 ]; then
        rm -rf "$stage" 2>/dev/null
        echo "[task-config] WARNING: no valid tasks parsed (rc=$arc n=$n invalid=$invalid); config unchanged" >&2
        return 1
    fi

    # ④ 幂等提升：已存在 id 跳过（重复导入不产生重复 Task、不覆盖既有条目）
    promoted=0; skipped=0
    for f in "$stage"/*.task; do
        [ -f "$f" ] || continue
        id=$(basename "$f" .task)
        target="$(tcfg_task_file "$id")"
        if [ -f "$target" ]; then
            skipped=$((skipped + 1))
            continue
        fi
        tmp="$target.tmp.$$"
        if cp "$f" "$tmp" 2>/dev/null && mv "$tmp" "$target" 2>/dev/null; then
            promoted=$((promoted + 1))
        else
            rm -f "$tmp" 2>/dev/null
        fi
    done
    rm -rf "$stage" 2>/dev/null

    # ⑤ manifest + MANAGED 标记（**最后写** → 中断不产生半管理态）
    {
        echo "mode=managed"
        echo "source=$cfg"
        echo "imported_at=$ts"
        echo "count=$n"
        echo "promoted=$promoted"
        echo "skipped=$skipped"
        echo "backup=$bk"
    } | tcfg_atomic_write "$(tcfg_manifest_file)" >/dev/null 2>&1
    echo "managed" | tcfg_atomic_write "$(tcfg_managed_marker)" >/dev/null 2>&1

    echo "[task-config] import ok: n=$n promoted=$promoted skipped=$skipped"
    return 0
}

# 导出：task-config/ → 兼容 legacy config.txt（schema §8.4 反向；块任务输出
# 重构行，兼容导出非逐字节还原）
tcfg_export() {   # <out_config> → 0 成功（跳过非法任务）
    out=$1
    d=$(tcfg_dir)
    tmp="$out.tmp.$$"
    : > "$tmp" 2>/dev/null || return 2
    ok=0
    for f in "$d"/*.task; do
        [ -f "$f" ] || continue
        tcfg_validate_task "$f" || continue
        trig=$(tcfg_get "$f" trigger)
        cmd=$(tcfg_get "$f" action.command)
        flags=""
        ns=$(tcfg_get "$f" action.notify_start);  [ "$ns" = "1" ] && flags="$flags --notify-start"
        ne=$(tcfg_get "$f" action.notify_end);    [ "$ne" = "1" ] && flags="$flags --notify-end"
        del=$(tcfg_get "$f" action.delete);       [ "$del" = "1" ] && flags="$flags --delete"
        tx=$(tcfg_get "$f" action.termux);        [ "$tx" = "1" ] && flags="$flags --termux"
        ix=$(tcfg_get "$f" action.interactive);   [ "$ix" = "1" ] && flags="$flags --interactive"
        rn=$(tcfg_get "$f" action.run_once_now);  [ "$rn" = "1" ] && flags="$flags --run-once-now"
        bt=$(tcfg_get "$f" action.boot);          [ "$bt" = "1" ] && flags="$flags --boot"
        msg=$(tcfg_get "$f" action.msg);          [ -n "$msg" ] && flags="$flags --msg=\"$msg\""
        if [ -n "$flags" ]; then
            printf '%s %s; :%s\n' "$trig" "$cmd" "$flags" >> "$tmp"
        else
            printf '%s %s\n' "$trig" "$cmd" >> "$tmp"
        fi
        ok=$((ok + 1))
    done
    mv "$tmp" "$out" 2>/dev/null || { rm -f "$tmp"; return 2; }
    echo "[task-config] export ok: $ok tasks -> $out"
    return 0
}

# 回滚：恢复 config.txt 备份 + 移除 MANAGED 标记（回到 legacy；文件保留为惰性）
tcfg_rollback() {   # <config> → 0 成功（含 no-op） 2 硬错误
    cfg=$1
    if ! tcfg_is_managed; then
        echo "[task-config] rollback: not managed (no-op)"
        return 0
    fi
    bk=$(ls -1t "$(tcfg_backup_dir)"/config.txt.* 2>/dev/null | head -1)
    if [ -n "$bk" ] && [ -f "$bk" ]; then
        cp "$bk" "$cfg" 2>/dev/null || { echo "[task-config] ERROR: restore failed" >&2; return 2; }
        echo "[task-config] rollback: restored config from $bk"
    else
        echo "[task-config] WARNING: no backup found; removing marker only" >&2
    fi
    rm -f "$(tcfg_managed_marker)" 2>/dev/null
    echo "[task-config] rollback: managed mode disabled"
    return 0
}

# 字段更新（managed 才允许；tmp+mv 原子）——WebUI/CLI 编辑的持久化底座
tcfg_set_field() {   # <id> <key> <value> → 0/1/2
    id=$1; key=$2; value=$3
    tcfg_is_managed || { echo "[task-config] ERROR: not managed (import first)" >&2; return 1; }
    f=$(tcfg_task_file "$id")
    [ -f "$f" ] || { echo "[task-config] ERROR: task not found: $id" >&2; return 1; }
    # P4-02：dependency/condition 走后端权威校验；非法 → 拒绝且原文件逐字节不变
    case "$key" in
        dependency) dep_validate "$value" || { echo "[task-config] ERROR: invalid dependency '$value' (expect '[?]<task-id>[:STATE]', <= $DEP_MAX entries)" >&2; return 1; } ;;
        condition)
            cond_validate "$value" || { echo "[task-config] ERROR: invalid condition (printable ASCII, <= $COND_MAX_LEN chars)" >&2; return 1; }
            [ -z "$value" ] || cond_grammar_ok "$value" || { echo "[task-config] ERROR: invalid condition expression (whitelisted predicates only; see docs/P4-06.md)" >&2; return 1; } ;;
    esac
    # P4-03：写 dependency 键后做依赖图校验（未知/自依赖/环）——「当前目录 +
    # 本字段写改后的有效集合」判定；失败 → 拒绝且原文件逐字节不变
    if [ "$key" = "dependency" ]; then
        depg_cfg=""
        if grep -q "^dependency=" "$f"; then
            depg_cfg=$(grep -v '^dependency=' "$f")
        else
            depg_cfg=$(cat "$f")
        fi
        depg_cfg="${depg_cfg}
dependency=$value"
        dep_validate_graph "$(tcfg_dir)" "$id" "$depg_cfg" || return 1
    fi
    tmp="$f.tmp.$$"
    if grep -q "^$key=" "$f"; then
        grep -v "^$key=" "$f" > "$tmp" 2>/dev/null
    else
        cp "$f" "$tmp" 2>/dev/null
    fi
    printf '%s=%s\n' "$key" "$value" >> "$tmp" 2>/dev/null
    mv "$tmp" "$f" 2>/dev/null || { rm -f "$tmp"; return 2; }
    return 0
}

# 新建 Task（managed；最小 Task v2 文件；ID 走 tcfg_new_id 或用户给定）
tcfg_new_task() {   # <id> <trigger> <command> → 0/1/2
    id=$1; trig=$2; cmd=$3
    tcfg_is_managed || { echo "[task-config] ERROR: not managed (import first)" >&2; return 1; }
    case "$id" in
        *[!A-Za-z0-9_.-]*) echo "[task-config] ERROR: invalid id '$id'" >&2; return 1 ;;
    esac
    f=$(tcfg_task_file "$id")
    [ -f "$f" ] && { echo "[task-config] ERROR: task exists: $id" >&2; return 1; }
    name=$(echo "$cmd" | awk '{print $1}' | cut -c1-40)
    [ -n "$name" ] || name=task
    {
        echo "schema_version=2"
        echo "id=$id"
        echo "name=$name"
        echo "enabled=1"
        echo "trigger=$trig"
        echo "action.type=command"
        echo "action.command=$cmd"
        echo "action.notify_start=0"
        echo "action.notify_end=0"
        echo "action.delete=0"
        echo "action.termux=0"
        echo "action.interactive=0"
        echo "action.run_once_now=0"
        echo "action.boot=0"
        echo "action.msg="
        echo "health.type=none"
        echo "health.target="
        echo "recovery.type=none"
        echo "retry.max=0"
        echo "retry.interval=60"
    } | tcfg_atomic_write "$f" || return 2
    return 0
}

# 删除 Task（managed）：<id> → 0/1/2（文件级删除；不触碰运行目录）
tcfg_remove_task() {   # <id>
    id=$1
    tcfg_is_managed || { echo "[task-config] ERROR: not managed (import first)" >&2; return 1; }
    f=$(tcfg_task_file "$id")
    [ -f "$f" ] || { echo "[task-config] ERROR: task not found: $id" >&2; return 1; }
    rm -f "$f" 2>/dev/null || return 2
    return 0
}
# ────────────────────────────────────────────────────────────────────────
# §20 Scheduler-Prod（P3-03）：Registry 正式调度源
# ────────────────────────────────────────────────────────────────────────
# 把 Registry 从 Shadow Mode 提升为**正式调度数据源**，结束「Registry 旁路、
# legacy 实际执行」的双轨状态。调用方（daemon 主循环 RUNTIME_LOADED=1 分支）
# 只经 `scheduler_tick` 获取任务：
#   Registry Task ──trigger_decide(TriggerProvider)──▶ 到期？
#       ├─due=Y + 依赖门控通过（P4-04）─▶ action_run(ActionProvider) ─▶ State
#       └─due=Y + 依赖门控未过（P4-04）─▶ PENDING>WAITING（下一 tick 复查）
# 双模式：
#   - managed（task-config/MANAGED 存在，P3-02）：registry 快照从 task-config/
#     重建（**不再重新扫描 config.txt**）；
#   - legacy（无 MANAGED，config.txt 权威）：registry_reload(config.txt)（KEPT
#     回退最后有效快照）；RUNTIME_LOADED=0 时 daemon 走既有 config.txt 扫描
#     （C2 fallback 原样）。
# 语义保证：
#   - 原子切换：reload 只写新快照 + 原子 flip current 指针；损坏/无效 → KEPT；
#   - 每周期去重：同任务在一个调度周期（分钟）至多执行一次（cycle 标记文件）；
#   - 配置变更不产生重复执行：reload 以源指纹（md5）判定，仅变化才重建；
#   - 单任务错误隔离：任何 Task 失败只记 audit、不中止整个 tick；
#   - 后置语义保留：--run-once-now（执行后置 0/修剪源行）、--delete（执行后
#     移除）；heredoc/Termux/Interactive/notify/msg 经 action_run 原样透传；
#   - 旧运行目录/旧运行 ID：执行落 `tasks/<id>`（canonical），idmap（§9）双向
#     映射保留，旧 CLI 查询/终止不变；
#   - 快照移除的运行任务仍被监督：执行时把任务文件 stash 到运行目录
#     `task.v2`，supervisor_task_file 兜底读取（P3-03 要求 9）。
# 审计：调度来源与每次决策/执行/重载落盘 `<base>/scheduler/audit.log`。
# ═══════════════════════════════════════════════════════════════════════════
sched_log() { [ "${SCHED_LOG:-1}" = "1" ] && echo "[scheduler] $1" >&2; }
sched_audit_file() { echo "$1/scheduler/audit.log"; }
sched_audit() {   # <base> <line> — 调度来源审计日志（追加一行）
    base=$1; line=$2
    f=$(sched_audit_file "$base")
    mkdir -p "$(dirname "$f")" 2>/dev/null
    echo "$(date '+%Y-%m-%d %H:%M:%S')|$line" >> "$f" 2>/dev/null
    return 0
}
sched_source_mode() {   # <base> → managed|legacy
    if tcfg_is_managed; then echo managed; else echo legacy; fi
}
sched_ensure_base() {   # <base> → 确保 TR_BASE 就绪（registry 快照定位）
    base=$1
    if [ -z "${TR_BASE:-}" ]; then
        registry_attach "$base" >/dev/null 2>&1
    fi
    [ -n "${TR_BASE:-}" ]
}
# 源指纹：managed=task-config 内容；legacy=config.txt 内容（用于判定是否需要 reload）
sched_source_fingerprint() {   # <base> <config>
    if tcfg_is_managed; then
        ( cat "$(tcfg_managed_marker)" 2>/dev/null; ls -l "$(tcfg_dir)"/*.task 2>/dev/null ) | md5sum | cut -d' ' -f1
    else
        [ -f "$2" ] && md5sum "$2" | cut -d' ' -f1
    fi
}
# managed：从 task-config/ 重建 registry 快照（复制 + 校验 + 原子 flip current；KEPT）
sched_snapshot_managed() {   # <base> → 0=ok 1=无有效任务(KEPT) 2=硬错误
    base=$1
    src=$(tcfg_dir)
    [ -d "$src" ] || return 2
    mkdir -p "$base/snapshots" 2>/dev/null || return 2
    sid=$(registry_snapshot_next)
    sdir="$base/snapshots/$sid"
    mkdir -p "$sdir" 2>/dev/null || return 2
    n=0
    for f in "$src"/*.task; do
        [ -f "$f" ] || continue
        if tcfg_validate_task "$f"; then
            id=$(basename "$f" .task)
            cp "$f" "$sdir/$id.task" 2>/dev/null && n=$((n + 1))
        fi
    done
    if [ "$n" -eq 0 ]; then
        rm -rf "$sdir" 2>/dev/null
        return 1
    fi
    # P4-03：快照构建时依赖图过滤——源目录图非法（未知/自依赖/环）→ KEPT：
    # 不写 current，维持旧快照（config 自愈语义：宁可沿用旧快照不引入坏图）
    if ! dep_validate_graph "$src" "" "" "[task-config] ERROR:"; then
        sched_audit "$base" "op=snapshot-managed|rc=1|reason=dependency-graph-invalid|kept=1"
        rm -rf "$sdir" 2>/dev/null
        return 1
    fi
    { echo "snapshot=$sid"; echo "config=task-config"; echo "task_count=$n"; } > "$sdir/manifest.tmp" 2>/dev/null \
        && mv "$sdir/manifest.tmp" "$sdir/manifest" 2>/dev/null
    echo "$sid" > "$base/current.tmp" 2>/dev/null && mv "$base/current.tmp" "$base/current" 2>/dev/null
    TASK_REGISTRY_SNAPSHOT=$sid
    return 0
}
# 原子重载：源变化才重建；managed→task-config；legacy→registry_reload（KEPT）
sched_reload() {   # <base> <config> → 0=未变/ok 1=kept 2=硬错误
    base=$1; config=$2
    sched_ensure_base "$base" || return 2
    mkdir -p "$base/scheduler" 2>/dev/null
    fp=$(sched_source_fingerprint "$base" "$config")
    old=$(cat "$base/scheduler/source.md5" 2>/dev/null)
    if [ -n "$old" ] && [ "$old" = "$fp" ]; then
        return 0
    fi
    if tcfg_is_managed; then
        sched_snapshot_managed "$base"
        rc=$?
    else
        [ -f "$config" ] || { sched_audit "$base" "op=reload|mode=$(sched_source_mode "$base")|rc=2|reason=no-config"; return 2; }
        registry_reload "$config" >/dev/null 2>&1
        rc=$?
    fi
    printf '%s\n' "$fp" > "$base/scheduler/source.md5" 2>/dev/null
    sched_audit "$base" "op=reload|mode=$(sched_source_mode "$base")|rc=$rc"
    return "$rc"
}
# 周期去重（分钟级）：<base> <token>；seen=0 已执行
sched_cycle_file() { echo "$1/scheduler/cycle-$2"; }
# P4-04：周期 token 可经 SCHED_CYCLE_NOW 覆盖（测试确定性；生产缺省 = 真实分钟）
sched_cycle_token() { echo "${SCHED_CYCLE_NOW:-$(date +%Y%m%d%H%M)}"; }
sched_cycle_mark() {   # <base> <id> <token>
    f=$(sched_cycle_file "$1" "$3")
    mkdir -p "$(dirname "$f")" 2>/dev/null
    printf '%s\n' "$2" >> "$f" 2>/dev/null
}
sched_cycle_seen() {   # <base> <id> <token> → 0=已执行
    f=$(sched_cycle_file "$1" "$3")
    [ -f "$f" ] && grep -qx "$2" "$f" 2>/dev/null
}
sched_task_field() {   # <task_file> <key> → 值
    grep "^$2=" "$1" 2>/dev/null | head -1 | cut -d= -f2-
}
# 原子更新任务文件字段（tmp+mv）
sched_set_task_field() {   # <file> <key> <value>
    f=$1; key=$2; val=$3
    t="$f.tmp.$$"
    if grep -q "^$key=" "$f" 2>/dev/null; then
        awk -v k="$key" -v v="$val" '{ if (index($0, k"=")==1) print k"="v; else print }' "$f" > "$t" 2>/dev/null
    else
        cp "$f" "$t" 2>/dev/null
        printf '%s=%s\n' "$key" "$val" >> "$t" 2>/dev/null
    fi
    mv "$t" "$f" 2>/dev/null || rm -f "$t" 2>/dev/null
    return 0
}
# 后置：--delete 执行后移除（managed→task-config + 快照；legacy→config.txt 行 + 快照）
sched_remove_task() {   # <base> <config> <id> → 0/1/2
    base=$1; config=$2; id=$3
    tf=$(registry_task_file "$id" 2>/dev/null) || return 1
    if tcfg_is_managed; then
        tcfg_remove_task "$id" >/dev/null 2>&1
    else
        # legacy：按 source.line 删除 config.txt 对应行（line 或 a-b 范围；Q13 尽力而为）
        [ -f "$config" ] || return 0
        sl=$(sched_task_field "$tf" source.line)
        case "$sl" in
            *-*)
                a=${sl%%-*}; b=${sl#*-}
                sed "${a},${b}d" "$config" > "$config.tmp" 2>/dev/null && mv "$config.tmp" "$config" 2>/dev/null ;;
            *[0-9]*)
                sed "${sl}d" "$config" > "$config.tmp" 2>/dev/null && mv "$config.tmp" "$config" 2>/dev/null ;;
        esac
    fi
    rm -f "$tf" 2>/dev/null
    sched_audit "$base" "op=delete|task=$id|mode=$(sched_source_mode "$base")"
    return 0
}
# 后置：--run-once-now 执行后置 0 并修剪源（managed→task-config；legacy→config.txt 行）
sched_prune_ron() {   # <base> <config> <id>
    base=$1; config=$2; id=$3
    tf=$(registry_task_file "$id" 2>/dev/null) || return 1
    sched_set_task_field "$tf" action.run_once_now 0 >/dev/null 2>&1
    if tcfg_is_managed; then
        tcfg_set_field "$id" action.run_once_now 0 >/dev/null 2>&1
    else
        [ -f "$config" ] || return 0
        sl=$(sched_task_field "$tf" source.line)
        case "$sl" in
            *[0-9]*)
                # 仅单行任务修剪（块任务 ron 罕见，保留 config 原样）
                awk -v n="${sl%%-*}" '{ if (NR==n) { gsub("--run-once-now",""); gsub(/  */," "); gsub(/ :[ \t]*$/,""); gsub(/[ \t]+$/,""); print } else print }' "$config" > "$config.tmp" 2>/dev/null \
                    && mv "$config.tmp" "$config" 2>/dev/null ;;
        esac
    fi
    sched_audit "$base" "op=prune-ron|task=$id|mode=$(sched_source_mode "$base")"
    return 0
}
# ────────────────────────────────────────────────────────────────────────
# §20 P4-04/P4-05 依赖门控（WAITING 状态接线 + Required/Optional 失败传播）：
# 把 TSM reserved 边（PENDING>WAITING / WAITING>STARTING / WAITING>PENDING /
# WAITING>FAILED）接入调度层。门控插入点 = sched_execute_one 的 due=Y 分支内、
# trigger_decide 之后、action_run 之前；另在 scheduler_tick 首部对已 WAITING
# 任务逐周期复查（sched_advance_waiting）。
# 语义（docs/P4-04.md / docs/P4-05.md / dependency-schema.md ADR D11–D17）：
#   - 依赖满足判定：读运行目录实时态 `runtime_current_state <tasks>/<dep_id>`（
#     缺省 PENDING）；Required 须达到该 entry 指定 `:STATE`（缺省 STOPPED，含
#     `:FAILED` + dep FAILED → 满足）；`?` Optional 未满足不阻断（只记原因）。
#   - P4-05 失败传播：Required 依赖已终态（STOPPED|FAILED）但 != 指定 :STATE →
#     `sched_dep_satisfied` 返回 2（dep failed）→ sched_advance_waiting **立即**
#     WAITING>FAILED（不等 WAIT_MAX）；依赖缺失（dep missing）/ 禁用（dep
#     disabled）/ 非终态（dep unsat）→ 返回 1（可等待）→ 有界等待，超时 FAILED。
#   - 进入 WAITING：触发匹配 + 依赖未满足 → PENDING>WAITING（gate_wait 事件，
#     msg=原因如 `dep unsat: t_b`）；终态（STOPPED/FAILED）先 rearm 回 PENDING
#     再门控（TSM 无 STOPPED>WAITING 边）。
#   - 解除：WAITING 任务依赖全部满足 + 触发仍匹配 → WAITING>STARTING（gate_ok）
#     → action_run；依赖仍不满足 → 保持 WAITING（等待）；触发不再匹配 →
#     WAITING>PENDING（rearm，避免永久挂起）；超过 WAIT_MAX 秒 → WAITING>FAILED
#     （gate_fail，硬性有界；msg 附依赖原因）。
#   - 每触发窗口至多执行一次：门控不改 cycle 去重——进入 WAITING 不 mark cycle，
#     解除后同一窗口至多执行一次（执行时 mark）；未解除不误标为已执行。
#   - 重启保留：state_rehydrate_residual 不再把 WAITING→FAILED（P4-04 合法语义
#     变更）；重启后下个 tick 复查依赖，gate.wait_start 重新计时（有界）。
# 常量：WAIT_MAX=86400 秒（P4-05 语义：进入 WAITING 起超过仍不满足则 FAILED；
# 终态不匹配立即 FAILED 不受其限），可经环境覆盖（测试用短超时）。
# 命名空间：函数 sched_gate_/sched_dep_/sched_advance_ 前缀，内部全局 gdv_ 前缀。
# ═══════════════════════════════════════════════════════════════════════════
WAIT_MAX=${WAIT_MAX:-86400}

sched_gate_file()  { echo "$1/gate.wait_start"; }
# P4-04：门控时钟可经 GATE_NOW 覆盖（测试确定性；生产缺省 = 真实 epoch 秒）
sched_gate_epoch() { echo "${GATE_NOW:-$(date +%s)}"; }
sched_gate_start() {   # <run_dir> → 记录等待起点（epoch 秒）
    gdv_f=$(sched_gate_file "$1")
    [ -f "$gdv_f" ] || echo "$(sched_gate_epoch)" > "$gdv_f" 2>/dev/null
    return 0
}
sched_gate_clear() {   # <run_dir> → 清除等待起点
    rm -f "$(sched_gate_file "$1")" 2>/dev/null
    return 0
}
sched_gate_elapsed() {   # <run_dir> → echo 已等待秒数（无起点 → 0）
    gdv_f=$(sched_gate_file "$1")
    if [ -f "$gdv_f" ]; then
        gdv_s=$(cat "$gdv_f" 2>/dev/null)
        case "$gdv_s" in
            ''|*[!0-9]*) echo 0 ;;
            *) echo $(( $(sched_gate_epoch) - gdv_s )) ;;
        esac
    else
        echo 0
    fi
}

# ────────────────────────────────────────────────────────────────────────
# §20b P4-07 Supervisor/Recovery/Retry 联动：FAILED>WAITING 重试退避接线
# ────────────────────────────────────────────────────────────────────────
# 需求（docs/P4-07.md / dependency-schema.md ADR D23–D26）：
#   - 接线 FAILED>WAITING（reserved 边，cause rearm）：任务 FAILED（action_failure
#     执行失败 或 gate_fail 依赖失败传播）后，retry 策略允许（retry.max>0 且未达
#     上限）→ 按既有 retry 语义进入 WAITING 退避。其余 FAILED 终态保持既有
#     （FAILED>PENDING rearm 由 sched_execute_one 既有路径维持）。
#   - 运行目录工件：retry.count（已退避次数，上限 retry.max）、retry.until
#     （退避截止 epoch 秒，经 sched_gate_epoch 计时，重启后可继续）。退避期间
#     scheduler 不执行（execute_one 遇 WAITING 保持不执行）；退避结束 + 依赖满足
#     + 触发仍匹配 → WAITING>STARTING（gate_ok）执行。
#   - 依赖失败与 Recovery 协调：gate_fail（依赖失败传播）落 FAILED 时写运行目录
#     标记 gate.fail；supervisor_step 遇 gate.fail → 不 auto-recovery（依赖失败
#     ≠ 进程崩溃，D25）；重试退避只重跑 action（普通执行），不派发 recovery 动作。
#   - Cooldown/Crash Loop：crash_guard 进程级不变；retry.cooldown 在重试上限
#     触达后写 recovery.cooldown_until（supervisor 既有工件），cooldown 内不重接。
#   - 重启恢复：WAITING 保留（P4-04）；retry.until 桩文件重启后继续计时。
# 命名空间：sched_retry_*，内部全局 rty_ 前缀。
# ═══════════════════════════════════════════════════════════════════════════
sched_retry_count_file()   { echo "$1/retry.count"; }
sched_retry_until_file()   { echo "$1/retry.until"; }
sched_retry_gatefail_file() { echo "$1/gate.fail"; }

# FAILED>WAITING 退避接线判定：<run_dir> <task_file> → 0=应进入退避 1=不应
# （retry.max=0 / 已达上限 / 依赖门控失败任务不接退避 / cooldown 内）。
rty_policy() {   # 载入 retry 策略到全局（retry_max/retry_interval/retry_cooldown）
    rty_tf=$1
    retry_max=$(grep '^retry.max=' "$rty_tf" | head -1 | cut -d= -f2-)
    retry_interval=$(grep '^retry.interval=' "$rty_tf" | head -1 | cut -d= -f2-)
    retry_cooldown=$(grep '^retry.cooldown=' "$rty_tf" | head -1 | cut -d= -f2-)
    case "$retry_max" in ''|*[!0-9]*) retry_max=0 ;; esac
    [ "$retry_max" -gt 100 ] && retry_max=100
    case "$retry_interval" in ''|*[!0-9]*) retry_interval=60 ;; esac
    case "$retry_cooldown" in ''|*[!0-9]*) retry_cooldown=0 ;; esac
}

# 进入重试退避：<base> <run_dir> <task_file> → 0=已接线 FAILED>WAITING 1=未接线
#（调用方保证 FAILED；本函数幂等：retry.until 已存在 → 不重复接线）。
sched_retry_arm() {
    rty_base=$1; rty_rd=$2; rty_tf=$3
    [ -f "$(sched_retry_until_file "$rty_rd")" ] && return 1   # 已在退避中
    # P4-07：依赖门控失败（gate.fail 标记）不接重试退避——依赖失败 ≠ 进程崩溃，
    # 由 supervisor 不 auto-recovery（D25）协同，等待 rearm/人工/下一窗口。
    [ -f "$(sched_retry_gatefail_file "$rty_rd")" ] && return 1
    rty_policy "$rty_tf"
    [ "$retry_max" -gt 0 ] 2>/dev/null || return 1
    rty_cnt=$(cat "$(sched_retry_count_file "$rty_rd")" 2>/dev/null)
    [ -n "$rty_cnt" ] || rty_cnt=0
    [ "$rty_cnt" -lt "$retry_max" ] 2>/dev/null || {
        # 已达上限：记基础 cooldown（防失败风暴热循环；复用 supervisor 工件）
        rty_now=$(sched_gate_epoch)
        [ "$retry_cooldown" -gt 0 ] 2>/dev/null && \
            echo $((rty_now + retry_cooldown)) > "$rty_rd/recovery.cooldown_until" 2>/dev/null
        return 1
    }
    # cooldown 未到 → 不接线
    rty_cdu=$(cat "$rty_rd/recovery.cooldown_until" 2>/dev/null)
    if [ -n "$rty_cdu" ] && [ "$(sched_gate_epoch)" -lt "$rty_cdu" ] 2>/dev/null; then
        return 1
    fi
    rty_cnt=$((rty_cnt + 1))
    echo "$rty_cnt" > "$(sched_retry_count_file "$rty_rd")" 2>/dev/null
    echo $(( $(sched_gate_epoch) + retry_interval )) > "$(sched_retry_until_file "$rty_rd")" 2>/dev/null
    rty_id=$(basename "$rty_rd")
    state_log_event "$rty_rd" "$rty_id" rearm WAITING "" "" "retry backoff attempt $rty_cnt/$retry_max (interval=${retry_interval}s)" >/dev/null 2>&1
    sched_gate_start "$rty_rd"
    sched_audit "$rty_base" "op=retry|task=$rty_id|action=backoff|attempt=$rty_cnt|max=$retry_max|mode=$(sched_source_mode "$rty_base")"
    return 0
}

# 退避判定（advance 复查用）：<run_dir> → 0=不在退避/已到退避截止 1=退避中
sched_retry_pending() {
    rty_f=$(sched_retry_until_file "$1")
    [ -f "$rty_f" ] || return 0
    rty_u=$(cat "$rty_f" 2>/dev/null)
    case "$rty_u" in ''|*[!0-9]*) rm -f "$rty_f" 2>/dev/null; return 0 ;; esac
    if [ "$(sched_gate_epoch)" -ge "$rty_u" ] 2>/dev/null; then
        rm -f "$rty_f" 2>/dev/null
        return 0
    fi
    return 1
}

# 依赖满足判定：<tasks_dir> <id> → 0=满足 1=未满足（等待中/缺失/禁用——可等待，
# 至 WAIT_MAX 超时判失败） 2=未满足且 Required 依赖已终态但不匹配（立即判失败，
# P4-05 dep failed 传播）；stdout=原因（仅供审计/msg）。
# 解析复用 §26 dep_normalize（D1 容错）+ 单条 entry 切分（D2 `[?]id[:STATE]`）。
# P4-05 语义：Required 依赖达到 entry 指定 `:STATE`（缺省 STOPPED）即满足；依赖
# 已终态（STOPPED|FAILED）但 != 指定 → dep failed（WAITING>FAILED，不等超时）；
# 依赖缺失（registry 无此任务）→ dep missing（有界等待）；依赖 DISABLED（enabled=0）
# → dep disabled（非终态、不可作为满足依据，有界等待）；依赖尚在非终态 → dep unsat
# （有界等待）。`?` Optional 依赖任何未满足均不阻断（只记 opt-unsat）。
sched_dep_satisfied() {
    gdv_tasks=$1; gdv_id=$2
    gdv_tf=$(registry_task_file "$gdv_id" 2>/dev/null) || { echo "no task file"; return 1; }
    gdv_dep=$(sched_task_field "$gdv_tf" dependency)
    [ -n "$gdv_dep" ] || { echo "deps ok (none)"; return 0; }
    gdv_norm=$(dep_normalize "$gdv_dep")
    [ -n "$gdv_norm" ] || { echo "deps ok (none)"; return 0; }
    gdv_optunsat=""   # 累积 opt-unsat（Optional 未满足，不阻断）
    gdv_fail=""   # P4-05：终态不匹配的 Required 依赖（立即失败）
    gdv_missing=""   # P4-05：registry 缺失的 Required 依赖（有界等待）
    gdv_disabled=""  # P4-05：enabled=0 的 Required 依赖（有界等待）
    gdv_unsat=""   # 首个非终态未满足的 Required 依赖（有界等待）
    gdv_e=""
    gdv_tokens=$(printf '%s' "$gdv_norm" | sed 's/,/ /g')
    for gdv_e in $gdv_tokens; do
        gdv_opt=0
        case "$gdv_e" in
            "?"*) gdv_opt=1; gdv_e=${gdv_e#\?} ;;
        esac
        gdv_depid=$gdv_e; gdv_want=STOPPED
        case "$gdv_e" in
            *:*)
                gdv_depid=${gdv_e%%:*}
                gdv_want=${gdv_e#*:}
                ;;
        esac
        gdv_cur=$(runtime_current_state "$gdv_tasks/$gdv_depid" 2>/dev/null)
        if [ "$gdv_cur" = "$gdv_want" ]; then
            continue
        fi
        if [ "$gdv_opt" -eq 1 ]; then
            gdv_optunsat="$gdv_optunsat opt-unsat:$gdv_depid"
            continue
        fi
        # P4-05：Required 未满足 → 细分原因。终态不匹配最高优先级（dep failed，
        # 立即 WAITING>FAILED）；缺失/禁用次之（有界等待，超时 FAILED）；其余
        # 非终态（含 PENDING/RUNNING/WAITING）→ 等待。
        gdv_dtf=$(registry_task_file "$gdv_depid" 2>/dev/null)
        if [ -z "$gdv_dtf" ]; then
            [ -z "$gdv_missing" ] && gdv_missing="$gdv_depid"
            continue
        fi
        # 禁用优先于终态判定：DISABLED（enabled=0）视为非终态、不可作为满足依据
        # （P4-05 需求 3）——即使曾 STOPPED/FAILED 也不计入终态匹配。
        if [ "$gdv_cur" = "DISABLED" ] || [ "$(sched_task_field "$gdv_dtf" enabled 2>/dev/null)" = "0" ]; then
            [ -z "$gdv_disabled" ] && gdv_disabled="$gdv_depid"
            continue
        fi
        case "$gdv_cur" in
            STOPPED|FAILED)
                [ -z "$gdv_fail" ] && gdv_fail="$gdv_depid"
                continue ;;
        esac
        [ -z "$gdv_unsat" ] && gdv_unsat="$gdv_depid"
    done
    if [ -n "$gdv_fail" ]; then
        echo "dep failed: $gdv_fail (want STOPPED/FAILED, dep terminal mismatch)"
        return 2
    fi
    if [ -n "$gdv_missing" ]; then
        echo "dep missing: $gdv_missing (no such task)"
        return 1
    fi
    if [ -n "$gdv_disabled" ]; then
        echo "dep disabled: $gdv_disabled (enabled=0)"
        return 1
    fi
    if [ -n "$gdv_unsat" ]; then
        echo "dep unsat: $gdv_unsat (not yet terminal)"
        return 1
    fi
    [ -z "$gdv_optunsat" ] && echo "deps ok" || echo "deps ok (opt ignored:$gdv_optunsat)"
    return 0
}

# 门控判定（P4-04 决策层）：<tasks_dir> <id>
# → 0=通过 1=未通过（可等待：缺失/禁用/非终态） 2=未通过（Required 终态不匹配，
#   立即失败）。当前仅依赖维度。
sched_gate_check() {
    sched_dep_satisfied "$1" "$2"
}

# 条件求值门（P4-06）：<tasks_dir> <id> [<now> HHMM] [<wday> 0-6]
# → 0=通过（condition 空=恒真，或求值为真） 1=未通过（求值为假） 2=非法（运行期
#   防御，理论校验期已拒；视为「本轮不满足」并记录）。只读、无副作用。
# 语义（P4-06 ADR）：条件与依赖门控**并列 AND**——依赖满足 + 条件真 → 执行；
# 条件假 → 本轮不满足（直接跳过，不进入 WAITING、不改状态、不 mark cycle）。
sched_cond_check() {
    conde_tasks=$1; conde_id=$2; conde_now=${3:-$(date +%H%M)}; conde_wday=${4:-$(date +%w)}
    conde_tf=$(registry_task_file "$conde_id" 2>/dev/null) || { echo "cond no-task"; return 2; }
    conde_expr=$(sched_task_field "$conde_tf" condition)
    [ -z "$conde_expr" ] && return 0   # 空/缺省 = 恒真（不额外求值）
    cond_eval "$conde_expr" "$conde_tasks" "$conde_now" "$conde_wday"
    conde_erc=$?
    case "$conde_erc" in
        0) echo "cond ok" ; return 0 ;;
        1) echo "cond unmet: $conde_expr" ; return 1 ;;
        *) echo "cond illegal (defensive): $conde_expr" ; return 2 ;;
    esac
}

# 已 WAITING 任务复查（每个 tick 一次）：<base> <config> <tasks_dir> <id> <now> <boot>
# → 0=解除并执行（cycle 由调用方 mark） 1=非 WAITING（跳过） 2=保持 WAITING
#   3=rearm 回 PENDING（触发窗口已过） 4=FAILED（gate_fail：dep failed 立即失败
#   / 超时兜底）
sched_advance_waiting() {
    base=$1; config=$2; tasks=$3; id=$4
    now=${5:-$(date +%H%M)}; boot=${6:-0}
    run_dir="$tasks/$id"
    [ -d "$run_dir" ] || return 1
    [ "$(runtime_current_state "$run_dir" 2>/dev/null)" = "WAITING" ] || return 1
    tf=$(registry_task_file "$id" 2>/dev/null) || return 2
    trig=$(sched_task_field "$tf" trigger)
    # P4-07：重试退避复查——retry.until 存在（FAILED>WAITING 退避中）→ 未到点
    # 保持 WAITING（不执行、不参与触发/依赖释放）；到点清除桩、本轮强制可执行
    # （retry 释放不依赖触发窗口——重试针对失败动作本身）。
    rty_release=0
    if [ -f "$(sched_retry_until_file "$run_dir")" ]; then
        # sched_retry_pending：0=已到点/不在退避 1=退避中。
        if sched_retry_pending "$run_dir"; then
            rty_release=1
        else
            sched_audit "$base" "op=advance|task=$id|trigger=$trig|action=keep-retry-backoff|mode=$(sched_source_mode "$base")"
            return 2
        fi
    fi
    gres=$(sched_gate_check "$tasks" "$id")
    grc=$?
    out=$(trigger_decide "$base" "$id" "$now" "$boot" "$base/schedule_state.txt")
    case "$out" in
        *due=Y*) due=1 ;;
        *) due=0 ;;
    esac
    # P4-07：重试退避到点 → 本轮强制可执行（重试不依赖触发窗口；trigger_decide
    # 对已过窗口的触发返回 due=N，但重试是针对失败动作本身的新一轮执行）
    [ "$rty_release" -eq 1 ] && due=1
    if [ "$grc" -eq 0 ]; then
        # P4-06 条件门控（并列 AND）：依赖满足但条件非空且求值为假/非法（防御）→
        # rearm 回 PENDING（返回 3），下一周期再求值（有界，无永久 WAITING）。
        cres=$(sched_cond_check "$tasks" "$id" "$now" "$(date +%w)")
        crc=$?
        if [ "$crc" -ne 0 ]; then
            state_log_event "$run_dir" "$id" rearm PENDING "" "" "condition unmet: $cres" >/dev/null 2>&1
            sched_gate_clear "$run_dir"
            sched_audit "$base" "op=advance|task=$id|trigger=$trig|action=rearm|reason=condition|mode=$(sched_source_mode "$base")"
            return 3
        fi
        # 依赖已满足：触发仍匹配 → WAITING>STARTING → action_run；不再匹配 → rearm
        if [ "$due" -eq 1 ]; then
            # P4-07：释放执行 = 新一轮真实执行 → 清除 gate.fail 标记（防旧依赖失败
            # 影响本轮执行后的 recovery 判定）
            rm -f "$(sched_retry_gatefail_file "$run_dir")" 2>/dev/null
            state_log_event "$run_dir" "$id" gate_ok STARTING "" "" "deps satisfied" >/dev/null 2>&1
            sched_gate_clear "$run_dir"
            cmd=$(sched_task_field "$tf" action.command)
            tmx=$(sched_task_field "$tf" action.termux);  [ -z "$tmx" ] && tmx=0
            itr=$(sched_task_field "$tf" action.interactive); [ -z "$itr" ] && itr=0
            ns=$(sched_task_field "$tf" action.notify_start); [ -z "$ns" ] && ns=0
            ne=$(sched_task_field "$tf" action.notify_end);   [ -z "$ne" ] && ne=0
            msg=$(sched_task_field "$tf" action.msg)
            action_run "$id" "$cmd" "$tmx" "$itr" "$ns" "$ne" "$msg" >/dev/null 2>&1
            arc=$?
            [ -d "$run_dir" ] && cp "$tf" "$run_dir/task.v2" 2>/dev/null
            ron=$(sched_task_field "$tf" action.run_once_now)
            del=$(sched_task_field "$tf" action.delete)
            if [ "$del" = "1" ]; then
                sched_remove_task "$base" "$config" "$id" >/dev/null 2>&1
            elif [ "$ron" = "1" ]; then
                sched_prune_ron "$base" "$config" "$id" >/dev/null 2>&1
            fi
            sched_audit "$base" "op=advance|task=$id|trigger=$trig|action=start|rc=$arc|mode=$(sched_source_mode "$base")"
            return 0
        fi
        state_log_event "$run_dir" "$id" rearm PENDING "" "" "deps ok but window closed" >/dev/null 2>&1
        sched_gate_clear "$run_dir"
        sched_audit "$base" "op=advance|task=$id|trigger=$trig|action=rearm|reason=window-closed|mode=$(sched_source_mode "$base")"
        return 3
    fi
    # 依赖仍不满足。P4-05 传播：Required 依赖已终态但不匹配（grc=2，dep failed）
    # → 立即 WAITING>FAILED（不等 WAIT_MAX；门控永久失败 reserved 边）。无论触发
    # 窗口是否关闭都判失败——终态不匹配是永久条件，rearm 无意义（下一窗口触发时
    # 由 sched_execute_one 重新门控）。
    if [ "$grc" -eq 2 ]; then
        sched_gate_clear "$run_dir"
        # P4-07：依赖失败传播 → 落 FAILED 时标记 gate.fail（supervisor 不 auto-recovery）
        echo "$gres" > "$(sched_retry_gatefail_file "$run_dir")" 2>/dev/null
        state_log_event "$run_dir" "$id" gate_fail FAILED "" "" "$gres" >/dev/null 2>&1
        sched_audit "$base" "op=advance|task=$id|trigger=$trig|action=fail-dep|reason=$gres|mode=$(sched_source_mode "$base")"
        return 4
    fi
    # 其余未满足（grc=1：dep missing / dep disabled / dep unsat）→ 有界等待：
    # 触发仍匹配且等待超 WAIT_MAX → WAITING>FAILED（reserved 边，cause 语义
    # action_failure；事件令牌 gate_fail；msg 附依赖原因）
    if [ "$due" -eq 1 ] && [ "$WAIT_MAX" -gt 0 ] 2>/dev/null; then
        gdv_el=$(sched_gate_elapsed "$run_dir")
        if [ "$gdv_el" -gt "$WAIT_MAX" ] 2>/dev/null; then
            sched_gate_clear "$run_dir"
            # P4-07：依赖超时 FAILED 亦属 gate_fail 类 → 标记（不 auto-recovery）
            echo "wait timeout > WAIT_MAX=${WAIT_MAX}s; $gres" > "$(sched_retry_gatefail_file "$run_dir")" 2>/dev/null
            state_log_event "$run_dir" "$id" gate_fail FAILED "" "" "wait timeout > WAIT_MAX=${WAIT_MAX}s; $gres" >/dev/null 2>&1
            sched_audit "$base" "op=advance|task=$id|trigger=$trig|action=fail-timeout|reason=$gres|mode=$(sched_source_mode "$base")"
            return 4
        fi
    fi
    if [ "$due" -eq 1 ]; then
        # 触发仍匹配且未超时 → 保持 WAITING（下一 tick 复查）
        sched_audit "$base" "op=advance|task=$id|trigger=$trig|action=keep-waiting|reason=$gres|mode=$(sched_source_mode "$base")"
        return 2
    fi
    # 触发不再匹配 → WAITING>PENDING（rearm，避免永久挂起）
    state_log_event "$run_dir" "$id" rearm PENDING "" "" "dep window closed: $gres" >/dev/null 2>&1
    sched_gate_clear "$run_dir"
    sched_audit "$base" "op=advance|task=$id|trigger=$trig|action=rearm|reason=$gres|mode=$(sched_source_mode "$base")"
    return 3
}
# 单任务执行：trigger_decide（TriggerProvider）→ 依赖门控（P4-04）→ action_run
# （ActionProvider）→ 后置
# 返回：0=已执行 1=未到期 2=错误 3=触发匹配但被依赖门控（进入/保持 WAITING，不执行）
#   （调用方循环隔离，不中止 tick；3 时不 mark cycle——解除后同窗口仍可执行一次）
sched_execute_one() {   # <base> <config> <tasks_dir> <id> [now] [boot]
    base=$1; config=$2; tasks=$3; id=$4
    now=${5:-$(date +%H%M)}; boot=${6:-0}
    tf=$(registry_task_file "$id" 2>/dev/null) || { sched_log "WARN execute: no task file $id"; return 2; }
    trig=$(sched_task_field "$tf" trigger)
    out=$(trigger_decide "$base" "$id" "$now" "$boot" "$base/schedule_state.txt")
    case "$out" in
        *due=Y*) ;;
        *) return 1 ;;
    esac
    # P4-04 门控插入点：触发匹配 + 依赖未满足 → PENDING>WAITING（gate_wait）。
    # 终态（STOPPED/FAILED）先 rearm 回 PENDING 再门控；DISABLED 不门控（沿用
    # 既有行为）。
    run_dir="$tasks/$id"
    gdv_cur=""
    [ -f "$run_dir/state.txt" ] && gdv_cur=$(cat "$run_dir/state.txt" 2>/dev/null)
    # P4-07：WAITING 由 advance 通道独占管理（依赖门控 + 重试退避）。execute 路径
    # 对 WAITING 一律不执行（退避期间不得重复执行）；D14「每窗口至多一次」由 advance
    # 释放时 mark cycle 保证，execute 路径不得再碰 WAITING 任务。
    if [ "$gdv_cur" = "WAITING" ]; then
        sched_audit "$base" "op=execute|task=$id|trigger=$trig|blocked=waiting|mode=$(sched_source_mode "$base")"
        return 3
    fi
    case "$gdv_cur" in
        STOPPED|FAILED)
            # P4-07：rearm 进入新执行周期 → 清除 gate.fail 标记（防旧依赖失败
            # 影响新一轮执行后的 recovery 判定）
            rm -f "$(sched_retry_gatefail_file "$run_dir")" 2>/dev/null
            state_log_event "$run_dir" "$id" rearm PENDING "" "" "rearm before gate" >/dev/null 2>&1 ;;
        DISABLED) ;;
    esac
    gres=$(sched_gate_check "$tasks" "$id")
    grc=$?
    if [ "$grc" -ne 0 ]; then
        mkdir -p "$run_dir" 2>/dev/null
        sched_gate_start "$run_dir"
        state_log_event "$run_dir" "$id" gate_wait WAITING "" "" "$gres" >/dev/null 2>&1
        sched_audit "$base" "op=gate|task=$id|trigger=$trig|blocked=1|reason=$gres|mode=$(sched_source_mode "$base")"
        return 3
    fi
    # P4-06 条件门控（与依赖门控并列 AND）：条件非空且求值为假/非法（防御）→
    # 本轮直接跳过（不进入 WAITING、不改状态、不 mark cycle），下一周期再求值。
    # 条件空 = 恒真（sched_cond_check rc 0，不额外求值）。
    cres=$(sched_cond_check "$tasks" "$id" "$now" "$(date +%w)")
    crc=$?
    if [ "$crc" -ne 0 ]; then
        sched_audit "$base" "op=cond|task=$id|trigger=$trig|blocked=1|reason=$cres|mode=$(sched_source_mode "$base")"
        return 1
    fi
    cmd=$(sched_task_field "$tf" action.command)
    tmx=$(sched_task_field "$tf" action.termux);  [ -z "$tmx" ] && tmx=0
    itr=$(sched_task_field "$tf" action.interactive); [ -z "$itr" ] && itr=0
    ns=$(sched_task_field "$tf" action.notify_start); [ -z "$ns" ] && ns=0
    ne=$(sched_task_field "$tf" action.notify_end);   [ -z "$ne" ] && ne=0
    msg=$(sched_task_field "$tf" action.msg)
    action_run "$id" "$cmd" "$tmx" "$itr" "$ns" "$ne" "$msg" >/dev/null 2>&1
    arc=$?
    # stash 任务文件到运行目录（快照移除后 supervisor 仍可监督——P3-03 要求 9）
    if [ -d "$tasks/$id" ]; then
        cp "$tf" "$tasks/$id/task.v2" 2>/dev/null
    fi
    ron=$(sched_task_field "$tf" action.run_once_now)
    del=$(sched_task_field "$tf" action.delete)
    if [ "$del" = "1" ]; then
        sched_remove_task "$base" "$config" "$id" >/dev/null 2>&1
    elif [ "$ron" = "1" ]; then
        sched_prune_ron "$base" "$config" "$id" >/dev/null 2>&1
    fi
    sched_audit "$base" "op=exec|task=$id|trigger=$trig|mode=$(sched_source_mode "$base")|rc=$arc|ron=$ron|del=$del"
    return "$arc"
}
# Registry 正式调度 tick（daemon 主循环 RUNTIME_LOADED=1 调用）：源重载 + 已
# WAITING 任务复查（P4-04）+ 逐任务决策执行
scheduler_tick() {   # <base> <config> <tasks_dir> [now] → 0
    base=$1; config=$2; tasks=$3
    now=${4:-$(date +%H%M)}
    mkdir -p "$base/scheduler" 2>/dev/null
    sched_reload "$base" "$config" >/dev/null 2>&1
    token=$(sched_cycle_token)
    # P4-04：先复查已 WAITING 任务（每个 tick 至多一次；解除→执行并 mark，保持/
    # rearm 不 mark——与「每窗口至多一次」兼容）
    w_ok=0; w_err=0
    for id in $(registry_task_ids); do
        if [ -d "$tasks/$id" ] && [ "$(cat "$tasks/$id/state.txt" 2>/dev/null)" = "WAITING" ]; then
            sched_advance_waiting "$base" "$config" "$tasks" "$id" "$now" 0
            arc=$?
            case "$arc" in
                0|4)
                    sched_cycle_mark "$base" "$id" "$token"
                    [ "$arc" -eq 0 ] && w_ok=$((w_ok + 1)) || w_err=$((w_err + 1)) ;;
                1|2|3) : ;;
                *) : ;;
            esac
        fi
    done
    # P4-07：FAILED>WAITING 重试退避接线——FAILED 任务（action_failure 执行失败 /
    # gate_fail 依赖失败传播）按 retry 策略进入 WAITING 退避（retry.until 计时）。
    # 退避期间 advance 通道保持 WAITING（不执行）；到点 + 依赖满足 + 触发匹配 →
    # WAITING>STARTING 执行。未接线（retry.max=0 / 达上限 / cooldown）保持 FAILED
    # （终态，既有 FAILED>PENDING rearm 路径不变）。
    rty_n=0
    for id in $(registry_task_ids); do
        if [ -d "$tasks/$id" ] && [ "$(cat "$tasks/$id/state.txt" 2>/dev/null)" = "FAILED" ]; then
            rty_tf=$(registry_task_file "$id" 2>/dev/null) || continue
            if sched_retry_arm "$base" "$tasks/$id" "$rty_tf" >/dev/null 2>&1; then
                rty_n=$((rty_n + 1))
            fi
        fi
    done
    due=0; execn=0; errn=0
    for id in $(registry_task_ids); do
        if sched_cycle_seen "$base" "$id" "$token"; then
            continue
        fi
        sched_execute_one "$base" "$config" "$tasks" "$id" "$now" 0
        rc=$?
        if [ "$rc" -eq 1 ] || [ "$rc" -eq 3 ]; then
            continue   # 未到期不标记；被门控（3）不标记——解除后同窗口仍可执行一次
        fi
        sched_cycle_mark "$base" "$id" "$token"
        [ "$rc" -eq 0 ] && execn=$((execn + 1)) || errn=$((errn + 1))
    done
    sched_audit "$base" "op=tick|now=$now|mode=$(sched_source_mode "$base")|exec=$execn|err=$errn|wadv=$w_ok|wfail=$w_err|retry=$rty_n"
    return 0
}
# 启动 boot：registry 中 trigger=boot 的任务（RUNTIME_LOADED=1 启动段调用）
scheduler_boot() {   # <base> <config> <tasks_dir> → 0
    base=$1; config=$2; tasks=$3
    mkdir -p "$base/scheduler" 2>/dev/null
    sched_reload "$base" "$config" >/dev/null 2>&1
    n=0
    for id in $(registry_task_ids); do
        tf=$(registry_task_file "$id" 2>/dev/null) || continue
        trig=$(sched_task_field "$tf" trigger)
        [ "$trig" = "boot" ] || continue
        TRIGGER_BOOT_CONTEXT=1 sched_execute_one "$base" "$config" "$tasks" "$id" "$(date +%H%M)" 1 >/dev/null 2>&1 \
            && n=$((n + 1))
    done
    sched_audit "$base" "op=boot|mode=$(sched_source_mode "$base")|exec=$n"
    return 0
}
# ═══════════════════════════════════════════════════════════════════════════
# §21 Local IPC Control Plane（P3-04）：WebUI ↔ daemon 受控通信边界
# ═══════════════════════════════════════════════════════════════════════════
# 目标：WebUI（浏览器侧）→ validated IPC → su-schedulerd → validated Task
# operation → Root action。**禁止** WebUI JavaScript 直接执行 shell。
# 传输：`$base/ipc/`（chmod 700，root-only）下的**请求文件 + 响应文件**通道。
#   （不用 FIFO：POSIX sh 无便携非阻塞 FIFO 读取；文件通道满足「如果使用 FIFO
#   必须」的全部等价属性——daemon 创建、0700 权限、固定请求格式、请求长度受限、
#   命令白名单、每请求唯一 ID、响应文件原子写入；选择依据见 docs/P3-04.md。）
#   布局：
#     ipc/                chmod 700（仅 root 可写）
#     ipc/requests/       <req_id>.req   客户端落盘（单行请求，tmp+mv 原子）
#     ipc/responses/      <req_id>.resp  服务端原子写回（tmp+mv）
#     ipc/daemon.pid      daemon 存活标记（客户端判 daemon_unavailable）
# 请求行（≤4096 字节）：REQ_ID|OP|k1=b64&k2=b64
#   - REQ_ID：^[A-Za-z0-9._-]{1,64}$（客户端生成，唯一）
#   - OP：白名单（12 个，见 IPC_WHITELIST）
#   - 参数：`&` 分隔 `key=base64value`；值一律 base64 ⇒ **请求行不含任何 Shell
#     元字符**，服务端只解码为数据、绝不 eval。
# 响应文件：首行 `REQ_ID|OP|RC|ERROR`，随后为载荷行。
# RC/ERROR（可区分错误码）：
#   0 ok | 1 invalid_request | 2 permission_denied | 3 task_not_found
#   | 4 configuration_invalid | 5 operation_timeout | 6 daemon_unavailable
# 安全保证：
#   - 服务端从不把请求内容交给 shell 解释/执行（固定格式解析 + 白名单校验 +
#     base64 解码为数据）；
#   - START/STOP/RESTART 只接受任务 ID，命令取自**已校验任务文件**（Registry
#     快照），WebUI 无法经请求注入任意命令；
#   - 写操作（CREATE/UPDATE/DELETE/ENABLE/DISABLE）仅 **Managed 模式**（P3-02
#     task-config 权威存储）；Legacy 返回 configuration_invalid（config.txt 不
#     被 WebUI 触碰）；
#   - 非法/超长/未知 OP/坏参数 ⇒ invalid_request 且**零副作用**（不启动、不写
#     任务、不触发 Root action）；
#   - 重复请求：同 req_id 响应已存在 ⇒ 幂等丢弃；START_TASK 任务已运行 ⇒ 不重复
#     启动；
#   - 客户端超时 ⇒ operation_timeout；daemon 停止 ⇒ daemon_unavailable。
# 命名空间：内部全局一律 ipcv_ 前缀（防覆盖调用方全局，同 P3-03 教训）。
# ═══════════════════════════════════════════════════════════════════════════
ipc_log() { [ "${IPC_LOG:-1}" = "1" ] && echo "[ipc] $1" >&2; }
IPC_WHITELIST="GET_TASKS GET_TASK_STATUS GET_TASK_LOG VALIDATE_TASK CREATE_TASK UPDATE_TASK DELETE_TASK ENABLE_TASK DISABLE_TASK START_TASK STOP_TASK RESTART_TASK CHECK_TASK GET_SUMMARY GET_TASK_DETAIL GET_TASK_EVENTS GET_DAEMON_LOG GET_TASK_EDIT EDIT_TASK"
IPC_REQ_MAX=4096
IPC_POLL_MAX=64
ipc_dir() { echo "$1/ipc"; }
ipc_req_dir() { echo "$1/ipc/requests"; }
ipc_resp_dir() { echo "$1/ipc/responses"; }
ipc_pid_file() { echo "$1/ipc/daemon.pid"; }
# 值编码：base64（字母表无 Shell 元字符）；tr -d '\n' 去除 coreutils 76 列换行
ipc_b64enc() { printf '%s' "$1" | base64 2>/dev/null | tr -d '\n'; }
ipc_b64dec() { printf '%s' "$1" | base64 -d 2>/dev/null; }
# 判定解码值含真实换行（防 task 文件被多行污染——task 命令须单行存储）
# P3-08：改为 END 汇总式判定（NR>1 → 含换行 → 0）——`NR>1{exit 0}END{exit 1}`
# 在部分 awk（gawk）下 END 会覆盖 exit，导致恒判无换行（多行注入漏检）。
ipc_has_newline() { printf '%s' "$1" | awk 'END { exit (NR>1 ? 0 : 1) }' 2>/dev/null; }
# 服务端初始化：建 0700 目录 + daemon.pid 存活标记
ipc_server_init() {   # <base> → 0
    ipcv_base=$1
    mkdir -p "$(ipc_req_dir "$ipcv_base")" "$(ipc_resp_dir "$ipcv_base")" 2>/dev/null || return 1
    chmod 700 "$(ipc_dir "$ipcv_base")" "$(ipc_req_dir "$ipcv_base")" "$(ipc_resp_dir "$ipcv_base")" 2>/dev/null
    echo "$$" > "$(ipc_pid_file "$ipcv_base")" 2>/dev/null
    return 0
}
# 请求行校验：REQ_ID|OP|k=b64&k=b64
ipc_parse() {   # <line> → 0=ok（ipcv_req_id/ipcv_op/ipcv_params 就绪）1=invalid
    ipcv_line=$1
    [ -n "$ipcv_line" ] || return 1
    # P3-10 D-IPC 修复：不用 `${var%%|*}`/`${var#*|}`（mksh 对含 `|` 模式
    # 的参数展开失败，见 docs/P3-DEVICE-MATRIX §3），改可移植 cut 切分。
    ipcv_req_id=$(printf '%s' "$ipcv_line" | cut -d'|' -f1)
    ipcv_rest=$(printf '%s' "$ipcv_line" | cut -d'|' -f2-)
    ipcv_op=$(printf '%s' "$ipcv_rest" | cut -d'|' -f1)
    ipcv_params=$(printf '%s' "$ipcv_rest" | cut -d'|' -f2-)
    case "$ipcv_req_id" in
        ""|*[!A-Za-z0-9._-]*) return 1 ;;
    esac
    [ "${#ipcv_req_id}" -le 64 ] || return 1
    case " $IPC_WHITELIST " in
        *" $ipcv_op "*) ;;
        *) return 1 ;;
    esac
    ipc_params_valid "$ipcv_params" || return 1
    return 0
}
# 参数格式校验：每项 k=base64（k 白名单字符、v 仅 base64 字母表）
# 注：必须用当前 shell 的 for 循环（IFS='&' 分词），不可用管道 while——
# 管道内 return 只在子 shell 生效，无法把校验失败传回调用方。
ipc_params_valid() {   # <params> → 0=valid
    [ -z "$1" ] && return 0
    ipcv_params=$1
    ipcv_oldifs=$IFS
    IFS='&'
    for ipcv_tok in $ipcv_params; do
        case "$ipcv_tok" in
            *"="*) ;;
            *) IFS=$ipcv_oldifs; return 1 ;;
        esac
        ipcv_k=${ipcv_tok%%=*}
        ipcv_v=${ipcv_tok#*=}
        case "$ipcv_k" in ""|*[!A-Za-z0-9._-]*) IFS=$ipcv_oldifs; return 1 ;; esac
        case "$ipcv_v" in ""|*[!A-Za-z0-9+/=]*) IFS=$ipcv_oldifs; return 1 ;; esac
    done
    IFS=$ipcv_oldifs
    return 0
}
# 取参数（base64 解码）：<params> <key> → 值（无则空）
ipc_param() {   # 用 sed 抽取而非管道 while（子 shell return 不可靠）
    ipcv_v=$(printf '%s' "$1" | tr '&' '\n' | sed -n "s/^$2=//p" | head -1)
    [ -n "$ipcv_v" ] && ipc_b64dec "$ipcv_v"
}
# 原子响应写回：<base> <req_id> <op> <rc> <error> [payload]
ipc_respond() {   # 载荷为空则不写载荷行；tmp+mv 原子
    ipcv_base=$1; ipcv_rid=$2; ipcv_op=$3; ipcv_rc=$4; ipcv_err=$5; ipcv_payload=${6:-}
    ipcv_rdir=$(ipc_resp_dir "$ipcv_base")
    mkdir -p "$ipcv_rdir" 2>/dev/null
    ipcv_t="$ipcv_rdir/$ipcv_rid.resp.tmp"
    {
        printf '%s|%s|%s|%s\n' "$ipcv_rid" "$ipcv_op" "$ipcv_rc" "$ipcv_err"
        [ -n "$ipcv_payload" ] && printf '%s\n' "$ipcv_payload"
    } > "$ipcv_t" 2>/dev/null
    mv "$ipcv_t" "$ipcv_rdir/$ipcv_rid.resp" 2>/dev/null
    rm -f "$ipcv_t" 2>/dev/null
    return 0
}
# 任务运行态（state.txt 优先，旧 status.txt 兜底）
ipc_task_state() {   # <tasks_dir> <id>
    ipcv_tasks=$1; ipcv_id=$2
    if [ -n "$ipcv_tasks" ] && [ -f "$ipcv_tasks/$ipcv_id/state.txt" ]; then
        cat "$ipcv_tasks/$ipcv_id/state.txt" 2>/dev/null
        return 0
    fi
    if [ -n "$ipcv_tasks" ] && [ -f "$ipcv_tasks/$ipcv_id/status.txt" ]; then
        cat "$ipcv_tasks/$ipcv_id/status.txt" 2>/dev/null
        return 0
    fi
    echo "UNKNOWN"
}
# ── 操作处理器 ───────────────────────────────────────────────────────────────
ipc_op_get_tasks() {   # <base> <tasks> <req_id>
    ipcv_base=$1; ipcv_tasks=$2; ipcv_rid=$3
    ipcv_payload=""
    ipcv_nl='
'
    for ipcv_id in $(registry_task_ids); do
        ipcv_f=$(registry_task_file "$ipcv_id" 2>/dev/null) || continue
        ipcv_name=$(sched_task_field "$ipcv_f" name)
        ipcv_trig=$(sched_task_field "$ipcv_f" trigger)
        ipcv_en=$(sched_task_field "$ipcv_f" enabled)
        ipcv_st=$(ipc_task_state "$ipcv_tasks" "$ipcv_id")
        ipcv_payload="${ipcv_payload}${ipcv_id}|${ipcv_name}|${ipcv_trig}|${ipcv_en}|${ipcv_st}${ipcv_nl}"
    done
    ipc_respond "$ipcv_base" "$ipcv_rid" GET_TASKS 0 ok "$ipcv_payload"
    return 0
}
ipc_op_get_status() {   # <base> <tasks> <req_id> <id>
    ipcv_base=$1; ipcv_tasks=$2; ipcv_rid=$3; ipcv_id=$4
    [ -n "$ipcv_id" ] || { ipc_respond "$ipcv_base" "$ipcv_rid" GET_TASK_STATUS 1 invalid_request "missing id"; return 0; }
    ipcv_f=$(registry_task_file "$ipcv_id" 2>/dev/null)
    [ -n "$ipcv_f" ] || { ipc_respond "$ipcv_base" "$ipcv_rid" GET_TASK_STATUS 3 task_not_found "$ipcv_id"; return 0; }
    ipcv_st=$(ipc_task_state "$ipcv_tasks" "$ipcv_id")
    ipcv_payload="id=$ipcv_id
name=$(sched_task_field "$ipcv_f" name)
trigger=$(sched_task_field "$ipcv_f" trigger)
enabled=$(sched_task_field "$ipcv_f" enabled)
command=$(sched_task_field "$ipcv_f" action.command)
state=$ipcv_st"
    ipc_respond "$ipcv_base" "$ipcv_rid" GET_TASK_STATUS 0 ok "$ipcv_payload"
    return 0
}
ipc_op_get_log() {   # <base> <tasks> <req_id> <id> [lines]
    ipcv_base=$1; ipcv_tasks=$2; ipcv_rid=$3; ipcv_id=$4
    ipcv_lines=$(secv_num_clamp "${5:-50}" 1 "$WEBUI_LOG_MAX" 50)
    [ -n "$ipcv_id" ] || { ipc_respond "$ipcv_base" "$ipcv_rid" GET_TASK_LOG 1 invalid_request "missing id"; return 0; }
    # P3-07：稳定 Task ID 与旧运行 ID 均可查日志——解析运行目录（旧运行 ID 用其目录本体）
    ipcv_rd=""
    if [ -n "$ipcv_tasks" ] && [ -d "$ipcv_tasks/$ipcv_id" ]; then
        ipcv_rd="$ipcv_tasks/$ipcv_id"
    else
        ipcv_canon=$(task_cli_resolve_id "$ipcv_base" "$ipcv_tasks" "$ipcv_id" 2>/dev/null)
        if [ -n "$ipcv_canon" ] && [ -n "$ipcv_tasks" ] && [ -d "$ipcv_tasks/$ipcv_canon" ]; then
            ipcv_rd="$ipcv_tasks/$ipcv_canon"
        fi
    fi
    ipcv_f=$(registry_task_file "$ipcv_id" 2>/dev/null)
    [ -n "$ipcv_f" ] || [ -n "$ipcv_rd" ] || {
        ipc_respond "$ipcv_base" "$ipcv_rid" GET_TASK_LOG 3 task_not_found "$ipcv_id"; return 0; }
    ipcv_total=0
    if [ -n "$ipcv_rd" ] && [ -f "$ipcv_rd/output.log" ]; then
        ipcv_total=$(wc -l < "$ipcv_rd/output.log" 2>/dev/null || echo 0)
    fi
    ipcv_returned=$ipcv_total
    [ "$ipcv_returned" -gt "$ipcv_lines" ] && ipcv_returned=$ipcv_lines
    ipcv_trunc=0
    [ "$ipcv_returned" -lt "$ipcv_total" ] && ipcv_trunc=1
    # 首载荷行为 meta：truncated/total/lines（前端据此明确提示日志已截断）
    if [ -n "$ipcv_rd" ] && [ -f "$ipcv_rd/output.log" ]; then
        ipcv_payload="#truncated=$ipcv_trunc|total=$ipcv_total|lines=$ipcv_returned
$(tail -n "$ipcv_returned" "$ipcv_rd/output.log" 2>/dev/null)"
    else
        ipcv_payload="#truncated=0|total=0|lines=0
(no output yet)"
    fi
    ipc_respond "$ipcv_base" "$ipcv_rid" GET_TASK_LOG 0 ok "$ipcv_payload"
    return 0
}
# VALIDATE_TASK：临时文件校验（不持久化）
ipc_op_validate() {   # <base> <req_id> <params>
    ipcv_base=$1; ipcv_rid=$2; ipcv_params=$3
    # P3-06：payload 参数 = 完整 Task v2 内容（编辑器预览/校验）→ 全字段校验
    ipcv_pl=$(ipc_param "$ipcv_params" payload)
    if [ -n "$ipcv_pl" ]; then
        if tcfg_editor_validate_payload "$ipcv_pl"; then
            ipc_respond "$ipcv_base" "$ipcv_rid" VALIDATE_TASK 0 ok "valid"
        else
            ipc_respond "$ipcv_base" "$ipcv_rid" VALIDATE_TASK 4 configuration_invalid "task invalid"
        fi
        return 0
    fi
    ipcv_trig=$(ipc_param "$ipcv_params" trigger)
    ipcv_cmd=$(ipc_param "$ipcv_params" command)
    [ -n "$ipcv_trig" ] && [ -n "$ipcv_cmd" ] || {
        ipc_respond "$ipcv_base" "$ipcv_rid" VALIDATE_TASK 4 configuration_invalid "trigger+command required"; return 0; }
    if ipc_has_newline "$ipcv_cmd"; then
        ipc_respond "$ipcv_base" "$ipcv_rid" VALIDATE_TASK 4 configuration_invalid "command must be single-line"; return 0; fi
    ipcv_sandbox="$ipcv_base/ipc/.validate.$$"
    mkdir -p "$ipcv_sandbox" 2>/dev/null
    ipcv_vid="validate_$$"
    {
        echo "schema_version=2"
        echo "id=$ipcv_vid"
        echo "name=$(ipc_param "$ipcv_params" name)"
        echo "enabled=$(ipc_param "$ipcv_params" enabled)"
        echo "trigger=$ipcv_trig"
        echo "action.type=command"
        echo "action.command=$ipcv_cmd"
    } > "$ipcv_sandbox/$ipcv_vid.task" 2>/dev/null
    if tcfg_validate_task "$ipcv_sandbox/$ipcv_vid.task"; then
        ipc_respond "$ipcv_base" "$ipcv_rid" VALIDATE_TASK 0 ok "valid"
    else
        ipc_respond "$ipcv_base" "$ipcv_rid" VALIDATE_TASK 4 configuration_invalid "task invalid"
    fi
    rm -rf "$ipcv_sandbox" 2>/dev/null
    return 0
}
# CREATE_TASK：Managed 模式写入 task-config + 原子 reload
ipc_op_create() {   # <base> <config> <req_id> <params>
    ipcv_base=$1; ipcv_config=$2; ipcv_rid=$3; ipcv_params=$4
    tcfg_is_managed || {
        ipc_respond "$ipcv_base" "$ipcv_rid" CREATE_TASK 4 configuration_invalid "write ops require managed task-config (run: su-scheduler task-config import)"; return 0; }
    ipcv_trig=$(ipc_param "$ipcv_params" trigger)
    ipcv_cmd=$(ipc_param "$ipcv_params" command)
    [ -n "$ipcv_trig" ] && [ -n "$ipcv_cmd" ] || {
        ipc_respond "$ipcv_base" "$ipcv_rid" CREATE_TASK 4 configuration_invalid "trigger+command required"; return 0; }
    if ipc_has_newline "$ipcv_cmd"; then
        ipc_respond "$ipcv_base" "$ipcv_rid" CREATE_TASK 4 configuration_invalid "command must be single-line"; return 0; fi
    ipcv_id=$(ipc_param "$ipcv_params" id)
    [ -n "$ipcv_id" ] || ipcv_id=$(tcfg_new_id "$ipcv_trig")
    ipcv_sandbox="$ipcv_base/ipc/.create.$$"
    mkdir -p "$ipcv_sandbox" 2>/dev/null
    {
        echo "schema_version=2"
        echo "id=$ipcv_id"
        echo "name=$(ipc_param "$ipcv_params" name)"
        echo "enabled=$(ipc_param "$ipcv_params" enabled)"
        echo "trigger=$ipcv_trig"
        echo "action.type=command"
        echo "action.command=$ipcv_cmd"
        echo "action.termux=$(ipc_param "$ipcv_params" termux)"
        echo "action.interactive=$(ipc_param "$ipcv_params" interactive)"
        echo "action.notify_start=$(ipc_param "$ipcv_params" notify_start)"
        echo "action.notify_end=$(ipc_param "$ipcv_params" notify_end)"
        echo "action.msg=$(ipc_param "$ipcv_params" msg)"
        echo "health.type=none"
        echo "recovery.type=none"
        echo "retry.max=0"
        echo "retry.interval=60"
    } > "$ipcv_sandbox/$ipcv_id.task" 2>/dev/null
    if ! tcfg_validate_task "$ipcv_sandbox/$ipcv_id.task"; then
        rm -rf "$ipcv_sandbox" 2>/dev/null
        ipc_respond "$ipcv_base" "$ipcv_rid" CREATE_TASK 4 configuration_invalid "task invalid"
        return 0
    fi
    ipcv_target=$(tcfg_task_file "$ipcv_id")
    if cp "$ipcv_sandbox/$ipcv_id.task" "$ipcv_target.tmp.$$" 2>/dev/null \
        && mv "$ipcv_target.tmp.$$" "$ipcv_target" 2>/dev/null; then
        sched_reload "$ipcv_base" "$ipcv_config" >/dev/null 2>&1
        rm -rf "$ipcv_sandbox" 2>/dev/null
        ipc_respond "$ipcv_base" "$ipcv_rid" CREATE_TASK 0 ok "created $ipcv_id"
    else
        rm -f "$ipcv_target.tmp.$$" 2>/dev/null
        rm -rf "$ipcv_sandbox" 2>/dev/null
        ipc_respond "$ipcv_base" "$ipcv_rid" CREATE_TASK 4 configuration_invalid "write failed"
    fi
    return 0
}
# UPDATE_TASK：Managed 模式按给定字段更新 + 校验 + reload
ipc_op_update() {   # <base> <config> <req_id> <params>
    ipcv_base=$1; ipcv_config=$2; ipcv_rid=$3; ipcv_params=$4
    tcfg_is_managed || {
        ipc_respond "$ipcv_base" "$ipcv_rid" UPDATE_TASK 4 configuration_invalid "write ops require managed task-config (run: su-scheduler task-config import)"; return 0; }
    ipcv_id=$(ipc_param "$ipcv_params" id)
    [ -n "$ipcv_id" ] || { ipc_respond "$ipcv_base" "$ipcv_rid" UPDATE_TASK 1 invalid_request "missing id"; return 0; }
    [ -f "$(tcfg_task_file "$ipcv_id")" ] || { ipc_respond "$ipcv_base" "$ipcv_rid" UPDATE_TASK 3 task_not_found "$ipcv_id"; return 0; }
    for ipcv_fld in name enabled trigger command termux interactive notify_start notify_end msg; do
        ipcv_v=$(ipc_param "$ipcv_params" "$ipcv_fld")
        [ -n "$ipcv_v" ] || continue
        if [ "$ipcv_fld" = "command" ] && ipc_has_newline "$ipcv_v"; then
            ipc_respond "$ipcv_base" "$ipcv_rid" UPDATE_TASK 4 configuration_invalid "command must be single-line"; return 0; fi
        case "$ipcv_fld" in
            command) ipcv_key=action.command ;;
            termux) ipcv_key=action.termux ;;
            interactive) ipcv_key=action.interactive ;;
            notify_start) ipcv_key=action.notify_start ;;
            notify_end) ipcv_key=action.notify_end ;;
            msg) ipcv_key=action.msg ;;
            *) ipcv_key=$ipcv_fld ;;
        esac
        tcfg_set_field "$ipcv_id" "$ipcv_key" "$ipcv_v" >/dev/null 2>&1
    done
    if tcfg_validate_task "$(tcfg_task_file "$ipcv_id")"; then
        sched_reload "$ipcv_base" "$ipcv_config" >/dev/null 2>&1
        ipc_respond "$ipcv_base" "$ipcv_rid" UPDATE_TASK 0 ok "updated $ipcv_id"
    else
        ipc_respond "$ipcv_base" "$ipcv_rid" UPDATE_TASK 4 configuration_invalid "invalid after update"
    fi
    return 0
}
ipc_op_delete() {   # <base> <config> <req_id> <id>
    ipcv_base=$1; ipcv_config=$2; ipcv_rid=$3; ipcv_id=$4
    tcfg_is_managed || {
        ipc_respond "$ipcv_base" "$ipcv_rid" DELETE_TASK 4 configuration_invalid "write ops require managed task-config (run: su-scheduler task-config import)"; return 0; }
    [ -n "$ipcv_id" ] || { ipc_respond "$ipcv_base" "$ipcv_rid" DELETE_TASK 1 invalid_request "missing id"; return 0; }
    [ -f "$(tcfg_task_file "$ipcv_id")" ] || { ipc_respond "$ipcv_base" "$ipcv_rid" DELETE_TASK 3 task_not_found "$ipcv_id"; return 0; }
    tcfg_remove_task "$ipcv_id" >/dev/null 2>&1
    sched_reload "$ipcv_base" "$ipcv_config" >/dev/null 2>&1
    ipc_respond "$ipcv_base" "$ipcv_rid" DELETE_TASK 0 ok "deleted $ipcv_id"
    return 0
}
ipc_op_set_enabled() {   # <base> <config> <tasks> <req_id> <id> <val> <opname>
    ipcv_base=$1; ipcv_config=$2; ipcv_tasks=$3; ipcv_rid=$4; ipcv_id=$5; ipcv_val=$6; ipcv_opname=$7
    [ -n "$ipcv_id" ] || { ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_opname" 1 invalid_request "missing id"; return 0; }
    ipcv_out=$(tctl_set_enabled "$ipcv_base" "$ipcv_config" "$ipcv_tasks" "$ipcv_id" "$ipcv_val" 2>/dev/null)
    ipcv_trc=$?
    case "$ipcv_trc" in
        0) ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_opname" 0 ok "$ipcv_out" ;;
        1) ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_opname" 3 task_not_found "$ipcv_id" ;;
        2) ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_opname" 4 configuration_invalid "$ipcv_out" ;;
        3) ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_opname" 4 configuration_invalid "$ipcv_out" ;;
    esac
    return 0
}
# 启动（经 action_run，命令取自已校验任务文件——请求不可注入）；已运行不重复启动。
# P3-07：委托 §24 tctl_start（统一控制 API + TSM 强制 + skip 策略）。
ipc_op_start() {   # <base> <tasks> <req_id> <id> <opname> [force]
    ipcv_base=$1; ipcv_tasks=$2; ipcv_rid=$3; ipcv_id=$4; ipcv_opname=$5; ipcv_force=${6:-0}
    [ -n "$ipcv_id" ] || { ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_opname" 1 invalid_request "missing id"; return 0; }
    ipcv_out=$(tctl_start "$ipcv_base" "$ipcv_tasks" "$ipcv_id" "$ipcv_force" 2>/dev/null)
    ipcv_trc=$?
    case "$ipcv_trc" in
        0) ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_opname" 0 ok "$ipcv_out" ;;
        1) ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_opname" 3 task_not_found "$ipcv_id" ;;
        2) ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_opname" 0 ok "$ipcv_out" ;;   # skip（并发 start）
        3) ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_opname" 4 configuration_invalid "$ipcv_out" ;;
        4) ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_opname" 4 configuration_invalid "$ipcv_out" ;;
    esac
    return 0
}
# 停止：委托 §24 tctl_stop（只杀本运行目录 pid；TSM）
ipc_op_stop() {   # <base> <tasks> <req_id> <id> <opname>
    ipcv_base=$1; ipcv_tasks=$2; ipcv_rid=$3; ipcv_id=$4; ipcv_opname=$5
    [ -n "$ipcv_id" ] || { ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_opname" 1 invalid_request "missing id"; return 0; }
    ipcv_out=$(tctl_stop "$ipcv_base" "$ipcv_tasks" "$ipcv_id" 2>/dev/null)
    ipcv_trc=$?
    case "$ipcv_trc" in
        0) ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_opname" 0 ok "$ipcv_out" ;;
        1) ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_opname" 3 task_not_found "$ipcv_id" ;;
        3) ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_opname" 4 configuration_invalid "$ipcv_out" ;;
    esac
    return 0
}
# 重启：委托 §24 tctl_restart（停止 + 强启）
ipc_op_restart() {   # <base> <tasks> <req_id> <id> <opname>
    ipcv_base=$1; ipcv_tasks=$2; ipcv_rid=$3; ipcv_id=$4; ipcv_opname=$5
    [ -n "$ipcv_id" ] || { ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_opname" 1 invalid_request "missing id"; return 0; }
    ipcv_out=$(tctl_restart "$ipcv_base" "$ipcv_tasks" "$ipcv_id" 2>/dev/null)
    ipcv_trc=$?
    case "$ipcv_trc" in
        0) ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_opname" 0 ok "$ipcv_out" ;;
        1) ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_opname" 3 task_not_found "$ipcv_id" ;;
        3) ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_opname" 4 configuration_invalid "$ipcv_out" ;;
        4) ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_opname" 4 configuration_invalid "$ipcv_out" ;;
    esac
    return 0
}
# 立即健康检查：委托 §24 tctl_check（不改 state.txt；无 health 配置 → ok 明示）
ipc_op_check() {   # <base> <tasks> <req_id> <id>
    ipcv_base=$1; ipcv_tasks=$2; ipcv_rid=$3; ipcv_id=$4
    [ -n "$ipcv_id" ] || { ipc_respond "$ipcv_base" "$ipcv_rid" CHECK_TASK 1 invalid_request "missing id"; return 0; }
    ipcv_out=$(tctl_check "$ipcv_base" "$ipcv_tasks" "$ipcv_id" 2>/dev/null)
    ipcv_trc=$?
    case "$ipcv_trc" in
        0) ipc_respond "$ipcv_base" "$ipcv_rid" CHECK_TASK 0 ok "$ipcv_out" ;;
        1) ipc_respond "$ipcv_base" "$ipcv_rid" CHECK_TASK 3 task_not_found "$ipcv_id" ;;
        5) ipc_respond "$ipcv_base" "$ipcv_rid" CHECK_TASK 0 ok "$ipcv_out" ;;
        3) ipc_respond "$ipcv_base" "$ipcv_rid" CHECK_TASK 4 configuration_invalid "$ipcv_out" ;;
    esac
    return 0
}
# 分发：<base> <config> <tasks> <req_id> <op> <params>
# 每 op 的**参数键白名单**（固定格式 → 未知键即 invalid_request，绝不透传）：
ipc_allowed_keys() {   # <op> → 允许的参数键（空格分隔）
    case "$1" in
        GET_TASKS|GET_SUMMARY) echo "" ;;
        GET_TASK_STATUS|GET_TASK_LOG|GET_TASK_DETAIL|GET_TASK_EVENTS) echo "id lines" ;;
        GET_DAEMON_LOG) echo "lines" ;;
        GET_TASK_EDIT) echo "id" ;;
        EDIT_TASK) echo "id payload" ;;
        VALIDATE_TASK) echo "name trigger command enabled termux interactive notify_start notify_end msg payload" ;;
        CREATE_TASK) echo "id name trigger command enabled termux interactive notify_start notify_end msg" ;;
        UPDATE_TASK) echo "id name trigger command enabled termux interactive notify_start notify_end msg" ;;
        DELETE_TASK|ENABLE_TASK|DISABLE_TASK) echo "id" ;;
        START_TASK|STOP_TASK|RESTART_TASK|CHECK_TASK) echo "id" ;;
        *) echo "" ;;
    esac
}
ipc_dispatch() {
    ipcv_base=$1; ipcv_config=$2; ipcv_tasks=$3; ipcv_rid=$4; ipcv_op=$5; ipcv_params=$6
    # 参数键白名单校验（未知键 → invalid_request；例：START_TASK 带 command → 拒绝）
    ipcv_allow=$(ipc_allowed_keys "$ipcv_op")
    [ -z "$ipcv_params" ] || {
        ipcv_oldifs=$IFS; IFS='&'
        for ipcv_tok in $ipcv_params; do
            ipcv_k=${ipcv_tok%%=*}
            case " $ipcv_allow " in
                *" $ipcv_k "*) ;;
                *) IFS=$ipcv_oldifs
                   ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_op" 1 invalid_request "unknown param key: $ipcv_k"
                   return 0 ;;
            esac
        done
        IFS=$ipcv_oldifs
    }
    # P3-08：Task ID 字符集/路径穿越门（所有 id-bearing op 共用；非法 id →
    # invalid_request 零副作用，绝不进入文件路径拼接）
    case " $ipcv_allow " in
        *" id "*)
            ipcv_qid=$(ipc_param "$ipcv_params" id)
            if [ -n "$ipcv_qid" ] && ! secv_id_ok "$ipcv_qid"; then
                ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_op" 1 invalid_request "invalid id (charset/path-traversal)"
                return 0
            fi
            ;;
    esac
    case "$ipcv_op" in
        GET_TASKS) ipc_op_get_tasks "$ipcv_base" "$ipcv_tasks" "$ipcv_rid" ;;
        GET_SUMMARY) ipc_op_get_summary "$ipcv_base" "$ipcv_tasks" "$ipcv_rid" ;;
        GET_TASK_STATUS) ipc_op_get_status "$ipcv_base" "$ipcv_tasks" "$ipcv_rid" "$(ipc_param "$ipcv_params" id)" ;;
        GET_TASK_LOG) ipc_op_get_log "$ipcv_base" "$ipcv_tasks" "$ipcv_rid" "$(ipc_param "$ipcv_params" id)" "$(ipc_param "$ipcv_params" lines)" ;;
        GET_TASK_DETAIL) ipc_op_get_task_detail "$ipcv_base" "$ipcv_tasks" "$ipcv_rid" "$(ipc_param "$ipcv_params" id)" ;;
        GET_TASK_EVENTS) ipc_op_get_task_events "$ipcv_base" "$ipcv_tasks" "$ipcv_rid" "$(ipc_param "$ipcv_params" id)" "$(ipc_param "$ipcv_params" lines)" ;;
        GET_DAEMON_LOG) ipc_op_get_daemon_log "$ipcv_base" "$ipcv_rid" "$(ipc_param "$ipcv_params" lines)" ;;
        GET_TASK_EDIT) ipc_op_get_task_edit "$ipcv_base" "$ipcv_rid" "$(ipc_param "$ipcv_params" id)" ;;
        EDIT_TASK) ipc_op_edit_task "$ipcv_base" "$ipcv_config" "$ipcv_rid" "$(ipc_param "$ipcv_params" id)" "$(ipc_param "$ipcv_params" payload)" ;;
        VALIDATE_TASK) ipc_op_validate "$ipcv_base" "$ipcv_rid" "$ipcv_params" ;;
        CREATE_TASK) ipc_op_create "$ipcv_base" "$ipcv_config" "$ipcv_rid" "$ipcv_params" ;;
        UPDATE_TASK) ipc_op_update "$ipcv_base" "$ipcv_config" "$ipcv_rid" "$ipcv_params" ;;
        DELETE_TASK) ipc_op_delete "$ipcv_base" "$ipcv_config" "$ipcv_rid" "$(ipc_param "$ipcv_params" id)" ;;
        ENABLE_TASK) ipc_op_set_enabled "$ipcv_base" "$ipcv_config" "$ipcv_tasks" "$ipcv_rid" "$(ipc_param "$ipcv_params" id)" 1 ENABLE_TASK ;;
        DISABLE_TASK) ipc_op_set_enabled "$ipcv_base" "$ipcv_config" "$ipcv_tasks" "$ipcv_rid" "$(ipc_param "$ipcv_params" id)" 0 DISABLE_TASK ;;
        START_TASK) ipc_op_start "$ipcv_base" "$ipcv_tasks" "$ipcv_rid" "$(ipc_param "$ipcv_params" id)" START_TASK ;;
        STOP_TASK) ipc_op_stop "$ipcv_base" "$ipcv_tasks" "$ipcv_rid" "$(ipc_param "$ipcv_params" id)" STOP_TASK ;;
        RESTART_TASK) ipc_op_restart "$ipcv_base" "$ipcv_tasks" "$ipcv_rid" "$(ipc_param "$ipcv_params" id)" RESTART_TASK ;;
        CHECK_TASK) ipc_op_check "$ipcv_base" "$ipcv_tasks" "$ipcv_rid" "$(ipc_param "$ipcv_params" id)" ;;
    esac
    return 0
}
# 服务端轮询（daemon 主循环调用；单轮 ≤ IPC_POLL_MAX 个请求，绝不阻塞）：
# 扫描 requests/*.req → 读取/限长/解析/频率限制/分发 → 原子响应 → 删除请求文件。
# P3-08：频率限制（时间窗 IPC_RATE_MAX/窗，超限 → rc 7 rate_limited 零副作用）
# + 临时文件清理兜底。
ipc_server_poll() {   # <base> <config> <tasks_dir> → 0
    ipcv_base=$1; ipcv_config=$2; ipcv_tasks=$3
    ipcv_rdir=$(ipc_req_dir "$ipcv_base")
    [ -d "$ipcv_rdir" ] || return 0
    secv_sweep_tmp "$ipcv_base" >/dev/null 2>&1
    ipcv_n=0
    for ipcv_rf in "$ipcv_rdir"/*.req; do
        [ -f "$ipcv_rf" ] || continue
        ipcv_n=$((ipcv_n + 1))
        [ "$ipcv_n" -gt "$IPC_POLL_MAX" ] && break
        ipcv_rid=$(basename "$ipcv_rf" .req)
        if [ -f "$(ipc_resp_dir "$ipcv_base")/$ipcv_rid.resp" ]; then
            rm -f "$ipcv_rf" 2>/dev/null    # 幂等：响应已存在 → 丢弃重复请求
            continue
        fi
        ipcv_sz=$(wc -c < "$ipcv_rf" 2>/dev/null || echo 0)
        if [ "$ipcv_sz" -gt "$IPC_REQ_MAX" ]; then
            ipc_respond "$ipcv_base" "$ipcv_rid" "" 1 invalid_request "request too large"
            rm -f "$ipcv_rf" 2>/dev/null
            continue
        fi
        ipcv_line=$(cat "$ipcv_rf" 2>/dev/null | tr -d '\r')
        rm -f "$ipcv_rf" 2>/dev/null       # 先取走再处理（防重放）
        if ipc_parse "$ipcv_line"; then
            # P3-08：请求频率限制（合法格式请求计窗；超限 → rc 7，不处理不执行）
            if ! secv_ipc_ratelimit "$ipcv_base"; then
                ipc_respond "$ipcv_base" "$ipcv_rid" "$ipcv_op" 7 rate_limited "request rate exceeded"
                continue
            fi
            ipc_dispatch "$ipcv_base" "$ipcv_config" "$ipcv_tasks" "$ipcv_rid" "$ipcv_op" "$ipcv_params"
        else
            ipc_respond "$ipcv_base" "$ipcv_rid" "" 1 invalid_request "malformed request"
        fi
    done
    return 0
}
# 客户端（CLI/WebUI 后端调用）：构建请求 → 原子落盘 → 轮询响应（超时）→ 打印 + rc
ipc_client_send() {   # <base> <op> <params> [timeout] → rc；stdout 响应文件内容
    ipcv_base=$1; ipcv_op=$2; ipcv_params=$3; ipcv_timeout=${4:-5}
    ipcv_pid=$(cat "$(ipc_pid_file "$ipcv_base")" 2>/dev/null)
    if [ -z "$ipcv_pid" ] || [ ! -d "/proc/$ipcv_pid" ]; then
        echo "0|$ipcv_op|6|daemon_unavailable"
        return 6
    fi
    ipcv_rdir=$(ipc_req_dir "$ipcv_base")
    [ -d "$ipcv_rdir" ] || { echo "0|$ipcv_op|6|daemon_unavailable"; return 6; }
    [ -w "$ipcv_rdir" ] || { echo "0|$ipcv_op|2|permission_denied"; return 2; }
    ipcv_rid="r$(date +%s)-$$-$(od -An -N2 -tu2 /dev/urandom 2>/dev/null | tr -d ' ')"
    ipcv_line="$ipcv_rid|$ipcv_op|$ipcv_params"
    [ "${#ipcv_line}" -le "$IPC_REQ_MAX" ] || { echo "0|$ipcv_op|1|invalid_request"; return 1; }
    printf '%s\n' "$ipcv_line" > "$ipcv_rdir/$ipcv_rid.req.tmp" 2>/dev/null \
        && mv "$ipcv_rdir/$ipcv_rid.req.tmp" "$ipcv_rdir/$ipcv_rid.req" 2>/dev/null \
        || { echo "0|$ipcv_op|2|permission_denied"; return 2; }
    ipcv_respdir=$(ipc_resp_dir "$ipcv_base")
    ipcv_i=0
    while [ "$ipcv_i" -lt "$ipcv_timeout" ]; do
        if [ -f "$ipcv_respdir/$ipcv_rid.resp" ]; then
            cat "$ipcv_respdir/$ipcv_rid.resp" 2>/dev/null
            ipcv_rc=$(head -1 "$ipcv_respdir/$ipcv_rid.resp" 2>/dev/null | cut -d'|' -f3)
            rm -f "$ipcv_respdir/$ipcv_rid.resp" 2>/dev/null
            case "$ipcv_rc" in ''|*[!0-9]*) ipcv_rc=0 ;; esac
            return "$ipcv_rc"
        fi
        sleep 1
        ipcv_i=$((ipcv_i + 1))
    done
    echo "0|$ipcv_op|5|operation_timeout"
    return 5
}
# §22 WebUI Read-Only Data Plane（P3-05）：Runtime Read Aggregator
# ═══════════════════════════════════════════════════════════════════════════
# 目标：为 KernelSU WebUI（webroot/）与 `su-scheduler webui` CLI Reader 提供
# **只读**统一 JSON 数据面。**严格只读**：本层全部 op 只聚合 Registry 快照 +
# 运行目录工件 + daemon 日志；零 exec、零 config 写、零副作用（对齐 P3-04
# 安全模型——UI 只经 IPC 读，JS 不读 /data/adb、不调 su/sh -c/eval）。
# 统一 JSON Schema：每个只读 op 返回单行 JSON 载荷；所有字符串值经
#   web_json_escape 编码（\ " 与 C0 控制符转义 + < > & → \uXXXX），保证日志
#   中的 <script>、引号、换行不会注入 HTML/JS（P3-05 安全验收条款）。
# 有界日志读取：task log ≤500 行、daemon log ≤500 行、events ≤200 行；响应
#   携带 truncated=1/0 + total/returned，前端据此明确提示「日志已截断」。
# daemon 离线：本层在 IPC 服务端内运行（daemon 必存活）；离线态由客户端
#   （su-scheduler webui → ipc_client_send rc 6）转为 {"ok":false,...} 输出。
# 命名空间：函数 web_ 前缀、内部全局 webv_ 前缀（防覆盖调用方全局，同 §21）。
# ═══════════════════════════════════════════════════════════════════════════
WEBUI_LOG_MAX=500
WEBUI_EVENTS_MAX=200
web_log() { [ "${WEBUI_LOG:-1}" = "1" ] && echo "[webui] $1" >&2; }
# JSON 字符串转义（不含首尾引号；多行值以字面 \n 表示；< > & → \uXXXX）
web_json_escape() {
    printf '%s' "$1" | tr -d '\000-\010\013\014\016-\037' | awk '
        {
            gsub(/\\/, "\\\\")
            gsub(/"/, "\\\"")
            gsub(/\t/, "\\t")
            gsub(/\r/, "\\r")
            gsub(/</, "\\u003c")
            gsub(/>/, "\\u003e")
            gsub(/&/, "\\u0026")
            if (NR > 1) printf "\\n"
            printf "%s", $0
        }
    '
}
# JSON 字符串字段（带首尾引号）
web_json_str() { printf '"%s"' "$(web_json_escape "$1")"; }
# 运行目录工件优先，缺省回退 task 文件 runtime.* 字段
web_run_or_task() {   # <tasks_dir> <id> <runfile> <task_file> <taskkey>
    webv_rd="$1/$2"
    if [ -f "$webv_rd/$3" ]; then
        cat "$webv_rd/$3" 2>/dev/null
        return 0
    fi
    [ -f "$4" ] && sched_task_field "$4" "$5" || echo ""
}
# 一行 JSON 日志（尾部 N 行 → ["...","..."]）
web_log_lines_json() {   # <file> <returned>
    webv_f=$1; webv_ret=$2
    printf '['
    webv_sep=""
    if [ -f "$webv_f" ] && [ "$webv_ret" -gt 0 ]; then
        tail -n "$webv_ret" "$webv_f" 2>/dev/null | while IFS= read -r webv_line; do
            printf '%s%s' "$webv_sep" "$(web_json_str "$webv_line")"
            webv_sep=","
        done
    fi
    printf ']'
}
# ── P4-09 只读门控/依赖状态观测（无副作用；供 CLI 与 WebUI 查询面复用）──────
# 当前任务状态是否为 WAITING（gate 原因）：<tasks_dir> <id>
# → stdout=如 "WAITING (dep failed: t_b)"；非 WAITING/无运行目录 → 空。
# 原因来源：运行目录 gate 工件（retry.until=退避中 / gate.fail 标记）或
# events.log 最新 gate_wait/gate_fail 事件 msg（依赖原因可读）。
obs_gate_state() {
    obs_tasks=$1; obs_id=$2
    obs_rd="$obs_tasks/$obs_id"
    if [ -n "$obs_tasks" ] && [ -d "$obs_rd" ]; then
        obs_st=$(runtime_current_state "$obs_rd" 2>/dev/null)
        if [ "$obs_st" = "WAITING" ]; then
            obs_reason=""
            if [ -f "$(sched_retry_until_file "$obs_rd")" ]; then
                obs_reason="retry backoff (until $(cat "$(sched_retry_until_file "$obs_rd")" 2>/dev/null))"
            elif [ -f "$(sched_retry_gatefail_file "$obs_rd")" ]; then
                obs_reason=$(cat "$(sched_retry_gatefail_file "$obs_rd")" 2>/dev/null)
            else
                obs_reason=$(grep -E '\|(gate_wait|gate_fail)\|' "$obs_rd/events.log" 2>/dev/null | tail -1 | cut -d'|' -f7-)
            fi
            if [ -n "$obs_reason" ]; then
                printf 'WAITING (%s)' "$obs_reason"
            else
                printf 'WAITING'
            fi
            return 0
        fi
    fi
    return 0
}
# 当前依赖门控判定摘要（复用 §20 sched_dep_satisfied，只读无副作用）：
# <tasks_dir> <id> → stdout=ok|satisfied|waiting|unsat
obs_dep_state() {
    obs_tasks=$1; obs_id=$2
    obs_tf=$(registry_task_file "$obs_id" 2>/dev/null)
    [ -n "$obs_tf" ] || { echo "ok"; return 0; }
    obs_dep=$(sched_task_field "$obs_tf" dependency)
    [ -n "$obs_dep" ] || { echo "ok"; return 0; }
    sched_dep_satisfied "$obs_tasks" "$obs_id" >/dev/null 2>&1
    obs_rc=$?
    case "$obs_rc" in
        0) echo "satisfied" ;;
        1) echo "waiting" ;;
        2) echo "unsat" ;;
        *) echo "ok" ;;
    esac
    return 0
}
# 任务紧凑行（GET_SUMMARY.tasks 元素）
web_task_row() {   # <tasks_dir> <task_file> <id>
    webv_tasks=$1; webv_f=$2; webv_id=$3
    webv_st=$(ipc_task_state "$webv_tasks" "$webv_id")
    webv_en=$(sched_task_field "$webv_f" enabled); [ -z "$webv_en" ] && webv_en=0
    webv_trig=$(sched_task_field "$webv_f" trigger)
    webv_act=$(sched_task_field "$webv_f" action.command)
    webv_last=$(web_run_or_task "$webv_tasks" "$webv_id" start_time.txt "$webv_f" runtime.last_start)
    webv_rcount=$(cat "$webv_tasks/$webv_id/recovery.count" 2>/dev/null); [ -n "$webv_rcount" ] || webv_rcount=0
    webv_hasrun=0; [ -d "$webv_tasks/$webv_id" ] && webv_hasrun=1
    webv_ht=$(sched_task_field "$webv_f" health.type); [ -z "$webv_ht" ] && webv_ht=none
    webv_health=$webv_ht
    case "$webv_st" in HEALTHY|UNHEALTHY|UNKNOWN|RECOVERING) webv_health=$webv_st ;; esac
    printf '{"id":%s,"name":%s,"status":%s,"trigger":%s,"action":%s,"enabled":%s,"health":%s,"last_run":%s,"restart_count":%s,"has_run_dir":%s}' \
        "$(web_json_str "$webv_id")" \
        "$(web_json_str "$(sched_task_field "$webv_f" name)")" \
        "$(web_json_str "$webv_st")" \
        "$(web_json_str "$webv_trig")" \
        "$(web_json_str "$webv_act")" \
        "$(web_json_str "$webv_en")" \
        "$(web_json_str "$webv_health")" \
        "$(web_json_str "$webv_last")" \
        "$webv_rcount" "$webv_hasrun"
}
# ── GET_SUMMARY：计数 + 任务紧凑列表（Dashboard + Task List 单调用）────────
web_agg_summary() {   # <base> <tasks> → 单行 JSON
    webv_base=$1; webv_tasks=$2
    webv_total=0 webv_running=0 webv_healthy=0 webv_failed=0 webv_disabled=0 webv_unhealthy=0 webv_unknown=0 webv_waiting=0
    webv_rows="" webv_sep=""
    for webv_id in $(registry_task_ids); do
        webv_f=$(registry_task_file "$webv_id" 2>/dev/null) || continue
        webv_total=$((webv_total + 1))
        webv_en=$(sched_task_field "$webv_f" enabled)
        [ "$webv_en" = "0" ] && webv_disabled=$((webv_disabled + 1))
        webv_st=$(ipc_task_state "$webv_tasks" "$webv_id")
        case "$webv_st" in
            RUNNING|STARTING) webv_running=$((webv_running + 1)) ;;
            HEALTHY) webv_healthy=$((webv_healthy + 1)) ;;
            FAILED) webv_failed=$((webv_failed + 1)) ;;
            UNHEALTHY) webv_unhealthy=$((webv_unhealthy + 1)) ;;
            WAITING) webv_waiting=$((webv_waiting + 1)) ;;
            *) webv_unknown=$((webv_unknown + 1)) ;;
        esac
        webv_row=$(web_task_row "$webv_tasks" "$webv_f" "$webv_id")
        webv_rows="${webv_rows}${webv_sep}${webv_row}"
        webv_sep=","
    done
    webv_mode=$(sched_source_mode "$webv_base")
    printf '{"ok":true,"daemon":"online","mode":%s,"counts":{"total":%s,"running":%s,"healthy":%s,"failed":%s,"disabled":%s,"unhealthy":%s,"unknown":%s,"waiting":%s},"tasks":[%s]}' \
        "$(web_json_str "$webv_mode")" \
        "$webv_total" "$webv_running" "$webv_healthy" "$webv_failed" "$webv_disabled" "$webv_unhealthy" "$webv_unknown" "$webv_waiting" \
        "$webv_rows"
}
# ── GET_TASK_DETAIL：完整任务详情（Task Detail 页）─────────────────────────
web_task_detail() {   # <tasks_dir> <task_file> <id> → 单行 JSON
    webv_tasks=$1; webv_f=$2; webv_id=$3
    webv_st=$(ipc_task_state "$webv_tasks" "$webv_id")
    webv_rd="$webv_tasks/$webv_id"
    webv_pid=$(web_run_or_task "$webv_tasks" "$webv_id" pid.txt "$webv_f" runtime.pid)
    webv_exit=$(web_run_or_task "$webv_tasks" "$webv_id" exit_code.txt "$webv_f" runtime.last_exit)
    webv_start=$(web_run_or_task "$webv_tasks" "$webv_id" start_time.txt "$webv_f" runtime.last_start)
    webv_end=$(web_run_or_task "$webv_tasks" "$webv_id" end_time.txt "$webv_f" runtime.last_end)
    webv_rcount=$(cat "$webv_rd/recovery.count" 2>/dev/null); [ -n "$webv_rcount" ] || webv_rcount=0
    webv_run_count=$(sched_task_field "$webv_f" runtime.run_count); [ -n "$webv_run_count" ] || webv_run_count=0
    webv_ht=$(sched_task_field "$webv_f" health.type); [ -z "$webv_ht" ] && webv_ht=none
    webv_htgt=$(sched_task_field "$webv_f" health.target)
    webv_rtype=$(sched_task_field "$webv_f" recovery.type); [ -z "$webv_rtype" ] && webv_rtype=none
    webv_rmax=$(sched_task_field "$webv_f" retry.max); [ -n "$webv_rmax" ] || webv_rmax=0
    webv_rint=$(sched_task_field "$webv_f" retry.interval); [ -n "$webv_rint" ] || webv_rint=60
    webv_hasrun=0; [ -d "$webv_rd" ] && webv_hasrun=1
    printf '{"ok":true,"task":{'
    printf '"id":%s,"name":%s,"status":%s,"trigger":%s,"action":%s,"enabled":%s,' \
        "$(web_json_str "$webv_id")" \
        "$(web_json_str "$(sched_task_field "$webv_f" name)")" \
        "$(web_json_str "$webv_st")" \
        "$(web_json_str "$(sched_task_field "$webv_f" trigger)")" \
        "$(web_json_str "$(sched_task_field "$webv_f" action.command)")" \
        "$(web_json_str "$(sched_task_field "$webv_f" enabled)")"
    printf '"health":{"type":%s,"target":%s},' "$(web_json_str "$webv_ht")" "$(web_json_str "$webv_htgt")"
    printf '"recovery":{"type":%s,"max":%s,"interval":%s},' "$(web_json_str "$webv_rtype")" "$webv_rmax" "$webv_rint"
    printf '"pid":%s,"last_exit":%s,"last_start":%s,"last_end":%s,' \
        "$(web_json_str "$webv_pid")" "$(web_json_str "$webv_exit")" "$(web_json_str "$webv_start")" "$(web_json_str "$webv_end")"
    printf '"restart_count":%s,"run_count":%s,' "$webv_rcount" "$webv_run_count"
    printf '"source":{"type":%s,"line":%s,"raw":%s},' \
        "$(web_json_str "$(sched_task_field "$webv_f" source.type)")" \
        "$(web_json_str "$(sched_task_field "$webv_f" source.line)")" \
        "$(web_json_str "$(sched_task_field "$webv_f" source.raw)")"
    # P4-09：依赖/条件原字符串 + 只读门控判定摘要（dependency_state / gate_state）
    printf '"dependency":%s,"condition":%s,' \
        "$(web_json_str "$(sched_task_field "$webv_f" dependency)")" \
        "$(web_json_str "$(sched_task_field "$webv_f" condition)")"
    printf '"dependency_state":%s,"gate_state":%s,' \
        "$(web_json_str "$(obs_dep_state "$webv_tasks" "$webv_id")")" \
        "$(web_json_str "$(obs_gate_state "$webv_tasks" "$webv_id")")"
    printf '"has_run_dir":%s}}' "$webv_hasrun"
}
# ── 日志聚合（GET_TASK_EVENTS / GET_DAEMON_LOG / GET_TASK_LOG）──────────────
web_log_payload() {   # <file> <max> <label> → {"ok":true,<label>...,"total":..,"returned":..,"truncated":..,"lines":[...]}
    webv_f=$1; webv_max=$2; webv_label=$3
    webv_total=0
    [ -f "$webv_f" ] && webv_total=$(wc -l < "$webv_f" 2>/dev/null || echo 0)
    webv_returned=$webv_total
    [ "$webv_returned" -gt "$webv_max" ] && webv_returned=$webv_max
    webv_trunc=0
    [ "$webv_returned" -lt "$webv_total" ] && webv_trunc=1
    webv_lines=$(web_log_lines_json "$webv_f" "$webv_returned")
    printf '{"ok":true,%s"total":%s,"returned":%s,"truncated":%s,"lines":%s}' \
        "$webv_label" "$webv_total" "$webv_returned" "$webv_trunc" "$webv_lines"
}
# ── IPC op 处理器（全部只读）────────────────────────────────────────────────
ipc_op_get_summary() {   # <base> <tasks> <req_id>
    webv_base=$1; webv_tasks=$2; webv_rid=$3
    webv_payload=$(web_agg_summary "$webv_base" "$webv_tasks")
    ipc_respond "$webv_base" "$webv_rid" GET_SUMMARY 0 ok "$webv_payload"
    return 0
}
ipc_op_get_task_detail() {   # <base> <tasks> <req_id> <id>
    webv_base=$1; webv_tasks=$2; webv_rid=$3; webv_id=$4
    [ -n "$webv_id" ] || { ipc_respond "$webv_base" "$webv_rid" GET_TASK_DETAIL 1 invalid_request "missing id"; return 0; }
    webv_f=$(registry_task_file "$webv_id" 2>/dev/null)
    [ -n "$webv_f" ] || { ipc_respond "$webv_base" "$webv_rid" GET_TASK_DETAIL 3 task_not_found "$webv_id"; return 0; }
    webv_payload=$(web_task_detail "$webv_tasks" "$webv_f" "$webv_id")
    ipc_respond "$webv_base" "$webv_rid" GET_TASK_DETAIL 0 ok "$webv_payload"
    return 0
}
ipc_op_get_task_events() {   # <base> <tasks> <req_id> <id> [lines]
    webv_base=$1; webv_tasks=$2; webv_rid=$3; webv_id=$4
    webv_lines=$(secv_num_clamp "${5:-50}" 1 "$WEBUI_EVENTS_MAX" 50)
    [ -n "$webv_id" ] || { ipc_respond "$webv_base" "$webv_rid" GET_TASK_EVENTS 1 invalid_request "missing id"; return 0; }
    webv_f=$(registry_task_file "$webv_id" 2>/dev/null)
    [ -n "$webv_f" ] || { ipc_respond "$webv_base" "$webv_rid" GET_TASK_EVENTS 3 task_not_found "$webv_id"; return 0; }
    webv_payload=$(web_log_payload "$webv_tasks/$webv_id/events.log" "$webv_lines" "\"task\":$(web_json_str "$webv_id"),")
    ipc_respond "$webv_base" "$webv_rid" GET_TASK_EVENTS 0 ok "$webv_payload"
    return 0
}
ipc_op_get_daemon_log() {   # <base> <req_id> [lines]
    webv_base=$1; webv_rid=$2
    webv_lines=$(secv_num_clamp "${3:-50}" 1 "$WEBUI_LOG_MAX" 50)
    webv_payload=$(web_log_payload "$webv_base/su-scheduler.log" "$webv_lines" "")
    ipc_respond "$webv_base" "$webv_rid" GET_DAEMON_LOG 0 ok "$webv_payload"
    return 0
}
# GET_TASK_LOG 载荷 → 统一 JSON（CLI Reader 与前端共用；meta 行透传截断态）
web_task_log_to_json() {   # <payload> → 单行 JSON
    webv_payload=$1
    webv_meta=$(printf '%s\n' "$webv_payload" | head -1)
    webv_lines=$(printf '%s\n' "$webv_payload" | tail -n +2)
    webv_trunc=0; webv_total=0; webv_ret=0
    case "$webv_meta" in
        \#truncated=*)
            # P3-10 D-IPC 修复：cut 切分（同 §3 注释），meta 为
            # `#truncated=N|total=M|lines=K` 三字段。
            webv_trunc=$(printf '%s\n' "$webv_meta" | cut -d'|' -f1 | cut -d= -f2)
            webv_total=$(printf '%s\n' "$webv_meta" | cut -d'|' -f2 | cut -d= -f2)
            webv_ret=$(printf '%s\n' "$webv_meta" | cut -d'|' -f3 | cut -d= -f2)
            ;;
    esac
    printf '{"ok":true,"truncated":%s,"total":%s,"returned":%s,"lines":[' \
        "$webv_trunc" "$webv_total" "$webv_ret"
    webv_sep=""
    printf '%s\n' "$webv_lines" | while IFS= read -r webv_line; do
        printf '%s%s' "$webv_sep" "$(web_json_str "$webv_line")"
        webv_sep=","
    done
    printf ']}'
}
# ────────────────────────────────────────────────────────────────────────
# §23 Task Editor Store（P3-06）：Task v2 表单 schema 的权威后端
# ═══════════════════════════════════════════════════════════════════════════
# 目标：WebUI Task Editor 的后端底座——「前后端双重校验」的后端半边（前端
# 校验不是安全边界，最终以本层为准）。所有保存操作**原子化**（tmp+mv）、
# **ID 防路径穿越**、**App Action 复用 P2-10 结构化校验**、**recovery script
# 绝对路径且可读**、**全部数值范围钳制**；保存失败时旧配置逐字节不变。
#
# 输入：完整 Task v2 文件内容（POSIX key=value 多行；即 GET_TASK_EDIT 回显的
#   原文，用户在编辑器上改字段后原样提交）。本层不引入新配置格式——
#   task-config 存储规范（docs/architecture/task-config-store.md）不变。
# 字段（表单 schema，P3-06）：
#   Basic    schema_version / id / name / enabled / description
#   Trigger  trigger（boot | HH:MM | HHMM | weekly: | nweekly: | monthly: |
#            nmonthly: | yearly:；boot_completed / delay / interval / cron /
#            oneshot 未实现 → 拒绝，编辑器必须禁用或隐藏）
#   Action   action.type（command | script | app）
#            - command：action.command 非空单行命令
#            - script：action.command = 绝对路径脚本（存在可读）
#            - app：action.command = app:op:target[:extras]（P2-10 全校验）
#            action.notify_start/notify_end/delete/termux/interactive/
#            run_once_now/boot（0|1）＋ action.msg
#   Health   health.type（none|process|port）＋ health.target
#   Recovery recovery.type（none|restart|start|stopstart|script）
#            script → recovery.script 绝对路径且可读
#   Retry    retry.max [0,100] / retry.interval [0,86400] /
#            retry.cooldown [0,86400]
#   Advanced advanced.timeout [0,86400] / advanced.environment（K=V 列表，
#            安全字符集）/ advanced.concurrency [0,100] /
#            advanced.logging [0,1000000]
#   （不提供 dependency/condition 编辑：P3 边界，见 P3-ARCHITECTURE-DECISIONS
#   D6；runtime.*/source.* 只读保留——编辑不可篡改运行事实与来源事实）
# 命名空间：tcfg_ 前缀沿用 §19（内部全局 tcfgv_ / tedv_ 前缀）。
# ═══════════════════════════════════════════════════════════════════════════
# 数值范围助手：<val> <min> <max> → 0=合法
tcfg_editor_num() {
    tedv_v=$1; tedv_min=$2; tedv_max=$3
    case "$tedv_v" in ''|*[!0-9]*) return 1 ;; esac
    [ "$tedv_v" -ge "$tedv_min" ] 2>/dev/null && [ "$tedv_v" -le "$tedv_max" ] 2>/dev/null
}
tcfg_editor_bool() {   # <val> → 0=合法（0|1）
    [ "$1" = "0" ] || [ "$1" = "1" ]
}
tcfg_editor_id_ok() {   # <id> → 0=合法（charset + 无路径穿越）
    case "$1" in
        ""|*[!A-Za-z0-9_.-]*) return 1 ;;
        *..*|*/*|*\*) return 1 ;;
    esac
    return 0
}
tcfg_editor_trigger_ok() {   # <trigger> → 0=已实现合法触发器（拒绝未实现族）
    case "$1" in
        boot) return 0 ;;
        [0-9][0-9]:[0-9][0-9]) return 0 ;;
        [0-9][0-9][0-9][0-9]) return 0 ;;
        weekly:[1-7]:[0-9][0-9][0-9][0-9]) return 0 ;;
        nweekly:[0-9]*:[1-7]:[0-9][0-9][0-9][0-9]) return 0 ;;
        monthly:[0-9]*:[0-9][0-9][0-9][0-9]) return 0 ;;
        nmonthly:[0-9]*:[0-9]*:[0-9][0-9][0-9][0-9]) return 0 ;;
        yearly:[0-9][0-9][0-9][0-9]:[0-9][0-9][0-9][0-9]) return 0 ;;
        yearly:[0-9][0-9]:[0-9][0-9]:[0-9][0-9][0-9][0-9]) return 0 ;;
    esac
    return 1
}
# action 校验：<type> <command> → 0=合法（app 复用 P2-10 结构化校验；
# script 绝对路径存在可读；command 非空且不含未转义真实换行）
tcfg_editor_action_ok() {
    tedv_at=$1; tedv_cmd=$2
    case "$tedv_at" in
        command|script)
            [ -n "$tedv_cmd" ] || return 1
            printf '%s' "$tedv_cmd" | awk 'NR>1 { exit 0 } END { exit 1 }' 2>/dev/null; tedv_rc=$?
            if [ "$tedv_rc" -ne 1 ]; then return 1; fi
            if [ "$tedv_at" = "script" ]; then
                case "$tedv_cmd" in
                    /*) [ -f "$tedv_cmd" ] && [ -r "$tedv_cmd" ] || return 1 ;;
                    *) return 1 ;;
                esac
            fi
            return 0 ;;
        app)
            tpr_action_app_validate "$tedv_cmd" 2>/dev/null ;;
        *) return 1 ;;
    esac
}
# health 校验：<type> <target> → 0=合法（process/port 复用 P2-11 校验）
tcfg_editor_health_ok() {
    tedv_ht=$1; tedv_hg=$2
    case "$tedv_ht" in
        none) [ -z "$tedv_hg" ] || [ "$tedv_hg" = "none" ] ;;
        process) tpr_health_process_validate "$tedv_hg" 2>/dev/null ;;
        port) tpr_health_port_validate "$tedv_hg" 2>/dev/null ;;
        *) return 1 ;;
    esac
}
# recovery 校验：<type> <script> → 0=合法（script 绝对路径存在可读）
tcfg_editor_recovery_ok() {
    tedv_rt=$1; tedv_rs=$2
    case "$tedv_rt" in
        none|restart|start|stopstart) return 0 ;;
        script)
            case "$tedv_rs" in
                /*) [ -f "$tedv_rs" ] && [ -r "$tedv_rs" ] || return 1 ;;
                *) return 1 ;;
            esac
            return 0 ;;
        *) return 1 ;;
    esac
}
# 完整 payload 校验：<content> → 0=合法 / 1=非法（错误 → stderr，逐条）
# 校验失败**绝不写盘**（调用方 tcfg_apply_task 只在 0 时原子写）。
tcfg_editor_validate_payload() {   # <content>
    tedv_content=$1
    tedv_tmp=$(mktemp "/tmp/tcfg-edit.XXXXXX" 2>/dev/null) || return 1
    printf '%s\n' "$tedv_content" > "$tedv_tmp"
    tedv_id=""; tedv_name=""; tedv_enabled=""; tedv_desc=""; tedv_trig=""
    tedv_atype=""; tedv_acmd=""; tedv_htype=""; tedv_htgt=""; tedv_rtype=""; tedv_rscr=""
    tedv_rmax=""; tedv_rint=""; tedv_rcool=""; tedv_advto=""; tedv_advenv=""; tedv_advconc=""; tedv_advlog=""
    tedv_sv=""; tedv_err=0
    while IFS= read -r tedv_line || [ -n "$tedv_line" ]; do
        case "$tedv_line" in ''|[#]*) continue ;;
        esac
        case "$tedv_line" in *"="*) ;; *) continue ;; esac
        tedv_key=$(printf '%s' "$tedv_line" | cut -d= -f1 | tr -d '\n')
        tedv_val=$(printf '%s' "$tedv_line" | cut -d= -f2- | tr -d '\n')
        case "$tedv_key" in
            schema_version) tedv_sv=$tedv_val ;;
            id) tedv_id=$tedv_val ;;
            name) tedv_name=$tedv_val ;;
            enabled) tedv_enabled=$tedv_val ;;
            description) tedv_desc=$tedv_val ;;
            trigger) tedv_trig=$tedv_val ;;
            action.type) tedv_atype=$tedv_val ;;
            action.command) tedv_acmd=$tedv_val ;;
            action.notify_start|action.notify_end|action.delete|action.termux|action.interactive|action.run_once_now|action.boot)
                tcfg_editor_bool "$tedv_val" || { echo "[editor] ERROR: $tedv_key must be 0|1 (got '$tedv_val')" >&2; tedv_err=1; } ;;
            action.msg) [ ${#tedv_val} -le 256 ] || { echo "[editor] ERROR: action.msg > 256 chars" >&2; tedv_err=1; } ;;
            health.type) tedv_htype=$tedv_val ;;
            health.target) tedv_htgt=$tedv_val ;;
            recovery.type) tedv_rtype=$tedv_val ;;
            recovery.script) tedv_rscr=$tedv_val ;;
            retry.max) tedv_rmax=$tedv_val ;;
            retry.interval) tedv_rint=$tedv_val ;;
            retry.cooldown) tedv_rcool=$tedv_val ;;
            advanced.timeout) tedv_advto=$tedv_val ;;
            advanced.environment) tedv_advenv=$tedv_val ;;
            advanced.concurrency) tedv_advconc=$tedv_val ;;
            advanced.logging) tedv_advlog=$tedv_val ;;
            dependency)
                dep_validate "$tedv_val" || { echo "[editor] ERROR: dependency syntax invalid (got '$tedv_val'; expect '[?]<task-id>[:STATE]', ',' or space separated, <= $DEP_MAX entries)" >&2; tedv_err=1; } ;;
            condition)
                cond_validate "$tedv_val" || { echo "[editor] ERROR: condition invalid (got '$tedv_val'; printable ASCII, <= $COND_MAX_LEN chars)" >&2; tedv_err=1; }
                if [ -n "$tedv_val" ] && ! cond_grammar_ok "$tedv_val"; then
                    echo "[editor] ERROR: condition expression illegal (got '$tedv_val'; whitelisted predicates only: task.state/time.hour/time.minute/time.wday/env.<CONFIG_FILE|DATA_DIR|TASKS_DIR>/file.exists, ops ==/!=)" >&2; tedv_err=1
                fi ;;
            source.*|runtime.*) : ;;   # 只读保留字段（编辑器不可改）
            *) echo "[editor] ERROR: unknown key '$tedv_key' (editor schema)" >&2; tedv_err=1 ;;
        esac
    done < "$tedv_tmp"
    rm -f "$tedv_tmp" 2>/dev/null

    [ "$tedv_sv" = "2" ] || { echo "[editor] ERROR: schema_version must be 2" >&2; tedv_err=1; }
    tcfg_editor_id_ok "$tedv_id" || { echo "[editor] ERROR: invalid id '$tedv_id' (charset/path-traversal)" >&2; tedv_err=1; }
    [ -z "$tedv_enabled" ] && tedv_enabled=1
    tcfg_editor_bool "$tedv_enabled" || { echo "[editor] ERROR: enabled must be 0|1" >&2; tedv_err=1; }
    [ ${#tedv_name} -le 64 ] || { echo "[editor] ERROR: name > 64 chars" >&2; tedv_err=1; }
    [ ${#tedv_desc} -le 256 ] || { echo "[editor] ERROR: description > 256 chars" >&2; tedv_err=1; }
    tcfg_editor_trigger_ok "$tedv_trig" || { echo "[editor] ERROR: trigger '$tedv_trig' not implemented (P3 supports boot/time/advanced families only)" >&2; tedv_err=1; }
    [ -z "$tedv_atype" ] && tedv_atype=command
    tcfg_editor_action_ok "$tedv_atype" "$tedv_acmd" || { echo "[editor] ERROR: invalid action type='$tedv_atype' command='$tedv_acmd'" >&2; tedv_err=1; }
    [ -z "$tedv_htype" ] && tedv_htype=none
    tcfg_editor_health_ok "$tedv_htype" "$tedv_htgt" || { echo "[editor] ERROR: invalid health type='$tedv_htype' target='$tedv_htgt'" >&2; tedv_err=1; }
    [ -z "$tedv_rtype" ] && tedv_rtype=none
    tcfg_editor_recovery_ok "$tedv_rtype" "$tedv_rscr" || { echo "[editor] ERROR: invalid recovery type='$tedv_rtype' script='$tedv_rscr'" >&2; tedv_err=1; }
    [ -z "$tedv_rmax" ] && tedv_rmax=0
    tcfg_editor_num "$tedv_rmax" 0 100 || { echo "[editor] ERROR: retry.max must be 0-100" >&2; tedv_err=1; }
    [ -z "$tedv_rint" ] && tedv_rint=60
    tcfg_editor_num "$tedv_rint" 0 86400 || { echo "[editor] ERROR: retry.interval must be 0-86400" >&2; tedv_err=1; }
    [ -z "$tedv_rcool" ] && tedv_rcool=0
    tcfg_editor_num "$tedv_rcool" 0 86400 || { echo "[editor] ERROR: retry.cooldown must be 0-86400" >&2; tedv_err=1; }
    [ -z "$tedv_advto" ] && tedv_advto=0
    tcfg_editor_num "$tedv_advto" 0 86400 || { echo "[editor] ERROR: advanced.timeout must be 0-86400" >&2; tedv_err=1; }
    if [ -n "$tedv_advenv" ]; then
        case "$tedv_advenv" in
            *[!A-Za-z0-9_=,.:/+-]*) echo "[editor] ERROR: advanced.environment has unsafe chars (K=V,K=V)" >&2; tedv_err=1 ;;
        esac
    fi
    [ -z "$tedv_advconc" ] && tedv_advconc=0
    tcfg_editor_num "$tedv_advconc" 0 100 || { echo "[editor] ERROR: advanced.concurrency must be 0-100" >&2; tedv_err=1; }
    [ -z "$tedv_advlog" ] && tedv_advlog=0
    tcfg_editor_num "$tedv_advlog" 0 1000000 || { echo "[editor] ERROR: advanced.logging must be 0-1000000" >&2; tedv_err=1; }
    [ "$tedv_err" -eq 0 ] || return 1
    # P4-03：依赖图校验（未知/自依赖/环）——以「当前目录 + 该 payload 替换原
    # 文件后的有效集合」判定（apply 前目录是旧内容；payload 本身是新内容）。
    # 校验失败绝不写盘（调用方 tcfg_apply_task 只在 0 时原子写）。
    if [ -n "$tedv_id" ]; then
        dep_validate_graph "$(tcfg_dir)" "$tedv_id" "$tedv_content" "[editor] ERROR:" || tedv_err=1
    fi
    [ "$tedv_err" -eq 0 ] || return 1
    return 0
}
# 原子应用：<id> <content> → 0=成功 1=校验失败（不写盘） 2=硬错误
# managed 模式；tmp+mv 原子；失败清理 tmp、旧 task 文件逐字节不变。
tcfg_apply_task() {   # <id> <content>
    tedv_id=$1; tedv_content=$2
    tcfg_is_managed || { echo "[editor] ERROR: write ops require managed task-config (run: su-scheduler task-config import)" >&2; return 1; }
    tcfg_editor_id_ok "$tedv_id" || { echo "[editor] ERROR: invalid id '$tedv_id'" >&2; return 1; }
    tedv_reqid=$tedv_id   # 先保存请求 id（validate 内部会覆盖 tedv_id，POSIX 无局部变量）
    tcfg_editor_validate_payload "$tedv_content" || return 1
    # 一致性：payload 内 id= 必须等于请求 id（与文件名一致，防保存后 reload 隔离）
    tedv_pid=$(printf '%s' "$tedv_content" | grep '^id=' | head -1 | cut -d= -f2- | tr -d '\n')
    [ -n "$tedv_pid" ] && [ "$tedv_pid" = "$tedv_reqid" ] || { echo "[editor] ERROR: payload id mismatch (got '$tedv_pid' want '$tedv_reqid')" >&2; return 1; }
    tedv_f=$(tcfg_task_file "$tedv_reqid")
    tedv_tmp="$tedv_f.tmp.$$"
    printf '%s\n' "$tedv_content" > "$tedv_tmp" 2>/dev/null || { rm -f "$tedv_tmp"; return 2; }
    mv "$tedv_tmp" "$tedv_f" 2>/dev/null || { rm -f "$tedv_tmp"; return 2; }
    return 0
}
# GET_TASK_EDIT：返回 task-config 完整原文（base64 载荷；编辑器回填表单用）
ipc_op_get_task_edit() {   # <base> <req_id> <id>
    ipcv_base=$1; ipcv_rid=$2; ipcv_id=$3
    [ -n "$ipcv_id" ] || { ipc_respond "$ipcv_base" "$ipcv_rid" GET_TASK_EDIT 1 invalid_request "missing id"; return 0; }
    [ -f "$(tcfg_task_file "$ipcv_id")" ] || { ipc_respond "$ipcv_base" "$ipcv_rid" GET_TASK_EDIT 3 task_not_found "$ipcv_id"; return 0; }
    ipcv_content=$(cat "$(tcfg_task_file "$ipcv_id")" 2>/dev/null)
    ipc_respond "$ipcv_base" "$ipcv_rid" GET_TASK_EDIT 0 ok "$(ipc_b64enc "$ipcv_content")"
    return 0
}
# EDIT_TASK：完整 Task v2 内容原子写入（managed）+ reload
# 参数：id + payload（完整 key=value 内容 base64；GET_TASK_EDIT 回显 → 编辑 → 回传）
ipc_op_edit_task() {   # <base> <config> <req_id> <id> <payload>
    ipcv_base=$1; ipcv_config=$2; ipcv_rid=$3; ipcv_id=$4; ipcv_payload=$5
    tcfg_is_managed || {
        ipc_respond "$ipcv_base" "$ipcv_rid" EDIT_TASK 4 configuration_invalid "write ops require managed task-config (run: su-scheduler task-config import)"; return 0; }
    [ -n "$ipcv_id" ] && [ -n "$ipcv_payload" ] || {
        ipc_respond "$ipcv_base" "$ipcv_rid" EDIT_TASK 1 invalid_request "missing id/payload"; return 0; }
    tcfg_apply_task "$ipcv_id" "$ipcv_payload"
    ipcv_arc=$?
    case "$ipcv_arc" in
        0)
            sched_reload "$ipcv_base" "$ipcv_config" >/dev/null 2>&1
            ipc_respond "$ipcv_base" "$ipcv_rid" EDIT_TASK 0 ok "saved $ipcv_id" ;;
        1) ipc_respond "$ipcv_base" "$ipcv_rid" EDIT_TASK 4 configuration_invalid "task invalid (config unchanged)" ;;
        *) ipc_respond "$ipcv_base" "$ipcv_rid" EDIT_TASK 4 configuration_invalid "write failed" ;;
    esac
    return 0
}
# ═══════════════════════════════════════════════════════════════════════════
# §24 Task Control API（P3-07）：WebUI 与 CLI 共用同一控制 API
# ═══════════════════════════════════════════════════════════════════════════
# 目标：把「任务控制操作」（enable/disable/start/stop/restart/check/logs）收敛
# 为**单一控制 API**——WebUI（经 IPC op → daemon）与 CLI（`su-scheduler task
# <op> <id>`，经同一 IPC 通道）都路由到本层 `tctl_*` 函数。本层是控制语义与
# 状态机强制（TSM 允许边）的唯一事实源。
#   - 稳定 Task ID 与旧运行 ID 双向解析（§13 task_cli_resolve_id + §9 idmap）；
#   - start：终态重武装（FAILED/STOPPED/DISABLED → PENDING）→ PENDING→STARTING
#     （manual_exec）→ action_run（STARTING→RUNNING，spawn）；已 RUNNING/STARTING
#     → **skip 策略**（不重复启动）；非 force 下 STOPPING/RECOVERING/WAITING →
#     非法拒绝；force=1（restart 亦走此）时 WAITING → **手动跳过依赖门控**直接
#     STARTING（TSM 允许边 WAITING>STARTING manual_exec，P4-05）；
#   - stop：RUNNING/HEALTHY/UNHEALTHY/STARTING/RECOVERING → STOPPING
#     （stop_request）→ supervisor_stop_task（**只杀本运行目录 pid**，不误杀
#     其他任务）→ 等进程退出 → STOPPING→STOPPED；PENDING/STOPPED/FAILED/
#     DISABLED → not_running（不写状态）；STOPPING → already_stopping；
#   - restart：stop（若运行中）+ force start；
#   - check：立即执行一次健康检查（§16 health_check），**只追加 probe 事件，
#     不改 state.txt**（避免非法状态转换）；无 health 配置 → no_health_configured；
#   - logs：查询运行目录 output.log 尾部；
#   - enable/disable：改 task-config 权威存储（**仅 Managed 模式**）+ reload。
# **非法操作必须返回错误且不得强行写状态文件**：所有状态迁移一律经
# state_log_event（TSM 校验；非法边 → 拒绝 + 调用方返回错误），绝不直接写
# state.txt。操作失败不破坏 Registry（task-config 原子写）与旧工件（status.txt
# /pid.txt/output.log/exit_code.txt 只读不动）。
# 返回约定（tctl 层）：
#   0=ok | 1=task not found | 2=skip（并发 start 已运行）| 3=illegal（状态机
#   拒绝）| 4=操作失败（启动失败/无命令）| 5=check 无 health 配置
# 命名空间：函数 tctl_ 前缀、内部全局 tclv_ 前缀（防覆盖调用方全局，同 §21）。
# ═══════════════════════════════════════════════════════════════════════════
tctl_log() {
    [ "${TCTL_LOG:-1}" = "1" ] && echo "[tctl] $1" >&2
}

# 解析：稳定 Task ID 或旧运行 ID → echo "canonical|run_dir"；rc 1=not found
# 旧运行 ID 控制旧运行目录：优先命中 `$tasks/<qid>`（旧运行目录本体），否则
# canonical 目录（稳定 ID 运行目录）。
tctl_resolve() {   # <base> <tasks> <qid>
    tclv_base=$1; tclv_tasks=$2; tclv_qid=$3
    # P3-08：入口强制 Task ID 字符集/路径穿越门（IPC dispatch 已查，此处兜底
    # 覆盖 CLI 直接调用——非法 id 绝不进入文件路径拼接）
    secv_id_ok "$tclv_qid" || return 1
    tclv_canon=$(task_cli_resolve_id "$tclv_base" "$tclv_tasks" "$tclv_qid") || return 1
    tclv_rd=""
    if [ -n "$tclv_tasks" ] && [ -d "$tclv_tasks/$tclv_qid" ]; then
        tclv_rd="$tclv_tasks/$tclv_qid"
    elif [ -n "$tclv_tasks" ] && [ -d "$tclv_tasks/$tclv_canon" ]; then
        tclv_rd="$tclv_tasks/$tclv_canon"
    fi
    echo "$tclv_canon|$tclv_rd"
    return 0
}

tctl_state() {   # <run_dir> → 当前状态（无目录/未知 → UNKNOWN）
    if [ -n "$1" ] && [ -d "$1" ]; then
        runtime_current_state "$1"
    else
        echo "UNKNOWN"
    fi
}

# 手动启动（skip 策略 + TSM）：
#   <base> <tasks> <qid> [force] → 0=started / 1=not_found / 2=skip / 3=illegal / 4=failed
tctl_start() {
    tclv_base=$1; tclv_tasks=$2; tclv_qid=$3; tclv_force=${4:-0}
    tclv_res=$(tctl_resolve "$tclv_base" "$tclv_tasks" "$tclv_qid") || {
        echo "task_not_found $tclv_qid"; return 1; }
    # P3-10 D-IPC 修复：cut 切分 `canonical|run_dir`（mksh `|`-in-pattern 失败，见 docs/P3-DEVICE-MATRIX §3）
    tclv_canon=$(printf '%s' "$tclv_res" | cut -d'|' -f1); tclv_rd=$(printf '%s' "$tclv_res" | cut -d'|' -f2-)
    tclv_tf=$(registry_task_file "$tclv_canon" 2>/dev/null) || {
        echo "task_not_found $tclv_canon"; return 1; }
    if [ -z "$tclv_rd" ]; then
        tclv_rd="$tclv_tasks/$tclv_canon"
        mkdir -p "$tclv_rd" 2>/dev/null
    fi
    tclv_cur=$(tctl_state "$tclv_rd")
    [ "$tclv_cur" = "UNKNOWN" ] && tclv_cur="PENDING"
    if [ "$tclv_force" -ne 1 ]; then
        case "$tclv_cur" in
            RUNNING|STARTING)
                echo "skip already $tclv_cur ($tclv_canon)"; return 2 ;;
            STOPPING|RECOVERING|WAITING)
                echo "illegal cannot start while $tclv_cur ($tclv_canon)"; return 3 ;;
        esac
    fi
    # 终态重武装 → PENDING（TSM 允许边：FAILED>PENDING / STOPPED>PENDING / DISABLED>PENDING）
    case "$tclv_cur" in
        FAILED)   state_log_event "$tclv_rd" "$tclv_canon" rearm PENDING "" "" "manual rearm before start" >/dev/null 2>&1 ;;
        STOPPED)  state_log_event "$tclv_rd" "$tclv_canon" rearm PENDING "" "" "manual rearm before start" >/dev/null 2>&1 ;;
        DISABLED) state_log_event "$tclv_rd" "$tclv_canon" enable PENDING "" "" "manual start while disabled" >/dev/null 2>&1 ;;
    esac
    tclv_cur=$(tctl_state "$tclv_rd")
    case "$tclv_cur" in
        PENDING|WAITING)
            # P4-05：force start 对 WAITING 任务 = 手动跳过依赖门控（TSM 允许边
            # WAITING>STARTING manual_exec）。清除等待时钟（残留会导致下次进入
            # WAITING 时误判超时）。
            [ "$tclv_cur" = "WAITING" ] && sched_gate_clear "$tclv_rd"
            state_log_event "$tclv_rd" "$tclv_canon" manual_exec STARTING "" "" "manual start" >/dev/null 2>&1 || {
                echo "illegal transition $tclv_cur->STARTING ($tclv_canon)"; return 3; }
            ;;
        *) echo "illegal cannot start while $tclv_cur ($tclv_canon)"; return 3 ;;
    esac
    tclv_cmd=$(sched_task_field "$tclv_tf" action.command)
    if [ -z "$tclv_cmd" ]; then
        echo "failed no command ($tclv_canon)"
        state_log_event "$tclv_rd" "$tclv_canon" action_failure FAILED "" "" "manual start: no command" >/dev/null 2>&1
        return 4
    fi
    tclv_tmx=$(sched_task_field "$tclv_tf" action.termux);       [ -z "$tclv_tmx" ] && tclv_tmx=0
    tclv_itr=$(sched_task_field "$tclv_tf" action.interactive);  [ -z "$tclv_itr" ] && tclv_itr=0
    tclv_ns=$(sched_task_field "$tclv_tf" action.notify_start);  [ -z "$tclv_ns" ] && tclv_ns=0
    tclv_ne=$(sched_task_field "$tclv_tf" action.notify_end);    [ -z "$tclv_ne" ] && tclv_ne=0
    tclv_msg=$(sched_task_field "$tclv_tf" action.msg)
    action_run "$tclv_canon" "$tclv_cmd" "$tclv_tmx" "$tclv_itr" "$tclv_ns" "$tclv_ne" "$tclv_msg" >/dev/null 2>&1
    tclv_arc=$?
    if [ "$tclv_arc" -eq 0 ]; then
        echo "started $tclv_canon"
        return 0
    fi
    state_log_event "$tclv_rd" "$tclv_canon" action_failure FAILED "" "" "manual start failed rc=$tclv_arc" >/dev/null 2>&1
    echo "failed start rc=$tclv_arc ($tclv_canon)"
    return 4
}

# 手动停止（只杀本运行目录 pid；TSM）：
#   <base> <tasks> <qid> → 0=stopped/not_running / 1=not_found / 3=illegal
tctl_stop() {
    tclv_base=$1; tclv_tasks=$2; tclv_qid=$3
    tclv_res=$(tctl_resolve "$tclv_base" "$tclv_tasks" "$tclv_qid") || {
        echo "task_not_found $tclv_qid"; return 1; }
    # P3-10 D-IPC 修复：cut 切分 `canonical|run_dir`（mksh `|`-in-pattern 失败，见 docs/P3-DEVICE-MATRIX §3）
    tclv_canon=$(printf '%s' "$tclv_res" | cut -d'|' -f1); tclv_rd=$(printf '%s' "$tclv_res" | cut -d'|' -f2-)
    [ -n "$tclv_rd" ] || { echo "not_running $tclv_canon (no run dir)"; return 0; }
    tclv_cur=$(tctl_state "$tclv_rd")
    case "$tclv_cur" in
        STOPPING) echo "already_stopping $tclv_canon"; return 0 ;;
        PENDING|STOPPED|FAILED|DISABLED|UNKNOWN)
            echo "not_running $tclv_canon ($tclv_cur)"; return 0 ;;
    esac
    # RUNNING/HEALTHY/UNHEALTHY/STARTING/RECOVERING → STOPPING（TSM 允许边）
    state_log_event "$tclv_rd" "$tclv_canon" stop_request STOPPING "" "" "manual stop" >/dev/null 2>&1 || {
        echo "illegal transition $tclv_cur->STOPPING ($tclv_canon)"; return 3; }
    supervisor_stop_task "$tclv_rd" 1 >/dev/null 2>&1
    # 有界等待进程退出，随后 STOPPING→STOPPED
    tclv_pid=$(cat "$tclv_rd/pid.txt" 2>/dev/null)
    tclv_i=0
    while [ -n "$tclv_pid" ] && [ -d "/proc/$tclv_pid" ] && [ "$tclv_i" -lt 30 ]; do
        sleep 0.1
        tclv_i=$((tclv_i + 1))
    done
    state_log_event "$tclv_rd" "$tclv_canon" stop_request STOPPED "" "" "stopped by user" >/dev/null 2>&1 || true
    echo "stopped $tclv_canon"
    return 0
}

# 重启：停止（若运行中）+ 强启
#   <base> <tasks> <qid> → 0 / 1=not_found / 3=illegal / 4=failed
tctl_restart() {
    tclv_base=$1; tclv_tasks=$2; tclv_qid=$3
    tclv_res=$(tctl_resolve "$tclv_base" "$tclv_tasks" "$tclv_qid") || {
        echo "task_not_found $tclv_qid"; return 1; }
    # P3-10 D-IPC 修复：cut 切分 `canonical|run_dir`（mksh `|`-in-pattern 失败，见 docs/P3-DEVICE-MATRIX §3）
    tclv_canon=$(printf '%s' "$tclv_res" | cut -d'|' -f1); tclv_rd=$(printf '%s' "$tclv_res" | cut -d'|' -f2-)
    tclv_cur=$(tctl_state "$tclv_rd")
    case "$tclv_cur" in
        RUNNING|HEALTHY|UNHEALTHY|STARTING|RECOVERING|STOPPING)
            tctl_stop "$tclv_base" "$tclv_tasks" "$tclv_qid" >/dev/null 2>&1 ;;
    esac
    tctl_start "$tclv_base" "$tclv_tasks" "$tclv_qid" 1
}

# 立即健康检查（只追加 probe 事件，不改 state.txt）：
#   <base> <tasks> <qid> → 0=ok / 1=not_found / 5=no_health / 3=probe 错误
tctl_check() {
    tclv_base=$1; tclv_tasks=$2; tclv_qid=$3
    tclv_res=$(tctl_resolve "$tclv_base" "$tclv_tasks" "$tclv_qid") || {
        echo "task_not_found $tclv_qid"; return 1; }
    # P3-10 D-IPC 修复：cut 切分 `canonical|run_dir`（mksh `|`-in-pattern 失败，见 docs/P3-DEVICE-MATRIX §3）
    tclv_canon=$(printf '%s' "$tclv_res" | cut -d'|' -f1); tclv_rd=$(printf '%s' "$tclv_res" | cut -d'|' -f2-)
    tclv_tf=$(registry_task_file "$tclv_canon" 2>/dev/null) || {
        echo "task_not_found $tclv_canon"; return 1; }
    tclv_spec=$(supervisor_health_spec "$tclv_tf")
    [ -n "$tclv_spec" ] || { echo "no_health_configured $tclv_canon"; return 5; }
    tclv_kind=${tclv_spec%%:*}; tclv_target=${tclv_spec#*:}
    tclv_resline=$(health_check "$tclv_kind" "$tclv_target" 2>/dev/null)
    tclv_prc=$?
    # probe 事件（RT_EVENTS 含 probe）只追加 events.log——不改 state.txt
    if [ -n "$tclv_rd" ] && [ -d "$tclv_rd" ]; then
        tclv_cur=$(tctl_state "$tclv_rd")
        tclv_line="$(date '+%Y-%m-%d %H:%M:%S')|$tclv_canon|probe|$tclv_cur|||$(printf '%s' "$tclv_resline" | sed 's/|/;/g')"
        printf '%s\n' "$tclv_line" >> "$tclv_rd/events.log" 2>/dev/null
    fi
    echo "$tclv_resline"
    return "$tclv_prc"
}

# 查询任务日志（运行目录 output.log 尾部）：
#   <base> <tasks> <qid> [lines] → 0 / 1=not_found
tctl_logs() {
    tclv_base=$1; tclv_tasks=$2; tclv_qid=$3
    tclv_lines=$(secv_num_clamp "${4:-50}" 1 500 50)
    tclv_res=$(tctl_resolve "$tclv_base" "$tclv_tasks" "$tclv_qid") || {
        echo "task_not_found $tclv_qid"; return 1; }
    # P3-10 D-IPC 修复：cut 切分 `canonical|run_dir`（mksh `|`-in-pattern 失败，见 docs/P3-DEVICE-MATRIX §3）
    tclv_canon=$(printf '%s' "$tclv_res" | cut -d'|' -f1); tclv_rd=$(printf '%s' "$tclv_res" | cut -d'|' -f2-)
    [ -n "$tclv_rd" ] && [ -d "$tclv_rd" ] || { echo "(no run dir yet)"; return 0; }
    if [ -f "$tclv_rd/output.log" ]; then
        tail -n "$tclv_lines" "$tclv_rd/output.log" 2>/dev/null
    else
        echo "(no output yet)"
    fi
    return 0
}

# 启/禁用（改配置状态；仅 Managed 模式权威存储 + reload）：
#   <base> <config> <tasks> <qid> <val> → 0=ok / 1=not_found / 2=legacy-only / 3=write_failed
tctl_set_enabled() {
    tclv_base=$1; tclv_config=$2; tclv_tasks=$3; tclv_qid=$4; tclv_val=$5
    tcfg_is_managed || { echo "write ops require managed task-config (run: su-scheduler task-config import)"; return 2; }
    tclv_canon=$(task_cli_resolve_id "$tclv_base" "$tclv_tasks" "$tclv_qid") || {
        echo "task_not_found $tclv_qid"; return 1; }
    [ -f "$(tcfg_task_file "$tclv_canon")" ] || { echo "task_not_found $tclv_canon"; return 1; }
    tcfg_set_field "$tclv_canon" enabled "$tclv_val" >/dev/null 2>&1 || {
        echo "write_failed $tclv_canon"; return 3; }
    sched_reload "$tclv_base" "$tclv_config" >/dev/null 2>&1
    echo "enabled=$tclv_val $tclv_canon"
    return 0
}
# ────────────────────────────────────────────────────────────────────────
# §25 Security & Resource Hardening（P3-08）：WebUI 高权限平台的加固层
# ═══════════════════════════════════════════════════════════════════════════
# 目标：WebUI 成为高权限（root）平台后，杜绝三类失控——任意 Root 执行、配置
#   破坏、资源失控。本层为**叠加加固**（C2/C4：不改既有解析语义与执行路径，
#   不新增 eval / 不直接 sh -c / 不临时拼接 Root 命令），全部为可独立验证的
#   校验原语 + 既有入口的收口。
# 输入安全：
#   - secv_id_ok        Task ID 字符集（^[A-Za-z0-9_.-]{1,128}$ 且无 `..`）——
#                       IPC 全部 id-bearing op 与 tctl_resolve 入口强制；
#   - secv_num_clamp    数值范围钳制（IPC lines 等；防超大数溢出算术）；
#   - 请求大小限制/op 白名单/参数键白名单（§21 既有，P3-04）；
# 文件安全：
#   - secv_inside       路径必须位于允许目录（拒绝 `..` 段逃逸）；
#   - secv_nosymlink    拒绝符号链接（防链接指向允许目录外）；
#   - secv_guard_task_dir  任务运行目录 = id 合法 + 位于 tasks 内 + 非符号链接；
#   - secv_fix_perms    权限强制：ipc 0700 / task-config 600 / 运行目录 700 / 文件 600；
#   - secv_sweep_tmp    临时文件清理（ipc tmp/沙箱、task-config tmp 残留）；
#   - 原子写入（tmp+mv）与失败清理（§19/§21 既有，本层补 sweep 兜底）；
# 执行安全：
#   - 不新增 eval；服务端绝不把请求内容交给 shell 解释（§21 既有）；
#   - WebUI/CLI 只经 IPC 受控 op，命令只读自已校验任务文件（§21/§24 既有）；
#   - secv_effective_timeout  每个 Action 有超时：advanced.timeout>0 且 ≤
#     TASK_RUNTIME_MAX（全局护栏）→ 生效；否则回落 TASK_RUNTIME_MAX（≥0）；
# 资源安全：
#   - runtime_limit_task_log  单 Task 日志字节上限（output.log/events.log）；
#   - runtime_prune_tasks / runtime_prune_snapshots（P2-14 既有上限）；
#   - secv_ipc_ratelimit      IPC 请求频率限制（时间窗计数，超限 → rc 7）；
#   - IPC_POLL_MAX / WEBUI_LOG_MAX / WEBUI_EVENTS_MAX（既有，P3-04/P3-05）。
# 命名空间：函数 secv_ 前缀、内部全局 secv_ 前缀（防覆盖调用方全局，同 §21）。
# ═══════════════════════════════════════════════════════════════════════════
TASK_LOG_MAX_BYTES=${TASK_LOG_MAX_BYTES:-262144}
IPC_RATE_WINDOW=${IPC_RATE_WINDOW:-1}
IPC_RATE_MAX=${IPC_RATE_MAX:-256}
SECV_ID_MAXLEN=${SECV_ID_MAXLEN:-128}

# Task ID 字符集门：^[A-Za-z0-9_.-]{1,128}$ 且不含 `..`（路径穿越）。
# 覆盖 canonical ID（t<line>_<trigger>/task_*）与旧运行 ID
# （time_<HHMM>_<n>_<epoch>/advanced_/immediate_/startup_<n>_<epoch>）。
secv_id_ok() {   # <id> → 0=合法 1=非法
    secv_id=$1
    [ -n "$secv_id" ] || return 1
    [ "${#secv_id}" -le "$SECV_ID_MAXLEN" ] || return 1
    case "$secv_id" in
        *[!A-Za-z0-9_.-]*) return 1 ;;
        *..*|*/*|*\\) return 1 ;;
    esac
    return 0
}
# 数值范围钳制：<val> <min> <max> <default> → echo 钳制值（非数字/超大 → 缺省）
secv_num_clamp() {   # 防止超大数字让 POSIX 算术溢出（`-gt` 报 integer 溢出）
    secv_v=$1; secv_min=$2; secv_max=$3; secv_def=$4
    case "$secv_v" in
        ''|*[!0-9]*) secv_v=$secv_def ;;
    esac
    [ "${#secv_v}" -gt 9 ] && secv_v=$secv_def
    if [ "$secv_v" -lt "$secv_min" ] 2>/dev/null; then secv_v=$secv_min; fi
    if [ "$secv_v" -gt "$secv_max" ] 2>/dev/null; then secv_v=$secv_max; fi
    echo "$secv_v"
}
# 路径必须位于允许目录：<base> <path> → 0=path 在 base 内（含 `..` 段拒绝）
secv_inside() {   # 词法判定：先前缀匹配 base/，再逐段拒绝 `..`（不落地含
    secv_base=$1; secv_path=$2   # `..`/ 字面量，满足 P2-02 生产库零引用门禁）
    [ -n "$secv_base" ] || return 1
    case "$secv_path" in
        "$secv_base") return 0 ;;
        "$secv_base"/*) ;;
        *) return 1 ;;
    esac
    secv_rel=${secv_path#"$secv_base"/}
    secv_oldifs=$IFS; IFS='/'
    for secv_seg in $secv_rel; do
        if [ "$secv_seg" = "." ] || [ "$secv_seg" = ".." ]; then
            IFS=$secv_oldifs
            return 1
        fi
    done
    IFS=$secv_oldifs
    return 0
}
# 符号链接风险：<path> → 0=不存在或真实文件（非符号链接） 1=符号链接
secv_nosymlink() {   # 目标目录/文件不得为符号链接（防指向允许目录外）
    [ -L "$1" ] 2>/dev/null && return 1 || return 0
}
# 任务运行目录门：<tasks_dir> <id> → 0=安全（id 合法 + 目录位于 tasks 内 + 非符号链接）
secv_guard_task_dir() {
    secv_tasks=$1; secv_id=$2
    secv_id_ok "$secv_id" || return 1
    secv_inside "$secv_tasks" "$secv_tasks/$secv_id" || return 1
    [ -e "$secv_tasks/$secv_id" ] && secv_nosymlink "$secv_tasks/$secv_id" || return 1
    return 0
}
# IPC 请求频率限制（窗口计数）：<base> → 0=放行 1=拒绝（rate_limited）
# 状态文件 ipc/rate.state（`window_bucket|count`，tmp+mv 原子）；窗口桶 =
# floor(now / IPC_RATE_WINDOW)（同窗口期共享计数，不受秒级边界影响——慢宿主
# 逐请求跨秒也不会错误重置）；每窗内至多 IPC_RATE_MAX 个请求；超限后续请求
# 拒绝（不处理、不执行）。窗口越界自动重置——可确定测试（设大窗口 + 小上限）。
secv_ipc_ratelimit() {
    secv_base=$1
    secv_dir=$(ipc_dir "$secv_base")
    secv_state="$secv_dir/rate.state"
    mkdir -p "$secv_dir" 2>/dev/null
    [ "$IPC_RATE_WINDOW" -le 0 ] 2>/dev/null && return 0
    secv_now=$(date +%s)
    secv_b=$((secv_now / IPC_RATE_WINDOW))
    secv_w=""; secv_c=0
    if [ -f "$secv_state" ]; then
        IFS='|' read -r secv_w secv_c _ < "$secv_state" 2>/dev/null
    fi
    case "$secv_c" in ''|*[!0-9]*) secv_c=0 ;; esac
    if [ -z "$secv_w" ] || [ "$secv_w" != "$secv_b" ]; then
        secv_w=$secv_b
        secv_c=0
    fi
    if [ "$secv_c" -ge "$IPC_RATE_MAX" ]; then
        return 1
    fi
    secv_c=$((secv_c + 1))
    printf '%s|%s\n' "$secv_w" "$secv_c" > "$secv_state.tmp.$$" 2>/dev/null \
        && mv "$secv_state.tmp.$$" "$secv_state" 2>/dev/null
    return 0
}
# 临时文件清理（每次 poll 兜底）：<base> → 清 IPC tmp/沙箱 + task-config tmp 残留
secv_sweep_tmp() {
    secv_base=$1
    for secv_f in "$(ipc_req_dir "$secv_base")"/*.tmp \
                  "$(ipc_resp_dir "$secv_base")"/*.tmp; do
        [ -e "$secv_f" ] && rm -f "$secv_f" 2>/dev/null
    done
    for secv_d in "$(ipc_dir "$secv_base")"/.validate.* \
                  "$(ipc_dir "$secv_base")"/.create.*; do
        [ -d "$secv_d" ] && rm -rf "$secv_d" 2>/dev/null
    done
    if tcfg_is_managed 2>/dev/null; then
        for secv_f in "$(tcfg_dir)"/*.tmp.*; do
            [ -e "$secv_f" ] && rm -f "$secv_f" 2>/dev/null
        done
    fi
    return 0
}
# 权限强制：<base> <tasks> → ipc 0700 / task-config 600 / 运行目录 700 / 文件 600
# （chmod 不可用/不支持的文件系统上为 no-op，不视为失败——权限门禁另有逻辑层）。
secv_fix_perms() {
    secv_base=$1; secv_tasks=$2
    chmod 700 "$(ipc_dir "$secv_base")" "$(ipc_req_dir "$secv_base")" \
              "$(ipc_resp_dir "$secv_base")" 2>/dev/null
    if tcfg_is_managed 2>/dev/null; then
        chmod 700 "$(tcfg_dir)" 2>/dev/null
        chmod 600 "$(tcfg_dir)"/*.task 2>/dev/null
    fi
    [ -n "$secv_tasks" ] && [ -d "$secv_tasks" ] && chmod 700 "$secv_tasks" 2>/dev/null
    for secv_d in "$secv_tasks"/*; do
        [ -d "$secv_d" ] || continue
        chmod 700 "$secv_d" 2>/dev/null
        chmod 600 "$secv_d"/* 2>/dev/null
    done
    chmod 700 "$secv_base/snapshots" "$secv_base/scheduler" "$secv_base/audit" 2>/dev/null
    chmod 600 "$secv_base/current" 2>/dev/null
    return 0
}
# 每个 Action 的有效超时：<task_file> → echo 秒数（advanced.timeout>0 且 ≤ 全局
# TASK_RUNTIME_MAX → 生效；否则回落 TASK_RUNTIME_MAX；≤0 → 0=不限）
secv_effective_timeout() {
    secv_tf=$1
    secv_t=$(sched_task_field "$secv_tf" advanced.timeout)
    case "$secv_t" in
        ''|*[!0-9]*) secv_t=0 ;;
    esac
    if [ "$secv_t" -gt 0 ] 2>/dev/null; then
        if [ "$TASK_RUNTIME_MAX" -gt 0 ] 2>/dev/null && [ "$secv_t" -gt "$TASK_RUNTIME_MAX" ]; then
            echo "$TASK_RUNTIME_MAX"
        else
            echo "$secv_t"
        fi
        return 0
    fi
    echo "$TASK_RUNTIME_MAX"
    return 0
}
# 单 Task 日志字节上限：<run_dir> → output.log / events.log 超 TASK_LOG_MAX_BYTES
# 截断（复用 §18 runtime_limit_log：保留尾部 max/2 字节，tmp+mv 原子）
runtime_limit_task_log() {
    rd=$1
    runtime_limit_log "$rd/output.log" "$TASK_LOG_MAX_BYTES"
    runtime_limit_log "$rd/events.log" "$TASK_LOG_MAX_BYTES"
    return 0
}
# ────────────────────────────────────────────────────────────────────────
# §26 Dependency & Condition Schema（P4-02）
# ────────────────────────────────────────────────────────────────────────
# Task v2 `dependency=`/`condition=` 字段的解析语义 + 后端权威校验（managed
# 域；Legacy config.txt 零改动，C4）。本层只做**存储层安全校验与规范化**，
# 不做求值/门控（P4-06）与存在性/环检测（P4-03）。
# 语法（ADR D1/D2，见 docs/architecture/dependency-schema.md）：
#   dependency  = <entry>[, <entry> ...]         规范保存=逗号分隔（D1）；
#                解析同时容忍空格/制表符作分隔（兼容早期 schema 描述）。
#   <entry>     = [?]<task-id>[:<STATE>]
#                 ?          前缀 = Optional（缺省 Required）
#                 :<STATE>   指定期望终态；STATE ∈ {STOPPED, FAILED}（TSM 两
#                            终态）；缺省 = STOPPED（「已执行成功」）
#                 <task-id>  须过既有 id 字符集（tcfg_editor_id_ok 规则
#                            [A-Za-z0-9_.-]、无 `..`/`/`/`*`、非空）
#   上限：单任务依赖条数 ≤ DEP_MAX；超则拒绝（常量供 P4-10 复用）。
#   condition = <expr>：单行可打印 ASCII（拒绝换行/控制符）、长度 ≤ COND_MAX_LEN、
#                空/缺省 = 无条件（恒真占位）。完整表达式文法白名单归 P4-06。
# 命名空间：dep_/cond_ 前缀函数，内部全局 depv_/condv_ 前缀（防覆盖调用方）。
# ═══════════════════════════════════════════════════════════════════════════
DEP_MAX=${DEP_MAX:-32}
COND_MAX_LEN=${COND_MAX_LEN:-256}

# 规范化 dependency 值：<raw> → 逗号分隔规范串（空格/制表符→逗号、去空段、去首尾逗号）。
# 仅应在 dep_validate 通过后用于写回/回显。
dep_normalize() {
    depv_raw=$1
    printf '%s' "$depv_raw" | tr ', ' ',' | tr -s ',' | sed 's/^,//; s/,$//'
}

# 校验单条 entry：<entry> → 0=合法 1=非法（语法/保留符号/id 字符集/STATE 枚举）
dep_entry_ok() {
    depv_e=$1
    [ -n "$depv_e" ] || return 1
    case "$depv_e" in
        "?"*) depv_e=${depv_e#\?} ;;
    esac
    [ -n "$depv_e" ] || return 1          # 仅 "?"（无 id）
    case "$depv_e" in
        *:*)
            depv_id=${depv_e%%:*}
            depv_state=${depv_e#*:}
            [ -n "$depv_id" ] || return 1 # 空 id（:STATE）
            case "$depv_state" in
                STOPPED|FAILED) ;;
                *) return 1 ;;            # STATE 枚举外
            esac
            ;;
        *)
            depv_id=$depv_e
            ;;
    esac
    tcfg_editor_id_ok "$depv_id" || return 1   # id 字符集 + 无路径穿越
    return 0
}

# 校验整串 dependency 值：<raw> → 0=合法 1=非法（含控制符拒绝、条数上限、逐条语法）
dep_validate() {
    depv_raw=$1
    printf '%s' "$depv_raw" | awk 'END { if (NR > 1) exit 1; exit 0 }' || return 1   # 嵌入换行
    printf '%s' "$depv_raw" | grep -q '[^ -~]' && return 1    # 非可打印 ASCII / 控制符
    [ -z "$depv_raw" ] && return 0                            # 空 = 无依赖，合法
    depv_tokens=$(printf '%s' "$depv_raw" | sed 's/,/ /g')    # 逗号→空格，与空白容错统一
    depv_i=0
    for depv_t in $depv_tokens; do                            # IFS 默认分词（空格/制表/换行）
        depv_i=$((depv_i + 1))
        [ "$depv_i" -le "$DEP_MAX" ] || return 1              # 超上限
        dep_entry_ok "$depv_t" || return 1
    done
    [ "$depv_i" -ge 1 ] || return 1                           # 全分隔符（空依赖）
    return 0
}

# 校验 condition 值：<raw> → 0=合法 1=非法（可打印 ASCII、长度上限、空=无条件）
cond_validate() {
    condv_raw=$1
    [ ${#condv_raw} -le "$COND_MAX_LEN" ] || return 1
    [ -z "$condv_raw" ] && return 0                           # 空/缺省 = 无条件（恒真）
    printf '%s' "$condv_raw" | awk 'END { if (NR > 1) exit 1; exit 0 }' || return 1   # 嵌入换行
    printf '%s' "$condv_raw" | grep -q '[^ -~]' && return 1   # 非可打印 ASCII / 控制符
    return 0
}

# ═══════════════════════════════════════════════════════════════════════════
# §26b P4-06 Condition 受限表达式引擎（白名单谓词求值）：
# 在 §26 cond_validate（存储层安全）之上叠加受限表达式文法与求值。**禁止任何
# Shell 执行**：无 eval / sh -c / $(...) / 反引号 / 管道到命令 / 重定向 / 用户
# 函数调用——只做纯 POSIX 字符串解析 + case/字段比对 + 白名单表驱动，绝不在求值
# 中把用户表达式拼进任何被执行的 shell 片段。
# 语法：`{{ <谓词> }}` 包裹**单谓词**（`{{`/`}}` 内首尾空白容忍），求值为真/假。
# 谓词白名单（COND_PREDS）：
#   task.state(<id>) == <STATE> / !=   另一任务实时态比较（读 tasks/<id>/state.txt，
#                                       缺省 PENDING；无副作用）
#   time.hour == <0-23> / time.minute == <0-59> / time.wday == <0-6>（0=Sunday）
#   env.<NAME> == <值> / !=            仅白名单环境变量 CONFIG_FILE / DATA_DIR /
#                                       TASKS_DIR（其余 env.<X> → 非法拒绝）
#   file.exists(<绝对路径>)             文件存在性；路径仅允许 CONFIG_FILE 同目录 或
#                                       DATA_DIR 下；禁止 `..`/`//` 穿越；只读探测
# 比较运算符（P4-06 决策，勿改）：`==`（等于）/ `!=`（不等于）两个即可；`<`/`>`/
# `>=`/`<=`/`contains` 不在 P4-06 范围（P5 可扩）。
# 三态语义：cond_eval rc 0=真 1=假 2=非法。
#   - 校验期：cond_grammar_ok 只做文法/白名单/越界/注入检查（不读文件、不读状态），
#     用于 tcfg/editor/apply/set/import 写路径——非法 → 写盘前拒绝，旧配置逐字节
#     不变（D5/B9）。
#   - 运行期：cond_eval 先过 cond_grammar_ok（非法 → 防御性 return 2，理论不应
#     发生），再按谓词求值；文件系统只读探测，无副作用。
# 命名空间：cond_/conde_ 前缀（conde_ 行内变量防覆盖调用方全局，同 §26）。
# ═══════════════════════════════════════════════════════════════════════════
COND_TSM_STATES="DISABLED PENDING WAITING STARTING RUNNING HEALTHY UNHEALTHY RECOVERING FAILED STOPPING STOPPED"
COND_PREDS="task.state time.hour time.minute time.wday env file.exists"
COND_ENV_ALLOW="CONFIG_FILE DATA_DIR TASKS_DIR"

# 去前导零：<num> → echo 去零数字（POSIX 无 10# 基数写法，避免 08 触 octal）
conde_unzero() {
    conde_v=$1
    while :; do
        case "$conde_v" in 0*) conde_v=${conde_v#0} ;; *) break ;; esac
    done
    [ -n "$conde_v" ] || conde_v=0
    echo "$conde_v"
}
# 安全字符集：<str> → 0 全部为 [A-Za-z0-9_/.:+-]（无空白/元字符/控制符/重定向/`;`）
conde_charset_ok() {
    case "$1" in
        ''|*[!A-Za-z0-9_/.:+-]*) return 1 ;;
    esac
    return 0
}
# TSM 状态成员：<state> → 0 合法
conde_state_ok() {
    case " $COND_TSM_STATES " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}
# 词法路径包含：<base> <path> → 0=path 位于 base 内（含 base 自身，逐段无 `..`/`//`）
conde_path_in() {
    conde_base=$1; conde_path=$2
    case "$conde_path" in
        "$conde_base") return 0 ;;
        "$conde_base"/*) ;;
        *) return 1 ;;
    esac
    conde_rel=${conde_path#"$conde_base"/}
    case "$conde_rel" in
        *".."*|*"//"*) return 1 ;;
    esac
    return 0
}
# 抽取 `{{ }}` 内层并去首尾空白：<expr> → echo inner（或空 = 非法包裹）
conde_inner() {
    conde_e=$1
    case "$conde_e" in
        "{{"*"}}") ;;
        *) return 1 ;;
    esac
    conde_in=${conde_e#"{{"}
    conde_in=${conde_in%"}}"}
    while :; do
        case "$conde_in" in
            ' '*|"	"*) conde_in=${conde_in#?} ;;
            *' '|*"	") conde_in=${conde_in%?} ;;
            *) break ;;
        esac
    done
    echo "$conde_in"
}

# 文法/白名单/越界/注入校验：<expr> → 0=合法 1=非法（纯词法，无副作用）
cond_grammar_ok() {
    conde_expr=$1
    [ -n "$conde_expr" ] || return 1
    conde_in=$(conde_inner "$conde_expr") || return 1
    [ -n "$conde_in" ] || return 1
    # 顶层注入面：单谓词表达式内不得出现命令拼接痕迹（防御，与下文字符集双保险）
    case "$conde_in" in
        *";"*|*'`'*|*"\$("*|*"sh -c"*|*"|"*|*"&"*|*">"*|*"<"*) return 1 ;;
    esac
    conde_oldifs=$IFS; IFS=' '
    set -- $conde_in
    IFS=$conde_oldifs
    conde_l=$1; conde_op=${2:-}; conde_r=${3:-}
    [ -n "$conde_l" ] || return 1
    case "$conde_l" in
        task.state\(*\))
            conde_id=${conde_l#task.state(}
            conde_id=${conde_id%)}
            [ "$conde_l" = "task.state($conde_id)" ] || return 1   # 精确包裹（拒多余 `)`）
            secv_id_ok "$conde_id" || return 1
            [ "$conde_op" = "==" ] || [ "$conde_op" = "!=" ] || return 1
            conde_state_ok "$conde_r" || return 1
            ;;
        time.hour|time.minute|time.wday)
            [ "$conde_op" = "==" ] || [ "$conde_op" = "!=" ] || return 1
            case "$conde_r" in
                ''|*[!0-9]*) return 1 ;;
            esac
            conde_rn=$(conde_unzero "$conde_r")
            case "$conde_l" in
                time.hour)   [ "$conde_rn" -le 23 ] 2>/dev/null || return 1 ;;
                time.minute) [ "$conde_rn" -le 59 ] 2>/dev/null || return 1 ;;
                time.wday)   [ "$conde_rn" -le 6 ] 2>/dev/null || return 1 ;;
            esac
            ;;
        env.*)
            conde_name=${conde_l#env.}
            case " $COND_ENV_ALLOW " in *" $conde_name "*) ;; *) return 1 ;; esac   # 未授权 env
            [ "$conde_op" = "==" ] || [ "$conde_op" = "!=" ] || return 1
            conde_charset_ok "$conde_r" || return 1
            ;;
        file.exists\(*\))
            conde_path=${conde_l#file.exists(}
            conde_path=${conde_path%)}
            [ "$conde_l" = "file.exists($conde_path)" ] || return 1
            [ -z "$conde_op" ] || return 1   # file.exists 无比较运算符
            case "$conde_path" in
                /*) ;;
                *) return 1 ;;   # 必须绝对路径
            esac
            conde_charset_ok "$conde_path" || return 1
            # 允许目录 = CONFIG_FILE 同目录 或 DATA_DIR（词法包含，防 `..`/`//` 穿越）
            conde_cfg=${CONFIG_FILE:-/sdcard/Documents/su-scheduler/config.txt}
            conde_datadir=${DATA_DIR:-/data/adb/su-scheduler}
            conde_cfgdir=${conde_cfg%/*}
            if ! conde_path_in "$conde_cfgdir" "$conde_path" && \
               ! conde_path_in "$conde_datadir" "$conde_path"; then
                return 1
            fi
            ;;
        *)
            return 1 ;;
    esac
    return 0
}

# 受限表达式求值：<expr> <tasks_dir> [<now> HHMM] [<wday> 0-6] → 0=真 1=假 2=非法
# 非法表达式（防御性，理论校验期已拒）→ return 2（stdout 给原因）；文件只读探测。
cond_eval() {
    conde_expr=$1; conde_tasks=${2:-}
    conde_now=${3:-$(date +%H%M)}; conde_wday=${4:-$(date +%w)}
    cond_grammar_ok "$conde_expr" || { echo "condition illegal (grammar)"; return 2; }
    conde_in=$(conde_inner "$conde_expr") || { echo "condition illegal (wrap)"; return 2; }
    conde_oldifs=$IFS; IFS=' '
    set -- $conde_in
    IFS=$conde_oldifs
    conde_l=$1; conde_op=${2:-}; conde_r=${3:-}
    case "$conde_l" in
        task.state\(*\))
            conde_id=${conde_l#task.state(}
            conde_id=${conde_id%)}
            conde_cur=$(runtime_current_state "$conde_tasks/$conde_id" 2>/dev/null)
            if [ "$conde_op" = "==" ]; then
                [ "$conde_cur" = "$conde_r" ] && return 0 || return 1
            else
                [ "$conde_cur" != "$conde_r" ] && return 0 || return 1
            fi
            ;;
        time.hour|time.minute|time.wday)
            case "$conde_l" in
                time.hour)   conde_cur=$(printf '%s' "$conde_now" | cut -c1-2) ;;
                time.minute) conde_cur=$(printf '%s' "$conde_now" | cut -c3-4) ;;
                time.wday)   conde_cur=$conde_wday ;;
            esac
            conde_curn=$(conde_unzero "$conde_cur")
            conde_rn=$(conde_unzero "$conde_r")
            if [ "$conde_op" = "==" ]; then
                [ "$conde_curn" -eq "$conde_rn" ] 2>/dev/null && return 0 || return 1
            else
                [ "$conde_curn" -ne "$conde_rn" ] 2>/dev/null && return 0 || return 1
            fi
            ;;
        env.*)
            conde_name=${conde_l#env.}
            conde_cfg=${CONFIG_FILE:-/sdcard/Documents/su-scheduler/config.txt}
            conde_datadir=${DATA_DIR:-/data/adb/su-scheduler}
            case "$conde_name" in
                CONFIG_FILE) conde_val=$conde_cfg ;;
                DATA_DIR)    conde_val=$conde_datadir ;;
                TASKS_DIR)   conde_val=${TASKS_DIR:-$conde_datadir/tasks} ;;
                *) echo "condition illegal (env not allowed)"; return 2 ;;
            esac
            if [ "$conde_op" = "==" ]; then
                [ "$conde_val" = "$conde_r" ] && return 0 || return 1
            else
                [ "$conde_val" != "$conde_r" ] && return 0 || return 1
            fi
            ;;
        file.exists\(*\))
            conde_path=${conde_l#file.exists(}
            conde_path=${conde_path%)}
            [ -e "$conde_path" ] && return 0 || return 1
            ;;
        *)
            echo "condition illegal (unknown predicate)"; return 2 ;;
    esac
}
# ═══════════════════════════════════════════════════════════════════════════

# 依赖图校验（P4-03）：遍历 <dir> 全部 .task 构建 id 集合 + 依赖边，执行
# 未知依赖 / 自依赖 / 环检测。返回 0=无环且引用完整；非 0=拒绝（错误消息
# 写 stderr，含具体原因：unknown dependency 'x' in 't_a' / self-dependency /
# cycle: a->b->c->a）。
# 参数：
#   <dir>       task-config 目录（覆盖文件 = 目录内该 id 的替身，见 <content>）
#   [<id>]      （可选）本次待写任务 id；提供 <content> 时覆盖该 id 的内容
#   [<content>] （可选）<id> 的新内容（字面内容，非文件路径），用于「替换后有效
#               集合」校验（tcfg_apply_task / tcfg_set_field）；缺省 = 按目录
#               现状校验
#   [<prefix>]  （可选）错误消息前缀，缺省 "[task-config] ERROR:"
# 语义（P4-03 ADR，见 docs/architecture/dependency-schema.md）：
#   - 前向引用允许：只要求最终 id 集合全部存在且图无环；
#   - Optional（`?`）条目同样参与未知/环校验（引用关系即边）；
#   - 自依赖 = 环特例，单独报 self-dependency；
#   - 检测算法 = 简单 DFS（N≤32×任务数，POSIX sh 可实现），不引入通用 DAG
#     调度器（P4 明确禁止）。
# 命名空间：dep_ 前缀函数、内部全局 depg_ 前缀（防覆盖调用方全局，同 §26）。
# ═══════════════════════════════════════════════════════════════════════════
dep_validate_graph() {   # <dir> [<id>] [<content>] [<prefix>]
    depg_dir=$1
    depg_oid=${2:-}
    depg_ocontent=${3:-}
    depg_prefix=${4:-[task-config] ERROR:}
    [ -d "$depg_dir" ] || { echo "${depg_prefix} dependency graph: directory not found: $depg_dir" >&2; return 1; }
    depg_nodes=""
    depg_adj=""
    depg_ofile=""
    if [ -n "$depg_ocontent" ]; then
        depg_ofile=$(mktemp "/tmp/depg.XXXXXX" 2>/dev/null) || { echo "${depg_prefix} dependency graph: temp file failed" >&2; return 1; }
        printf '%s\n' "$depg_ocontent" > "$depg_ofile" 2>/dev/null || { rm -f "$depg_ofile" 2>/dev/null; echo "${depg_prefix} dependency graph: temp write failed" >&2; return 1; }
    fi
    depg_fp=""
    for depg_fp in "$depg_dir"/*.task; do
        [ -f "$depg_fp" ] || continue
        depg_node=$(basename "$depg_fp" .task)
        case " $depg_nodes " in
            *" $depg_node "*) continue ;;
        esac
        # 覆盖节点（本次待写）从 <content> 读取，不读磁盘旧文件
        if [ -n "$depg_ofile" ] && [ "$depg_node" = "$depg_oid" ]; then
            continue
        fi
        depg_eff="$depg_fp"
        depg_sv=$(grep '^schema_version=' "$depg_eff" 2>/dev/null | head -1 | cut -d= -f2-)
        depg_id=$(grep '^id=' "$depg_eff" 2>/dev/null | head -1 | cut -d= -f2-)
        depg_tr=$(grep '^trigger=' "$depg_eff" 2>/dev/null | head -1 | cut -d= -f2-)
        [ "$depg_sv" = "2" ] && [ "$depg_id" = "$depg_node" ] && [ -n "$depg_tr" ] || continue
        depg_dep=$(grep '^dependency=' "$depg_eff" 2>/dev/null | head -1 | cut -d= -f2-)
        depg_norm=$(dep_normalize "$depg_dep")
        depg_edges=""
        depg_t=""
        if [ -n "$depg_norm" ]; then
            depv_tokens=$(printf '%s' "$depg_norm" | sed 's/,/ /g')
            for depg_t in $depv_tokens; do
                depg_tgt=$depg_t
                case "$depg_tgt" in
                    "?"*) depg_tgt=${depg_tgt#\?} ;;
                esac
                case "$depg_tgt" in
                    *:*) depg_tgt=${depg_tgt%%:*} ;;
                esac
                case " $depg_edges " in
                    *" $depg_tgt "*) continue ;;
                esac
                depg_edges="$depg_edges $depg_tgt"
            done
        fi
        depg_nodes="$depg_nodes $depg_node"
        depg_adj="$depg_adj
$depg_node|$depg_edges"
    done
    # 覆盖节点（存在与否都要参与图校验——新建/编辑任务的依赖边来自 payload）
    if [ -n "$depg_ofile" ] && [ -n "$depg_oid" ]; then
        depg_sv=$(grep '^schema_version=' "$depg_ofile" 2>/dev/null | head -1 | cut -d= -f2-)
        depg_id=$(grep '^id=' "$depg_ofile" 2>/dev/null | head -1 | cut -d= -f2-)
        depg_tr=$(grep '^trigger=' "$depg_ofile" 2>/dev/null | head -1 | cut -d= -f2-)
        if [ "$depg_sv" = "2" ] && [ "$depg_id" = "$depg_oid" ] && [ -n "$depg_tr" ]; then
            depg_dep=$(grep '^dependency=' "$depg_ofile" 2>/dev/null | head -1 | cut -d= -f2-)
            depg_norm=$(dep_normalize "$depg_dep")
            depg_edges=""
            depg_t=""
            if [ -n "$depg_norm" ]; then
                depv_tokens=$(printf '%s' "$depg_norm" | sed 's/,/ /g')
                for depg_t in $depv_tokens; do
                    depg_tgt=$depg_t
                    case "$depg_tgt" in
                        "?"*) depg_tgt=${depg_tgt#\?} ;;
                    esac
                    case "$depg_tgt" in
                        *:*) depg_tgt=${depg_tgt%%:*} ;;
                    esac
                    case " $depg_edges " in
                        *" $depg_tgt "*) continue ;;
                    esac
                    depg_edges="$depg_edges $depg_tgt"
                done
            fi
            depg_nodes="$depg_nodes $depg_oid"
            depg_adj="$depg_adj
$depg_oid|$depg_edges"
        fi
    fi
    [ -n "$depg_ofile" ] && rm -f "$depg_ofile" 2>/dev/null

    depg_ok=1
    depg_n=""
    depg_adjline=""
    for depg_n in $depg_nodes; do
        depg_adjline=$(printf '%s\n' "$depg_adj" | grep "^$depg_n|" | head -1)
        # P4-10：`${var#*|}` 为 mksh `|`-in-pattern 展开（Android 16 失败，
        # B7/NF-7，P3-10 D-IPC 修复同源）→ 改可移植 cut 切分
        depg_targets=$(printf '%s' "$depg_adjline" | cut -d'|' -f2-)
        depg_target=""
        for depg_target in $depg_targets; do
            case " $depg_nodes " in
                *" $depg_target "*) ;;
                *) depg_ok=0; echo "${depg_prefix} unknown dependency '$depg_target' in '$depg_n'" >&2 ;;
            esac
            [ "$depg_target" = "$depg_n" ] && { depg_ok=0; echo "${depg_prefix} self-dependency in '$depg_n'" >&2; }
        done
    done

    depg_visited=""
    depg_done=""
    depg_cyc=""
    depg_start=""
    for depg_start in $depg_nodes; do
        case " $depg_done " in
            *" $depg_start "*) continue ;;
        esac
        depg_dfs "$depg_start" "->$depg_start"
    done
    [ "$depg_ok" -eq 0 ] && return 1
    return 0
}

# DFS 助手（dep_validate_graph 内部）：<node> <curpath>；全局 depg_* 复用
depg_dfs() {
    depg_x=$1
    depg_curpath=$2
    case " $depg_visited " in
        *" $depg_x "*) return 0 ;;
    esac
    depg_visited="$depg_visited $depg_x"
    depg_adjline=$(printf '%s\n' "$depg_adj" | grep "^$depg_x|" | head -1)
    # P4-10：同 §5518 修法——`${var#*|}` 为 mksh `|`-in-pattern 展开 → cut 切分
    depg_targets=$(printf '%s' "$depg_adjline" | cut -d'|' -f2-)
    depg_t=""
    for depg_t in $depg_targets; do
        [ "$depg_t" = "$depg_x" ] && continue
        case "$depg_curpath" in
            *"->$depg_t->"*)
                depg_ok=0
                depg_cyc=$(printf '%s' "$depg_curpath" | sed 's/^->//')
                depg_cyc="${depg_cyc}->${depg_t}"
                echo "${depg_prefix} cycle: $depg_cyc" >&2
                ;;
        esac
        case " $depg_visited " in
            *" $depg_t "*) continue ;;
        esac
        depg_dfs "$depg_t" "$depg_curpath->$depg_t"
    done
    depg_done="$depg_done $depg_x"
    return 0
}
# ────────────────────────────────────────────────────────────────────────
runtime_lib_selfcheck() {
    [ -n "${RUNTIME_LIB_VERSION:-}" ] || return 1
    for fn in task_state_transition legacy_adapter_parse provider_dispatch \
              runtime_log_event registry_init lifecycle_start task_cli_list \
              shadow_tick runtime_map_lookup trigger_decide action_run \
              state_log_event state_health_allowed state_sync_all \
              state_rehydrate_residual registry_attach task_cli_attach \
              task_cli_resolve_id task_cli_status_id runtime_scan_stale \
              lifecycle_startup_registry lifecycle_startup_recover \
              tpr_action_app_validate tpr_action_app_start health_check \
              tpr_health_process_check tpr_health_port_check supervisor_step \
              supervisor_tick supervisor_health_spec supervisor_recover \
              supervisor_stop_task crash_guard_enter crash_record_exit \
              runtime_protect runtime_protect_tasks supervisor_health_due \
              supervisor_runtime_exceeded tcfg_is_managed tcfg_mode \
              tcfg_task_ids tcfg_validate_task tcfg_import tcfg_export \
              tcfg_rollback tcfg_set_field tcfg_new_task tcfg_remove_task \
              tcfg_new_id tcfg_atomic_write sched_reload sched_snapshot_managed \
              scheduler_tick scheduler_boot sched_execute_one sched_cycle_mark \
              sched_cycle_seen sched_source_mode sched_remove_task sched_prune_ron \
sched_task_field sched_audit sched_dep_satisfied sched_gate_check \
               sched_cond_check sched_gate_epoch sched_advance_waiting ipc_server_init ipc_server_poll \
              ipc_parse ipc_params_valid ipc_param ipc_respond ipc_dispatch \
              ipc_allowed_keys ipc_op_get_tasks ipc_op_get_status ipc_op_get_log ipc_op_validate \
              ipc_op_get_summary ipc_op_get_task_detail ipc_op_get_task_events ipc_op_get_daemon_log \
              web_json_escape web_json_str web_run_or_task web_log_lines_json web_task_row \
              web_agg_summary web_task_detail web_log_payload web_task_log_to_json \
              obs_gate_state obs_dep_state \
              tcfg_editor_num tcfg_editor_bool tcfg_editor_id_ok tcfg_editor_trigger_ok tcfg_editor_action_ok \
              tcfg_editor_health_ok tcfg_editor_recovery_ok tcfg_editor_validate_payload tcfg_apply_task ipc_op_get_task_edit ipc_op_edit_task \
              ipc_op_create ipc_op_update ipc_op_delete ipc_op_set_enabled \
              ipc_op_start ipc_op_stop ipc_op_restart ipc_client_send \
              ipc_b64enc ipc_b64dec ipc_task_state ipc_has_newline \
              tctl_resolve tctl_state tctl_start tctl_stop tctl_restart \
              tctl_check tctl_logs tctl_set_enabled ipc_op_check \
              secv_id_ok secv_num_clamp secv_inside secv_nosymlink \
               secv_guard_task_dir secv_ipc_ratelimit secv_sweep_tmp \
               secv_fix_perms secv_effective_timeout runtime_limit_task_log \
               dep_normalize dep_entry_ok dep_validate cond_validate \
               cond_grammar_ok cond_eval \
               sched_retry_count_file sched_retry_until_file sched_retry_gatefail_file \
               rty_policy sched_retry_arm sched_retry_pending \
               dep_validate_graph; do
        type "$fn" >/dev/null 2>&1 || { echo "runtime-lib selfcheck: missing $fn" >&2; return 1; }
    done
    return 0
}